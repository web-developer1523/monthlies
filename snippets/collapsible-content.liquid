<div class="collapsible-content">
  <label class="collapsible-content__label">
    <input type="checkbox">
    {{ title }}
    {% render 'icons', name: 'tab_arrow' %}
  </label>
  <div class="collapsible-content__content-wrapper">
    <div class="collapsible-content__content">
      {{ content }}
    </div>
  </div>
</div>