ax-width: 2400px)"/><img src="https://cdn.shopify.com/s/files/1/0615/3951/6642/files/Frame_9914145.webp?v=1720629119" alt="Supplement jar with a spoonful of powder, highlighting benefits and price per day." class="r-ezfu7f" loading="lazy"/></picture><div data-rid="1765d46f-e018-4f76-aa6b-356415926a30" class="r-1nto667 alchemy-rte"><span style="width:100%"><h5>Balance Your Hormones*</h5></span></div><div data-rid="121fd2df-b1b4-40ac-921f-f70fe2bdf4c3" class="r-ema3oe alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontsize:14px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-texttransform:undefined"><span style="width:100%"><p><b>What happens?</b></p><p><br></p><p>Your hormones naturally rise and fall each month. But when oestrogen rises too high (often under everyday stress, hectic schedules, bad sleep, or poor diet), it triggers an overproduction of prostaglandins — the main driver behind deeper cramps and inflammation.<br><br>The result? With this natural balance lost, you´re left facing heightened cramping, and fewer defenses against pain flares.</p></span></div><div data-rid="c1e21630-7191-4819-8d98-12228c756ae4" class="r-13cubk7 alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontsize:14px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-texttransform:undefined"><span style="width:100%"><p></p><b>How monthlies helps:<br></b><br><p>Formulated with scientifically backed ingredients like <b>Lemon Balm, Broccoli Seed Extract, B-Complex, Myo-Inositol, Choline, and Flaxseed</b>, monthlies supports hormonal balance at its core—optimising oestrogen metabolism, promoting healthy progesterone, and supporting stress management.*<br><br>As your hormonal pathways are optimised, you’re less prone to overactive cramping and inflammation from the start, <b>setting the stage for cramps you barely even notice.*</b></p></span></div></div></div></div></div></div><div data-state="inactive" data-orientation="vertical" role="tabpanel" aria-labelledby="radix-:Rcaj2:-trigger-72dfdcfb-b4c1-4304-a3d3-f4c2c6a57d011" id="radix-:Rcaj2:-content-72dfdcfb-b4c1-4304-a3d3-f4c2c6a57d011" tabindex="0" style="display:none"><div data-rid="a8a14de3-7e0d-42f3-b23d-a15195d0d2c6" class="r-fw2ors"><div data-rid="32f9e3ff-1ab2-4413-aa46-1c081a01a07c" class="r-hn9c7s"><div data-rid="cd8cbdd0-9687-454a-85b4-56b9322f4e87" class="r-t02go4"><div data-rid="6a9b5bbf-093a-445c-84b8-8ed248873e05" class="r-snwr80"><picture data-rid="ff8c29fc-2d7e-494d-a5f2-4f8c2598d957" class="r-z95z5j"><source srcSet="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/v3_1_a36178d0-95b9-4783-ac76-8038a7e2e39f.webp?v=1739282201&amp;width=820" media="(max-width: 640px)"/><source srcSet="https://cdn.shopify.com/s/files/1/0615/3951/6642/files/Frame_9914145.webp?v=1720629119&amp;width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://cdn.shopify.com/s/files/1/0615/3951/6642/files/Frame_9914145.webp?v=1720629119&amp;width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://cdn.shopify.com/s/files/1/0615/3951/6642/files/Frame_9914145.webp?v=1720629119" alt="Supplement bottle in a garden, highlighting ginger, turmeric, and aniseed extracts." class="r-1b7fgvf" loading="lazy"/></picture><div data-rid="766201f7-cb03-4f5f-ad02-663de28de46d" class="r-1kp0fex alchemy-rte"><span style="width:100%"><h5>Tame Prostaglandins*</h5></span></div><div data-rid="3e376407-04d3-4535-b6bf-bae67dea484c" class="r-1ebpu0x alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontsize:14px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-texttransform:undefined"><span style="width:100%"><p><b>What happens?</b></p><p><br></p><p>Prostaglandins are essential and help your uterus shed its lining. However, when they surge — due to an an overactive COX-2 enzyme — they directly intensify cramps, sharpen pain signals, and make them more frequent.<br><br></p><p>Painkillers work by blocking prostaglandins after they’ve spiked, often hitting COX-1 (needed for stomach protection) along with COX-2. This can lead to side effects like indigestion or ulcers —while leaving hormonal and nutrient imbalances unresolved, so the cycle of pain keeps repeating.</p></span></div><div data-rid="d5ab68c0-dc73-4ee2-a500-7c9b9588d201" class="r-ylbfmw alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontsize:14px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-texttransform:undefined"><span style="width:100%"><p></p><b>How monthlies helps:<br></b><br>Formulated with <b>potent anti-inflammatory</b> support from Ginger Root Extract, Turmeric, and Aniseed, monthlies helps combat inflammation— with Ginger and Turmeric <b>selectively favoring COX-2 inhibition to safeguard your stomach lining.*</b><br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br>And because monthlies is designed for daily use — unlike painkillers — it works to keep COX-2 in check all month long, <b>helping manage discomfort during your period while also addressing pain before it even begins.*<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</b><br>By calming pain amplifiers at their source, monthlies supports less intense contractions, lower inflammation, and helps ease the nerve sensitivity that magnifies cramps — <b>without the side effects you can get from painkillers.*</b><br></span></div></div></div></div></div></div><div data-state="inactive" data-orientation="vertical" role="tabpanel" aria-labelledby="radix-:Rcaj2:-trigger-4e06e966-e251-47aa-bb87-82e152ba74cf2" id="radix-:Rcaj2:-content-4e06e966-e251-47aa-bb87-82e152ba74cf2"