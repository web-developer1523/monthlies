43d7-b73f-26639a2f7dc0-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f775258-2b0d-43d7-b73f-26639a2f7dc0-attributes-texttransform:undefined"><span style="width:100%"><p>RHN, ND, Canada College of Natural Nutrition, Concordia University</p></span></div><div data-rid="1d99e840-012c-457b-ad0a-d72aab26231c" class="r-2wfps1 alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontsize:14px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textalign:center;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-texttransform:undefined"><span style="width:100%"><p>„Keine Frau erlebt ihren Zyklus auf die gleiche Weise, deshalb schätze ich die Vielseitigkeit von monthlies. Die Formel ist darauf ausgelegt, eine Vielzahl von Symptomen zu behandeln - von Regelschmerzen und Verdauungsbeschwerden bis hin zu Energiemangel und Stimmungsschwankungen. Diese Anpassungsfähigkeit macht es zu einer umfassenden Lösung für Frauen, die eine bessere Menstruationsgesundheit anstreben.“</p></span></div></div></div></div></div></div></div><div data-replo-marquee-root="true" data-rid="5a8c8ef6-6b04-4b4b-9f47-1ad794f829fe" class="r-1tlswyd"><div class="r-1l3cl8w" data-replo-marquee-track="true"><div data-rid="7a3b26ab-6484-4d80-870b-d8c0cd6a661c" class="r-1dn5dt"><div data-rid="3d58f60d-e997-44c2-b83f-88b2eb73c366" class="r-1nwjjd8"><picture data-rid="f2b5b7e2-6b98-4101-8923-2a9240a7aac5" class="r-jbzodj"><source srcSet="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/360_support.png?v=1737212396&amp;width=96" media="(max-width: 640px)"/><source srcSet="https://cdn.shopify.com/s/files/1/0781/1982/9800/files/Frame_9914067_c5121be8-befe-48ec-a3b4-4a7babff7d40.png?v=1716107978&amp;width=96" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://cdn.shopify.com/s/files/1/0781/1982/9800/files/Frame_9914067_c5121be8-befe-48ec-a3b4-4a7babff7d40.png?v=1716107978&amp;width=96" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://cdn.shopify.com/s/files/1/0781/1982/9800/files/Frame_9914067_c5121be8-befe-48ec-a3b4-4a7babff7d40.png?v=1716107978" class="r-4xreem" loading="lazy"/></picture><div data-rid="53e9ed2f-36ba-447f-87d9-94377e1fb844" class="r-1xeziy7 alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-4c9ac7ce-a53a-458a-a315-7f9f3661963d-attributes-fontsize:16px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-4c9ac7ce-a53a-458a-a315-7f9f3661963d-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-4c9ac7ce-a53a-458a-a315-7f9f3661963d-attributes-textalign:center;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-4c9ac7ce-a53a-458a-a315-7f9f3661963d-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2