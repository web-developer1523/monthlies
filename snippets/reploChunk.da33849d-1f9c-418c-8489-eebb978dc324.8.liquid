-85c2-a9c88cbfa244-styles-9f775258-2b0d-43d7-b73f-26639a2f7dc0-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f775258-2b0d-43d7-b73f-26639a2f7dc0-attributes-texttransform:undefined"><span style="width:100%"><p>DipNT, mANP, The College</p><p>of Naturopathic Medicine</p></span></div><div data-rid="dd1f5725-67fe-46e2-9f1d-b237ab908afe" class="r-rfe9aa alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-fontsize:17px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-textalign:center;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-texttransform:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-textdecoration:undefined"><span style="width:100%"><p><span>“Es ist erstaunlich, wie viele Frauen glauben, dass Menstruationsschmerzen normal sind und „einfach zum Frausein dazugehören“. Wenn Frauen an Gesundheit denken, konzentrieren sie sich oft auf ihr Gewicht, ihre Verdauung oder ihre Haut, aber selten auf ihren Zyklus. Monthlies verfolgt einen innovativen Ansatz, indem es das Wohlbefinden während der Menstruation in den Vordergrund stellt und Frauen hilft, ihren Zyklus zu verstehen und ihren Körper dabei zu unterstützen, das Gleichgewicht auf natürliche Weise wiederherzustellen.“</span></p></span></div></div></div></div><div data-state="inactive" data-orientation="vertical" role="tabpanel" aria-labelledby="radix-:Rpj2:-trigger-c284e82b-8299-45d1-8c61-a6387f6c38d13" id="radix-:Rpj2:-content-c284e82b-8299-45d1-8c61-a6387f6c38d13" tabindex="0" style="display:none"><div data-rid="f92076d2-7cfe-4d98-b284-9e4f7b669717" class="r-1hjmepi"><picture data-rid="91869450-09f0-4bf3-964f-996c238c9614" class="r-k90ktv"><source srcSet="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/1_2_aaa7a350-73cd-4404-ba37-07284d15cb20.webp?v=1737642708&amp;width=820" media="(max-width: 640px)"/><source srcSet="https://andytown-public.s3.us-west-1.amazonaws.com/templates/component-templates/AG%20Lp/bc3d69b3-dffe-436b-badc-9223d9d0ae8a_huberman.jpg%3Fauto%3Dcompress%2Cformat" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://andytown-public.s3.us-west-1.amazonaws.com/templates/component-templates/AG%20Lp/bc3d69b3-dffe-436b-badc-9223d9d0ae8a_huberman.jpg%3Fauto%3Dcompress%2Cformat" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://andytown-public.s3.us-west-1.amazonaws.com/templates/component-templates/AG%20Lp/bc3d69b3-dffe-436b-badc-9223d9d0ae8a_huberman.jpg%3Fauto%3Dcompress%2Cformat" alt="A person outdoors holding a stethoscope while smiling." class="r-fiwyiw" loading="lazy"/></picture><div data-rid="b4d00ae3-b17f-4c61-ae5a-e3af55eea834" class="r-dfm7k4"><div data-rid="20e89c30-a689-4d53-a28b-43f6e561c425" class="r-nh2ypd alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-ece01f1d-0e12-429a-8e5e-958d2509494b-attributes-c