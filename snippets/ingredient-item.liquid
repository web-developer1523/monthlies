<slider-modal-opener
  class="ingredient"
  data-index="{{ index }}"
  data-category="{{ category }}"
  data-modal="{{ modal }}"
  data-target-index="{{ index }}"
>
  <div class="ingredient__image absolute-img">
    {{
      item.image
      | image_url: width: 388
      | image_tag:
        width: item.image.width,
        sizes: '(min-width: 750px) 50vw, 100vw',
        widths: '320, 550, 767, 990, 1024, 1440',
        alt: item.image.alt,
        loading: 'lazy'
    }}
  </div>
  <div class="ingredient__info">
    {% if item.vitamin_name != blank %}
      <h3 class="ingredient__name">{{ item.vitamin_name | metafield_tag }}</h3>
    {% endif %}
    {% if item.mineral_name != blank %}
      <h3 class="ingredient__name">{{ item.mineral_name | metafield_tag }}</h3>
    {% endif %}
    {% if item.nutrient_name != blank %}
      <h3 class="ingredient__name">{{ item.nutrient_name | metafield_tag }}</h3>
    {% endif %}
    {% if item.amino_acid_name != blank %}
      <h3 class="ingredient__name">{{ item.amino_acid_name | metafield_tag }}</h3>
    {% endif %}
    {% if item.other_ingredient_name != blank %}
      <h3 class="ingredient__name">{{ item.other_ingredient_name | metafield_tag }}</h3>
    {% endif %}
    {% if item.plant_extract_name != blank %}
      <h3 class="ingredient__name">{{ item.plant_extract_name | metafield_tag }}</h3>
    {% endif %}

    {% if item.amount_per_serving != blank %}
      <div class="ingredient__amount">{{ item.amount_per_serving }}</div>
    {% endif %}
  </div>
</slider-modal-opener>
