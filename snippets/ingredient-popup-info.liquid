<div class="ingredient-popup-info">
  <div class="ingredient-popup-info__heading">
    {% if ingredient.vitamin_name != blank %}
      <h3>{{ ingredient.vitamin_name | metafield_text }}</h3>
    {% endif %}
    {% if ingredient.mineral_name != blank %}
      <h3>{{ ingredient.mineral_name | metafield_text }}</h3>
    {% endif %}
    {% if ingredient.nutrient_name != blank %}
      <h3>{{ ingredient.nutrient_name | metafield_text }}</h3>
    {% endif %}
    {% if ingredient.amino_acid_name != blank %}
      <h3>{{ ingredient.amino_acid_name | metafield_text }}</h3>
    {% endif %}
    {% if ingredient.other_ingredient_name != blank %}
      <h3>{{ ingredient.other_ingredient_name | metafield_text }}</h3>
    {% endif %}
    {% if ingredient.plant_extract_name != blank %}
      <h3>{{ ingredient.plant_extract_name | metafield_text }}</h3>
    {% endif %}
    <button class="ingredient-popup-info__close-button" data-slider-modal-close>
      {%- render 'icon-close' -%}
    </button>
  </div>
  {%- assign amount_per_serving_strip = ingredient.amount_per_serving | strip -%}
  {% if ingredient.amount_per_serving != blank and amount_per_serving_strip != '-' %}
    <div class="ingredient-popup-info__amount-per-serving">
      <p>{{ 'ingredients.amount_per_serving_html' | t: amount: ingredient.amount_per_serving }}</p>
    </div>
  {% endif %}
  <div class="ingredient-popup-info__content">
    {% if ingredient.image != blank %}
      <div class="ingredient-popup-info__image">
        {{
          ingredient.image
          | image_url: width: 800
          | image_tag:
            width: ingredient.image.width,
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '320, 550, 767, 990, 1024, 1440',
            alt: ingredient.image.alt,
            loading: 'lazy'
        }}
      </div>
    {% endif %}
    {%- assign absorbability_comments_strip = ingredient.absorbability_comments | strip -%}
    {% if ingredient.absorbability_comments != blank and absorbability_comments_strip != '-' %}
      <div class="ingredient-popup-info__absorbability-comments">
        {{ ingredient.absorbability_comments }}
      </div>
    {% endif %}
    {%- assign benefits_strip = ingredient.benefits | strip -%}
    {% if ingredient.benefits != blank and benefits_strip != '-' %}
      <div class="ingredient-popup-info__info-wrapper">
        <h4 class="ingredient-popup-info__info-heading">{{ 'ingredients.info_titles.benefits' | t }}</h4>
        <div class="ingredient-popup-info__info-text">
          {{ ingredient.benefits | metafield_tag }}
        </div>
      </div>
    {% endif %}
    {%- assign evidence_list_strip = ingredient.evidence_list | strip -%}
    {% if ingredient.evidence_list != blank and evidence_list_strip != '-' %}
      <div class="ingredient-popup-info__info-wrapper">
        <h4 class="ingredient-popup-info__info-heading">{{ 'ingredients.info_titles.evidence' | t }}</h4>
        <div class="ingredient-popup-info__info-text">
          {{ ingredient.evidence_list | metafield_tag }}
        </div>
      </div>
    {% endif %}
    {%- assign percent_rda_strip = ingredient.percent_rda | strip -%}
    {% if ingredient.percent_rda != blank and percent_rda_strip != '-' %}
      <div class="ingredient-popup-info__info-wrapper">
        <h4 class="ingredient-popup-info__info-heading">{{ 'ingredients.info_titles.percent_rda' | t }}</h4>
        <div class="ingredient-popup-info__info-text">
          {{ ingredient.percent_rda }}
        </div>
      </div>
    {% endif %}
    {%- assign sub_ingredient_strip = ingredient.sub_ingredient | strip -%}
    {% if ingredient.sub_ingredient != blank and sub_ingredient_strip != '-' %}
      <div class="ingredient-popup-info__info-wrapper">
        <h4 class="ingredient-popup-info__info-heading">{{ 'ingredients.info_titles.sub_ingredient' | t }}</h4>
        <div class="ingredient-popup-info__info-text">
          {{ ingredient.sub_ingredient }}
        </div>
      </div>
    {% endif %}
    {%- assign source_reference_strip = ingredient.source_reference | strip -%}
    {% if ingredient.source_reference != blank and source_reference_strip != '-' %}
      <div class="ingredient-popup-info__info-wrapper">
        <h4 class="ingredient-popup-info__info-heading">{{ 'ingredients.info_titles.source' | t }}</h4>
        <div class="ingredient-popup-info__info-text">
          {{ ingredient.source_reference | metafield_tag }}
        </div>
      </div>
    {% endif %}
  </div>
</div>