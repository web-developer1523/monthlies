iv data-rid="7178929d-03c9-456f-aad4-1af4e453fbcb" class="r-1xi6xob"><div data-rid="45722f82-7496-4556-9818-b7a36c8d896a" class="r-12z04ka"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:100%" class="r-78s5zu" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"></path></svg></div></div></div><div hidden="" id="replo-:R19ej2:"><div data-rid="99a7244d-50d3-47c3-be3e-c05ad2f30522" class="r-3vm6rv"><div data-rid="aa841260-6970-48df-9a0c-539d80a693b9" class="r-fnu6wz alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontsize:14px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-texttransform:undefined"><span style="width:100%"><p><span style="color: rgb(0, 0, 0)">Vitamin B-Octa-Komplex (B1, B2, B3, B5, B6, B7, B9, B12)</span></p><p><br></p><p><span style="color: rgb(0, 0, 0)">Trägt zur Energieproduktion, Hormonregulierung und Stimmungsaufhellung bei*.</span></p><p><br></p><p><span style="color: rgb(0, 0, 0)">Hilft bei: Steigert die Energie, stabilisiert die Stimmung und unterstützt eine gesunde Hormonfunktion.*</span></p><p><br><br></p><p><span style="color: rgb(0, 0, 0)">Vitamin C</span></p><p><br></p><p><span style="color: rgb(0, 0, 0)">Unterstützt die Gesundheit der Haut und die Funktion des Immunsystems*.</span></p><p><br></p><p><span style="color: rgb(0, 0, 0)">Hilft bei: Fördert eine gesündere Haut und trägt zum Schutz vor oxidativem Stress bei.*</span></p><p><br><br></p><p><span style="color: rgb(0, 0, 0)">Vitamin D3 + K2</span></p><p><br></p><p><span style="color: rgb(0, 0, 0)">Unterstützt die Knochengesundheit und den Kalziumstoffwechsel*.</span></p><p><br></p><p><span style="color: rgb(0, 0, 0)">Hilft bei: Stärkt die Knochen und unterstützt den Hormonhaushalt.*</span></p><p><br><br></p><p><span style="color: rgb(0, 0, 0)">Vitamin A</span></p><p><br></p><p><span style="color: rgb(0, 0, 0)">Trägt zur Hautreinheit und allgemeinen Gesundheit bei.*</span></p><p><br></p><p><span style="color: rgb(0, 0, 0)">Hilft bei: Sorgt für eine klarere Haut und unterstützt eine gesunde Hormonfunktion.*</span></p></span></div></div></div></div><div data-rid="b1fd91f6-c2fc-4693-89ed-32f739708864" class="r-7h3old" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="ae3e5d31-5eca-489d-9f85-fcc0501acb74" aria-expanded="false" aria-controls="replo-:R1pej2:" tabindex="0" role="button" class="r-19f5kl8"><div data-rid="a920fb8f-9891-4799-913d-d7c2e2e5c839" class="r-1p0k32w alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-60caf70d-2745-48ff-ac0b-fd7f96435b41-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2