d7-b73f-26639a2f7dc0-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f775258-2b0d-43d7-b73f-26639a2f7dc0-attributes-texttransform:undefined"><span style="width:100%"><p>RHN, ND, Canada College of Natural Nutrition, Concordia University</p></span></div><div data-rid="0d81d630-ccde-47b7-a748-9f54093fb906" class="r-eb21we alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontsize:14px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textalign:center;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-texttransform:undefined"><span style="width:100%"><p>„Keine Frau erlebt ihren Zyklus auf die gleiche Weise, deshalb schätze ich die Vielseitigkeit von monthlies. Die Formel ist darauf ausgelegt, eine Vielzahl von Symptomen zu behandeln - von Regel