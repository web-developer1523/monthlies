ndefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-texttransform:undefined"><span style="width:100%"><p><span style="font-weight: normal;">"Deficiencies in key micronutrients, including magnesium, zinc, calcium, and vitamin D, are associated</span><b> with increased severity of period pain.</b>"</p></span></div><div data-rid="8afd5c3c-a3f7-47ae-857e-8a72b5dad640" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-1ch0b1j alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-color:#2A2A2AFF;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-fontsize:8px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-textalign:left;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-at