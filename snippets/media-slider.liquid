{%- liquid
  assign gallery_media = blank
  if product != blank
    assign gallery_media = product.media | where: 'media_type', 'image'
  endif
-%}

{%- capture media_slider_settings -%}
  {
    "slidesPerView": "auto",
    "spaceBetween": 0,
    "speed": 450,
    "slideToClickedSlide": true,
    "loop": false,
    "watchSlidesProgress": true,
    "watchOverflow": true,
    "navigation": {
      "nextEl": "#MediaSlider-{{ section.id }} .media-slider__button--next",
      "prevEl": "#MediaSlider-{{ section.id }} .media-slider__button--prev"
    }
  }
{%- endcapture -%}

<div class="media-slider" data-media-slider>
  <div class="media-slider__frame">
    <div
      id="MediaSlider-{{ section.id }}"
      class="media-slider__component swiper"
      {%- render 'slider-attribute', config: media_slider_settings, is_observable: true -%}
    >
      <div class="media-slider__slides swiper-wrapper" role="list">
        {%- if gallery_media != blank -%}
          {%- for media in gallery_media -%}
            <div
              id="MediaSlide-{{ section.id }}-{{ forloop.index }}"
              class="media-slider__slide swiper-slide"
              role="listitem"
            >
              <div class="media-slider__media">
                {{
                  media
                  | image_url: width: 1600
                  | image_tag:
                    class: 'media-slider__image',
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    widths: '360, 540, 720, 900, 1100, 1440, 1600',
                    alt: media.alt
                }}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="media-slider__slide swiper-slide is-placeholder" role="listitem">
              <div class="media-slider__media media-slider__media--placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'media-slider__placeholder' }}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="media-slider__controls slider-buttons no-js-hidden">
        <button
          type="button"
          class="slider-button slider-button--prev media-slider__button media-slider__button--prev"
          name="previous"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          <svg class="media-slider__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 5L8 12L15 19" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="slider-button slider-button--next media-slider__button media-slider__button--next"
          name="next"
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          <svg class="media-slider__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 5L16 12L9 19" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="MediaSliderThumbs-{{ section.id }}"
    class="media-slider__thumbs"
    aria-label="{{ 'general.slider.name' | t }}"
  >
    <div class="media-slider__thumbs-track" role="list">
      {%- if gallery_media != blank -%}
        {%- for media in gallery_media -%}
          <button
            type="button"
            class="media-slider__thumb{% if forloop.first %} is-active{% endif %}"
            data-media-thumb-index="{{ forloop.index0 }}"
            aria-label="{{ 'general.slider.name' | t }} {{ forloop.index }}"
            aria-current="{% if forloop.first %}true{% endif %}"
          >
            {{
              media
              | image_url: width: 240
              | image_tag:
                class: 'media-slider__thumb-image',
                loading: 'lazy',
                sizes: '120px',
                widths: '120, 180, 240',
                alt: media.alt
            }}
          </button>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <button
            type="button"
            class="media-slider__thumb{% if forloop.first %} is-active{% endif %}"
            data-media-thumb-index="{{ forloop.index0 }}"
            aria-label="{{ 'general.slider.name' | t }} {{ forloop.index }}"
            aria-current="{% if forloop.first %}true{% endif %}"
          >
            <div class="media-slider__thumb-placeholder"></div>
          </button>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>
