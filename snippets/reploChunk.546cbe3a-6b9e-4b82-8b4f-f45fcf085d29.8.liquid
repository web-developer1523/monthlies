94-85c2-a9c88cbfa244-styles-9f775258-2b0d-43d7-b73f-26639a2f7dc0-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f775258-2b0d-43d7-b73f-26639a2f7dc0-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f775258-2b0d-43d7-b73f-26639a2f7dc0-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f775258-2b0d-43d7-b73f-26639a2f7dc0-attributes-texttransform:undefined"><span style="width:100%"><p>BSc, ND</p></span></div><div data-rid="eb6d6056-23b0-4a2c-8fa2-42972403ba1a" class="r-1e0qbxw alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-fontsize:17px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-textalign:center;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-texttransform:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-textdecoration:undefined"><span style="width:100%"><p><span>„Selbst meine gesündesten Patientinnen, die regelmäßig Sport treiben, haben mit Menstruationsbeschwerden zu kämpfen. Stress, Nährstoffmangel und hormonelle Schwankungen können eine große Rolle spielen. Monthlies füllt diese Defizite mit wichtigen Nährstoffen aus Magnesium, Brokkolisprossen, Chrom, Zitronenmelisse und entzündungshemmenden Wirkstoffen wie Ingwer und Kurkuma und fördert eine langfristige Unterstützung des Zyklus und des hormonellen Gleichgewichts.“</span></p></span></div></div></div></div><div data-state="inactive" data-orientation="vertical" role="tabpanel" aria-labelledby="radix-:R6ar2:-trigger-8cf6d0b1-d29b-424e-81a5-41360429b0d84" id="radix-:R6ar2:-content-8cf6d0b1-d29b-424e-81a5-41360429b0d84" tabindex="0" style="display:none"><div data-rid="988a686c-ecb7-48a4-bc8d-0c6cf9a9fad3" class="r-1j1qyg7"><picture data-rid="7ef45564-73d5-48f4-9c8f-17ee21f08a95" class="r-1x73k7y"><source srcSet="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/5_2_ca8ae0c2-d553-4252-a355-5b2092680f14.webp?v=1737642707&amp;width=820" media="(max-width: 640px)"/><source srcSet="https://andytown-public.s3.us-west-1.amazonaws.com/templates/component-templates/AG%20Lp/bc3d69b3-dffe-436b-badc-9223d9d0ae8a_huberman.jpg%3Fauto%3Dcompress%2Cformat" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://andytown-public.s3.us-west-1.amazonaws.com/templates/component-templates/AG%20Lp/bc3d69b3-dffe-436b-badc-9223d9d0ae8a_huberman.jpg%3Fauto%3Dcompress%2Cformat" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://andytown-public.s3.us-west-1.amazonaws.com/templates/component-templates/AG%20Lp/bc3d69b3-dffe-436b-badc-9223d9d0ae8a_huberman.jpg%3Fauto%3Dcompress%2Cformat" alt="A woman with long blonde hair, smiling and wearing a blue shirt." class="r-2nwf1a" loading="lazy"/></picture><div data-rid="f93b1dba-785a-4625-87d4-23ad924b8c23" class="r-w06sno"><div data-rid="60434523-df93-4e58-a85