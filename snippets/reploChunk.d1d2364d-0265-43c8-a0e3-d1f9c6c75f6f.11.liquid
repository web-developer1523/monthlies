d7-96cc-bc84ca02be5f-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-b1595417-72bf-46d7-96cc-bc84ca02be5f-attributes-letterspacing:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-b1595417-72bf-46d7-96cc-bc84ca02be5f-attributes-texttransform:undefined"><span style="width:100%"><p><strong>What happens?</strong></p><br><p>Progesterone rises to support potential pregnancy, while estrogen levels fluctuate. If no fertilization occurs, both hormones drop, triggering PMS symptoms like bloating, mood swings, cravings, and fatigue. The body may also experience increased water retention and sensitivity.*</p></span></div></div></div><div data-rid="07da28b4-712b-4c09-b5eb-aaf67b99a7c6" class="r-1plp485 alchemy-rte" style="--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontsize:14px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textdecoration:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textshadow:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-textstroke:undefined;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-9f4e2106-1742-4edd-a195-a474795b8511-attributes-texttransform:undefined"><span style="width:100%"><p><strong>How monthlies helps:</strong></p