      "settings": {
        "title": "Say goodbye to period pain",
        "text": "<p>Cramps, fatigue, weakness, heavy periods, and menstrual stress weighing you down?<br/><br/>Hormonal analysis can help you understand the connection between your hormonal health and period pain so you can find effective solutions.<br/><br/>Gain insights into how imbalances impact your cycle, mood, metabolism, libido, sleep, and overall health, so you can take control of your well-being and improve your menstrual health.<br/><br/><em>*Hormonal tests on hormone pills may give inaccurate results due to synthetic hormone interference with reflecting your natural menstrual cycle.</em></p>",
        "btn": "Order now",
        "btn_id": "cta-orderpain",
        "btn_url": "shopify://products/hormonal-test",
        "image": "https://cdn.shopify.com/s/files/1/0708/7462/8371/files/AdobeStock_178355722.png?v=1687252617",
        "reverse": false
      }
    },
    "content-block-2": {
      "type": "content-block",
      "custom_css": [
        ".content-block-richtext p {text-align: left;}"
      ],
      "settings": {
        "title": "What’s included?",
        "text": "<p>Everything you need to quickly and easily understand your cycle in a convenient self-test package.<br/></p><p><strong>Saliva Extraction Instructions:</strong><br/>Clear instructions that guide you for an effective saliva sample collection.</p><p><strong>Accompanying Document: <br/></strong>Additional information and guidance to ensure accurate collection.</p><p><strong>Guarantee Certificate:</strong><br/>Backed by our commitment to reliable results.</p><p><strong>Saliva Collection Kit:</strong><br/>Includes vessels (x3), straw (x3), and labels (x3) for secure and convenient sample collection.</p><p><strong>Shipping Container:<br/></strong>Specialized container to securely package your saliva sample and ensure safe transportation.</p><p><strong>Mailing Bag:</strong><br/>Prepaid bag for easy sample return to our laboratory.</p>",
        "btn": "Order now",
        "btn_id": "cta-orderinc",
        "btn_url": "shopify://products/hormonal-test",
        "image": "https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Hormonaltest.webp?v=1687419464",
        "reverse": true
      }
    },
    "steroids": {
      "type": "steroids",
      "settings": {
        "title": "Measuring six biomarkers called steroid hormones",
        "text": "Your steroid hormones tell us if your primary hormones are within normal ranges. Abnormal levels may be causing symptoms that affect your cycle and overall well-being.",
        "btn": "Order now",
        "btn_url": "shopify://products/hormonal-test",
        "download": "Download example results insights",
        "item_text_1": "This hormone has various functions in the body, including supporting immune function, maintaining energy levels, and promoting overall well-being.",
        "item_title_1": "DHEA",
        "item_text_2": "It is the primary form of estrogen in females (AFAB) and plays a crucial role in reproductive health, bone development, and brain function.",
        "item_title_2": "Estradiol",
        "item_text_3": "Estriol is a form of estrogen that is particularly important during pregnancy and is produced by the placenta.",
        "item_title_3": "Estriol",
        "item_text_4": "Often referred to as the 'stress hormone,' cortisol is involved in regulating stress responses, metabolism, and immune function.",
        "item_title_4": "Cortisol",
        "item_text_5": "Known as the 'pregnancy hormone,' progesterone helps prepare the uterus for pregnancy and plays a role in the menstrual cycle.",
        "item_title_5": "Progesterone",
        "item_text_6": "Testosterone is a key hormone in both males and females, influencing sexual development, fertility, muscle mass, and overall well-being.",
        "item_title_6": "Testosterone"
      }
    },
