        "faq_8fyfQE": {
          "type": "faq",
          "settings": {
            "acc_id": "",
            "icon_round": "shopify://shop_images/Lemon_Balm.png",
            "accordion_heading": "Lemon Balm",
            "small_description": "<p>An ancient aromatic herb prized for its calming and antispasmodic properties.</p>",
            "dsc": "<ul><li>An ancient aromatic herb prized for its calming and antispasmodic properties, Lemon Balm has been scientifically proven to reduce mild anxiety symptoms by up to 36% (Phytotherapy Research).</li><li>Its ability to <strong>alleviate menstrual cramps and bloating</strong> makes it a powerful natural remedy for period pain.</li><li>Additionally, it improves mood, digestion, and cognitive function, providing holistic support during PMS and beyond.</li></ul>"
          }
        },
        "faq_GnaFgn": {
          "type": "faq",
          "settings": {
            "acc_id": "",
            "icon_round": "shopify://shop_images/Inositol.png",
            "accordion_heading": "Inositol",
            "small_description": "<p>A carbohydrate essential for hormonal balance, cell signalling, and metabolic health.</p>",
            "dsc": "<ul><li>A carbohydrate essential for hormonal balance, cell signalling, and metabolic health, Inositol plays a vital role in improving ovarian health and menstrual regularity. Extensively studied for its effectiveness in individuals with PCOS, it <strong>reduces androgen levels, enhances ovulatory function, and shortens irregular cycle lengths.</strong></li><li>Research has shown Inositol can even outperform Metformin in improving hormonal balance and insulin sensitivity, making it a safe and natural solution for restoring menstrual health and alleviating cycle-related symptoms.</li></ul>"
          }
        },
        "faq_cxHNm9": {
          "type": "faq",
          "settings": {
            "acc_id": "",
            "icon_round": "shopify://shop_images/Broccoli.png",
            "accordion_heading": "Broccoli Seed Extract",
            "small_description": "<p>Derived from nutrient-rich broccoli sprouts, this ingredient is packed with glucoraphanin, a precursor to sulforaphane.</p>",
            "dsc": "<ul><li>Derived from nutrient-rich broccoli sprouts, this ingredient is packed with glucoraphanin, a precursor to sulforaphane. Sulforaphane supports liver detoxification by enhancing the metabolism and excretion of excess hormones, reducing estrogen dominance, and alleviating PMS symptoms.</li><li>With its <strong>strong anti-inflammatory and antioxidant effects</strong>, studies show it can reduce oxidative stress by 60-70%, making it essential for balancing hormones and supporting overall well-being.</li></ul>"
          }
        },
        "faq_TLKYnR": {
          "type": "faq",
          "settings": {
            "acc_id": "",
            "icon_round": "shopify://shop_images/Flaxseeds.png",
            "accordion_heading": "Flaxseed",
            "small_description": "<p>Rich in phytoestrogens (lignans) and omega-3 fatty acids, Flaxseed helps balance estrogen levels.</p>",
            "dsc": "<ul><li>Rich in phytoestrogens (lignans) and omega-3 fatty acids, Flaxseed <strong>helps balance estrogen levels to ease symptoms of PMS, PCOS, and menopause.</strong></li><li>The omega-3s reduce inflammation and support hormone production, while its high fiber content promotes bowel regularity and aids in the excretion of excess hormones.</li><li>Studies have shown regular flaxseed consumption can reduce hot flashes by up to 57%, making it a cornerstone for long-term hormonal health and comfort.</li></ul>"
          }
        }
      },
