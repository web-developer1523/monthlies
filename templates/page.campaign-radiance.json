        },
        "23b85301-950f-45d0-8c6b-62d30a1960cd": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How much does Monthlies cost?",
            "row_content": "<p>We offer different options:</p><ul><li>Single Pack: €59.90 for one powder pot.</li><li>Subscription: €49.90 delivered monthly to your doorstep, + exclusive perks.<br/><br/>Invest in your menstrual health and experience the transformative benefits of our powder. <br/><br/>Choose the option that fits your needs and embrace a pain-free cycle.</li></ul>",
