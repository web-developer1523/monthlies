        "richtext_block_JRp7fh": {
          "settings": {
            "richtext_block": "<ul><li>Don’t let your periods run your life.</li><li>Designed for every phase of your cycle, not just period week.</li><li>All-In-One daily drink. </li><li>90-day money-back guarantee and cancel anytime.</li></ul><p></p>"
