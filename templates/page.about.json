          }
        },
        "e4510ad6-e3ba-4b18-9e5f-3734b8e8b409": {
          "type": "text",
          "settings": {
            "text": "<p><strong>100% Commitment</strong><br/><br/>We’ve walked the path, felt the pain, and found relief. Now we’re sharing the solutions we believe in with you.<br/><br/><strong>High-quality standards</strong><br/><br/>We use only science-backed, top-tier ingredients because we believe in maintaining a standard as high as your trust in us.<br/><br/><strong>Inclusive community</strong><br/><br/>Monthlies thrives on the belief that true healing flourishes within a supportive community. Our platform, a refuge for all genders, is built on diversity, fostering dialogue, growth, and positive change.</p>",
            "text_size": "typeset2",
            "secondary_color": true
          }
        },
