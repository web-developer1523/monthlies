o-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-color:#2A2A2A;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-fontsize:17px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-textalign:center;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-e2bf30c6-7292-47b6-96b1-1bb9a4ff7feb-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-color:#2A2A2AFF;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-fontsize:8px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-textalign:left;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-fontfamily:Quicksand;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-fontweight:400;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-lineheight:125%;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-71e50621-f0f3-4a8c-9b18-55b8dd211253-attributes-letterspacing:0px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-1c9d2c07-3467-41a8-a0d5-e24e7bd1cae5-attributes-color:#2a2a2a;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-1c9d2c07-3467-41a8-a0d5-e24e7bd1cae5-attributes-fontsize:23px;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-1c9d2c07-3467-41a8-a0d5-e24e7bd1cae5-attributes-textalign:center;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-1c9d2c07-3467-41a8-a0d5-e24e7bd1cae5-attributes-fontfamily:Lora;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-1c9d2c07-3467-41a8-a0d5-e24e7bd1cae5-attributes-fontweight:500;--replo-library-7229a9be-0ff2-4194-85c2-a9c88cbfa244-styles-1c9d2c07-3467-41a8-a0d5-e24e7bd1cae5-attributes-lineheight:125%"><div data-rid="9e8fed6b-56fd-47ad-b415-a264f84913bb" class="r-99qmkx"><div data-rid="810db656-d48f-44be-abaf-0078fafd9ffe" class="r-1ftojkr"><div data-rid="a790cefd-3606-4569-9a97-04708ebc5e86" class="r-101u726"><div data-rid="125a1cf1-9d27-4e41-8840-d562b53c418e" class="r-5yrwaz"><div data-rid="addd708e-9f1f-4f3d-b61f-259b4a061df5" class="r-1h4ux9a"><div data-rid="6610e3d6-53ae-4862-9013-e01cc7bdb847" class="r-yfd7bt"><button data-rid="9579c6de-48c5-46b1-826f-9516f3885a37" class="text r-1143eep alchemy-rte"><div data-rid="c1b9d9a1-a6d4-4f5a-a36e-24119e658a38" class="r-5fm89a alchemy-rte"><span style="width:100%"><p>Menstrual Wellbeing</p></span></div></button><div data-rid="1a0477e9-a705-47d2-a0c4-60cc25c782e9" class="r-fgb9cx"></div><div data-rid="544285d7-011d-43c4-aa82-bbdf8c1bef65" class="r-qqfsnk alchemy-rte"><span style="width:100%"><p>Last updated: July 2025</p></span></div></div></div></div><div data-rid="b40fd82f-7051-41f6-b9b1-675e3e78d13a" class="r-8yqskd"><div data-rid="4cd07499-bb37-4666-939e-a8b4a91c001c" class="r-1h71594"><div data-rid="a6049726-c9b7-49b0-9175-2c30c9d2d27a" class="r-5if748 alchemy-rte"><span style="width:100%"><h1><span style="color: rgb(0, 0, 0)">Four in five women told it's completely normal</span></h1></span></div></div><div data-rid="09f9e749-0860-4fff-82e3-c7a4beabb8a5" class="r-qrx4b6 alchemy-rte"><span style="width:100%"><h1><span style="color: rgb(0, 0, 0)">Four in five women told it's completely normal</span></h1></span></div><picture data-rid="0a1459be-4e07-4301-9b5e-aee6b1fd2261" class="r-1eqeljy"><source srcSet="https://assets.replocdn.com/projects/05d1c41a-8cc0-4d37-87de-b42dfbdbefe9/e526e8be-7acc-456f-ace3-d5e6cbf5802b?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/74ef5866-9ad7-456b-81d4-5e84e591ae16/d20ee3f2-4c51-4c94-b523-51a39c091e1b?width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/05d1c41a-8cc0-4d37-87de-b42dfbdbefe9/e526e8be-7acc-456f-ace3-d5e6cbf5802b?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/05d1c41a-8cc0-4d37-87de-b42dfbdbefe9/e526e8be-7acc-456f-ace3-d5e6cbf5802b" class="r-iedtpm" loading="eager"/></picture></div><div class="r-1yj3fcx" data-rid="1"><div data-rid="67af309b-533c-4dfa-946a-d62cf2043749" class="r-1mu71f4"><div data-rid="0aa29cc4-2986-4e99-88d9-b7267a4f38e9" class="r-ikrgl9 alchemy-rte"><span style="width:100%"><h4><span style="color: rgb(0, 0, 0)"><strong>Dr. Ashley Florestal, ND&nbsp;</strong><em>Women's Health Focused, Certified Naturopathic Doctor</em></span></h4></span></div><div data-rid="4666f885-0a5a-4976-aecb-08102aaf3ba3" class="r-1171l4x"><div data-rid="520057b5-9ca7-4dd6-961b-1674035d381b" class="r-rau7fl alchemy-rte"><span style="width:100%"><p><span style="color: rgb(0, 0, 0)">We learned from our study of 5,000 women that four in five have been told it's completely normal to feel discomfort every single month, and 49% had been told that birth control was the only option for pain management.</span></p><p><br></p><p><span style="color: rgb(0, 0, 0)">Women want more choices for managing period pain, so we sat down with one of our in-house experts, Ashley, to find out what else women can do to manage their pain.</span></p></span></div></div><div data-rid="d5fc351d-2da5-4595-9c4d-371c68fce78f" class="r-1bpakek"><div data-rid="76d3d1ec-477e-4539-a6d2-fbfedd1bae83" class="r-upo3gl alchemy-rte"><span style="width:100%"><h2><span style="color: rgb(0, 0, 0)"><strong>What is period pain and what causes it?</strong></span></h2></span></div><div data-rid="9b78070d-90f2-4ba7-b0c9-868c8491e66e" class="r-4asl6w alchemy-rte"><span style="width:100%"><p>"Period pain, also called dysmenorrhoea, can be separated into two categories, primary dysmenorrhoea, pain with no known underlying cause and secondary dysmenorrhoea pain caused by a specific condition, such as endometriosis or fibroids. The main driver is believed to be prostaglandins, chemicals in your body that trigger uterine contractions. People who make more prostaglandins tend to experience stronger cramps."</p></span></div></div><div data-rid="90f743a7-15fe-4a0a-97a8-0ef93f9165da" class="r-fbvtp4"><div data-rid="31d10f8a-0ec2-4255-a515-3f3682fc5caa" class="r-43yybl alchemy-rte"><span style="width:100%"><h2><span style="color: rgb(0, 0, 0)">"If you have primary dysmenorrhoea, diet and lifestyle tweaks can make a real difference"</span></h2><p><br></p></span></div><div data-rid="adc1afa8-a148-4d8e-b869-1234984d0e72" class="r-1b9t7qi alchemy-rte"><span style="width:100%"><h2><span style="color: rgb(0, 0, 0)"><strong>Are there everyday ways to help with period pain instead of, or in addition to, painkillers and birth control?</strong></span></h2></span></div><div data-rid="f718e183-5921-42cd-a894-dbca909ebb7d" class="r-3fm5cz alchemy-rte"><span style="width:100%"><p>"If you have primary dysmenorrhoea, diet and lifestyle tweaks can make a real difference:<span style="color: rgb(0, 0, 0)">&nbsp;</span></p><p><br></p><p>• Eat a well-balanced diet rich in fruit, vegetables, healthy fats, protein and fibre.</p><p><br></p><p>&nbsp;• Include plenty of cruciferous vegetables like broccoli, cauliflower, kale and cabbage to support healthy hormone metabolism.&nbsp;</p><p><br></p><p>• Consume omega-3's regularly (salmon, sardines, flaxseed) to help with prostaglandins.<span style="color: rgb(0, 0, 0)">&nbsp;</span></p><p><br></p><p>Key nutrients that may help include vitamins C, D and E, B vitamins, zinc, ginger; omega-3 and magnesium (when combined with B6).<span style="color: rgb(0, 0, 0)">&nbsp;</span></p><p><br></p><p>Other fundamentals are quality sleep, regular exercise and stress management. We know that stress can worsen PMS and period pain. Regular exercise and quality sleep can help with stress management as well as many other bodily functions that are involved in period pain."hormone</p></span></div></div><picture data-rid="16a092ec-f421-4aff-bb69-f89576cf567e" class="r-1367xet"><source srcSet="https://assets.replocdn.com/projects/05d1c41a-8cc0-4d37-87de-b42dfbdbefe9/14f6baf7-1879-4d44-a50e-23524be93acb?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/74ef5866-9ad7-456b-81d4-5e84e591ae16/d20ee3f2-4c51-4c94-b523-51a39c091e1b?width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/05d1c41a-8cc0-4d37-87de-b42dfbdbefe9/14f6baf7-1879-4d44-a50e-23524be93acb?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/05d1c41a-8cc0-4d37-87de-b42dfbdbefe9/14f6baf7-1879-4d44-a50e-23524be93acb" alt="Wooden spoons with various beans and legumes on a rustic surface." class="r-1w8824o" loading="eager"/></picture><div data-rid="c3d77ae6-f6c0-4550-8298-1ac265a4c1e7" class="r-1me08xr"><div data-rid="78cad129-c2d8-4129-99bf-6bda5de97ed9" class="r-1m5p02k alchemy-rte"><span style="width:100%"><h2><span style="color: rgb(0, 0, 0)"><strong>What is PMS?</strong></span></h2></span></div><div data-rid="e5cd26d1-fcd7-4521-9320-48d602e2f41a" class="r-1a2ents alchemy-rte"><span style="width:100%"><p>"PMS stands for premenstrual syndrome, and these are the physical and mental symptoms you experience in the weeks leading up to your period. For some it can start right after ovulation, for others it can start just a few days before. The symptoms are often mood swings, fatigue, bloating, breast tenderness and It is really important to know the difference between PMS and PMDD. PMDD stands for Premenstrual Dysphoric Disorder, and this is a much more serious form of PMS that interferes with your health and daily activity. It is critical that you speak to your healthcare provider if you feel this may be you."</p></span></div></div><div data-rid="c4515823-5b9e-4108-90ce-e80892d6584a" class="r-1cw7fu3"><div data-rid="445877f0-f506-4640-a7eb-186109a040c1" class="r-yr91jd alchemy-rte"><span style="width:100%"><h2><strong>How can we help with other symptoms like PMS?</strong><span style="color: rgb(0, 0, 0)">&nbsp;</span></h2></span></div><div data-rid="4776dd2a-d88b-4ec7-a08b-303bebc59881" class="r-os9my4 alchemy-rte"><span style="width:100%"><p>"Alongside the nutrition information above, ultra processed foods and alcohol have been shown to worsen PMS. A diet with a focus in anti-inflammatory, whole grains, nuts and legumes has been shown to be beneficial for PMS.<span style="color: rgb(0, 0, 0)">&nbsp;</span></p><p><br></p><p>Again, exercise, sleep and stress management are also all still very important. In addition, you can consider:<span style="color: rgb(0, 0, 0)">&nbsp;</span></p><p><br></p><p><strong>Calcium:</strong> People with PMS can have lower levels. Good sources include dairy, canned salmon with bones, sardines, broccoli, sesame seeds and kale.&nbsp;<span style="color: rgb(0, 0, 0)"><br></span><strong>Supplements</strong>: Vitamin B6, saffron, chamomile and vitamin D show promise. Always check with your doctor before starting any supplement."</p></span></div></div><div data-rid="1af49d46-8f32-4df6-86c1-edca4ee4353b" class="r-zskf2z"><div data-rid="65fece24-6dfe-46b8-9d3d-3aedb3a6b89c" class="r-15ywr36 alchemy-rte"><span style="width:100%"><h2><span style="color: rgb(0, 0, 0)"><strong>Are there things we can do when we’re experiencing period pain other than taking pain-killers?</strong></span></h2></span></div><div data-rid="0499174d-9db5-4544-a3c7-1a9f672f1bce" class="r-2l7lqo alchemy-rte"><span style="width:100%"><p><strong>"Heat:</strong> A heating pad, warm bath or stick-on heat patch relaxes muscles and distracts nerves.&nbsp;<span style="color: rgb(0, 0, 0)"><br></span><strong>Gentle movement: </strong>Walking or yoga can ease cramps.&nbsp;<span style="color: rgb(0, 0, 0)"><br></span><strong>Acupressure: </strong>Press point SP-6 (about four finger-breadths above the inner ankle bone) for a minute or two.&nbsp;<span style="color: rgb(0, 0, 0)"><br></span><strong>TENS units:</strong> Electrical nerve stimulation can help.&nbsp;<span style="color: rgb(0, 0, 0)"><br></span><strong>Aromatherapy: </strong>Lavender essential oil has some minimal evidence behind it.&nbsp;<span style="color: rgb(0, 0, 0)"><br></span><strong>Supplements:</strong> Zinc, ginger and magnesium may reduce pain when taken during your period."</p></span></div><div data-rid="7ee47f48-a1a1-449b-8862-c0d0e5775e65" class="r-zb6l9d alchemy-rte"><span style="width:100%"><h2><span style="color: rgb(0, 0, 0)">"Here's an example of 3 easy steps to add to your routine to start conquering period pain"</span></h2><br></span></div><div data-rid="0ac48ef5-6c0e-4e60-9d53-7b0d09798aba" class="r-1wb0maa alchemy-rte"><span style="width:100%"><h2><strong>All this information is great, but I don't know where to start?</strong></h2></span></div><div data-rid="38fae9e8-e862-42ea-aad6-794389c64242" class="r-xayxvm alchemy-rte"><span style="width:100%"><p>"The key is to pick one or two small changes, weave them into your routine, and give them time to stick. Once they feel second nature, layer in another habit. Those steady, incremental steps are what create lasting results.</p><p><br></p><p>Diet and lifestyle tweaks are the most powerful place to begin. In reality, though, it can be tricky to cover every nutrient gap through food alone especially when research shows that many supplements for period symptoms use doses higher than you could reasonably eat. That’s where monthlies comes in.&nbsp;</p><p><br></p><p>Monthlies combines vitamins, minerals, and other evidence-backed nutrients for hormonal balance and period discomfort into a single, high-quality, highly absorbable powder. One scoop a day means you get a full strength blend without juggling a dozen different bottles making it easy to add into your new <a href="http://routine.Here">routine. <strong>Here</strong></a><strong>'s an example of 3 easy steps to add to your routine to start conquering your period pain."</strong></p></span></div><div data-rid="c7f7acd6-6897-49e5-8e42-5cf2fac2c563" class="r-14vnobl"><div data-rid="3f495b8c-761b-4bbe-a718-7ccc4e56dd66" class="r-1eic5by"><picture data-rid="fa36a4a6-8763-4290-aee0-c744c1421d1c" class="r-18uahe7"><source srcSet="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/header-mob.jpg?v=1741622235&amp;width=100" media="(max-width: 640px)"/><source srcSet="https://cdn.shopify.com/s/files/1/0771/0860/9337/files/Kuru_17.webp?v=1724611480&amp;width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://cdn.shopify.com/s/files/1/0771/0860/9337/files/Kuru_17.webp?v=1724611480&amp;width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://cdn.shopify.com/s/files/1/0771/0860/9337/files/Kuru_17.webp?v=1724611480" alt="Close-up of green mint leaves in a garden." class="r-1yo8cxh" loading="lazy"/></picture></div><div data-rid="dd4d9fa2-979e-4e20-8016-4f434c59f814" class="r-bitylo alchemy-rte"><span style="width:100%"><p><strong>1. Morning Movement</strong></p></span></div><div data-rid="41e44085-8b6b-45ec-9fbd-d8aef806fb80" class="r-cc8h40 alchemy-rte"><span style="width:100%"><p><span style="color: rgb(0, 0, 0)">Wake up and take a brisk 20-minute walk.</span></p></span></div></div><div data-rid="5c5c38ff-3464-495b-901b-95ca1aa327ec" class="r-1ppc36d"><div data-rid="edaac4df-ecd2-4d1e-b876-3e2bcea0312d" class="r-wzvu7f alchemy-rte"><span style="wid