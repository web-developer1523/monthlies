    "doctor_details_new_yz34BT": {
      "type": "doctor-details-new",
      "blocks": {
        "team_cBaUEW": {
          "type": "team",
          "settings": {
            "name": "Ashley",
            "role": "The science behind monthlies",
            "profile_image": "shopify://shop_images/281024_SteffixMonthlies8345-2_1_2_274e10f5-2b41-4511-975e-bd9b77ca7b9d.png",
            "learn_more": "Learn more about Ashley",
            "short_description": "Helped thousands of women at clinical practice",
            "full_description": "Detailed info about Ash: I’m a naturopath from Canada, now based in the UK. I’ve spent years helping women manage their cycles and hormones naturally and have seen how the right nutrients and lifestyle approaches can transform menstrual health. When I met Maria, I realised we shared a vision: to bring science-backed solutions to more women, beyond the clinic, at a scale that could make a real difference. monthlies is that bridge between medical insight, natural solutions, and everyday accessibility."
          }
        },
        "team_RTqkwh": {
          "type": "team",
          "settings": {
            "name": "Maria",
            "role": "The brain behind monthlies",
            "profile_image": "shopify://shop_images/WhatsApp_Image_2025-12-29_at_17.40.53.jpg",
            "learn_more": "Learn more about Maria",
            "short_description": "Used her business skills to bring the brand to life",
            "full_description": "Detailed info about Maria:\nI moved from Spain to Germany eight years ago for my master’s and have spent most of my career building and scaling ventures. For me, monthlies is deeply personal. I have lived with period pain for most of my life and was frustrated by how widely neglected this issue has been. I wanted to use my business experience to create a solution that truly works. monthlies is about building more than a product. It is about shaping a brand that empowers women."
          }
        },
        "team_pMQwcC": {
          "type": "team",
          "settings": {
            "name": "Jagriti",
            "role": "The voice behind monthlies",
            "profile_image": "shopify://shop_images/image.jpg",
            "learn_more": "Learn more about Jagriti",
            "short_description": "Brought the brand closer to the audience",
            "full_description": "Detailed info about Jagriti:\nI moved from India to Germany two years ago and faced the challenges of managing PCOS in a new healthcare system. With years of experience in marketing and communications, I wanted to help build a brand that does more than sell a product. With monthlies, I found that opportunity to create a brand that educates and empowers women with honesty and empathy. My goal is to make monthlies a space where women feel understood, supported, and empowered to take charge of their health through real conversations and practical solutions."
          }
        }
      },
