    "founders_and_experts_F8qqWb": {
      "type": "founders-and-experts",
      "blocks": {
        "card_popup_QCz3KX": {
          "type": "card_popup",
          "settings": {
            "card_avatar": "shopify://shop_images/image_10_99ca069e-e4e9-490b-8f52-54c802535cd4.png",
            "card_content": "<h2>Dr. Ash</h2><h4>The science behind monthlies</h4><p>Helped thousands of women at clinical practice</p>",
            "card_button_text": "Learn more about Dr. Ash",
            "popup_avatar": "shopify://shop_images/image_10_99ca069e-e4e9-490b-8f52-54c802535cd4.png",
            "popup_content": "<p><strong>Dr. Ash (ND)<br/></strong>The science behind monthlies<br/>Helped 100s of women at clinical practice</p><p>Detailed info about Ash:<br/>I’m a naturopathic doctor from Canada, now based in the UK. I’ve spent years helping women manage their cycles and hormones naturally and have seen how the right nutrients and lifestyle approaches can transform menstrual health. When I met Maria, I realised we shared a vision: to bring science-backed solutions to more women, beyond the clinic, at a scale that could make a real difference. monthlies is that bridge between medical insight, natural solutions, and everyday accessibility.</p>"
          }
        },
        "card_popup_PgqQpf": {
          "type": "card_popup",
          "settings": {
            "card_avatar": "shopify://shop_images/image_10_99ca069e-e4e9-490b-8f52-54c802535cd4.png",
            "card_content": "<h2>Maria</h2><h4>The brain behind monthlies</h4><p>Used her business skills to bring the brand to life</p>",
            "card_button_text": "Learn more about Maria",
            "popup_avatar": "shopify://shop_images/image_10_99ca069e-e4e9-490b-8f52-54c802535cd4.png",
            "popup_content": "<p><strong>Maria<br/></strong>The brain behind monthlies<br/>Used her business skills to bring the brand to life</p><p>Detailed info about Maria:<br/>I moved from Spain to Germany eight years ago for my master’s and have spent most of my career building and scaling ventures. For me, monthlies is deeply personal. I have lived with period pain for most of my life and was frustrated by how widely neglected this issue has been. I wanted to use my business experience to create a solution that truly works. monthlies is about building more than a product. It is about shaping a brand that empowers women to take control of their well-being through knowledge, science, and proven results.</p>"
          }
        },
        "card_popup_wjPi87": {
          "type": "card_popup",
          "settings": {
            "card_avatar": "shopify://shop_images/image_10_99ca069e-e4e9-490b-8f52-54c802535cd4.png",
            "card_content": "<h2>Jagriti</h2><h4>The voice behind monthlies</h4><p>Brought the brand closer to the audience</p>",
            "card_button_text": "Learn more about Jagriti",
            "popup_avatar": "shopify://shop_images/image_10_99ca069e-e4e9-490b-8f52-54c802535cd4.png",
            "popup_content": "<p><strong>Jagriti<br/></strong>The voice behind monthlies<br/>Brought the brand closer to the audience</p><p>Detailed info about Jagriti: <br/>I moved from India to Germany two years ago and faced the challenges of managing PCOS in a new healthcare system. With years of experience in marketing and communications, I wanted to help build a brand that does more than sell a product. With monthlies, I found that opportunity to create a brand that educates and empowers women with honesty and empathy. My goal is to make monthlies a space where women feel understood, supported, and empowered to take charge of their health through real conversations and practical solutions.</p>"
          }
        }
      },
