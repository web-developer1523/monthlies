      "blocks": {
        "testimonial-0": {
          "type": "testimonial",
          "settings": {
            "icon": "5",
            "text": "<p>For the first time in my life I received evidence-based, individual recommendations for my cycle. I couldn't find anything like that from my gynecologist or on the internet. I now understand my cycle peculiarities much better and know now how to start changes.</p>",
            "image": "shopify://shop_images/Alexandra.png",
