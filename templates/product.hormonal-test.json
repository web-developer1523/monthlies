    "1c8f2bc2-278f-4216-9c25-0259f177674e": {
      "type": "steroids",
      "settings": {
        "title": "Measuring six biomarkers called steroid hormones",
        "text": "Your steroid hormones tell us if your primary hormones are within normal ranges. Abnormal levels may be causing symptoms that affect your cycle and overall well-being.",
        "btn": "Shop now",
        "btn_url": "https://withmonthlies.com/cart/47054412513627:1",
        "download": "Download example results insights",
        "item_text_1": "This hormone has various functions in the body, including supporting immune function, maintaining energy levels, and promoting overall well-being.",
        "item_title_1": "DHEA",
        "item_text_2": "It is the primary form of estrogen in females (AFAB) and plays a crucial role in reproductive health, bone development, and brain function.",
        "item_title_2": "Estradiol",
        "item_text_3": "Estriol is a form of estrogen that is particularly important during pregnancy and is produced by the placenta.",
        "item_title_3": "Estriol",
        "item_text_4": "Often referred to as the 'stress hormone,' cortisol is involved in regulating stress responses, metabolism, and immune function.",
        "item_title_4": "Cortisol",
        "item_text_5": "Known as the 'pregnancy hormone,' progesterone helps prepare the uterus for pregnancy and plays a role in the menstrual cycle.",
        "item_title_5": "Progesterone",
        "item_text_6": "Testosterone is a key hormone in both males and females, influencing sexual development, fertility, muscle mass, and overall well-being.",
        "item_title_6": "Testosterone"
      }
    },
