    "carefully_selected_ingredients_Rgby7L": {
      "type": "carefully-selected-ingredients",
      "blocks": {
        "faq_tB4TFc": {
          "type": "faq",
          "settings": {
            "faq_title": "Clean and natural ingredients - perfect for you",
            "faq_text": "<p>Our supplement is made with only natural, premium ingredients in their high absorbable format. It’s vegan, gluten-free, soy-free, lactose-free, and free from artificial colours and flavours, providing pure nourishment without compromise.</p>"
          }
        },
        "faq_ayjtAN": {
          "type": "faq",
          "settings": {
            "faq_title": "Crafted with care, backed by science",
            "faq_text": "<p>We design every product with female health experts, using research-driven formulation to meet your unique needs. Our approach prioritises safety, effectiveness, and innovation.</p>"
          }
        },
        "faq_qCHMa8": {
          "type": "faq",
          "settings": {
            "faq_title": "Quality you can trust",
            "faq_text": "<p>Proudly manufactured in the UK, in a GMP-certified facility, and third-party tested for purity and safety. Every step reflects our commitment to excellence and transparency.</p>"
          }
        },
        "faq_8jtp9e": {
          "type": "faq",
          "settings": {
            "faq_title": "Our formula",
            "faq_text": "<p>Our formulation uses highly bioavailable, pre-activated nutrient forms that your body absorbs easily. Many vitamins and minerals must be converted into their active forms before the body can use them - a process that can be inefficient for many people. By using pre-activated forms, we bypass this step, improve absorption, and ensure more of each nutrient actually reaches where it’s needed.</p><p>This results in:</p><ul><li>better effectiveness, because more active nutrients reach your bloodstream and tissues.</li><li>faster results, as optimally absorbed nutrients begin working sooner.</li><li>fewer side effects, since highly absorbable forms are gentler on the digestive system and ideal for sensitive individuals.</li></ul><p>Everything we include is chosen with intention for the best tolerance, maximum effectiveness, and meaningful support for your body.</p>"
          }
        },
