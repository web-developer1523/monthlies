      "name": "Hormone Info Section",
      "settings": {
        "main_heading": "<p>Hormones affect <strong>far more than we think</strong></p>",
        "main_description": "<p>They are not only driving the menstrual cycle and periods, but also <strong>shaping mood, energy, sleep, appetite, skin, bones, and even how we handle stress.</strong></p>",
        "side_heading": "<p>Could it be <strong>you</strong>?</p>",
        "body_image": "shopify://shop_images/Group_514003.webp",
        "mobile_body_image": "shopify://shop_images/image_5.webp",
        "chemical_image": "shopify://shop_images/chemical_84717429-88c3-4150-b930-afaf3bd6e1f4.png",
        "mobile_chemical_image": "shopify://shop_images/Estrogen.png",
        "progesterone_title": "Progesterone",
        "progesterone_text": "Progesterone has calming, sleep-promoting effects on the brain.",
        "estrogen_title": "Estrogen (Estradiol)",
        "estrogen_text": "Estradiol doesn’t just regulate periods, it also improves memory and mood by acting directly on the brain’s learning centers.",
        "testosterone_title": "Testosterone",
        "testosterone_text": "Women are more sensitive to testosterone than men, even tiny changes can strongly affect libido, mood, and energy.",
        "symptom_heading": "<p><strong>Hormones guide your cycle,</strong> testing shows you the map.</p>",
        "symptom_description": "Select the symptoms that you're experiencing and find out if your hormones could be the underlying issue.",
        "symptom_note": "The symptoms you selected may be connected:"
      }
    },
    "what_we_test_section_BbYDtR": {
      "type": "what-we-test-section",
      "blocks": {
        "hormone_item_XbGBy3": {
          "type": "hormone_item",
          "settings": {
            "hormone_name": "Oestradiol",
            "hormone_description": "Oestradiol is the main form of oestrogen in the body. Oestradiol is essential for ovulation, conception and pregnancy, measuring your oestradiol levels can provide insight into ovarian function."
          }
        },
        "hormone_item_yVNMpy": {
          "type": "hormone_item",
          "settings": {
            "hormone_name": "Progesterone",
            "hormone_description": "Known as the \"pregnancy hormone,\" progesterone helps prepare the uterus for pregnancy and plays a role in the menstrual cycle."
          }
        },
        "hormone_item_ypJhtw": {
          "type": "hormone_item",
          "settings": {
            "hormone_name": "Luteinising Hormone",
            "hormone_description": "LH plays an important role in reproductive health. LH levels peak in the middle of the menstrual cycle triggering ovulation. Abnormal LH levels could indicate a hormone imbalance that could be affecting ovulation."
          }
        },
        "hormone_item_a9qfJ6": {
          "type": "hormone_item",
          "settings": {
            "hormone_name": "Prolactin",
            "hormone_description": "Prolactin plays a role in the menstrual cycle and also breastfeeding. Too much prolactin can impact the production of other hormones including FSH and LH and as such is important for reproductive health."
          }
        },
        "hormone_item_aHQabw": {
          "type": "hormone_item",
          "settings": {
            "hormone_name": "Testosterone",
            "hormone_description": "Measuring your testosterone levels may help to determine the cause of symptoms such as oily skin, excess body hair and irregular periods. High levels are associated with conditions like PCOS."
          }
        },
        "hormone_item_Lj8RMw": {
          "type": "hormone_item",
          "settings": {
            "hormone_name": "Sex Hormone Binding Globulin",
            "hormone_description": "Sex Hormone-Binding Globulin is a protein that attaches to sex hormones like testosterone and estrogen. It makes sure these hormones are around when needed and keeps them from being used up too fast."
          }
        },
        "hormone_item_bQgxbD": {
          "type": "hormone_item",
          "settings": {
            "hormone_name": "Free Androgen Index",
            "hormone_description": "The free androgen index is a way to figure out how much testosterone in your body is active and available to use. It looks at the balance between total testosterone and a protein called SHBG, which holds some of it back."
          }
        }
      },
      "block_order": [
        "hormone_item_XbGBy3",
        "hormone_item_yVNMpy",
        "hormone_item_ypJhtw",
        "hormone_item_a9qfJ6",
        "hormone_item_aHQabw",
        "hormone_item_Lj8RMw",
        "hormone_item_bQgxbD"
      ],
      "name": "What We Test Section",
      "settings": {
        "heading_main": "<p><strong>What </strong>We Test</p>",
        "subheading": "<p>Measuring <strong>eight Hormonal biomarkers</strong></p>",
        "description": "Your steroid hormones tell us if your primary hormones are within normal ranges. Abnormal levels may be causing symptoms that affect your cycle and overall well-being.",
        "side_image": "shopify://shop_images/Group_514005_1.webp"
      }
    },
