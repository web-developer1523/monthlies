        "right_yx3Mmx": {
          "type": "right",
          "settings": {
            "accordion_heading": "When is the best time of day to take my blood sample?",
            "dsc": "<p>Any time of the day is fine to take the test but be sure to do it on the right days of your cycle. It must done on days 3-5 of your menstrual cycle. Day 1 being first day of your period.</p>"
