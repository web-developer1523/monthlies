    "product_bottom_faq_hhq647": {
      "type": "product-bottom-faq",
      "blocks": {
        "left_6WrLgq": {
          "type": "left",
          "settings": {
            "accordion_heading1": "What is Monthlies?",
            "dsc1": "<p><em>Monthlies</em> was created with a team of women’s health and wellness professionals with over a decade of experience to give females a choice when it comes to managing their menstrual health. monthlies' leading product is a menstrual pain supplement with 26+ science backed ingredients to support period pain and menstrual health. monthlies' expanding range of products now includes an at home hormonal test along with free expert consultations.  </p>"
          }
        },
        "left_pePbY6": {
          "type": "left",
          "settings": {
            "accordion_heading1": "How does the hormonal analysis work?",
            "dsc1": "<p>The monthlies hormone analysis is an at home blood test. Upon purchase the kit is mailed to your home. The sample is collected via our Quick Draw device between days 3-5 of your menstrual cycle. Once the sample is collected you will have to mail it back to the lab. Your results will be released digitally within 7 days.</p>"
          }
        },
        "left_Whw3MP": {
          "type": "left",
          "settings": {
            "accordion_heading1": "What can I learn from the hormonal analysis?",
            "dsc1": "<p>A hormone test gives a snapshot of your body’s hormonal health, helping uncover the root causes of symptoms like tiredness, irregular cycles, mood changes, low libido, or weight changes. It’s a valuable tool for anyone wanting to better understand their health.</p>"
          }
        },
        "left_wrh9VF": {
          "type": "left",
          "settings": {
            "accordion_heading1": "How do I collect the blood sample?",
            "dsc1": "<p>The monthlies blood testing kit uses the Tasso to collect blood. The Tasso Button sticks to the skin with a light adhesive. When the button is pressed, a vacuum forms and a lancet pricks the surface of the skin. The vacuum draws blood out of the capillaries and into a compatible container attached to the bottom of the Tasso Button.</p>"
          }
        },
        "left_QffW6K": {
          "type": "left",
          "settings": {
            "accordion_heading1": "Can I discuss my results with an expert?",
            "dsc1": "<p>We will provide education with your results but if you need more assistance we provide free consultations with our health experts.</p>"
