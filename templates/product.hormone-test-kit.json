    "product_bottom_faq_UVztLB": {
      "type": "product-bottom-faq",
      "blocks": {
        "left_7VcB3B": {
          "type": "left",
          "settings": {
            "accordion_heading1": "",
            "dsc1": ""
          }
        },
        "left_MJrDmW": {
          "type": "left",
          "settings": {
            "accordion_heading1": "How does the hormonal analysis work?",
            "dsc1": "<p>The monthlies hormone analysis is an at home blood test. Upon purchase the kit is mailed to your home. The sample is collected via our Quick Draw device between days 3-5 of your menstrual cycle. Once the sample is collected you will have to mail it back to the lab. Your results will be released digitally within 7 days.</p>"
          }
        },
        "left_3Y33ra": {
          "type": "left",
          "settings": {
            "accordion_heading1": "What can I learn from the hormonal analysis?",
            "dsc1": "<p>A hormone test gives a snapshot of your body’s hormonal health, helping uncover the root causes of symptoms like tiredness, irregular cycles, mood changes, low libido, or weight changes. It’s a valuable tool for anyone wanting to better understand their health.</p>"
          }
        },
        "left_AyypDk": {
          "type": "left",
          "settings": {
            "accordion_heading1": "How do I collect the blood sample?",
            "dsc1": "<p>The monthlies blood testing kit uses the Tasso to collect blood. The Tasso Button sticks to the skin with a light adhesive. When the button is pressed, a vacuum forms and a lancet pricks the surface of the skin. The vacuum draws blood out of the capillaries and into a compatible container attached to the bottom of the Tasso Button.</p>"
          }
        },
        "left_k7T3m4": {
          "type": "left",
          "settings": {
            "accordion_heading1": "Can I discuss my results with an expert?",
            "dsc1": "<p>We will provide education with your results but if you need more assistance we provide free consultations with our health experts.</p>"
          }
        },
        "left_iLMtd9": {
          "type": "left",
          "settings": {
            "accordion_heading1": "Is the shipping process included?",
            "dsc1": "<p>Yes, shipping is included in the price of the test.</p>"
          }
        },
        "left_ARUf6p": {
          "type": "left",
          "settings": {
            "accordion_heading1": "What day of my menstrual cycle should I take the test?",
            "dsc1": "<p>The hormonal test should be taken between days 3-5 of your cycle. Day 1 of your cycle is your first day of bleeding.</p>"
          }
        },
        "left_4nDtqa": {
          "type": "left",
          "settings": {
            "accordion_heading1": "Is there an age limit to purchase a home blood test kit?",
            "dsc1": "<p>There is no age limit to purchase a hormonal test. However, you mus be 18 to purchase the test.</p>"
          }
        },
        "right_PNQLUt": {
          "type": "right",
          "settings": {
            "accordion_heading": "Does the service cause any pain or discomfort?",
            "dsc": "<p>The monthlies test uses the Tasso device to collect blood. Participants in clinical studies have reported lower levels of pain with the Tasso device compared to collecting blood with a finger stick or standard venipuncture procedure.</p>"
          }
        },
        "right_BTCfwe": {
          "type": "right",
          "settings": {
            "accordion_heading": "How does a QuickDraw device work?",
            "dsc": "<p>How does the Tasso device work? The Tasso Button sticks to the skin with a light adhesive. When the button is pressed, a vacuum forms and a lancet pricks the surface of the skin. The vacuum draws blood out of the capillaries and into a compatible container attached to the bottom of the Tasso Button.</p>"
          }
        },
        "right_CQ4gwp": {
          "type": "right",
          "settings": {
            "accordion_heading": "Is this a needle-free blood collection system?",
            "dsc": "<p>Some people refer to Tasso Devices as a needle-free system since it does not use a hollow venipuncture needle to enter a vein.</p>"
          }
        },
        "right_FeeN9W": {
          "type": "right",
          "settings": {
            "accordion_heading": "How many times can each QuickDraw device be used?",
            "dsc": "<p>Each device is used one time to collect a sample and is then discarded.</p>"
          }
        },
        "right_MrKFMW": {
          "type": "right",
          "settings": {
            "accordion_heading": "Does it hurt to collect blood with the QuickDraw device?",
            "dsc": "<p>The Quick Draw device is simple and painless!</p>"
          }
        },
        "right_yBWDeh": {
          "type": "right",
          "settings": {
            "accordion_heading": "When is the best time of day to take my blood sample?",
            "dsc": "<p>Any time of the day is fine to take the test but be sure to do it on the right days of your cycle. It must done on days 3-5 of your menstrual cycle. Day 1 being first day of your period.</p>"
          }
        },
        "right_iBrAcK": {
          "type": "right",
          "settings": {
            "accordion_heading": "How long will it take for results to be made available?",
            "dsc": "<p>You can expect your results within 5 working days.</p>"
          }
        },
        "right_7BcrbJ": {
          "type": "right",
          "settings": {
            "accordion_heading": "How do I ship my test back to the lab?",
            "dsc": "<p> Once completed, return your at-home test using the pre-paid Royal Mail label provided. Please amil the sample the same day you collected it.</p>"
          }
        },
        "right_Yi7gbD": {
          "type": "right",
          "settings": {
            "accordion_heading": "Is fasting required?",
            "dsc": "<p> No fasting is not required.</p>"
          }
        }
      },
