    "other_problems_3qYHfE": {
      "type": "other-problems",
      "blocks": {
        "problem_FGBc8c": {
          "type": "problem",
          "settings": {
            "problem_heading": "<p>Trigger 1</p>",
            "problem_subheading": "<h3>Imbalanced Hormones</h3>",
            "problem_text": "<p>“High oestrogen hormone levels are linked to <strong>almost five times the risk of painful period cramps</strong> by increasing prostaglandin production.”</p><p>Source: Chan et al.(2023).</p>"
          }
        },
        "problem_Mqw8Wp": {
          "type": "problem",
          "settings": {
            "problem_heading": "<p>Trigger 2</p>",
            "problem_subheading": "<h3>Prostaglandins</h3>",
            "problem_text": "<p>“Women with painful cramps have over three times higher PGF2α (prostaglandin) levels, <strong>which strongly correlate with more intense contractions.”</strong></p><p>Source: Lundström & Green (1978).</p>"
          }
        },
        "problem_JWKbV4": {
          "type": "problem",
          "settings": {
            "problem_heading": "<p>Trigger 3</p>",
            "problem_subheading": "<h3>Micronutrient Gaps</h3>",
            "problem_text": "<p>“Deficiencies in key micronutrients, including magnesium, zinc, calcium, and vitamin D, are associated<strong> with increased severity of period pain.”</strong></p><p>Source: A Systematic Review and Meta-Analysis (PMC, 2020)</p>"
          }
        }
      },
      "block_order": [
        "problem_FGBc8c",
        "problem_Mqw8Wp",
        "problem_JWKbV4"
      ],
      "disabled": true,
      "name": "Other Problems",
      "settings": {
        "custom_class": "",
