    "other_problems_JFFEkU": {
      "type": "other-problems",
      "blocks": {
        "problem_zJtwXk": {
          "type": "problem",
          "settings": {
            "problem_heading": "<p>Trigger 1</p>",
            "problem_subheading": "<h3>Excess Prostaglandins</h3>",
            "problem_text": "<p>“High oestrogen hormone levels are linked to <strong>almost five times the risk of painful period cramps</strong> by increasing prostaglandin production.”</p><p>Source: Chan et al.(2023).</p>"
          }
        },
        "problem_PJRNJL": {
          "type": "problem",
          "settings": {
            "problem_heading": "<p>Trigger 2</p>",
            "problem_subheading": "<h3>Prostaglandins</h3>",
            "problem_text": "<p>“Women with painful cramps have over three times higher PGF2α (prostaglandin) levels, <strong>which strongly correlate with more intense contractions.”</strong></p><p>Source: Lundström & Green (1978).</p>"
          }
        },
        "problem_jRfPJh": {
          "type": "problem",
          "settings": {
            "problem_heading": "<p>Trigger 3</p>",
            "problem_subheading": "<h3>Micronutrient Gaps</h3>",
            "problem_text": "<p>“Deficiencies in key micronutrients, including magnesium, zinc, calcium, and vitamin D, are associated<strong> with increased severity of period pain.”</strong></p><p>Source: A Systematic Review and Meta-Analysis (PMC, 2020)</p>"
          }
        }
      },
      "block_order": [
        "problem_zJtwXk",
        "problem_PJRNJL",
        "problem_jRfPJh"
      ],
      "name": "Other Problems",
      "settings": {
        "custom_class": "",
        "heading": "The Pain Triangle",
        "description": "<p>Your period pain is not random, it follows a clear pattern. At monthlies, we call it <strong>The Pain Triangle</strong>. When these three factors come together, they create a vicious cycle of pain, fatigue, and low mood.</p><p><br/></p><p><em>It all comes down to the three triggers:</em></p>",
        "paragraph": "",
        "image": "shopify://shop_images/Web_Image_-_Pain_1920x440_fe880a9c-d0e9-4eb4-a5e6-dd29112c8be0.png"
      }
    },
    "monthlies_solutions_4PWxqe": {
      "type": "monthlies-solutions",
      "blocks": {
        "benefits_dQJitN": {
          "type": "benefits",
          "settings": {
            "benefit_heading": "<p>1. Excess Prostaglandins*</p>",
            "benefit_subheading": "",
            "benefit_text": "<p>Prostaglandins are essential and help your uterus shed its lining. However, when they surge — due to an an overactive COX-2 enzyme — they directly intensify cramps, sharpen pain signals, and make them more frequent.</p><p>Painkillers work by blocking prostaglandins after they’ve spiked, often hitting COX-1 (needed for stomach protection) along with COX-2. This can lead to side effects like indigestion or ulcers —while leaving hormonal and nutrient imbalances unresolved, so the cycle of pain keeps repeating.</p>",
            "help-image": "shopify://shop_images/Group_512915.png",
            "help_heading": "<p><strong>How monthlies helps</strong></p>",
            "help_subheading": "",
            "help_text": "<p>Formulated with scientifically backed ingredients like Lemon Balm, Broccoli Seed Extract, B-Complex, Myo-Inositol, Choline, and Flaxseed, monthlies supports hormonal balance at its core - optimising oestrogen metabolism, promoting healthy progesterone, and supporting stress management.*</p>",
            "help_text1": "<p>As your hormonal pathways are optimised you’re less prone to overactive cramping and inflammation from the start, setting the stage for cramps you barely even notice.*</p>",
            "read-more": "<p>Read More</p>",
            "read-less": ""
          }
        },
        "benefits_PEBawU": {
          "type": "benefits",
          "settings": {
            "benefit_heading": "",
