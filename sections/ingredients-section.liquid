<section class="cst-custom-all_ingrediants page-width product-page-only-section">
  <h2 class="title h1">{{ section.settings.heading | replace: '<p>', '' | replace: '</p>', '' }}</h2>
  <span>{{ section.settings.description }}</span>
  <div class="ingredient-grid">
    {% for block in section.blocks %}
      <div class="ingredient-card" {{ block.shopify_attributes }}>
        <div class="ingredient-image">
          <a href="{{ block.settings.button_link }}">
            {% if block.settings.image %}
              <img 
                data-class="LazyLoad" 
                src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
                data-src="{{ block.settings.image | image_url:width:1000 }}"
                data-mob-src="{{ block.settings.image | image_url:width:500 }}" alt="">
            {% endif %}
          </a>
        </div>
        <div class="ingredient-info">
          <div class="plus-icon">
            <a href="{{ block.settings.button_link }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 50 50" fill="none">
                <rect width="50" height="50" fill="#ABD0CD"></rect>
                <path d="M13 25H37" stroke="white" stroke-width="3" stroke-linecap="round"></path>
                <path d="M25 37V13" stroke="white" stroke-width="3" stroke-linecap="round"></path>
              </svg>
            </a>
          </div>
          <a href="{{ block.settings.button_link }}">
            <h3>{{ block.settings.title }}</h3>
          </a>
          <p>{{ block.settings.description }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="doc_link" bis_skin_checked="1">
    <a href="{{ section.settings.link }}">
      {{- section.settings.all_ingredients }}
      <span class="link_icon">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7.46154 3H1V17H15V10.5385" stroke="#CB342C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M8 10L17 1M17 1H11M17 1V7" stroke="#CB342C" stroke-width="1.5" stroke-linecap="round"></path>
        </svg></span
    ></a>
  </div>
</section>

<style>
  .product-page-only-section {
    padding: 0px !important;
}
.product-page-only-section strong {
    color: #cb342c;
}
.product-page-only-section .title {
    text-align: center;
    font-size: 44px;
    font-weight: 600;
    margin-top: 0px;
}

.product-page-only-section span {
    text-align: center;
    font-size: 26px;
}
.doc_link {
    padding: 60px 0 0;
    text-align: center;
}
.product-page-only-section .ingredient-info {
    background: #fff;
    border: 1px solid #fff;
}
.ingredient-section-product-only {
    background: #abd0cd;
    padding: 80px 110px 80px 80px;
}
.ingredient-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}
.ingredient-card {
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 15px;
    width: calc(25% - 20px);
    box-sizing: border-box;
}
.ingredient-image img {
    max-width: 100%;
    border-radius: 5px;
}

.slick-dots li button {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    font-size: 0; /* hide any number text */
    outline: none;
    cursor: pointer;
    padding: 2px;
}
ul.slick-dots {
    display: flex;
    justify-content: center;
}

.slick-dots li button:before {
    content: "";
    display: inline-block;
    width: 10px;
    height: 10px;
    background: #999;
    border-radius: 50%;
}

.slick-dots li.slick-active button:before {
    background: #cb342c; /* your active color */
}
button.slick-prev.slick-arrow {
    z-index: 9;
    transform: rotate(180deg);
    width: 61px;
    border-radius: 43px;
    padding: 20px;
    border: none;
}

button.slick-next.slick-arrow {
    z-index: 9;
    transform: rotate(180deg);
    width: 61px;
    border-radius: 43px;
    padding: 20px;
    border: none;
}

</style>
<script type="lazyload_js">
    document.addEventListener('DOMContentLoaded', function () {
    function initMobileSlider() {
      if (window.innerWidth <= 768 && !document.querySelector('.ingredient-grid.slick-initialized')) {
        $('.ingredient-grid').slick({
          dots: false,
          arrows: false,
          infinite: false,
          slidesToShow: 1.1,
          slidesToScroll: 1,

        });
      } else if (window.innerWidth > 768 && $('.ingredient-grid').hasClass('slick-initialized')) {
        $('.ingredient-grid').slick('unslick');
      }
    }

    initMobileSlider();

    window.addEventListener('resize', function () {
      initMobileSlider();
    });
  });
</script>
{% schema %}
{
  "name": "Ingredients",
  "class": "ingredient-section-product-only",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "heading"
    },
        {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "all_ingredients",
      "label": "Button name"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Add Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient Image"
        },
        {
          "type": "html",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "category": "Custom"
    }
  ]
}
{% endschema %}
