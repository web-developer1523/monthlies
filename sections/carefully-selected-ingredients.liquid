<section class="cst-ing-sorf">
<section class="sorgfaltig">
    <div class="container">
        <div class="sorgfaltig-container">
            <div class="sorgfaltig-grid">
                
                <div class="sorgfaltig-grid-item cstnew-sorg">
                    <div class="sorgfaltig-content">
                        <h2>{{ section.settings.main_heading }}</h2>
                        {{ section.settings.main_paragraph_1 }}
                        {{ section.settings.main_paragraph_2 }}
                    </div>

                    <div class="faq-box">
                        {% for block in section.blocks %}
                            {% if block.type == 'faq' %}
                            <div class="faq-item">
                                <div class="faq-header">
                                    <span>{{ block.settings.faq_title }}</span>
                                    <div class="svg-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="12" height="21" viewBox="0 0 12 21" fill="none" class="">
                                        <path d="M12 10.0806L2.87909 20.1611L2.87909 15.9609L7.19953 10.0806L2.87909 4.20023L2.87909 -3.48836e-07L12 10.0806Z" fill="#CB342C"></path>
                                        <path d="M9.12109 10.0806L0.000185913 20.1611L0.000186123 15.9609L4.32062 10.0806L0.000185757 4.20023L0.000185966 -3.48836e-07L9.12109 10.0806Z" fill="#96B8B5"></path>
                                        </svg></div>
                                </div>
                                <div class="faq-content">
                                    {{ block.settings.faq_text }}
                                </div>
                            </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <a href="{{section.settings.btn_url }}" class="cst-btn-faq">{{section.settings.btn_text }}</a>
                </div>

                <div class="sorgfaltig-grid-item">
                    <div class="sorgfaltig-grid-inner">
                        {% for block in section.blocks %}
                            {% if block.type == 'ingredient' %}
                            <div class="sorgfaltig-box">
                                <div class="sorgfaltig-img">
                                    <a href="{{ block.settings.link_url }}"><img src="{{ block.settings.ingredient_image | img_url: 'medium' }}" alt=""></a>
                                    <div class="plus-icon">
                                      <a href="{{ block.settings.link_url }}">
                                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                                        <path d="M7.75 0.75V14.75M0.75 7.75004H14.75" stroke="#404040" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                      </a>
                                    </div>
                                </div>
                                <div class="sorgfaltig-img-content">
                                    <span>{{ block.settings.ingredient_label }}</span>
                                    <h3>{{ block.settings.ingredient_title }}</h3>
                                </div>
                            </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
</section>

<style>
    .cst-ing-sorf .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
}
    .faq-item.active svg.rotate {
        transform: rotate(90deg) !important;
    }
  .sorgfaltig-box .sorgfaltig-img .plus-icon {
    background: #ffffff;
    border-radius: 16px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 8px;
    right: 8px;
    left: auto;
    transform: translateX(0);
}

    .sorgfaltig-container {
        background: #ecf1f4;
        border-radius: 20px;
        padding: 70px 70px;
    }
    
    .sorgfaltig-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 45px;
    }
    
    .sorgfaltig-content h2 {
        font-family: "Lora", serif;
        font-weight: 600;
        color: #2a2a2a;
        text-align: left;
        font-size: 64px;
        letter-spacing: -0.02em;
        font-style: italic;
        margin-bottom: 16px;
    }
    
    .sorgfaltig-content p {
        color: #2a2a2a;
        text-align: left;
        font-family: "Quicksand", sans-serif;
        font-size: 20px;
        line-height: 1.4;
        font-weight: 400;
        width: 100%;
        max-width: 505px;
    }
.faq-content p {
    color: #404040 !important;
    text-align: left;
    font-size: 19px !important;
    line-height: 140% !important;
    font-weight: 400;
}
    .faq-box {
        margin-top: 56px;
    }
    
    .sorgfaltig-grid-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    
    .plus-icon {
        background: #ffffff;
        border-radius: 16px;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        top: 8px;
        right: 8px;
    }
    
    .plus-icon i {
        font-size: 20px;
        color: #000;
    }
    
    .sorgfaltig-img {
        position: relative;
    }
    
    .sorgfaltig-img-content span {
        color: #404040;
        text-align: center;
        font-family: "Quicksand", sans-serif;
        font-size: 12px;
        line-height: 1.4;
        font-weight: 500;
        border-radius: 999px;
        {% comment %} border: 1px solid #abd0cd; {% endcomment %}
        {% comment %} padding: 8px 12px; {% endcomment %}
        display: inline-block;
    text-transform: uppercase;
    }
    
    .sorgfaltig-img-content {
        padding: 20px 16px 0;
    }
    
    .sorgfaltig-img-content h3 {
        color: #404040;
        text-align: left;
        font-family: "lora", serif;
        font-size: 19px;
        line-height: 1.4;
        font-weight: 600;
        margin-top: 8px;
        margin-bottom: 0;
    }
    
    .cst-ing-sorf .sorgfaltig-img img {
        height: 240px;
        object-fit: cover;
        border-radius: 20px;
        width:100%;
    }
    
    .faq-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
  }
  .svg-wrapper {
    width: 44px !important;
    height: 44px;
    background: #ecf1f4;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}
  .faq-header svg {
      transition: transform 0.3s ease;
  }
  
  .faq-header svg.rotate {
      transform: rotate(180deg);
  }
a.cst-btn-faq {
    border-radius: 999px;
    border-style: solid;
    border-color: #CB342C;
    border-width: 1px;
    padding: 12px 16px;
    color: #CB342C;
    text-align: center;
    font-family: "Quicksand-Bold", sans-serif;
    font-size: 16px;
    line-height: 140%;
    font-weight: 700;
    text-decoration: none;
    margin-top: 30px;
    display: block;
}
/* responsive css*/

.faq-content ul li {
    color: #404040 !important;
    text-align: left;
    font-size: 16px !important;
    line-height: 140% !important;
    font-weight: 400;
    margin: 0 0 30px 0 !important;
}
.sorgfaltig-grid .faq-content ul li {
    margin-bottom: 10px !important;
}



