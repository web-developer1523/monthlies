    }

    .sorgfaltig-content h2 {
        font-size: 24px;
        text-align: left;
    }

    .sorgfaltig-content p {
        font-size: 16px;

    }

    .faq-header span {


        font-size: 16px;

    }

    .faq-content p {

        font-size: 16px !important;

    }
}
@media (max-width: 1023px) {
    .cst-ing-sorf .container {
