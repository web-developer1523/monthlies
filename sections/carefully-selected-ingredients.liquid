border-radius:0;
}
 .cstnew-sorg {
        padding: 0;
    }
    .sorgfaltig-grid {
        grid-template-columns: 1fr;
    }

    .sorgfaltig-img-content {
        padding: 20px 0;
    }
     .faq-header span {
        font-size: 16px !important;
    }
    a.cst-btn-faq {

    display: block;
}
}

@media (max-width: 767px) {
.faq-box {
    margin-top: 35px;
}
}
@media (max-width: 767px) {
   .cst-ing-sorf  .sorgfaltig-img img {
        height: 150px;
    }
}

</style>
<script>
  const faqItems = document.querySelectorAll(".faq-item");
  
  faqItems.forEach(item => {
      const header = item.querySelector(".faq-header");
      const content = item.querySelector(".faq-content");
      const svg = item.querySelector("svg");
  
      header.addEventListener("click", () => {
  
          // Close all others
          faqItems.forEach(other => {
              if (other !== item) {
                  other.querySelector(".faq-content").style.maxHeight = "0";
                  other.querySelector("svg").style.transform = "rotate(0deg)";
              }
          });
  
          // Toggle this one
          if (content.style.maxHeight && content.style.maxHeight !== "0px") {
              content.style.maxHeight = "0";
              svg.style.transform = "rotate(0deg)";
          } else {
              content.style.maxHeight = content.scrollHeight + "px";
              svg.style.transform = "rotate(180deg)";
          }
      });
  });
  </script>
  
{% schema %}
{
  "name": "Carefully ingredients",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Sorgfältig ausgewählte Inhaltsstoffe"
    },
    {
      "type": "richtext",
      "id": "main_paragraph_1",
      "label": "Paragraph 1",
      "default": "<p>Gesunde Hormone benötigen eine kontinuierliche Versorgung mit essenziellen Nährstoffen und einen gesunden Lebensstil.</p>"
    },
    {
      "type": "richtext",
      "id": "main_paragraph_2",
      "label": "Paragraph 2",
      "default": "<p>Aus diesem Grund haben wir monthlies entwickelt.</p>"
    },
    {
        "type": "text",
        "id": "btn_text",
        "label": "Button text"
    },
    {
        "type": "url",
        "id": "btn_url",
        "label": "Button Url"
    }
  ],

  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "faq_title",
          "label": "FAQ Title",
          "default": "Reine Nährstoffe ohne Kompromisse - perfekt für dich"
        },
        {
          "type": "richtext",
          "id": "faq_text",
          "label": "FAQ Content"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "ingredient_image",
          "label": "Ingredient Image"
        },
        {
            "type": "url",
            "id": "link_url",
            "label": "Ingredient Url"
        },
        {
          "type": "text",
          "id": "ingredient_label",
          "label": "Small Label (e.g., Zitronenmelisse)",
          "default": "Ingredient Label"
        },
        {
          "type": "text",
          "id": "ingredient_title",
          "label": "Heading",
          "default": "Ingredient title"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Carefully ingredients"
    }
  ]
}
{% endschema %}
