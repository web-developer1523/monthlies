{{ 'section-statistics.css' | asset_url | stylesheet_tag }}

<div class="stats-container">
  <div class="stats-hero">
    <h3 class="title">{{ section.settings.hero }}</h3>
    <p>{{ section.settings.subtitle }}</p>
  </div>
  <div class='stats-list'>
    <div class='stats-item'>
      <div>
        <span class='stats-percentage'>{{ section.settings.percentage_1 }}</span>
        <div class='stats-text'>
          {{ section.settings.text_1 }}
        </div>
      </div>
    </div>
    
    <div class='stats-item'>
      <div>
        <span class='stats-percentage'>{{ section.settings.percentage_2 }}</span>
        <div class='stats-text'>
          {{ section.settings.text_2 }}
        </div>
      </div>
    </div>
    
    <div class='stats-item'>
      <div>
        <span class='stats-percentage'>{{ section.settings.percentage_3 }}</span>
        <div class='stats-text'>
          {{ section.settings.text_3 }}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
    {
      "name": "statistics",
      "tag": "section",
      "class": "section",
      "settings": [
        {
            "type": "text",
            "label": "Hero",
            "id": "hero",
            "default": "Proven solution to ease menstrual pain"
        },
        {
            "type": "text",
            "label": "subtitle",
            "id": "subtitle",
            "default": "Over 2000 women from 2021 to 2023"
        },
        {
            "type": "text",
            "label": "Item 1 - Percentage",
            "id": "percentage_1",
            "default": "80%"
        },
        {
            "type": "text",
            "label": "Item 1 - Text",
            "id": "text_1",
            "default": "of our customers feel a positive difference after a few days"
        },
        {
            "type": "text",
            "label": "Item 2 - Percentage",
            "id": "percentage_2",
            "default": "96%"
        },
        {
            "type": "text",
            "label": "Item 2 - Text",
            "id": "text_2",
            "default": "of our customers feel a strong improvement after a period of 3 months"
        },
        {
            "type": "text",
            "label": "Item 3 - Percentage",
            "id": "percentage_3",
            "default": "87%"
        }   ,
        {
            "type": "text",
            "label": "Item 3 - Text",
            "id": "text_3",
            "default": "said that is is more efficient than painkillers"
        }      
      ],
      "presets": [
        {
          "name": "statistics section"
        }
      ]
    }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}