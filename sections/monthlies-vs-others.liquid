.cst-vs-compare h2.cst-vs-subtitle {
    font-size: 24px;
    color:#404040;
    text-align: center;
    font-weight: 400;
    font-family: 'Quicksand' !IMPORTANT;
    margin-bottom: 30px;
}


      .cst-vs-col.left-sec {
    flex-direction: row;
}
.cst-vs-col.right-sec {
    flex-direction: row-reverse;
}
.cst-vs-compare {
  max-width: 1440px;
  margin: 0 auto;
  padding: 70px 20px !important;
  position:relative;
}
  .cst-vs-title {
    text-align: center;
    font-size: 40px;
    font-weight: 600;
    margin-bottom: 50px;
    color: #404040;
}
.cst-vs-item p {
    margin: 0;
    font-size: 18px;
    color: #404040;
    font-weight: 600;
}
.cst-vs-list.negative .cst-vs-item {
    background: #FBF1F0;
}
.cst-vs-list.positive .cst-vs-item {
    background: #FAFCFE;
}
.cst-vs-list.negative .cst-vs-item:first-child {
    border-top-right-radius: 20px;
}
.cst-vs-list.negative .cst-vs-item:last-child {
    border-bottom-right-radius: 20px;
}
.cst-vs-list.positive .cst-vs-item:first-child {
    border-top-left-radius: 20px;
}
.cst-vs-list.positive .cst-vs-item:last-child {
    border-bottom-left-radius: 20px;
}
.cst-vs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: center;
    width: 100%;
}
    .cst-vs-col{display:flex;flex-direction:column;align-items:center}
    .cst-vs-product img{width:auto;height:auto;margin-bottom:24px}
    .cst-vs-center{  
        display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    }
    .cst-vs-badge {
        width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #2f2f2f;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 16px;
      top: 48%;
    position:absolute;
  }
    .cst-vs-list{width:100%;overflow:hidden}


    .cst-vs-item {
      display: flex;
      gap: 14px;
      align-items: center;
      padding: 10px 22px;
      font-size: 16px;
      line-height: 1.45;
      color: #2b2b2b;
      margin-bottom: 8px;
      height: 83px;
  }
    .cst-vs-item+.cst-vs-item{border-top:1px solid rgba(0,0,0,.05)}
    .cst-vs-icon{width:22px;height:22px;flex-shrink:0;margin-top:2px}
    @media (max-width:1030px){
      .cst-vs-item p {
        font-size: 14px;
    }
    }
