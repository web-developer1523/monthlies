
    <section class="cst-vs-compare">
      {% if section.settings.title != blank %}
        <h2 class="cst-vs-title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <h2 class="cst-vs-subtitle">{{ section.settings.subtitle }}</h2>
      {% endif %}

      <div class="cst-vs-center">
            <span class="cst-vs-badge">{{ section.settings.vs_text }}</span>
          </div>
      <div class="cst-vs-grid">
    
        {%- assign left_items = section.blocks | where: 'type', 'left_item' -%}
        {%- assign right_items = section.blocks | where: 'type', 'right_item' -%}
    
        {% if section.settings.left_image != blank or left_items.size > 0 %}
        <div class="cst-vs-col left-sec">
          {% if section.settings.left_image != blank %}
            <div class="cst-vs-product">
              <img src="{{ section.settings.left_image | image_url: width: 300 }}" alt="{{ section.settings.left_alt | escape }}" />
            </div>
          {% endif %}
    
          {% if left_items.size > 0 %}
            <div class="cst-vs-list positive">
              {% for block in left_items %}
                {% if block.settings.text != blank %}
                  <div class="cst-vs-item" {{ block.shopify_attributes }}>
                    {% if section.settings.positive_icon != blank %}
                      <img class="cst-vs-icon" src="{{ section.settings.positive_icon | image_url: width: 44 }}" alt="check" />
                    {% endif %}
                    <span>{{ block.settings.text }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
        {% endif %}
    
        {% if left_items.size > 0 and right_items.size > 0 %}
        
        {% endif %}
    
        {% if section.settings.right_image != blank or right_items.size > 0 %}
        <div class="cst-vs-col right-sec">
          {% if section.settings.right_image != blank %}
            <div class="cst-vs-product">
              <img src="{{ section.settings.right_image | image_url: width: 300 }}" alt="{{ section.settings.right_alt | escape }}" />
            </div>
          {% endif %}
    
          {% if right_items.size > 0 %}
            <div class="cst-vs-list negative">
              {% for block in right_items %}
                {% if block.settings.text != blank %}
                  <div class="cst-vs-item" {{ block.shopify_attributes }}>
                    {% if section.settings.negative_icon != blank %}
                      <img class="cst-vs-icon" src="{{ section.settings.negative_icon | image_url: width: 44 }}" alt="cross" />
                    {% endif %}
                    <span>{{ block.settings.text }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
        {% endif %}
    
      </div>
    </section>

    
