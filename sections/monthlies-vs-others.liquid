    {% schema %}
    {
      "name": "Monthlies VS Compare",
      "settings": [
        {"type": "checkbox", "id": "enable_section", "label": "Enable section", "default": true},
        {"type": "text", "id": "title", "label": "Section title"},
        {"type": "text", "id": "subtitle", "label": "Sub Heading"},
    
        {"type": "image_picker", "id": "left_image", "label": "Left product image"},
        {"type": "text", "id": "left_alt", "label": "Left image alt text"},
    
        {"type": "image_picker", "id": "right_image", "label": "Right product image"},
        {"type": "text", "id": "right_alt", "label": "Right image alt text"},
    
        {"type": "image_picker", "id": "positive_icon", "label": "Positive icon"},
        {"type": "image_picker", "id": "negative_icon", "label": "Negative icon"},
    
        {"type": "text", "id": "vs_text", "label": "VS badge text", "default": "VS"}
      ],
      "blocks": [
        {
          "type": "left_item",
          "name": "Left list item",
          "settings": [
            {"type": "richtext", "id": "text", "label": "Text"}
          ]
        },
        {
          "type": "right_item",
          "name": "Right list item",
          "settings": [
            {"type": "richtext", "id": "text", "label": "Text"}
          ]
        }
      ],
      "presets": [
        {"name": "Monthlies VS Compare"}
      ]
    }
    {% endschema %}
    