{{ 'section-reviews-slider.css' | asset_url | stylesheet_tag }}
<section class="reviews-section {{ section.settings.class }}">
  <div class="control_width">
    <div class="title-container">
      <h2 class="title h1">{{ section.settings.title }}</h2>
    </div>
    <div class="swiper swiper-reviews !overflow-visible">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide">
            <img
              src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/trustpilot-star.svg?v=1759914197"
              alt="Stars"
              class="stars">
            <h3>{{block.settings.title | replace:'<p>','' | replace:'</p>',''}}</h3>
            {{ block.settings.dsc }}
            <span class="name">{{ block.settings.name }} {{ block.settings.age }}</span>
            <span class="date"> January, 2023 </span>
          </div>
        {% endfor %}
      </div>
    </div>
    {% if section.settings.btn != blank %}
      <a href="{{ section.settings.link }}" class="see_all_reviews en">{% if section.settings.btn != blank %} {{ section.settings.btn }} {% else %} Show all experiences {% endif %}<img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Arrows_3.png?v=1722572084" /></a>
      <a href="{{ section.settings.link }}" class="see_all_reviews german">{% if section.settings.btn != blank %} {{ section.settings.btn }} {% else %} Alle Erfahrungen anzeigen {% endif %}<img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Arrows_3.png?v=1722572084" /></a>
    {% endif %}
  </div>
</section>

<script type="lazyload_js">
  // Wait for Swiper to be available
  function initializeSwiper() {
    if (typeof Swiper !== 'undefined') {
      new Swiper(".swiper-reviews", {
        slidesPerView: "auto",
        loop: false,
        spaceBetween: 16
      });
    } else {
      // If Swiper isn't loaded yet, try again in 100ms
      setTimeout(initializeSwiper, 100);
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSwiper);
  } else {
    initializeSwiper();
  }
</script>

{% schema %}
  {
    "name": "Hormone Reviews",
    "presets": [
      {
        "name": "Hormone Reviews",
        "category": "section"
      }
    ],
    "settings": [
      {
        "type": "html",
        "label": "Title",
        "default": "Don't take our word for it, take hers!",
        "id": "title"
      },
      {
        "type": "url",
        "label": "Redirect Link",
        "id": "link"
      },
      {
        "type": "text",
        "label": "Button Text",
        "id": "btn"
      },
      {
        "type": "text",
        "label": "Add Custom Class",
        "id": "class"
      }
    ],
    "blocks": [
      {
        "type": "reviews",
        "name": "reviews",
        "settings": [
          {
            "type": "text",
            "id": "rating",
            "label": "Rating"
          },
          {
            "type": "richtext",
            "id": "title",
            "label": "title"
          },
          {
            "type": "richtext",
            "id": "dsc",
            "label": "dsc"
          },
          {
            "type": "text",
            "id": "name",
            "label": "Name"
          },
          {
            "type": "text",
            "id": "age",
            "label": "Age"
          }
        ]
      }    
    ]
  }
{% endschema %}