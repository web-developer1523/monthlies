<div class="discover-monthlies {{ section.settings.custom_class }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    {% if section.settings.top_shape_image != blank %}
      <img class="top_shape" src="{{ section.settings.top_shape_image | image_url }}" />
    {% else %}
      <img class="top_shape" src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Vector_351.png?v=1725421679" />
    {% endif %}
  
    {% if section.settings.section_heading != blank %}
      <h2 class="section_heading"><span>{{ section.settings.section_heading }}</span><em>.</em></h2>
    {% endif %}
  
    <div class="main_wrapper">
      <!-- Tabs -->
      <div class="tabs_container">
        {% if section.blocks.size > 0 %}
          <div class="benefits tab_pin active">{{section.settings.tab1 }}</div>
          <div class="what_you_get tab_pin">{{section.settings.tab2 }}</div>
          <div class="how_it_works tab_pin">{{section.settings.tab3 }}</div>
          <div class="ingredients tab_pin">{{section.settings.tab4 }}</div>
        {% endif %}
      </div>
  
      <!-- Tab Contents -->
      <div class="tabs_content_container">
  
        <!-- Benefits -->
        {% assign has_benefits = false %}
        {% for block in section.blocks %}
          {% if block.type == 'benefit_slide' %}
            {% assign has_benefits = true %}
          {% endif %}
        {% endfor %}
        {% if has_benefits %}
        <div class="benefits_content tab_content active">
          {% if section.settings.section_description != blank %}
            <p class="description">{{ section.settings.section_description }}</p>
          {% endif %}
          <div class="swiper-container_supl">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% if block.type == 'benefit_slide' %}
                  <div class="clip_card swiper-slide">
                    <div class="front">
                      {% if block.settings.image != blank %}
                        <img data-class="LazyLoad" src="{{ block.settings.image | img_url: 'master' }}" />
                      {% endif %}
                      <div class="card_bottom">
                        {% if block.settings.heading != blank %}
                          <h6 class="title">{{ block.settings.heading }}</h6>
                        {% endif %}
                        {%if block.settings.dsc != blank %}
                          {{ block.settings.dsc }}
                        {% endif %}
                        <div class="swiper-supl-button-next">
                          <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Flip.png?v=1722924073" />
                        </div>
                      </div>
                    </div>
                    <div class="back">
                      {% if block.settings.back_heading != blank %}
                        <h6 class="title">{{ block.settings.back_heading }}</h6>
                      {% endif %}
                      {% if block.settings.back_dsc != blank %}
                        {{ block.settings.back_dsc }}
                      {% endif %}
                      <div class="swiper-supl-button-next">Back 
                        <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Flip_arrows.png?v=1722924104" />
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            <div class="swiper-supl-button-prev"></div>
          </div>
        </div>
        {% endif %}
  
        <!-- What You Get -->
        {% assign has_what_you_get = false %}
        {% for block in section.blocks %}
          {% if block.type == 'what_you_get_card' %}
            {% assign has_what_you_get = true %}
          {% endif %}
        {% endfor %}
        {% if has_what_you_get %}
        <div class="what_you_get_content tab_content">
          <div class="swiper-container_supl">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% if block.type == 'what_you_get_card' %}
                  <div class="clip_card swiper-slide">
                    <div class="front">
                      {% if block.settings.image != blank %}
                        <img src="{{ block.settings.image | img_url: 'master' }}" />
                      {% endif %}
                      <div class="card_bottom">
                        {% if block.settings.title != blank %}
                          <h6 class="title">{{ block.settings.title }}</h6>
                        {% endif %}
                        <div class="swiper-supl-button-next">
                          <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Flip.png?v=1722924073" />
                        </div>
                      </div>
                    </div>
                    <div class="back">
                      {% if block.settings.title != blank %}
                        <h6 class="title">{{ block.settings.title }}</h6>
                      {% endif %}
                      {% if block.settings.description != blank %}
                        {{ block.settings.description }}
                      {% endif %}
                      {% if block.settings.extra_info != blank %}
                        <div>{{ block.settings.extra_info }}</div>
                      {% endif %}
                      <div class="swiper-supl-button-next">Back 
                        <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Flip_arrows.png?v=1722924104" />
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
        {% endif %}
  
        <!-- How It Works -->
        {% assign has_how_it_works = false %}
        {% for block in section.blocks %}
          {% if block.type == 'how_it_works_step' %}
            {% assign has_how_it_works = true %}
          {% endif %}
        {% endfor %}
        {% if has_how_it_works %}
        <div class="how_it_works_content tab_content">
          <div class="swiper-container_supl">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% if block.type == 'how_it_works_step' %}
                  <div class="card swiper-slide">
                    <div>
                      {% if block.settings.image != blank %}
                        <img src="{{ block.settings.image | img_url: 'master' }}" />
                      {% endif %}
                      {% if block.settings.title != blank %}
                        <h6 class="title">{{ block.settings.title }}</h6>
                      {% endif %}
                      {% if block.settings.description != blank %}
                        <p>{{ block.settings.description }}</p>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
        {% endif %}
  
        <!-- Ingredients -->
        {% assign has_ingredients = false %}
        {% for block in section.blocks %}
          {% if block.type == 'ingredient_accordion' %}
            {% assign has_ingredients = true %}
          {% endif %}
        {% endfor %}
        {% if has_ingredients %}
        <div class="ingredients_content tab_content">
          <div class="ingredients_content-wrap">
          {% if section.settings.ingredient_image != blank %}
            <div class="image_wrapper"> 
              <img class="desktop" src="{{ section.settings.ingredient_image | image_url }}" />
            </div>
          {% endif %}
          <div class="accordions">
            <div class="swiper-container_supl_01">
              <div class="swiper-wrapper_01">
                {% for block in section.blocks %}
                  {% if block.type == 'ingredient_accordion' %}
                    <div class="accordion swiper-slide">
                      <div>
                        {% if block.settings.title != blank %}
                          <div class="accordion_head">{{ block.settings.title }}</div>
                        {% endif %}
                        {% if block.settings.content != blank %}
                          <div class="accordion_content">{{ block.settings.content }}</div>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        </div>
        {% endif %}
  
      </div>
    </div>
  </div>
  

