{{ 'monthly-journey.css' | asset_url | stylesheet_tag }}
<div class="monthly-journey-section">
  <div class="journey-title">{{ section.settings.heading }}</div>
  <div class="journey-section">
    <div class="journey-container">
      <img
        src="{{ section.settings.main_image | image_url }}"
        alt="{{ section.settings.main_image.alt }}"
        width="100%"
        height="100%"
        class="graph-image"
      >
      <div class="months">
        {% for block in section.blocks %}
          <div class="month">
            <h3>{{ block.settings.month_heading }}</h3>
            <h4>{{ block.settings.month_desc }}</h4>
            <p>
              {{ block.settings.month_text | replace: '<p>', '' | replace: '</p>', '' }}
            </p>
          </div>
        {% endfor %}
      </div>
      <div class="disclaimer">
        {{ section.settings.cycle_paragraph | replace: '<p>', '' | replace: '</p>', '' }}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Monthly Journey",
  "class": "cst-monthy-journey",
  "settings": [
      {
        "type": "html",
        "id": "heading",
        "label": "Heading"
      },
      {
         "type":"image_picker",
         "id":"main_image",
         "label":"Image"
      },
      {
         "type":"richtext",
         "id":"cycle_paragraph",
         "label":"Paragraph"
      }
  ],
  "blocks":[
      {
         "type":"month",
         "name":"Month",
         "limit": 3,
         "settings":[
            {
               "type":"text",
               "id":"month_heading",
               "label":"Month heading"
            },
            {
               "type":"inline_richtext",
               "id":"month_desc",
               "label":"Month Description",
            },
            {
               "type":"richtext",
               "id":"month_text",
               "label":"Month Text"
            }
         ]
      }
   ],
  "presets": [
    {
    "name": "Monthly Journey"
    }
  ]
}
{% endschema %}
