{{ 'section-campaign-hero.css' | asset_url | stylesheet_tag }}

<div class="campaign-hero">
      <img
      src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/hero_mobile.jpg?v=1689182312"
      alt="hero-visual"
      class="campaign-hero--bg small-screens">
  <div class="page-width campaign-hero-wrapper">
    <div class="campaign-hero--content">
      <img
      class="campaign-hero--visual "
      src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/pot-mobile.png?v=1689182311"
      alt="bg-icon">
      <!--<img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/icon.png?v=1681241572" alt="icon"> -->

      <h1>{{ section.settings.title }}</h1>
      <p class="campaign-hero--text">{{ section.settings.text }}</p>

      <a href="{{ section.settings.btn_url }}" id="cta-hero-horm" class="button button--black">
        {{ section.settings.btn }}
        <svg
          width="7"
          height="12"
          viewBox="0 0 7 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523"
            stroke="white"
            stroke-width="1.5" />
        </svg>
      </a>

      <p>{{ section.settings.satisfaction }}</p>
    </div>

   <img
      src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/hero-product-large.png?v=1689180563"
      alt="hero-visual"
      class="campaign-hero--visual large-screens">

    <img
      class="campaign-hero--bg large-screens"
      src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Mask_group_a67a10b8-0fd3-4ea4-a1d8-86782d4a8099.png?v=1689611477"
      alt="bg-icon">

</div>

{% schema %}
  {
    "name": "campaign-hero",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "label": "Title",
        "id": "title",
        "default": "Get to the root cause of your menstrual pain"
      }, {
        "type": "text",
        "label": "Text",
        "id": "text",
        "default": "Eliminate the guesswork and take control of your well-being with our at-home hormone saliva self-test with personalised recommendations to tackle any underlying issues."
      }, {
        "type": "text",
        "label": "Button",
        "id": "btn",
        "default": "Order now"
      },{
        "type": "url",
        "label": "Button URL",
        "id": "btn_url"
      }, {
        "type": "text",
        "label": "Satisfaction",
        "id": "satisfaction",
        "default": "★★★★☆ 80% of customer satisfaction"
      }
    ],
    "presets": [
      {
        "name": "campaign-hero"
      }
    ]
  }
{% endschema %}