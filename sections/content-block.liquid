{{ 'section-content-block.css' | asset_url | stylesheet_tag }}

<div class="page-width">
  <div class="content-block{% if section.settings.reverse %} content-block--reverse{% endif %}">
    <img
      class="content-block-img"
      src="{{ section.settings.image }}"
      alt="image">

    <div class="content-block-text">
      <h2>{{ section.settings.title }}</h2>
      <div class="content-block-richtext">{{ section.settings.text }}</div>

      <add-to-cart
        id="{{ section.settings.btn_id }}"
        class="button button--black"
        data-variant-id="46864087187803">
        {{ section.settings.btn }}
      
        <svg
          width="7"
          height="12"
          viewBox="0 0 7 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523"
            stroke="white"
            stroke-width="1.5" />
        </svg>
        <use href="#icon-cart"></svg>
      </add-to-cart>

      
    </div>
  </div>
</div>


{% schema %}
  {
    "name": "Content Block",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Say goodbye to period pain"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Title",
        "default": "<p>Lorem ipsum dolor</p>"
      },
      {
        "type": "text",
        "id": "btn",
        "label": "Button",
        "default": "Order now"
      },
      
        {
      "type": "text",
      "id": "btn_id",
      "label": "Button ID",
      "default": "cta-"
    }
      
      ,{
        "type": "url",
        "label": "Button URL",
        "id": "btn_url"
      },
      {
        "type": "text",
        "id": "image",
        "label": "Image URL",
        "default": "https://cdn.shopify.com/s/files/1/0708/7462/8371/files/AdobeStock_178355722.png?v=1687252617"
      }, {
        "type": "checkbox",
        "id": "reverse",
        "label": "Reverse",
        "default": false
      }
    ],
    "presets": [
      {
        "name": "Content Block"
      }
    ]
  }
{% endschema %}