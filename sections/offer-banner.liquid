{{ 'section-offer-banner.css' | asset_url | stylesheet_tag }}

<section class="offer-banner {{ section.settings.gclass }}">
    <div class="page-width">
        <div class="offer-banner-content">
            <div class="offer-banner-title">
                <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/icon-monthlies_73d6c88e-c971-4828-8ba1-784a4386f365.png?v=1688549610" alt="Icon">
                <h2>{{ section.settings.title }}</h2>
            </div>
            <p>{{ section.settings.text }}</p>
            <a
            href="{{ section.settings.url_1 }}"
            id="cta-buynowfoot"
            class="button button--black">
            {{ section.settings.label_1 }}
            <svg
              width="7"
              height="12"
              viewBox="0 0 7 12"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523"
                stroke="white"
                stroke-width="1.5" />
            </svg>
          </a>
        </div>
    </div>
</section>

{% schema %}
    {
      "name": "offer-banner",
      "tag": "section",
      "class": "section",
      "settings": [
          {
          "type": "text",
          "label": "Add Custom Class",
          "id": "gclass"
        }, 
        {
          "type": "text",
          "label": "Title",
          "id": "title",
          "default": "Get your personalised solution today"
        }, 
        {
            "type": "text",
            "label": "Text",
            "id": "text",
            "default": "Take our quiz to get your personalised recommendations based on your symptoms to get started."
        },
        {
            "type": "url",
            "id": "url_1",
            "label": "URL 1"
        },
        {
            "type": "text",
            "id": "label_1",
            "label": "Label 1",
            "default": "Take the quiz"
        }
      ],
      "presets": [
        {
          "name": "offer-banner"
        }
      ]
    }
  {% endschema %}