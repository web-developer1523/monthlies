@media (max-width: 480px) {
    .cst-custom-homepage-new .monthlies-hero-wrapper .hero-content {
        padding: 32px 20px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .main-text {
        padding-top: 24px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .headline {
        margin-bottom: 12px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .subheadline {
        font-size: 14px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .badges-container {
        padding-top: 20px;
        gap: 6px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .badge img {
        max-width: 85px;
        height: 80px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .bottom-sections {
        margin-top: 0;
        gap: 12px;
    }



    .cst-custom-homepage-new .monthlies-hero-wrapper .pharmacy-section {
        padding: 16px;
        gap: 12px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .star {
        font-size: 14px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .star img {
        width: 14px;
        height: 14px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .rating-text {
        font-size: 13px;
    }

    .cst-custom-homepage-new .monthlies-hero-wrapper .trust-text {
        font-size: 12px;
    }
    .cst-custom-homepage-new .monthlies-hero-wrapper .pharmacy-section {
        grid-template-columns: 1fr 1fr;
        }
        .cst-custom-homepage-new .monthlies-hero-wrapper .pharmacy-section img {
        width: 100%;
        }

}
