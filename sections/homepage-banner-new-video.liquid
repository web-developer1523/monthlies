<div class="monthlies-hero-wrapper">

    <div class="trust-bar">
        <div class="trust-bar-content">

            <div class="trust-rating">
                <div class="stars">

                    {% if section.settings.review_profile_image != blank %}
                    <div class="profile-pictures mob">
                        <img src="{{ section.settings.review_profile_image | img_url: 'master' }}" alt="testimonial-image" class="testimonial-image" />
                    </div>
                    {% endif %}
                    <div class="werappepr">
                    {% if section.settings.review_star_image != blank %}
                    <img src="{{ section.settings.review_star_image | img_url: 'master' }}" alt="Star" class="star" />
                    {% endif %}

                    {% if section.settings.review_rating_text != blank %}
                    <span class="rating-text">{{ section.settings.review_rating_text }}</span>
                    {% endif %}
                     {% if section.settings.trust_statement != blank %}
                    <p class="trust-statement">{{ section.settings.trust_statement }}</p>
                    {% endif %}
                    </div>
                </div>

               
            </div>

        </div>
    </div>

    <section class="hero-section">

        <!-- Background Image -->
        <div class="hero-background">
            {% if section.settings.hero_background != blank %}
            <img src="{{ section.settings.hero_background | img_url: 'master' }}" alt="Background" class="bg-image" />
            {% endif %}
            {% assign mp4 = section.settings.hero_background_video.sources | where: "mime_type", "video/mp4" | first %}
            {% if mp4 %}
              <video
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                poster="{{ section.settings.hero_video_poster | image_url }}"
              >
                <source src="{{ mp4.url }}" type="video/mp4">
              </video>
            {% endif %}
            
                          
              
            <div class="dark-overlay"></div>
        </div>

        <div class="hero-content">
            <div class="main-grid">

                <div class="main-text">

                    {% if section.settings.headline != blank %}
                    <h1 class="headline">{{ section.settings.headline }}</h1>
                    {% endif %}

                    {% if section.settings.subheadline != blank %}
                    <p class="subheadline">{{ section.settings.subheadline }}</p>
                    {% endif %}

                    {% if section.settings.cta_text != blank %}
                    <div class="hero-cta-wrapper">
                        <a href="{{ section.settings.cta_link }}" class="hero-cta-btn">
                            {{ section.settings.cta_text }}
                        </a>
                    </div>
                    {% endif %}
                </div>

                <!-- Badges Section -->
                <div class="badges-container">
                    {% if section.settings.badge_1 != blank %}
                    <div class="badge badge-1">
                        <img src="{{ section.settings.badge_1 | img_url: 'master' }}" alt="Vegan Badge" />
                    </div>
                    {% endif %}

                    {% if section.settings.badge_2 != blank %}
                    <div class="badge badge-2">
                        <img src="{{ section.settings.badge_2 | img_url: 'master' }}" alt="Cruelty Free Badge" />
                    </div>
                    {% endif %}

                    {% if section.settings.badge_3 != blank %}
                    <div class="badge badge-3">
                        <img src="{{ section.settings.badge_3 | img_url: 'master' }}" alt="GMP Badge" />
                    </div>
                    {% endif %}
                </div>

            </div>

            <div class="bottom-sections">

                <!-- Customer Review Section -->
                <div class="review-section">

                    {% if section.settings.review_profile_image != blank %}
                    <div class="profile-pictures">
                        <img src="{{ section.settings.review_profile_image | img_url: 'master' }}" alt="testimonial-image" class="testimonial-image" />
                    </div>
                    {% endif %}

                    <div class="review-content">
                        <div class="stars">

                            {% if section.settings.review_star_image != blank %}
                            <img src="{{ section.settings.review_star_image | img_url: 'master' }}" alt="Star" class="star" />
                            {% endif %}

                            {% if section.settings.review_rating_text != blank %}
                            <span class="rating-text">{{ section.settings.review_rating_text }}</span>
                            {% endif %}
                        </div>

                        {% if section.settings.review_trust_text != blank %}
                        <p class="trust-text">{{ section.settings.review_trust_text }}</p>
                        {% endif %}
                    </div>
                </div>

                <!-- Pharmacy Section -->
                <div class="pharmacy-section">

                    {% if section.settings.pharmacy_intro != blank %}
                    <p class="pharmacy-intro">{{ section.settings.pharmacy_intro }}</p>
                    {% endif %}

                    {% if section.settings.pharmacy_docmorris != blank %}
                    <div class="pharmacy-logo docmorris">
                        <img src="{{ section.settings.pharmacy_docmorris | img_url: 'master' }}" alt="DocMorris" class="pharmacy-logo-img" />
                    </div>
                    {% endif %}

                    {% if section.settings.pharmacy_shop != blank %}
                    <div class="pharmacy-logo shopapotheke">
                        <img src="{{ section.settings.pharmacy_shop | img_url: 'master' }}" alt="Shop Apotheke" class="pharmacy-logo-img" />
                    </div>
                    {% endif %}

                    {% if section.settings.amazon_shop != blank %}
                    <div class="amazon-logo shopapotheke">
                        <img src="{{ section.settings.amazon_shop | img_url: 'master' }}" alt="Shop Apotheke" class="pharmacy-logo-img" />
                    </div>
                    {% endif %}

                </div>

            </div>
        </div>
    </section>
</div>


