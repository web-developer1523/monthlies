{{ 'section-pricing.css' | asset_url | stylesheet_tag }}

<section class="pricing" id="pricing">
  <div class="pricing-title">
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="pricing-subtitle">
    <p class="subhead">{{ section.settings.text }}</p>
  </div>

<div class="pricing-wrapper">
    {% for i in (1..3) %}
        {% assign product_key = 'product' | append: i %}
        {% assign product = all_products[section.settings[product_key]] %}
        {% assign variant_id_key = 'variant' | append: i | append: '_id' %}
        {% assign selected_variant_id = section.settings[variant_id_key] %}
        {% assign selected_variant = nil %}
        {% for variant in product.variants %}
            {% if variant.id == selected_variant_id %}
                {% assign selected_variant = variant %}
                {% break %}
            {% endif %}
        {% endfor %}
        {% assign column_id = 'product-column-' | append: forloop.index %}
        {% assign icon_svg_key = product_key | append: '_icon_svg' %}
        {% assign icon_svg = section.settings[icon_svg_key] %}

        {{ 'Selected variant ID from settings: ' | append: selected_variant_id }}
        {{ 'Selected variant ID from product: ' | append: selected_variant.id }}

      <div class="product-column" id="{{ column_id }}">
        <!-- Show product image -->
        <div class="product-img">
          
          {% if product.metafields.custom.description != blank %}
            <div class="product-tag">
              <div class="product-tag-icon">
                    {{ icon_svg | default: '' | raw }}
              </div>
              <div class="product-tag-description">
                {{ product.metafields.custom.description }}
              </div>
            </div>
          {% endif %}
          <img src="{{ selected_variant.image.src | img_url: '480x480' }}" alt="{{ selected_variant.title }}">

        </div>

      </div>
    {% endfor %}
  </div>
</section>

