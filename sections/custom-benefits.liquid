{{ 'section-custom-benefits.css' | asset_url | stylesheet_tag }}

{% liquid
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign heading = section.settings.heading
  assign heading_alignment = section.settings.heading_alignment
%}

{% render 'section-paddings',
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

{% if heading != blank or section.blocks.size > 0 %}
  <div
    class="benefits-grid section-{{ section.id }}--padding"
    style="
      --background-color: {{ background_color }};
      --text-color: {{ text_color }};
      --heading-alignment: {{ heading_alignment }};
    "
  >
    <div class="benefits-grid__wrapper">
      {% if heading != blank %}
        <h2 class="benefits-grid__heading page-width">
          {{ heading }}
        </h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="benefits-grid__items--wrapper">
          <div class="benefits-grid__items page-width">
          {% for block in section.blocks %}
            {% liquid
              assign image = block.settings.image
              assign text = block.settings.text
              assign icon = block.settings.icon
            %}

            {% if image != blank or text != blank %}
              <div class="benefits-grid__item" {{ block.shopify_attributes }}>
                {% if image != blank %}
                  <div class="benefits-grid__image-wrapper">
                    {{
                      image
                      | image_url: width: 600
                      | image_tag:
                        class: 'benefits-grid__image',
                        loading: 'lazy'
                    }}
                    {% if icon != blank %}
                      <div class="benefits-grid__icon-wrapper">
                        {{
                          icon
                          | image_url: width: 64
                          | image_tag:
                            class: 'benefits-grid__icon',
                            loading: 'lazy'
                        }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

                {% if text != blank %}
                  <div class="benefits-grid__content">
                    <p class="benefits-grid__text">
                      {{ text }}
                    </p>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Benefits grid",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Die natürlichen Inhaltsstoffe unserer Formel bergen zahlreiche Vorteile"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#404040"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (Mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (Mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Benefit description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits grid",
      "category": "Custom",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
