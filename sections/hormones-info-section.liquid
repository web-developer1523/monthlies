<section class="cst-custom-hormone-info-section">
    <div class="container">
      <div class="symptoms-main">
        <div class="intro-main">
          <div class="symptoms-intro">
            <h1>{{ section.settings.main_heading | replace:'<p>','' | replace:'</p>','' }}</h1>
            <p>{{ section.settings.main_description | replace:'<p>','' | replace:'</p>',''}}</p>
          </div>
          <div class="diagram">
            {% if section.settings.body_image != blank %}
              <img class="for-desktop-only" src="{{ section.settings.body_image | img_url: 'master' }}" alt="Hormones Diagram">
              <img class="for-mobile-only" src="{{ section.settings.mobile_body_image | img_url: 'master' }}" alt="Hormones Diagram">
            {% endif %}
            {% comment %} {% if section.settings.body_image != blank %}
              <img src="{{ section.settings.body_image | img_url: 'master' }}" alt="Hormones Diagram">
            {% endif %}
            <div class="diagram-content">
              <div class="label progesterone">
                   <div class="connector"></div>
                <p class="header-p">{{ section.settings.progesterone_title }}</p>
                <p class="border-p">{{ section.settings.progesterone_text }}</p>
              </div>
              <div class="label estrogen">
                   <div class="connector"></div>
                <p class="header-p">{{ section.settings.estrogen_title }}</p>
                <p class="border-p">{{ section.settings.estrogen_text }}</p>
              </div>
              <div class="label testosterone">
                   <div class="connector"></div>
                <p class="header-p">{{ section.settings.testosterone_title }}</p>
                <p class="border-p">{{ section.settings.testosterone_text }}</p>
              </div>
            </div> {% endcomment %}
          </div>
        </div>
        <div class="symptoms-main-content">
          <div class="card symptoms-card">
            <div class="symptoms-card-content">
              {% if section.settings.chemical_image != blank %}
                <img class="for-desktop-only" src="{{ section.settings.chemical_image | img_url: 'master' }}" alt="Chemical Structures">
              {% endif %}
              {% if section.settings.mobile_chemical_image != blank %}
                <img class="for mobile-only" src="{{ section.settings.mobile_chemical_image | img_url: 'master' }}" alt="Chemical Structures">
              {% endif %}
              <h2>{{ section.settings.side_heading | replace:'<p>','' | replace:'</p>',''}}</h2>
            </div>
          </div>
  
          <div class="symptoms-content">
            <div class="symptoms">
              <h2>{{ section.settings.symptom_heading | replace:'<p>','' | replace:'</p>',''}}</h2>
              <p>{{ section.settings.symptom_description }}</p>
            
              <div class="tags symptom-tags">
                {% for block in section.blocks %}
                  <div class="tag tags-{{ forloop.index }}">
                    {{ block.settings.symptom_name }}
                  </div>
                {% endfor %}
              </div>
            
              {% if section.blocks.size > 18 %}
                <button class="toggle-tags-mobile">+ Show More</button>
              {% endif %}
            {% if section.settings.symptom_note != blank %}
              <p class="small-note">
                {{ section.settings.symptom_note }}
              </p>
            {% endif %}
            </div>
            
            <script>
              document.addEventListener("DOMContentLoaded", function () {
                const tagElements = document.querySelectorAll(".symptom-tags .tag");
                const noteElement = document.querySelector(".small-note");
              
                // Symptom → Disease mapping (all possible hormones)
                const symptomToDisease = {
                  "bloating": ["Estradiol (E2) too high", "Progesterone too high"],
                  "breast tenderness": ["Estradiol (E2) too high"],
                  "breast pain": ["Progesterone too high"],
                  "mood swings": ["Estradiol (E2) too high"],
                  "heavy bleeding": ["Estradiol (E2) too high"],
                  "hot flashes": ["Estradiol (E2) too low", "FSH too high"],
                  "night sweats": ["Estradiol (E2) too low"],
                  "vaginal dryness": ["Estradiol (E2) too low"],
                  "low mood": ["Estradiol (E2) too low", "Progesterone too high", "Testosterone too low"],
                  "irregular periods": ["Progesterone too low", "FSH too low"],
                  "anxiety": ["Progesterone too low"],
                  "trouble sleeping": ["Progesterone too low"],
                  "infertility": ["FSH too high", "LH too high", "LH too low"],
                  "acne": ["SHBG too low", "Testosterone too high", "Free Androgen Index too high"],
                  "oily skin": ["SHBG too low", "Testosterone too high"],
                  "hair growth": ["SHBG too low", "Testosterone too high"],
                  "unwanted hair growth": ["Testosterone too high"],
                  "fatigue": ["SHBG too high", "Testosterone too low", "Free Androgen Index too low"],
                  "low libido": ["Prolactin too high", "SHBG too high", "Testosterone too low", "Free Androgen Index too low"],
                  "muscle loss": ["Testosterone too low"],
                  "weak muscles": ["SHBG too high"],
                  "milk leakage": ["Prolactin too high"],
                  "missed periods": ["Prolactin too high"],
                  "PCOS signs": ["LH too high"],
                  "low testosterone or estrogen": ["LH too low"],
                  "poor milk production": ["Prolactin too low"],
                  "scalp hair loss": ["Free Androgen Index too high"]
                };
              
                // Primary hormone for single selection (most important one)
                const primaryHormone = {
                  "bloating": "Estradiol (E2) too high",
                  "breast tenderness": "Estradiol (E2) too high",
                  "breast pain": "Progesterone too high",
                  "mood swings": "Estradiol (E2) too high",
                  "heavy bleeding": "Estradiol (E2) too high",
                  "hot flashes": "Estradiol (E2) too low",
                  "night sweats": "Estradiol (E2) too low",
                  "vaginal dryness": "Estradiol (E2) too low",
                  "low mood": "Estradiol (E2) too low",
                  "irregular periods": "Progesterone too low",
                  "anxiety": "Progesterone too low",
                  "trouble sleeping": "Progesterone too low",
                  "infertility": "FSH too high",
                  "acne": "SHBG too low",
                  "oily skin": "SHBG too low",
                  "hair growth": "SHBG too low",
                  "unwanted hair growth": "Testosterone too high",
                  "fatigue": "SHBG too high",
                  "low libido": "Prolactin too high",
                  "muscle loss": "Testosterone too low",
                  "weak muscles": "SHBG too high",
                  "milk leakage": "Prolactin too high",
                  "missed periods": "Prolactin too high",
                  "PCOS signs": "LH too high",
                  "low testosterone or estrogen": "LH too low",
                  "poor milk production": "Prolactin too low",
                  "scalp hair loss": "Free Androgen Index too high"
                };
              
                const selectedSymptoms = new Set();
              
                tagElements.forEach(tag => {
                  tag.addEventListener("click", () => {
                    const symptom = tag.textContent.trim().toLowerCase();
              
                    // Toggle selection
                    if (selectedSymptoms.has(symptom)) {
                      selectedSymptoms.delete(symptom);
                      tag.classList.remove("active");
                    } else {
                      selectedSymptoms.add(symptom);
                      tag.classList.add("active");
                    }
              
                    // === No selection
                    if (selectedSymptoms.size === 0) {
                      noteElement.textContent =
                        "{{ section.settings.symptom_note | strip_html }}";
                      return;
                    }
              
                    // === Single selection → show primary hormone only
                    if (selectedSymptoms.size === 1) {
                      const singleSym = Array.from(selectedSymptoms)[0];
                      let primary = primaryHormone[singleSym] || symptomToDisease[singleSym][0];
                      const match = primary.match(/(.+?)\s+too\s+(high|low)/i);
                      if (match) primary = `too ${match[2]} ${match[1]}`;
                      noteElement.textContent = `The symptoms you selected may be connected:  ${primary}.`;
                      return;
                    }
              
                    // === Multiple selection → show all hormones and highlight overlaps
                    const allDiseases = [];
                    selectedSymptoms.forEach(sym => {
                      if (symptomToDisease[sym]) {
                        allDiseases.push(...symptomToDisease[sym]);
                      }
                    });
              
                    const counts = {};
                    allDiseases.forEach(d => counts[d] = (counts[d] || 0) + 1);
              
                    const uniqueDiseases = Object.keys(counts);
                    const overlaps = uniqueDiseases.filter(d => counts[d] > 1);
              
                    if (uniqueDiseases.length === 0) {
                      noteElement.textContent =
                        "The symptoms you selected do not share a clear hormonal pattern. Try removing or changing a symptom.";
                      return;
                    }
              
                    // Reformat "Prolactin too high" → "too high Prolactin"
                    const formattedList = uniqueDiseases.map(d => {
                      const match = d.match(/(.+?)\s+too\s+(high|low)/i);
                      if (match) {
                        return `too ${match[2]} ${match[1]}`;
                      } else {
                        return d;
                      }
                    });
              
                    const emphasized = formattedList.map(f => {
                      const original = uniqueDiseases[formattedList.indexOf(f)];
                      if (overlaps.includes(original)) {
                        return `<strong>${f}</strong>`;
                      }
                      return f;
                    });
              
                    const sentence =
                      emphasized.length === 1
                        ? emphasized[0]
                        : emphasized.slice(0, -1).join(", ") + " or " + emphasized.slice(-1);
              
                    noteElement.innerHTML =
                      `The symptoms you selected may be connected to ${sentence}.`;
                  });
                });
              });
              </script>
              
  
              
            
            <style>
            .tag {
              display: inline-block;
              padding: 6px 10px;
              background: #f3f3f3;
              border-radius: 20px;
              margin: 5px;
              cursor: pointer;
              transition: all 0.2s ease;
            }
            .tag.active {
              background: #cce5ff;
              color: #004085;
              font-weight: bold;
            }
            </style>
            
            {% comment %} <div class="symptoms">
              <h2>{{ section.settings.symptom_heading | replace:'<p>','' | replace:'</p>',''}}</h2>
              <p>{{ section.settings.symptom_description }}</p>
          
              <div class="tags">
                {% for block in section.blocks %}
                  <div class="tag tags-{{forloop.index}}">
                    {{ block.settings.symptom_name }}
                  </div>
                {% endfor %}
              </div>
          
              {% if section.blocks.size > 18 %}
                <button class="toggle-tags-mobile">+ Show More</button>
              {% endif %}
          
              <p class="small-note">
                {{section.settings.symptom_note }}
              </p>
            </div> {% endcomment %}
  
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <style>
    @media (max-width: 768px) {
        .cst-custom-hormone-info-section .symptoms p:last-child{
          margin-top:25px !important;
      }
      .tags .tag:nth-child(n+18) {
        display: none;
      }
  
      .toggle-tags-mobile {
          display: block;
          background: none;
          border: none;
          cursor: pointer;
          padding: 0;
          margin-top: 25px;
          color: #000;
          font-size: 16px;
          font-weight: 600;
      }
    }
  
    @media (min-width: 769px) {
      .toggle-tags-mobile {
        display: none;
      }
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const toggleBtn = document.querySelector('.toggle-tags-mobile');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          const hiddenTags = document.querySelectorAll('.tags .tag:nth-child(n+18)');
          const isHidden = hiddenTags[0].style.display === 'none' || hiddenTags[0].style.display === '';
  
          hiddenTags.forEach(tag => tag.style.display = isHidden ? 'inline-block' : 'none');
          toggleBtn.textContent = isHidden ? '- Show Less' : '+ Show More';
        });
      }
    });
  </script>
