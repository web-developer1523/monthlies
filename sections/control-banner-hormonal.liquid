{{ 'section-control-banner.css' | asset_url | stylesheet_tag }}

<section class="control-banner">
  <img src="{{section.settings.image | image_url }}" alt="image">
  <div class="page-width">
    <h2>{{ section.settings.title }}</h2>
    <div class="buttons">

   <div class="hero-buttons">
{% if section.settings.label_1 == blank %}
  <add-to-cart id="cta-order" class="button button--black" data-variant-id="46864087187803">
      
    {{ section.settings.label_1 }}
    <svg
      width="7"
      height="12"
      viewBox="0 0 7 12"
      fill="none"
      xmlns="http://www.w3.org/2000/svg">
      <path
        d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523"
        stroke="white"
        stroke-width="1.5" />
    </svg>
    <use href="#icon-cart"></svg>
  </add-to-cart>
{% endif %}


      {% if section.settings.btn_url != blank and section.settings.label_2 != blank %}
  <a href="{{ section.settings.btn_url }}" id="cta-quizbot" class="button button--inverted-white">
            {{ section.settings.label_2 }}
            <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523" stroke="white" stroke-width="1.5"></path>
            </svg>
  </a>
{% endif %}

          
        </div>
      
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "control-banner-hormonal",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "label": "Title",
        "default": "Take control of your cycle",
        "id": "title"
      }, 
      {
        "type": "image_picker",
        "label": "Image",
        "id": "image"
      }, 
      {
        "type": "text",
        "label": "Button Label 1",
        "id": "label_1",
        "default": "Order now"
      }, 
      {
        "type": "text",
        "label": "Button Label 2",
        "id": "label_2",
        "default": "Take the Quiz"
      },
      {
        "type": "url",
        "label": "Button URL 2",
        "id": "btn_url"
      }
    ],
    "presets": [
      {
        "name": "Control Banner Hormonal"
      }
    ]
  }
{% endschema %}