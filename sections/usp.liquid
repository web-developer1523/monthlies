{{ 'section-usp.css' | asset_url | stylesheet_tag }}

<div class="usp-holder">
  <div class="page-width">
    <h3 class="title">{{ section.settings.title }}</h3>

    <div class="usp-list">
      <div class="usp">
          <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Vector.png?v=1681246632" alt="USP">
          <h4>{{ section.settings.title_1 }}</h4>
          <p>{{ section.settings.text_1 }}</p>
      </div>
  
      <div class="usp">
          <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Vector-1.png?v=1681246623" alt="USP">
          <h4>{{ section.settings.title_2 }}</h4>
          <p>{{ section.settings.text_2 }}</p>
      </div>
  
      <div class="usp">
          <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Vector-2.png?v=1681246632" alt="USP">
          <h4>{{ section.settings.title_3 }}</h4>
          <p>{{ section.settings.text_3 }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
    {
      "name": "usp",
      "tag": "section",
      "class": "section",
      "settings": [
        {
            "type": "text",
            "label": "Title",
            "id": "title",
            "default": "Painkillers aren’t your only option. Try natural solutions"
        },
        {
            "type": "text",
            "label": "Item 1 - Title",
            "id": "title_1",
            "default": "Natural ingredients"
        },
        {
            "type": "text",
            "label": "Item 1 - Text",
            "id": "text_1",
            "default": "Natural ingredients to ease your menstrual symptoms"
        },
        {
            "type": "text",
            "label": "Item 2 - Title",
            "id": "title_2",
            "default": "Backed by research"
        },
        {
            "type": "text",
            "label": "Item 2 - Text",
            "id": "text_2",
            "default": "Recommendations are based on scientific research and evidence"
        },
        {
            "type": "text",
            "label": "Item 3 - Title",
            "id": "title_3",
            "default": "By women"
        },
        {
            "type": "text",
            "label": "Item 3 - Title",
            "id": "text_3",
            "default": "Premium formulas by women’s heatlh experts"
        }
      ],
      "presets": [
        {
          "name": "USP's"
        }
      ]
    }
{% endschema %}
    