{{ 'section-faq-with-ingredients.css' | asset_url | stylesheet_tag }}
{{ 'component-ingredient-popup.css' | asset_url | stylesheet_tag }}
{{ 'component-collapsible-content.css' | asset_url | stylesheet_tag }}

{% render 'section-paddings',
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

{%- liquid
  assign has_ingredients = false
  assign ingredients = section.blocks | where: 'type', 'ingredient'
  if ingredients.size > 0
    for block in ingredients
      unless block.settings.metaobject_handle == blank or block.settings.metaobject_type == blank
        assign ingredient_metaobject = metaobjects[block.settings.metaobject_type][block.settings.metaobject_handle]
        if ingredient_metaobject
          assign has_ingredients = true
          break
        endif
      endunless
    endfor
  endif
-%}

<div class="faq-with-ingredients-wrapper">
  <div
    class="faq-with-ingredients section-{{ section.id }}--padding"
    style="--background: {{ section.settings.background }}"
  >
    <div class="faq-with-ingredients__faq">
      {%- unless section.settings.title == blank -%}
        <h2 class="faq-with-ingredients__title">{{ section.settings.title }}</h2>
      {%- endunless -%}
      {%- unless section.settings.subtitle == blank -%}
        <div class="faq-with-ingredients__subtitle">{{ section.settings.subtitle }}</div>
      {%- endunless -%}
      {%- assign collapsible_content = section.blocks | where: 'type', 'collapsible_content' -%}
      {%- if collapsible_content.size > 0 -%}
        <div class="faq-with-ingredients__collapsible-content-wrapper">
          {%- for block in collapsible_content -%}
            {%- if block.settings.title != blank and block.settings.content != blank -%}
              {%- render 'collapsible-content', title: block.settings.title, content: block.settings.content -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- unless section.settings.button_text == blank -%}
        <a class="faq-with-ingredients__button" href="{{ section.settings.button_url }}">
          {{- section.settings.button_text -}}
        </a>
      {%- endunless -%}
    </div>
    {%- if has_ingredients -%}
      <div class="faq-with-ingredients__ingredients-grid">
        {%- for block in ingredients -%}
          {%- unless block.settings.metaobject_handle == blank or block.settings.metaobject_type == blank -%}
            {%- assign ingredient_metaobject = metaobjects[block.settings.metaobject_type][block.settings.metaobject_handle] -%}
            <slider-modal-opener
              class="faq-with-ingredients__ingredients-grid-item"
              data-modal="#slider_modal_{{ section.id }}"
              data-target-index="{{ forloop.index0 }}"
            >
              <div class="grid-ingredient-card">
                <div class="grid-ingredient-card__plus">
                  {{ 'icon-plus.svg' | inline_asset_content }}
                </div>
                {%- unless ingredient_metaobject.image == blank -%}
                  <div class="grid-ingredient-card__image">
                    {{ ingredient_metaobject.image.value | image_url: width: 300 | image_tag }}
                  </div>
                {%- endunless -%}
                <div class="grid-ingredient-card__content">
                  {% if ingredient_metaobject.vitamin_name != blank %}
                    <p class="grid-ingredient-card__name">
                      {{ ingredient_metaobject.vitamin_name | metafield_text }}
                    </p>
                  {% endif %}
                  {% if ingredient_metaobject.mineral_name != blank %}
                    <p class="grid-ingredient-card__name">
                      {{ ingredient_metaobject.mineral_name | metafield_text }}
                    </p>
                  {% endif %}
                  {% if ingredient_metaobject.nutrient_name != blank %}
                    <p class="grid-ingredient-card__name">
                      {{ ingredient_metaobject.nutrient_name | metafield_text }}
                    </p>
                  {% endif %}
                  {% if ingredient_metaobject.amino_acid_name != blank %}
                    <p class="grid-ingredient-card__name">
                      {{ ingredient_metaobject.amino_acid_name | metafield_text }}
                    </p>
                  {% endif %}
                  {% if ingredient_metaobject.other_ingredient_name != blank %}
                    <p class="grid-ingredient-card__name">
                      {{ ingredient_metaobject.other_ingredient_name | metafield_text }}
                    </p>
                  {% endif %}
                  {% if ingredient_metaobject.plant_extract_name != blank %}
                    <p class="grid-ingredient-card__name">
                      {{ ingredient_metaobject.plant_extract_name | metafield_text }}
                    </p>
                  {% endif %}
                  {%- unless block.settings.custom_title == blank -%}
                    <p class="grid-ingredient-card__title">{{ block.settings.custom_title | newline_to_br | replace: '-', '&shy;' }}</p>
                  {%- endunless -%}
                </div>
              </div>
            </slider-modal-opener>
          {% endunless %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- capture slider_modal_settings -%}
  {
    "slidesPerView": "auto",
    "mousewheel": {
      "enabled": true,
      "releaseOnEdges": true,
      "forceToAxis": true
    },
    "navigation": {
      "nextEl": ".ingredients-info-modal--{{ section.id }} .ingredients-info-modal__button--next",
      "prevEl": ".ingredients-info-modal--{{ section.id }} .ingredients-info-modal__button--previous"
    },
    "pagination": {
      "el": ".ingredients-info-modal--{{ section.id }} .ingredients-info-modal__pagination-element",
      "type": "fraction",
      "currentClass": "ingredients-info-modal__current",
      "totalClass": "ingredients-info-modal__total"
    }
  }
{%- endcapture -%}

{%- if has_ingredients -%}
  <slider-modal class="ingredients-info-modal ingredients-info-modal--{{ section.id }}" id="slider_modal_{{ section.id }}">
    <div class="ingredients-info-modal__inner">
      <div
        class="swiper ingredients-info-modal__slider"
        {%- render 'slider-attribute', config: slider_modal_settings, is_observable: false -%}
      >
        <div class="swiper-wrapper">
          {%- assign blocks_amount = 0 -%}
          {%- for block in section.blocks -%}
            {%- unless block.settings.metaobject_handle == blank or block.settings.metaobject_type == blank -%}
              {%- assign ingredient_metaobject = metaobjects[block.settings.metaobject_type][block.settings.metaobject_handle] -%}
              {%- if ingredient_metaobject -%}
                {%- assign blocks_amount = blocks_amount | plus: 1 -%}
                <div class="swiper-slide ingredients-info-modal__slide">
                  {%- render 'ingredient-popup-info', ingredient: ingredient_metaobject -%}
                </div>
              {% endif %}
            {% endunless %}
          {%- endfor -%}
        </div>
      </div>
      <div class="ingredients-info-modal__footer">
        <div class="ingredients-info-modal__navigation">
          <div class="ingredients-info-modal__button--previous">
            {%- render 'icon', icon: 'slider-arrow-prev' -%}
          </div>
          <div class="ingredients-info-modal__button--next">
            {%- render 'icon', icon: 'slider-arrow-next' -%}
          </div>
        </div>
        <div class="ingredients-info-modal__pagination" style="--conjunction: '{{ 'ingredients.conjunction' | t }} '">
          {{ 'ingredients.ingredient_slider_fraction_html' | t }}
        </div>
      </div>
    </div>
  </slider-modal>
{%- endif -%}

{% schema %}
{
  "name": "FAQ with ingredients",
  "tag": "section",
  "settings": [
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ECF1F4"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Sorgfältig ausgewählte <i>Inhaltsstoffe</i>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Gesunde Hormone benötigen eine kontinuierliche Versorgung mit essenziellen Nährstoffen und einen gesunden Lebensstil.</p><p>Aus diesem Grund haben wir monthlies entwickelt.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Alle 26 Nährstoffe anzeigen"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "name": "Ingredient",
      "type": "ingredient",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "metaobject_type",
          "label": "Metaobject type"
        },
        {
          "type": "text",
          "id": "metaobject_handle",
          "label": "Metaobject handle"
        },
        {
          "type": "textarea",
          "id": "custom_title",
          "label": "Custom title",
          "default": "Custom title"
        }
      ]
    },
    {
      "name": "Collapsible content",
      "type": "collapsible_content",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Content</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ with ingredients"
    }
  ]
}
{% endschema %}
