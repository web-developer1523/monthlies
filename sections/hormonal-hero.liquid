{% schema %}
  {
    "name": "hormonal-hero",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "label": "Title",
        "id": "title",
        "default": "Get to the root cause of your menstrual pain"
      }, 
       {
      "type": "image_picker",
      "id": "dynamic_hero_image",
      "label": "Hero Image"
    }
      ,{
        "type": "text",
        "label": "Text",
        "id": "text",
        "default": "Eliminate the guesswork and take control of your well-being with our at-home hormone saliva self-test with personalised recommendations to tackle any underlying issues."
      }, {
        "type": "text",
        "label": "Button",
        "id": "btn",
        "default": "Order now"
      },{
        "type": "text",
        "label": "Button",
        "id": "btn2",
        "default": "Take the Quiz"
      },{
        "type": "url",
        "label": "Button URL",
        "id": "btn_url"
      }, {
        "type": "text",
        "label": "Satisfaction",
        "id": "satisfaction",
        "default": "★★★★☆ 80% of customer satisfaction"
      }
    ],
    "presets": [
      {
        "name": "hormonal-hero"
      }
    ]
  }
{% endschema %}

<script>
  function clearCartAndCheckout(variantId) {
    $.ajax({
      type: 'POST',
      url: '/cart/clear.js',
      dataType: 'json',
      success: function() {
        addToCartAndCheckout(variantId);
      }
    });
  }

  function addToCartAndCheckout(variantId) {
    $.ajax({
      type: 'POST',
      url: '/cart/add.js',
      data: { quantity: 1, id: variantId },
      dataType: 'json',
      success: function() {
        window.location.href = '/checkout';
      }
    });
  }
</script>