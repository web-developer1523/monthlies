<div>
  <div class="devider-images">
    <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/girl-holding-box-cropped.png?v=1686300022" alt="girl-holding-box"/>
    <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/girl-holding-product-cropped.png?v=1686300023" alt="girl-holding-box"/>
    <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/girl-checking-out-product-cropped.png?v=1686300022" alt="girl-holding-box"/>
  </div>
  
  <div class="text-boxes">
    <div class="text-box text-box__left">
      <h3 class="h2">Not sure which products you need?</h3>
      <p class="text-white">Take our quiz we will find out exactly what fits your needs</p>
      <a href="{{ section.settings.url_2 }}" class="button button--medium cta-primary">{{ section.settings.label_2 }}</a>
    </div>
  
    <div class="text-box text-box__right">
      <h3 class="h2">Not sure which products you need?</h3>
      <p class="text-black">Take our quiz we will find out exactly what fits your needs</p>
      <a href="{{ section.settings.url_2 }}" class="button button--medium cta-primary">{{ section.settings.label_2 }}</a>
    </div>
  </div>
</div>


