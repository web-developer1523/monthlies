document.addEventListener('DOMContentLoaded', function() {
  var addToCartForms = document.querySelectorAll('.add-to-cart-form');

  addToCartForms.forEach(function(form) {
    form.addEventListener('submit', function(event) {
      event.preventDefault();
      var variantId = form.querySelector('.variant-id').innerHTML;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(
          {
            items: [
              {
                id: variantId,
                quantity: 1
              }
            ]
          }
        )
      }).then(async function(response) {
        document.querySelector(".product-added").classList.add("active");

        setTimeout(() => {
          document.querySelector(".product-added").classList.remove("active");
        }, "3000");
      }).catch(async function(error) {
        console.error(error);
      });
    });
  });
});
