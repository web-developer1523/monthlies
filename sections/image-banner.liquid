{%- style -%}
  #shopify-section-{{ section.id }}{
    --section-padding-top: {{ section.settings.padding_top }}
    px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}
    px;
    {%- if section.settings.image != blank or section.settings.image_2 != blank %}
      {%- assign section_image = section.settings.image | default: section.settings.image_2 -%}
      --image-ratio-percent: {{ 1 | divided_by: section_image.aspect_ratio | times: 100 }}
      %;
      --image-position: {{ section.settings.image_position }}
      ;
    {% endif -%}
    --color-overlay-opacity: {{ section.settings.colors_overlay_opacity | divided_by: 100.0 }}
    ;
    --color-overlay: {{ section.settings.colors_overlay.red }}
    , {{ section.settings.colors_overlay.green }}
    , {{ section.settings.colors_overlay.blue }}
    ;
    --color-foreground: {{ section.settings.colors_text.red }}
    , {{ section.settings.colors_text.green }}
    , {{ section.settings.colors_text.blue }}
    ;
    --color-link: var(--color-foreground);
    --color-border: var(--color-foreground);
    --color-heading: var(--color-foreground);
    --color-button-background: {{ section.settings.colors_button_background.red }}
    , {{ section.settings.colors_button_background.green }}
    , {{ section.settings.colors_button_background.blue }}
    ;
    --color-button-text: {{ section.settings.colors_button_label.red }}
    , {{ section.settings.colors_button_label.green }}
    , {{ section.settings.colors_button_label.blue }}
    ;
    --color-button-border: var(--color-button-background);
    --color-shadow: var(--color-foreground);
    --shadow-opacity: 0.3;
  }
{%- endstyle -%}

{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full-width{% endif %}">
    <div
      id="Banner-{{ section.id }} dd"
      class="{{ section.settings.custom_class }} banner{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.show_text_box %} banner--container{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}"
    >
      {% if section.settings.video != blank %}
        <div class="mobile banner__media banner__media-half">
          <div class="image-animate media media--650px media-mobile--auto">
            <video autoplay muted loop playsinline>
              <source src="{{ section.settings.video }}" type="video/mp4">
            </video>
          </div>
          <div class="second_img_banner_custom desktop">
            <video autoplay muted loop playsinline>
              <source src="{{ section.settings.video }}" type="video/mp4">
            </video>
          </div>
        </div>
      {% endif %}
      {%- if section.settings.mobile_image_one != blank -%}
        <div class="mobile banner__media{% if section.settings.image_2 != blank %} banner__media-half {% endif %}">
          {%- if section.settings.mobile_image_one != blank -%}
            <use-animate data-animate="zoom-fade" class="media-wrapper">
              <div class="image-animate media media--{{ section.settings.image_ratio }} media-mobile--{{ section.settings.mobile_image_ratio }}{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}">
                {% comment %}
                  {%-liquid
                    assign image = section.settings.mobile_image
                    assign image_class = 'image-fit'
                    if section.settings.image_2 != blank
                      assign image_class = image_class | append: ' banner__media-image-half'
                    endif
                    if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
                      assign sizes = '(min-width: 750px) 50vw, 100vw'
                    elsif section.settings.image_2 != blank
                      assign sizes = '50vw'
                    else
                      assign sizes = '100vw'
                    endif

                    echo image | image_url: width: 1500 | image_tag: loading: 'lazy', class: image_class, sizes: sizes, widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840', is: 'lazy-image'
                  -%}
                {% endcomment %}

                <img
                  data-class="LazyLoad" 
                  src="{{ section.settings.mobile_image_one | img_url: 'master' }}" 
                  data-src="{{ section.settings.mobile_image_one | img_url: '500' }}"
                  data-mob-src="{{ section.settings.mobile_image_one | img_url: '500' }}"
                  alt="Mobile Banner"
                  width="your-width"
                  height="your-height"
                >
              </div>
            </use-animate>
          {% endif %}
          <div class="second_img_banner_custom desktop">
            <img 
              data-class="LazyLoad" 
              src="{{ section.settings.bg-image | img_url: 'master' }}" 
              data-src="{{ section.settings.bg-image | img_url: '700' }}">
          </div>
        </div>

      {%- elsif section.settings.image_2 == blank -%}
        <div class="banner__media desktop">
          <use-animate
            data-animate="zoom-fade"
            class="media media--{{ section.settings.image_ratio }} media-mobile--{{ section.settings.mobile_image_ratio }}"
          >
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder image-animate' }}
          </use-animate>
        </div>
      {%- endif -%}

      {%- if section.settings.image_2 != blank -%}
        <div class="desktop banner__media{% if section.settings.image != blank %} banner__media-half{% endif %}">
          <use-animate data-animate="zoom-fade" class="media-wrapper">
            <div class="image-animate media media--{{ section.settings.image_ratio }} media-mobile--{{ section.settings.mobile_image_ratio }}">
              {%- liquid
                assign image_2nd = section.settings.image_2
                assign image_class_2nd = 'image-fit'
                if section.settings.image != blank
                  assign image_class_2nd = image_class_2nd | append: ' banner__media-image-half'
                endif
                if section.settings.image != blank and section.settings.stack_images_on_mobile
                  assign sizes_2nd = '(min-width: 750px) 50vw, 100vw'
                elsif section.settings.image != blank
                  assign sizes_2nd = '50vw'
                else
                  assign sizes_2nd = '100vw'
                endif

                echo image_2nd | image_url: width: 1500 | image_tag: loading: 'lazy', class: image_class_2nd, sizes: sizes_2nd, widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840', is: 'lazy-image'
              -%}
            </div>
          </use-animate>
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="banner__content banner__content--{{ section.settings.text_box_position }} page-width">
          <div class="banner__box {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  <{{ block.settings.heading_tag }}
                    class="banner__heading  {{ block.settings.heading_size }} black-heading"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.heading -}}
                  </{{ block.settings.heading_tag }}>
                {%- when 'subheading' -%}
                  <p
                    class="banner__subheading{% if block.settings.secondary_color %} banner__subheading--colored{% endif %} {{ block.settings.subheading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.subheading | escape }}
                  </p>
                {%- when 'text' -%}
                  <div
                    class="banner__text{% if block.settings.secondary_color %} banner__text--colored{% endif %} {{ block.settings.text_size }} rte"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>
                {%- when 'custom_liquid' -%}
                  <div class="banner__text rte" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank %}
                    <div class="button_for_bg">
                      {%- if block.settings.button_label != blank %}
                        <a
                          class="button button--{{ block.settings.button_size }} cta-secondary"
                          target="_blank"
                          {% if block.settings.button_link != blank %}
                            href="{{ block.settings.button_link }}"
                          {% else %}
                            role="link"aria-disabled="true"
                          {% endif %}
                          {{ block.shopify_attributes }}
                        >
                          {{ block.settings.button_label }}
                        </a>
                      {% endif %}
                      {%- if block.settings.button_label != blank %}
                        <a
                          class="personalize-app button button--{{ block.settings.button_size }} cta-secondary"
                          {% comment %} target="_blank" {% endcomment %}
                          {% if block.settings.button_link1 != blank %}
                            href="{{ block.settings.button_link1 }}"
                          {% else %}
                            role="link"aria-disabled="true"
                          {% endif %}
                          {{ block.shopify_attributes }}
                        >
                          {{ block.settings.button_label1 }}
                        </a>
                      {% endif %}
                    </div>
                  {% else %}
                    {%- if block.settings.button_style_secondary -%}
                      <a
                        class="button button--cta button--{{ block.settings.button_size }}"
                        target="_blank"
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link"aria-disabled="true"
                        {% endif %}
                        {{ block.shopify_attributes }}
                      >
                        <span class="label">{{ block.settings.button_label | escape }}</span>
                        {% render 'icon', icon: 'arrow' %}
                      </a>
                    {%- else -%}
                      <a
                        class="button button--{{ block.settings.button_size }} cta-secondary"
                        target="_blank"
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link"aria-disabled="true"
                        {% endif %}
                        {{ block.shopify_attributes }}
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}
                  {%- elsif section.blocks.size == 1 and block.settings.button_link != blank -%}
                    </div>
                    <div>
                      <a
                        class="full-unstyled-link"
                        href="{{ block.settings.button_link }}"
                        {{ block.shopify_attributes }}
                      ></a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
  <div class="size_popup" style="display:none;">
    <div class="inner_div">
      <p class="close_popup">X</p>
      <script type="lazyload_js" data-src="https://static.elfsight.com/platform/platform.js" data-use-service-core ></script>
      <div class="elfsight-app-5a1b257b-8450-4b8d-a98f-1bb35b5072ba" data-elfsight-app-lazy></div>
    </div>
  </div>
</div>
<style>
  .backgrond_class.banner .banner__media-half {
    width: initial;
    flex-basis: 50%;
}
  @media screen and (min-width: 989px) {
    .backgrond_class.banner .banner__media {
        width: 50%;
    }
}
</style>
