<!-- jQuery (required for Slick Slider) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Slick Slider JS -->
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<script>
$(document).ready(function(){
// Initialize Slick Slider only on mobile/tablet
function initSlider() {
if ($(window).width() <= 1024) {
if (!$('.ingredients-cards').hasClass('slick-initialized')) {
$('.ingredients-cards').slick({
  dots: false,
  infinite: false, // 🔴 third slide avoid karne ke liye
  speed: 300,
  slidesToShow: 3,
  slidesToScroll: 1,
  autoplay: false,
  arrows: false,
  centerMode: false,
  adaptiveHeight: false,

  responsive: [
    {
      breakpoint: 768,
      settings: {
        slidesToShow: 2
      }
    },
    {
      breakpoint: 575, // 320–575
      settings: {
        slidesToShow: 1.5,
        slidesToScroll: 1,
        centerMode: false
      }
    }
  ]
});
}
} else {
if ($('.ingredients-cards').hasClass('slick-initialized')) {
$('.ingredients-cards').slick('unslick');
}
}
}

// Initialize on load
initSlider();

// Reinitialize on resize
$(window).on('resize', function(){
initSlider();
});
});
</script>
<style>
* {
margin: 0;
padding: 0;
box-sizing: border-box;
}

.drincard-wrapper {
font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
}

.drincard-wrapper .ingredients-section {
max-width: 1400px;
margin: 0 auto;
padding: 80px 60px;
background-color: #ffffff;
}

.drincard-wrapper .ingredients-header {
text-align: center;
margin-bottom: 32px;
}

.drincard-wrapper .ingredients-title {
font-size: 40px;
font-weight: 600;
color: #404040;
margin-bottom: 20px;
letter-spacing: -0.5px;
line-height: 1.2;
}

.drincard-wrapper .ingredients-description {
font-size: 19px;
color: #404040;
line-height: 1.6;
max-width: 800px;
margin: 0 auto;
font-weight: 400;
}

.drincard-wrapper .ingredients-cards {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 24px;
margin-bottom: 48px;
}

.drincard-wrapper .ingredient-card {
background: #ffffff;
border-radius: 16px;
overflow: hidden;
box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
transition: transform 0.3s ease, box-shadow 0.3s ease;
position: relative;
margin: 10px 0;
}

.drincard-wrapper .ingredient-card:hover {
transform: translateY(-4px);
box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
}

.card-image-wrapper {
position: relative;
width: 100%;
height: 250px;
overflow: hidden;
background: #f5f5f5;
}

.drincard-wrapper .card-image {
width: 100%;
height: 100%;
object-fit: cover;
object-position: center;
}

.card-plus-button {
position: absolute;
top: 16px;
right: 16px;
width: 40px;
height: 40px;
background: transparent;
border-radius: 0;
display: flex;
align-items: center;
justify-content: center;
cursor: pointer;
box-shadow: none;
transition: transform 0.2s ease;
z-index: 2;
text-decoration: none;
border: none;
padding: 0;
}

.drincard-wrapper .card-plus-button:hover {
transform: scale(1.05);
}

.card-plus-icon {
width: 48px;
height: 48px;
object-fit: contain;
display: block;
}

.drincard-wrapper .card-content {
padding: 20px 10px;
}

.drincard-wrapper .card-label {
font-size: 12px;
font-weight: 600;
color: #4A4A68;
text-transform: uppercase;
letter-spacing: 0.5px;
margin-bottom: 8px;
}

.drincard-wrapper .card-benefit {
font-size: 24px;
font-weight: 600;
color: #404040;
line-height: 1.3;
font-family: 'Lora';
}

.drincard-wrapper .ingredients-cta {
text-align: center;
margin-top: 48px;
}

.drincard-wrapper .cta-button {
display: inline-block;
padding: 14px 32px;
background: #ffffff;
color: #CB342C;
border: 2px solid #CB342C;
border-radius: 40px;
font-size: 16px;
font-weight: 600;
text-decoration: none;
transition: all 0.3s 
ease;
letter-spacing: 0.3px;
}

.drincard-wrapper .cta-button:hover {
background: #CB342C;
color: #ffffff;
}

/* Slick Slider Styles */
.drincard-wrapper .ingredients-cards.slick-slider {
margin-bottom: 48px;
}

.drincard-wrapper .ingredients-cards .slick-list {
margin: 0 -12px;
padding: 10px 0 !important;
overflow: hidden;
}

.drincard-wrapper .ingredients-cards .slick-track {
overflow: visible;
  display: flex;
}

.drincard-wrapper .ingredients-cards .slick-slide {
  padding-right: 16px;
}

.drincard-wrapper .ingredients-cards .slick-slide > div {
overflow: visible;
}

.drincard-wrapper .ingredients-cards .slick-dots {
bottom: -40px;
}

.drincard-wrapper .ingredients-cards .slick-dots li button:before {
font-size: 12px;
color: #CB342C;
opacity: 0.3;
}

.drincard-wrapper .ingredients-cards .slick-dots li.slick-active button:before {
opacity: 1;
color: #CB342C;
}

.drincard-wrapper .ingredients-cards .slick-prev,
.drincard-wrapper .ingredients-cards .slick-next {
width: 40px;
height: 40px;
z-index: 10;
}

.drincard-wrapper .ingredients-cards .slick-prev {
left: -50px;
}

.drincard-wrapper .ingredients-cards .slick-next {
right: -50px;
}

.drincard-wrapper .ingredients-cards .slick-prev:before,
.drincard-wrapper .ingredients-cards .slick-next:before {
font-size: 40px;
color: #CB342C;
opacity: 0.8;
}

.drincard-wrapper .ingredients-cards .slick-prev:hover:before,
.drincard-wrapper .ingredients-cards .slick-next:hover:before {
opacity: 1;
}

/* Responsive Design */
@media (max-width: 1200px) {
.drincard-wrapper .ingredients-section{
padding: 80px 20px;
}
}
@media (max-width: 1200px) {
.drincard-wrapper .ingredients-section{
padding: 60px 20px;
}

.drincard-wrapper .ingredients-cards .slick-prev {
left: -40px;
}

.drincard-wrapper .ingredients-cards .slick-next {
right: -40px;
}

}

@media (max-width: 1024px) {
.drincard-wrapper .ingredients-cards .slick-slide {
padding: 0;
margin: 0 10px;
}

.drincard-wrapper .ingredients-title {
font-size: 28px;
}

.drincard-wrapper .ingredients-description {
font-size: 17px;
}

.drincard-wrapper .ingredients-cards {
display: block;
}

.drincard-wrapper .ingredient-card {
margin-bottom: 0;
}

.card-image-wrapper {
height: 260px;
}

.drincard-wrapper .ingredients-cards .slick-prev {
left: -30px;
}

.drincard-wrapper .ingredients-cards .slick-next {
right: -30px;
}
}

@media (max-width: 991px) {
.ingredients-section  .slick-track
{
display: flex !important;
}

.ingredients-section .slick-slide
{
height: inherit !important;
}
}
@media (max-width: 768px) {
.drincard-wrapper .ingredients-section {
padding: 50px 20px;
}

.drincard-wrapper .ingredients-title {
font-size: 25px;
margin-bottom: 16px;
}

.drincard-wrapper .ingredients-description {
font-size: 16px;
margin-bottom: 32px;
}

.card-image-wrapper {
height: 240px;
}

.card-content {
padding: 16px 10px;
}

.card-label {
font-size: 11px;
}


.ingredients-cards .slick-prev,
.ingredients-cards .slick-next {
display: none !important;
}

.ingredients-cards .slick-dots {
bottom: -32px;
}
.drincard-wrapper .card-benefit {
font-size: 16px;
}
.drincard-wrapper .cta-button {
font-size: 15px;
padding: 12px 28px;
}
}

@media (max-width: 575px) {
  .drincard-wrapper .ingredients-header{
  padding:0 20px;
  }
.drincard-wrapper .cta-button {
font-size: 16px;
        padding: 6px 11px;
}
.drincard-wrapper .ingredients-section {
padding: 40px 0;
}

.drincard-wrapper .ingredients-cards .slick-list {
margin: 0;
}

        .drincard-wrapper .ingredients-cards .slick-slide {
        padding: 0;
        opacity: 1;
    }
}

@media (max-width: 480px) {
    .drincard-wrapper .cta-button {
        padding: 2px 6px;
        max-width: 335px;
    }
.drincard-wrapper .ingredients-title {
font-size: 24px;
margin-bottom: 12px;
}

.drincard-wrapper .ingredients-description {
font-size: 16px;
margin-bottom: 28px;
}

.card-image-wrapper {
height: 220px;
}

.card-plus-button {
width: 36px;
height: 36px;
top: 12px;
right: 12px;
}

.card-plus-icon {
width: 40px;
height: 40px;
}

.card-content {
padding: 14px 8px;
}

.card-label {
font-size: 10px;
margin-bottom: 6px;
}



.ingredients-cta {
margin-top: 40px;
}

.cta-button {
font-size: 14px;
padding: 10px 24px;
}
}

/* Hide slider on desktop, show grid */
@media (min-width: 1025px) {
.drincard-wrapper .ingredients-cards.slick-initialized {
display: grid !important;
}

.drincard-wrapper .ingredients-cards.slick-initialized .slick-list,
.drincard-wrapper .ingredients-cards.slick-initialized .slick-track {
display: contents !important;
}

.drincard-wrapper .ingredients-cards.slick-initialized .slick-slide {
padding: 0;
}

.drincard-wrapper .ingredients-cards .slick-dots,
.drincard-wrapper .ingredients-cards .slick-prev,
.drincard-wrapper .ingredients-cards .slick-next {
display: none !important;
}
}
</style>
