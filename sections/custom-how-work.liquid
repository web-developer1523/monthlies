  $(document).ready(function() {
  var swiper;

  function initSwiper() {
    if ($(window).width() < 990) {
      if (!swiper) {  // Initialize Swiper if it does not exist
        swiper = new Swiper('.swiper-container_how', {
          slidesPerView: 'auto', 
          spaceBetween: 16, // Adjust space between slides if needed
          navigation: {
            nextEl: '.swiper-supl-button-nexts',
            prevEl: '.swiper-supl-button-prev',
          },
          breakpoints: {
            768: {  // Example breakpoint for smaller screens
              slidesPerView: 'auto',
              spaceBetween: 16,
            }
          }
        });
      }
    } else {
      if (swiper) {  // Destroy Swiper if it exists and screen width is >= 990
        swiper.destroy(true, true);
        swiper = null;
      }
    }
  }

  // Initialize Swiper on page load
  initSwiper();

  // Re-initialize Swiper on window resize
  $(window).resize(function() {
    initSwiper();
  });
});

</script>
