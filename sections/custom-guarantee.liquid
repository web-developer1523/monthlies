{%- if section.settings.main_image != blank -%}
  {{ 'section-guarantee-banner.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign title = section.settings.title
    assign highlight_text = section.settings.highlight_text
    assign description = section.settings.description
    assign badge_image = section.settings.badge_image
    assign main_image = section.settings.main_image
    assign button_label = section.settings.button_label
    assign button_link = section.settings.button_link | default: '#'
    assign text_color_main = section.settings.main_text_color | default: '#333333'
    assign accent_color = section.settings.accent_color | default: '#b35e4d'
    assign accent_background = section.settings.accent_background_color | default: '#4a3a33'
  -%}

  {% render 'section-paddings',
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom,
    padding_top_mobile: section.settings.padding_top_mobile,
    padding_bottom_mobile: section.settings.padding_bottom_mobile
  %}

  <section
    class="guarantee-banner guarantee-banner--{{ section.id }} section-{{ section.id }}--padding"
    style="
      --background-accent: {{ accent_background }};
      --text-color-main: {{ text_color_main }};
      --accent-color: {{ accent_color }};
    "
  >
    <div class="guarantee-banner__container page-width">
        <div class="guarantee-banner__grid">
          <div class="guarantee-banner__card">
            <div class="guarantee-banner__text-content">
              <div class="guarantee-banner__content-header">
                {%- if title != blank -%}
                  <div class="guarantee-banner__title-container">
                    <h2 class="guarantee-banner__title">{{ title }}</h2>
                    {%- if highlight_text != blank -%}
                      <h3 class="guarantee-banner__highlight">{{ highlight_text }}</h3>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if badge_image != blank -%}
                  <div class="guarantee-banner__badge">
                    {{ badge_image | image_url: width: 240 | image_tag: loading: 'lazy' }}
                  </div>
                {%- endif -%}
              </div>

              {%- if description != blank -%}
                <div class="guarantee-banner__description">
                  {{ description }}
                </div>
              {%- endif -%}

              {%- if button_label != blank -%}
                <a href="{{ button_link }}" class="guarantee-banner__button">
                  {{ button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>

          <div class="guarantee-banner__image-side">
            {{ main_image | image_url: width: 1200 | image_tag:
              class: 'guarantee-banner__image',
              loading: 'lazy',
              widths: '375, 550, 750, 1100',
              sizes: '(max-width: 768px) 100vw, 50vw'
            }}
          </div>
        </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Guarantee Banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Unsere 90 Tage Geld-zurück-Garantie"
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight Text",
      "default": "- ohne wenn uns aber!"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Teste unser Produkt 90 Tage lang ganz ohne Risiko </p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Details zur Geld-zurück-Garantie"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Guarantee Badge"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "main_text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Highlight)",
      "default": "#b35e4d"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Padding Top (Desktop)",
        "default": 60
    },
    {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Padding Bottom (Desktop)",
        "default": 60
    },
    {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top (Mobile)",
        "default": 40
    },
    {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Padding Bottom (Mobile)",
        "default": 40
    }
  ],
  "presets": [
    {
      "name": "Guarantee Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}