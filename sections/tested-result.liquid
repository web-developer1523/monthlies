{{ 'tested-result.css' | asset_url | stylesheet_tag: preload: true }}
<section class="problem-section {{section.settings.custom_class }}" >
    <div class="container-fluid">
      <h1 class="main-title">{{ section.settings.heading }}</h1>
      <div class="quote">
        {{ section.settings.description }}
      </div>
     <div class="testing-bg">
      <div class="triggers">
        {% for block in section.blocks %}
          {% case block.type %}
            {%- when 'problem' -%}
              <div class="trigger-card">
                <div class="icon_idn">
                  {{ block.settings.problem_heading }}
                </div>
           
                <div class="cst-problem-flex">
                  {{ block.settings.problem_text }}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
      <div class="bg-image-container"><img src="{{ section.settings.image | img_url: 'master' }}" alt="">
    <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Group_513902.svg?v=1759501274">
        </div>
    </div>
    </div>
  </section>
  
  <style>
 
</style>
  
  {% schema %}
  {
      "name": "Tested Result",
      "class": "cst-other-problem",
      "settings": [
          {
              "type": "text",
              "id": "custom_class",
              "label": "Custom class"
          },
          {
              "type": "richtext",
              "id": "heading",
              "label": "Heading"
          },
          {
              "type": "richtext",
              "id": "description",
              "label": "Description"
          },
          {
              "type": "richtext",
              "id": "paragraph",
              "label": "Paragraph"
          },
          {
              "type": "image_picker",
              "id": "image",
              "label": "Background Image"
          }
      ],
      "blocks": [
          {
              "type": "problem",
              "name": "Add",
              "settings": [
                  {
                      "type": "richtext",
                      "id": "problem_heading",
                      "label": "Percentage"
                  },
                  {
                      "type": "richtext",
                      "id": "problem_text",
                      "label": "Text"
                  }
              ]
          }
      ],
      "presets": [
          {
              "name": "Tested Result"
          }
      ]
  }
  {% endschema %}
  