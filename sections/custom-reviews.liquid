{% if section.blocks.size > 0 %}
 {{ 'section-custom-reviews.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign background_color = section.settings.background_color
    assign text_color = section.settings.text_color
    assign highlight_color = section.settings.highlight_color
    assign heading = section.settings.heading
  -%}

  {% render 'section-paddings',
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom,
    padding_top_mobile: section.settings.padding_top_mobile,
    padding_bottom_mobile: section.settings.padding_bottom_mobile
  %}

  {% capture slider_config %}
    {
      "loop": false,
      "slidesPerView": 1.1,
      "spaceBetween": 18,
      "speed": 450,
      "grabCursor": true,
      "watchSlidesProgress": true,
      "navigation": {
        "nextEl": ".reviews-slider__button--next",
        "prevEl": ".reviews-slider__button--prev"
      },
      "breakpoints": {
        "600": { "slidesPerView": 2 },
        "1024": { "slidesPerView": 3, "spaceBetween": 24 },
        "1440": { "slidesPerView": 4 }
      }
    }
  {% endcapture %}

  <div
    class="reviews-slider section-{{ section.id }} section-{{ section.id }}--padding"
    data-section-id="{{ section.id }}"
    data-reviews-slider-wrapper
    style="
      --background-color: {{ background_color }};
      --text-color: {{ text_color }};
      --highlight-color: {{ highlight_color }};
    "
  >
    <div class="reviews-slider__header page-width">
      {%- if heading != blank -%}
          <h2 class="reviews-slider__heading">
            {{ section.settings.heading }}
          </h2>
      {%- endif -%}

      <div class="reviews-slider__navigation">
        <button class="reviews-slider__button reviews-slider__button--prev" type="button" data-reviews-prev aria-label="Previous slide">
          {% render 'icons', name: 'slider_arrow' %}
        </button>
        <button class="reviews-slider__button reviews-slider__button--next" type="button" data-reviews-next aria-label="Next slide">
          {% render 'icons', name: 'slider_arrow' %}
        </button>
      </div>
    </div>

    <div class="reviews-slider__shadow-wrapper page-width">
      <div class="reviews-slider__swiper swiper" {%- render 'slider-attribute', config: slider_config, is_mobile_only: false, is_observable: true -%}>
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign slide_image = block.settings.slide_image
              assign author = block.settings.author
              assign text = block.settings.text
              assign stars = block.settings.stars
            -%}

            <div class="reviews-slider__slide swiper-slide" {{ block.shopify_attributes }}>
              {%- if slide_image != blank -%}
                <div class="reviews-slider__image-container">
                  {{ slide_image | image_url: width: 800 | image_tag:
                    class: 'reviews-slider__image',
                    loading: 'lazy',
                    widths: '400, 600, 800'
                  }}
                </div>
              {%- endif -%}

              <div class="reviews-slider__content">
                {%- if stars > 0 or author != blank -%}
                  <div class="reviews-slider__author-info">
                    {%- if stars > 0 -%}
                      <div class="reviews-slider__stars" aria-label="{{ stars }} stars">
                        {%- for i in (1..stars) -%}
                          {% render 'icons', name: 'rating_star' %}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}

                    {%- if author != blank -%}
                      <div class="reviews-slider__author-name">{{ author }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if text != blank -%}
                  <div class="reviews-slider__text">
                    {{ text }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Reviews slider",
  "tag": "section",
  "limit": 1,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What our <em>customers</em> say"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#CB342C"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "richtext",
          "id": "author",
          "label": "Author",
          "default": "<p>John Doe</p>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>This product is amazing. Highly recommended!</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews slider",
      "category": "Custom",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}