{{ 'section-new-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-rating-bar.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-media-slider.css' | asset_url | stylesheet_tag }}

{% render 'section-paddings',
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

{%- liquid
  assign flavor_blocks = section.blocks | where: 'type', 'flavor'
  assign guarantee_blocks = section.blocks | where: 'type', 'guarantee'
  assign rendered_flavors = false
  assign rendered_guarantees = false
  
-%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
<section
  class="new-main-product section-{{ section.id }}--padding"
  data-new-main-product
  data-cart-clear-url="{{ routes.cart_clear_url }}.js"
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-cart-update-url="{{ routes.cart_update_url | default: '/cart/update' }}.js"
  data-cart-url="{{ routes.cart_url }}"
>
  <div class="new-main-product__wrapper page-width">
    <div class="new-main-product__grid">
      <div class="new-main-product__gallery">
        <div class="new-main-product__gallery-sticky">
          {% render 'media-slider' %}
        </div>
      </div>
      <div class="new-main-product__content">
        <div class="new-main-product__content-inner">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  {%- if block.settings.heading_text != blank -%}
                    {%- capture heading_style -%}
                      --new-main-product-heading-color: {{ block.settings.heading_color }};
                      --new-main-product-heading-size: {{ block.settings.heading_size }}px;
                      --new-main-product-heading-size-mobile: {{ block.settings.heading_size_mobile }}px;
                      --new-main-product-heading-padding-top: {{ block.settings.heading_padding_top }}px;
                      --new-main-product-heading-padding-bottom: {{ block.settings.heading_padding_bottom }}px;
                      --new-main-product-heading-padding-top-mobile: {{ block.settings.heading_padding_top_mobile }}px;
                      --new-main-product-heading-padding-bottom-mobile: {{ block.settings.heading_padding_bottom_mobile }}px;
                    {%- endcapture -%}
                    <div
                      class="new-main-product__heading-block"
                      style="{{ heading_style | strip_newlines }}"
                      {{ block.shopify_attributes }}
                    >
                      <h2 class="new-main-product__heading">{{ block.settings.heading_text | escape }}</h2>
                    </div>
                  {%- endif -%}
                {%- when 'text' -%}
                  {%- if block.settings.text_content != blank -%}
                    {%- capture text_style -%}
                      --new-main-product-text-color: {{ block.settings.text_color }};
                      --new-main-product-text-size: {{ block.settings.text_size }}px;
                      --new-main-product-text-size-mobile: {{ block.settings.text_size_mobile }}px;
                      --new-main-product-text-padding-top: {{ block.settings.text_padding_top }}px;
                      --new-main-product-text-padding-bottom: {{ block.settings.text_padding_bottom }}px;
                      --new-main-product-text-padding-top-mobile: {{ block.settings.text_padding_top_mobile }}px;
                      --new-main-product-text-padding-bottom-mobile: {{ block.settings.text_padding_bottom_mobile }}px;
                    {%- endcapture -%}
                    <div
                      class="new-main-product__text-block"
                      style="{{ text_style | strip_newlines }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="new-main-product__text">{{ block.settings.text_content }}</div>
                    </div>
                  {%- endif -%}
                {%- when 'benefits' -%}
                  {%- liquid
                    assign benefits = blank
                    if product != blank and product.metafields.custom.benefits != blank
                      assign benefits = product.metafields.custom.benefits.value
                    endif
                  -%}
                  {%- if benefits != blank -%}
                    {%- capture benefits_style -%}
                      --new-main-product-benefits-text-color: {{ block.settings.text_color }};
                      --new-main-product-benefits-text-size: {{ block.settings.text_size }}px;
                      --new-main-product-benefits-text-size-mobile: {{ block.settings.text_size_mobile }}px;
                      --new-main-product-benefits-padding-top: {{ block.settings.padding_top }}px;
                      --new-main-product-benefits-padding-bottom: {{ block.settings.padding_bottom }}px;
                      --new-main-product-benefits-padding-top-mobile: {{ block.settings.padding_top_mobile }}px;
                      --new-main-product-benefits-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;
                    {%- endcapture -%}
                    <div
                      class="new-main-product__benefits"
                      style="{{ benefits_style | strip_newlines }}"
                      {{ block.shopify_attributes }}
                    >
                      <ul class="new-main-product__benefits-list" role="list">
                        {%- for benefit in benefits -%}
                          <li class="new-main-product__benefits-item">
                            <span class="new-main-product__benefits-icon">
                              {%- if benefit.icon != blank -%}
                                {{
                                  benefit.icon
                                  | image_url: width: 120
                                  | image_tag:
                                    class: 'new-main-product__benefits-icon-image',
                                    loading: 'lazy'
                                }}
                              {%- else -%}
                                <span class="new-main-product__benefits-icon-placeholder" aria-hidden="true"></span>
                              {%- endif -%}
                            </span>
                            <span class="new-main-product__benefits-text">
                              {{ benefit.text | escape }}
                            </span>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                {%- when 'benefit_item' -%}
                  {%- if block.settings.text != blank or block.settings.icon != blank -%}
                    {%- capture benefit_item_style -%}
                      --new-main-product-benefit-item-text-color: {{ block.settings.text_color }};
                      --new-main-product-benefit-item-text-strong-color: {{ block.settings.text_strong_color }};
                      --new-main-product-benefit-item-text-size: {{ block.settings.text_size }}px;
                      --new-main-product-benefit-item-text-size-mobile: {{ block.settings.text_size_mobile }}px;
                      --new-main-product-benefit-item-text-line-height: {{ block.settings.text_line_height }}%;
                      --new-main-product-benefit-item-text-weight: {{ block.settings.text_weight }};
                    {%- endcapture -%}
                    <div
                      class="new-main-product__benefit-item{% if block.settings.icon != blank %} has-media{% endif %}"
                      style="{{ benefit_item_style | strip_newlines }}"
                      {{ block.shopify_attributes }}
                    >
                      {%- if block.settings.icon != blank -%}
                        <span class="new-main-product__benefit-item-media">
                          {{
                            block.settings.icon
                            | image_url: width: 120
                            | image_tag:
                              class: 'new-main-product__benefit-item-icon',
                              loading: 'lazy',
                              sizes: '56px',
                              widths: '40, 56, 72, 96, 120',
                              alt: block.settings.icon.alt
                          }}
                        </span>
                      {%- endif -%}
                      <div class="new-main-product__benefit-item-text">
                        {{ block.settings.text }}
                      </div>
                    </div>
                  {%- endif -%}
                {%- when 'faq_item' -%}
                  {%- if block.settings.question_text != blank -%}
                    {%- capture faq_style -%}
                      --new-main-product-faq-question-color: {{ block.settings.question_color }};
                      --new-main-product-faq-question-size: {{ block.settings.question_size }}px;
                      --new-main-product-faq-question-size-mobile: {{ block.settings.question_size_mobile }}px;
                      --new-main-product-faq-question-weight: {{ block.settings.question_weight }};
                      --new-main-product-faq-question-line-height: {{ block.settings.question_line_height }}%;
                      --new-main-product-faq-answer-color: {{ block.settings.answer_color }};
                      --new-main-product-faq-answer-size: {{ block.settings.answer_size }}px;
                      --new-main-product-faq-answer-size-mobile: {{ block.settings.answer_size_mobile }}px;
                      --new-main-product-faq-answer-weight: {{ block.settings.answer_weight }};
                      --new-main-product-faq-answer-line-height: {{ block.settings.answer_line_height }}%;
                      --new-main-product-faq-border-color: {{ block.settings.border_color }};
                      --new-main-product-faq-bg: {{ block.settings.background_color }};
                      --new-main-product-faq-radius: {{ block.settings.radius }}px;
                      --new-main-product-faq-icon-color: {{ block.settings.icon_color }};
                    {%- endcapture -%}
                    <details
                      class="new-main-product__faq-item"
                      style="{{ faq_style | strip_newlines }}"
                      {{ block.shopify_attributes }}
                      {% if block.settings.open_by_default %}
                        open
                      {% endif %}
                    >
                      <summary class="new-main-product__faq-summary">
                        <span class="new-main-product__faq-question">
                          {{ block.settings.question_text | escape }}
                        </span>
                        <span class="new-main-product__faq-icon" aria-hidden="true">
                          {% render "icon-arrow-down" %}
                        </span>
                      </summary>
                      {%- if block.settings.answer_text != blank -%}
                        <div class="new-main-product__faq-content">
                          {{ block.settings.answer_text }}
                        </div>
                      {%- endif -%}
                    </details>
                  {%- endif -%}
                {%- when 'flavor' -%}
                  {%- if rendered_flavors == false and flavor_blocks.size > 0 -%}
                    {%- assign rendered_flavors = true -%}
                    {%- assign flavor_group_block = flavor_blocks.first -%}
                    {%- capture flavor_group_style -%}
                      --new-main-product-flavor-group-padding-top: {{ flavor_group_block.settings.group_padding_top }}px;
                      --new-main-product-flavor-group-padding-bottom: {{ flavor_group_block.settings.group_padding_bottom }}px;
                      --new-main-product-flavor-group-padding-top-mobile: {{ flavor_group_block.settings.group_padding_top_mobile }}px;
                      --new-main-product-flavor-group-padding-bottom-mobile: {{ flavor_group_block.settings.group_padding_bottom_mobile }}px;
                    {%- endcapture -%}
                    <div
                      class="new-main-product__flavors"
                      style="{{ flavor_group_style | strip_newlines }}"
                      {{ block.shopify_attributes }}
                    >
                      {%- unless block.settings.flavor_heading == blank -%}
                        <div class="new-main-product__flavors-heading">
                          {{ block.settings.flavor_heading }}
                        </div>
                      {%- endunless -%}
                      <div class="new-main-product__flavors-list">
                        {%- for flavor_block in flavor_blocks -%}
                          {%- capture flavor_style -%}
                            --new-main-product-flavor-bg: {{ flavor_block.settings.background_color }};
                            --new-main-product-flavor-border-color: {{ flavor_block.settings.border_color }};
                            --new-main-product-flavor-border-width: {{ flavor_block.settings.border_width }}px;
                            --new-main-product-flavor-title-color: {{ flavor_block.settings.title_color }};
                            --new-main-product-flavor-title-size: {{ flavor_block.settings.title_size }}px;
                            --new-main-product-flavor-title-size-mobile: {{ flavor_block.settings.title_size_mobile }}px;
                            --new-main-product-flavor-text-color: {{ flavor_block.settings.text_color }};
                            --new-main-product-flavor-text-size: {{ flavor_block.settings.text_size }}px;
                            --new-main-product-flavor-text-size-mobile: {{ flavor_block.settings.text_size_mobile }}px;
                          {%- endcapture -%}
                          <div
                            class="new-main-product__flavor-card"
                            style="{{ flavor_style | strip_newlines }}"
                            {{ flavor_block.shopify_attributes }}
                          >
                            <div class="new-main-product__flavor-media">
                              {%- if flavor_block.settings.image != blank -%}
                                {{
                                  flavor_block.settings.image
                                  | image_url: width: 160
                                  | image_tag:
                                    class: 'new-main-product__flavor-image',
                                    loading: 'lazy',
                                    sizes: '56px',
                                    widths: '60, 80, 120, 160',
                                    alt: flavor_block.settings.image.alt
                                }}
                              {%- else -%}
                                {{ 'image' | placeholder_svg_tag: 'new-main-product__flavor-image new-main-product__flavor-image--placeholder' }}
                              {%- endif -%}
                            </div>
                            {%- if flavor_block.settings.title_text != blank or flavor_block.settings.description_text != blank  -%}
                              <div class="new-main-product__flavor-body">
                                {%- if flavor_block.settings.title_text != blank -%}
                                  <div class="new-main-product__flavor-title">
                                    {{ flavor_block.settings.title_text | escape }}
                                  </div>
                                {%- endif -%}
                                {%- if flavor_block.settings.description_text != blank -%}
                                  <div class="new-main-product__flavor-text">
                                    {{ flavor_block.settings.description_text | escape }}
                                  </div>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- when 'guarantee' -%}
                  {%- if rendered_guarantees == false and guarantee_blocks.size > 0 -%}
                    {%- assign rendered_guarantees = true -%}
                    {%- assign guarantee_count = 0 -%}
                    {%- for guarantee_block in guarantee_blocks -%}
                      {%- if guarantee_block.settings.title_text != blank or guarantee_block.settings.link_text != blank -%}
                        {%- assign guarantee_count = guarantee_count | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if guarantee_count > 0 -%}
                      {%- assign guarantee_group_block = guarantee_blocks.first -%}
                      {%- for guarantee_block in guarantee_blocks -%}
                        {%- if guarantee_block.settings.title_text != blank or guarantee_block.settings.link_text != blank -%}
                          {%- assign guarantee_group_block = guarantee_block -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- capture guarantee_group_style -%}
                        --new-main-product-guarantee-padding-top: {{ guarantee_group_block.settings.padding_top }}px;
                        --new-main-product-guarantee-padding-bottom: {{ guarantee_group_block.settings.padding_bottom }}px;
                        --new-main-product-guarantee-padding-top-mobile: {{ guarantee_group_block.settings.padding_top_mobile }}px;
                        --new-main-product-guarantee-padding-bottom-mobile: {{ guarantee_group_block.settings.padding_bottom_mobile }}px;
                        --new-main-product-guarantee-link-color: {{ guarantee_group_block.settings.link_color }};
                      {%- endcapture -%}
                      {%- capture guarantee_slider_settings -%}
                        {
                          "slidesPerView": 1,
                          "spaceBetween": 0,
                          "speed": 450,
                          "watchSlidesProgress": true
                        }
                      {%- endcapture -%}
                      <div
                        class="new-main-product__guarantee new-main-product__guarantee--slider"
                        style="{{ guarantee_group_style | strip_newlines }}"
                        {{ block.shopify_attributes }}
                      >
                        <div
                          id="GuaranteeSlider-{{ section.id }}"
                          class="new-main-product__guarantee-slider swiper"
                          role="region"
                          aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
                          aria-label="{{ 'general.slider.name' | t }}"
                          {%- render 'slider-attribute', config: guarantee_slider_settings, is_observable: true -%}
                        >
                          <div
                            class="new-main-product__guarantee-list swiper-wrapper"
                            role="list"
                            {% if guarantee_count > 1 %}
                              aria-label="{{ 'general.slider.name' | t }}"
                            {% endif %}
                          >
                          {%- assign slide_index = 0 -%}
                          {%- for guarantee_block in guarantee_blocks -%}
                              {%- if guarantee_block.settings.title_text != blank or guarantee_block.settings.link_text != blank -%}
                                {%- assign slide_index = slide_index | plus: 1 -%}
                                {%- capture guarantee_slide_style -%}
                                  --new-main-product-guarantee-bg: {{ guarantee_block.settings.background_color }};
                                  --new-main-product-guarantee-border-color: {{ guarantee_block.settings.border_color }};
                                  --new-main-product-guarantee-border-width: {{ guarantee_block.settings.border_width }}px;
                                  --new-main-product-guarantee-title-color: {{ guarantee_block.settings.title_color }};
                                  --new-main-product-guarantee-title-size: {{ guarantee_block.settings.title_size }}px;
                                  --new-main-product-guarantee-title-size-mobile: {{ guarantee_block.settings.title_size_mobile }}px;
                                  --new-main-product-guarantee-link-color: {{ guarantee_block.settings.link_color }};
                                  --new-main-product-guarantee-link-size: {{ guarantee_block.settings.link_size }}px;
                                  --new-main-product-guarantee-link-size-mobile: {{ guarantee_block.settings.link_size_mobile }}px;
                                {%- endcapture -%}
                                <div
                                  id="GuaranteeSlide-{{ section.id }}-{{ slide_index }}"
                                  class="new-main-product__guarantee-slide swiper-slide"
                                  style="{{ guarantee_slide_style | strip_newlines }}"
                                  role="group"
                                  {% if guarantee_count > 1 %}
                                    aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                    aria-label="{{ slide_index }} {{ 'general.slider.of' | t }} {{ guarantee_count }}"
                                  {% endif %}
                                  {{ guarantee_block.shopify_attributes }}
                                >
                                  <div class="new-main-product__guarantee-inner">
                                    <span class="new-main-product__guarantee-icon">
                                      {%- if guarantee_block.settings.icon_image != blank -%}
                                        {{
                                          guarantee_block.settings.icon_image
                                          | image_url: width: 120
                                          | image_tag:
                                            class: 'new-main-product__guarantee-icon-image',
                                            loading: 'lazy',
                                            sizes: '40px',
                                            widths: '40, 60, 80, 120',
                                            alt: guarantee_block.settings.icon_image.alt
                                        }}
                                      {%- else -%}
                                        {{ 'image' | placeholder_svg_tag: 'new-main-product__guarantee-icon-image' }}
                                      {%- endif -%}
                                    </span>
                                    <div class="new-main-product__guarantee-content">
                                      {%- if guarantee_block.settings.title_text != blank -%}
                                        <div class="new-main-product__guarantee-title">
                                          {{ guarantee_block.settings.title_text | escape }}
                                        </div>
                                      {%- endif -%}
                                      {%- if guarantee_block.settings.link_text != blank -%}
                                        {%- if guarantee_block.settings.link_url != blank -%}
                                          <a
                                            class="new-main-product__guarantee-link"
                                            href="{{ guarantee_block.settings.link_url }}"
                                          >
                                            {{ guarantee_block.settings.link_text | escape }}
                                          </a>
                                        {%- else -%}
                                          <span class="new-main-product__guarantee-link" aria-disabled="true">
                                            {{ guarantee_block.settings.link_text | escape }}
                                          </span>
                                        {%- endif -%}
                                      {%- endif -%}
                                    </div>
                                    <span class="new-main-product__guarantee-pagination-spacer" aria-hidden="true"></span>
                                  </div>
                                </div>
                              {%- endif -%}
                          {%- endfor -%}
                        </div>
                        <div class="slider-buttons new-main-product__guarantee-pagination{% if guarantee_count < 2 %} is-hidden{% endif %}">
                          <div class="slider-counter slider-counter--dots">
                            <div class="slideshow__control-wrapper">
                            <div
                              id="GuaranteePagination-{{ section.id }}"
                              class="new-main-product__guarantee-pagination-dots swiper-pagination"
                              data-guarantee-pagination-label="{{ 'general.slider.name' | t }}"
                            ></div>
                            </div>
                          </div>
                        </div>
                      </div>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- when 'info_bar' -%}
                  {%- if block.settings.text != blank -%}
                    {%- capture info_bar_style -%}
                      --new-main-product-info-bar-bg: {{ block.settings.background_color }};
                      --new-main-product-info-bar-border-color: {{ block.settings.border_color }};
                      --new-main-product-info-bar-border-width: {{ block.settings.border_width }}px;
                      --new-main-product-info-bar-radius: {{ block.settings.radius }}px;
                      --new-main-product-info-bar-text-color: {{ block.settings.text_color }};
                      --new-main-product-info-bar-text-size: {{ block.settings.text_size }}px;
                      --new-main-product-info-bar-text-size-mobile: {{ block.settings.text_size_mobile }}px;
                      --new-main-product-info-bar-text-line-height: {{ block.settings.text_line_height }}%;
                      --new-main-product-info-bar-text-weight: {{ block.settings.text_weight }};
                      --new-main-product-info-bar-icon-bg: {{ block.settings.icon_bg }};
                      --new-main-product-info-bar-icon-color: {{ block.settings.icon_color }};
                      --new-main-product-info-bar-icon-size: {{ block.settings.icon_size }}px;
                      --new-main-product-info-bar-icon-size-mobile: {{ block.settings.icon_size_mobile }}px;
                      --new-main-product-info-bar-icon-radius: {{ block.settings.icon_radius }}px;
                      --new-main-product-info-bar-padding-top: {{ block.settings.padding_top }}px;
                      --new-main-product-info-bar-padding-bottom: {{ block.settings.padding_bottom }}px;
                      --new-main-product-info-bar-padding-top-mobile: {{ block.settings.padding_top_mobile }}px;
                      --new-main-product-info-bar-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;
                    {%- endcapture -%}
                    <div
                      class="new-main-product__info-bar"
                      style="{{ info_bar_style | strip_newlines }}"
                      {{ block.shopify_attributes }}
                    >
                      <a href="{{ block.settings.url }}" class="new-main-product__info-bar-inner">
                        <span class="new-main-product__info-bar-icon new-main-product__info-bar-icon--left">
                          {%- if block.settings.left_icon != blank -%}
                            {{
                              block.settings.left_icon
                              | image_url: width: 120
                              | image_tag:
                                class: 'new-main-product__info-bar-icon-image',
                                loading: 'lazy',
                                sizes: '40px',
                                widths: '40, 56, 72, 96, 120',
                                alt: block.settings.left_icon.alt
                            }}
                          {%- else -%}
                            <span class="new-main-product__info-bar-icon-fallback">?</span>
                          {%- endif -%}
                        </span>
                        <div class="new-main-product__info-bar-text">
                          {{ block.settings.text }}
                        </div>
                        <span class="new-main-product__info-bar-icon new-main-product__info-bar-icon--right">
                          {%- if block.settings.right_icon != blank -%}
                            {{
                              block.settings.right_icon
                              | image_url: width: 120
                              | image_tag:
                                class: 'new-main-product__info-bar-icon-image',
                                loading: 'lazy',
                                sizes: '40px',
                                widths: '40, 56, 72, 96, 120',
                                alt: block.settings.right_icon.alt
                            }}
                          {%- else -%}
                            <span class="new-main-product__info-bar-icon-fallback">?</span>
                          {%- endif -%}
                        </span>
                      </a>
                    </div>
                  {%- endif -%}
                {%- when 'trust_gallery' -%}
                  {%- capture trust_style -%}
                    --new-main-product-trust-bg: {{ block.settings.background_color }};
                    --new-main-product-trust-quote-color: {{ block.settings.quote_color }};
                    --new-main-product-trust-author-color: {{ block.settings.author_color }};
                    --new-main-product-trust-trust-color: {{ block.settings.trust_color }};
                    --new-main-product-trust-quote-size: {{ block.settings.quote_size }}px;
                    --new-main-product-trust-quote-size-mobile: {{ block.settings.quote_size_mobile }}px;
                    --new-main-product-trust-author-size: {{ block.settings.author_size }}px;
                    --new-main-product-trust-author-size-mobile: {{ block.settings.author_size_mobile }}px;
                    --new-main-product-trust-trust-size: {{ block.settings.trust_size }}px;
                    --new-main-product-trust-trust-size-mobile: {{ block.settings.trust_size_mobile }}px;
                    --new-main-product-trust-badge-color: {{ block.settings.badge_color }};
                    --new-main-product-trust-badge-size: {{ block.settings.badge_size }}px;
                    --new-main-product-trust-badge-size-mobile: {{ block.settings.badge_size_mobile }}px;
                    --new-main-product-trust-padding-top: {{ block.settings.padding_top }}px;
                    --new-main-product-trust-padding-bottom: {{ block.settings.padding_bottom }}px;
                    --new-main-product-trust-padding-top-mobile: {{ block.settings.padding_top_mobile }}px;
                    --new-main-product-trust-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;
                    --new-main-product-trust-header-padding-top: {{ block.settings.header_padding_top }}px;
                    --new-main-product-trust-header-padding-bottom: {{ block.settings.header_padding_bottom }}px;
                    --new-main-product-trust-header-padding-top-mobile: {{ block.settings.header_padding_top_mobile }}px;
                    --new-main-product-trust-header-padding-bottom-mobile: {{ block.settings.header_padding_bottom_mobile }}px;
                    --new-main-product-trust-image-radius: {{ block.settings.image_radius }}px;
                    --new-main-product-trust-image-radius-mobile: {{ block.settings.image_radius_mobile }}px;
                  {%- endcapture -%}
                  <div
                    class="new-main-product__trust"
                    style="{{ trust_style | strip_newlines }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="new-main-product__trust-header">
                      <div class="new-main-product__trust-headline">
                        {%- if block.settings.quote_text != blank -%}
                          <span class="new-main-product__trust-quote">{{ block.settings.quote_text | escape }}</span>
                        {%- endif -%}
                        {%- if block.settings.author_text != blank -%}
                          <span class="new-main-product__trust-author">- {{ block.settings.author_text | escape }}</span>
                        {%- endif -%}
                        {%- if block.settings.show_badge -%}
                          <span class="new-main-product__trust-badge" aria-hidden="true">
                            {%- if block.settings.badge_image != blank -%}
                              {{
                                block.settings.badge_image
                                | image_url: width: 80
                                | image_tag:
                                  class: 'new-main-product__trust-badge-image',
                                  loading: 'lazy',
                                  sizes: '20px',
                                  widths: '20, 32, 40, 60, 80'
                              }}
                            {%- else -%}
                              <svg class="new-main-product__trust-badge-icon" viewBox="0 0 24 24">
                                <path d="M12 2l2.6 5.4 6 .8-4.3 4.2 1 5.9-5.3-2.8-5.3 2.8 1-5.9L3.4 8.2l6-.8L12 2z"/>
                                <path d="M8.6 12.3l2.2 2.2 4.6-4.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                        {%- if block.settings.trust_text != blank -%}
                          <span class="new-main-product__trust-text">{{ block.settings.trust_text | escape }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                    <div class="new-main-product__trust-media">
                      {%- if block.settings.gallery_image != blank -%}
                        {{
                          block.settings.gallery_image
                          | image_url: width: 1600
                          | image_tag:
                            class: 'new-main-product__trust-image',
                            loading: 'lazy',
                            sizes: '(min-width: 990px) 50vw, 100vw',
                            widths: '480, 720, 900, 1200, 1600',
                            alt: block.settings.gallery_image.alt
                        }}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'new-main-product__trust-image new-main-product__trust-image--placeholder' }}
                      {%- endif -%}
                    </div>
                  </div>
                {%- when 'purchase_tabs' -%}
                  {%- assign subscription_options = section.blocks | where: 'type', 'purchase_subscription' -%}
                  {%- assign onetime_options = section.blocks | where: 'type', 'purchase_onetime' -%}
                  {%- capture purchase_style -%}
                    --new-main-product-purchase-tab-bg: {{ block.settings.tab_bg }};
                    --new-main-product-purchase-tab-active-bg: {{ block.settings.tab_active_bg }};
                    --new-main-product-purchase-tab-text: {{ block.settings.tab_text_color }};
                    --new-main-product-purchase-tab-active-text: {{ block.settings.tab_active_text_color }};
                    --new-main-product-purchase-tab-border: {{ block.settings.tab_border_color }};
                  {%- endcapture -%}
                  <div
                    class="new-main-product__purchase"
                    style="{{ purchase_style | strip_newlines }}"
                    data-purchase-tabs
                    data-default-tab="{{ block.settings.default_tab }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- unless block.settings.purchase_options_heading == blank -%}
                      <div class="new-main-product__purchase-heading">
                        {{ block.settings.purchase_options_heading }}
                      </div>
                    {%- endunless -%}
                    <div class="new-main-product__purchase-tabs" role="tablist">
                      <button
                        class="new-main-product__purchase-tab{% if block.settings.default_tab == 'subscription' %} is-active{% endif %}"
                        type="button"
                        data-purchase-tab="subscription"
                        aria-selected="{% if block.settings.default_tab == 'subscription' %}true{% else %}false{% endif %}"
                      >
                        <span class="new-main-product__purchase-tab-label">{{ block.settings.subscription_tab_label | escape }}</span>
                        <span class="new-main-product__purchase-tab-label--mobile">{{ block.settings.subscription_tab_label_mobile | escape }}</span>
                        {%- if block.settings.subscription_tab_subtext != blank -%}
                          <span class="new-main-product__purchase-tab-subtext">{{ block.settings.subscription_tab_subtext | escape }}</span>
                        {%- endif -%}
                      </button>
                      <button
                        class="new-main-product__purchase-tab{% if block.settings.default_tab == 'onetime' %} is-active{% endif %}"
                        type="button"
                        data-purchase-tab="onetime"
                        aria-selected="{% if block.settings.default_tab == 'onetime' %}true{% else %}false{% endif %}"
                      >
                        <span class="new-main-product__purchase-tab-label">{{ block.settings.onetime_tab_label | escape }}</span>
                        {%- if block.settings.onetime_tab_subtext != blank -%}
                          <span class="new-main-product__purchase-tab-subtext">{{ block.settings.onetime_tab_subtext | escape }}</span>
                        {%- endif -%}
                      </button>
                    </div>
                    <div class="new-main-product__purchase-panels">
                      <div
                        class="new-main-product__purchase-panel{% if block.settings.default_tab == 'subscription' %} is-active{% endif %}"
                        data-purchase-panel="subscription"
                      >
                        <div class="new-main-product__purchase-options">
                          {%- if subscription_options.size > 0 -%}
                            {%- assign variants = product.variants -%}
                            {%- for option in subscription_options -%}
                              {%- assign option_index = forloop.index0 -%}
                              {%- assign plan_variant = variants[option_index] -%}
                              {%- assign option_quantity = option.settings.items_count_text | default: 1 -%}
                              {%- assign allocation = blank -%}
                              {%- assign selling_plan = blank -%}
                              {%- if plan_variant != blank and plan_variant.selling_plan_allocations != blank -%}
                                {%- assign allocation = plan_variant.selling_plan_allocations[0] -%}
                                {%- if allocation == blank -%}
                                  {%- assign allocation = plan_variant.selling_plan_allocations.first -%}
                                {%- endif -%}
                                {%- if allocation != blank -%}
                                  {%- assign selling_plan = allocation.selling_plan -%}
                                {%- endif -%}
                              {%- endif -%}
                              {%- assign option_title = option.settings.title_text -%}
                              {%- if option_title == blank and selling_plan != blank -%}
                                {%- assign option_title = selling_plan.name -%}
                              {%- endif -%}
                            {%- assign option_disabled = false -%}
                            {%- if plan_variant == blank or selling_plan == blank -%}
                              {%- assign option_disabled = true -%}
                            {%- endif -%}
                            <button
                              class="new-main-product__purchase-option{% if forloop.first %} is-active{% endif %}"
                              type="button"
                              data-purchase-option
                              {% if option.settings.discount_code != blank %}
                                data-discount-code="{{ option.settings.discount_code | escape }}"
                              {% endif %}
                              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                              {% if option_disabled %}
                                disabled
                                aria-disabled="true"
                              {% endif %}
                            >
                            {%- assign option_compare_price = blank -%}
                            {%- assign option_display_price = blank -%}
                              {%- assign option_discount_percent = 0 -%}
                              {%- if plan_variant != blank -%}
                                {%- assign plan_price = plan_variant.price -%}
                                {%- assign subscription_price = plan_price -%}
                                {%- assign compare_price_value = plan_price -%}
                                {%- assign percent_discount_value = 0 -%}
                                {%- if selling_plan != blank and selling_plan.price_adjustments != blank -%}
                                  {%- assign adjustments = selling_plan.price_adjustments -%}
                                  {%- for adjustment in adjustments -%}
                                    {%- assign adjustment_value = adjustment.value | default: adjustment.adjustment_value | default: 0 -%}
                                    {%- assign adjustment_type = adjustment.value_type | default: adjustment.valueType | downcase -%}
                                    {%- if adjustment_type == 'percentage' and adjustment_value != 0 -%}
                                      {%- assign decimal = adjustment_value | divided_by: 100.0 -%}
                                      {%- assign multiplier = 1 | plus: decimal -%}
                                      {%- if multiplier != 0 -%}
                                        {%- assign compare_price_value = compare_price_value -%}
                                        {%- assign discount_value = subscription_price | times: decimal -%}
                                        {%- assign subscription_price = subscription_price | minus: discount_value -%}
                                      {%- endif -%}
                                      {%- assign percent_discount_value = percent_discount_value | plus: adjustment_value | abs -%}
                                    {%- else -%}
                                      {%- assign compare_price_value = compare_price_value | minus: adjustment_value -%}
                                      {%- assign subscription_price = subscription_price | minus: adjustment_value -%}
                                    {%- endif -%}
                                  {%- endfor -%}
                                  {%- assign compare_price_value = compare_price_value | round -%}
                                  {%- if compare_price_value > subscription_price -%}
                                    {%- assign option_compare_price = compare_price_value | money -%}
                                  {%- endif -%}
                                  {%- assign option_discount_percent = percent_discount_value | abs | round -%}
                                {%- endif -%}
                                {%- assign option_display_price = subscription_price | money -%}
                              {%- if option_compare_price == blank and plan_variant.compare_at_price > plan_price -%}
                                {%- assign option_compare_price = plan_variant.compare_at_price | money -%}
                                {%- assign diff = plan_variant.compare_at_price | minus: plan_price -%}
                                {%- if option_discount_percent == 0 and plan_variant.compare_at_price != 0 -%}
                                  {%- assign option_discount_percent = diff | times: 100 | divided_by: plan_variant.compare_at_price | round -%}
                                {%- endif -%}
                              {%- endif -%}
                              {%- endif -%}
                              <div class="new-main-product__purchase-option-inputs" aria-hidden="true">
                              {%- if plan_variant != blank -%}
                                <input type="hidden" name="id" value="{{ plan_variant.id }}">
                              {%- endif -%}
                              <input type="hidden" name="quantity" value="{{ option_quantity }}">
                              {%- if selling_plan != blank -%}
                                <input type="hidden" name="selling_plan" value="{{ selling_plan.id }}">
                              {%- endif -%}
                              {%- if option_discount_percent > 0 -%}
                                <input
                                  type="hidden"
                                  name="properties[_display_discount_percent]"
                                  value="{{ option_discount_percent }}"
                                >
                              {%- endif -%}
                            </div>
                                {%- if option_discount_percent > 0 -%}
                                  <span class="new-main-product__purchase-option-badge">
                                    {{ option_discount_percent }}% {{ option.settings.discount_label | escape }}
                                  </span>
                                {%- endif -%}
                                <div class="new-main-product__purchase-option-main">
                                  <span class="new-main-product__purchase-option-radio" aria-hidden="true">
                                    <span class="new-main-product__purchase-option-dot"></span>
                                  </span>
                                  <div class="new-main-product__purchase-option-content">
                                    {%- if option_title != blank -%}
                                      <div class="new-main-product__purchase-option-title">
                                        {{ option_title | escape }}
                                      </div>
                                    {%- endif -%}
                                    <div class="new-main-product__purchase-option-meta">
                                      {%- if option.settings.servings_text != blank -%}
                                        <span class="new-main-product__purchase-option-meta-item">
                                          {{ option.settings.servings_text | escape }}
                                        </span>
                                      {%- endif -%}
                                    </div>
                                  </div>
                                  <div class="new-main-product__purchase-option-prices">
                                  {%- if option_compare_price != blank -%}
                                    <span class="new-main-product__purchase-option-compare">
                                      {{ option_compare_price }}
                                    </span>
                                  {%- endif -%}
                                    {%- if option_display_price != blank -%}
                                      <span class="new-main-product__purchase-option-price">
                                        {{ option_display_price }}
                                      </span>
                                    {%- elsif option.settings.price_text != blank -%}
                                      <span class="new-main-product__purchase-option-price">
                                        {{ option.settings.price_text | escape }}
                                      </span>
                                    {%- endif -%}
                                    {%- if option.settings.unit_price_text != blank -%}
                                      <span class="new-main-product__purchase-option-unit">
                                        {{ option.settings.unit_price_text | escape }}
                                      </span>
                                    {%- endif -%}
                                  </div>
                                </div>
                                {%- assign benefit_1_text = option.settings.benefit_1_text | strip -%}
                                {%- assign benefit_2_text = option.settings.benefit_2_text | strip -%}
                                {%- if benefit_1_text != blank or benefit_2_text != blank -%}
                                  <div class="new-main-product__purchase-option-benefits">
                                    <ul class="new-main-product__purchase-option-benefits-list" role="list">
                                      {%- if benefit_1_text != blank -%}
                                        <li class="new-main-product__purchase-option-benefits-item">
                                          {%- if option.settings.benefit_1_icon != blank -%}
                                            <span class="new-main-product__purchase-option-benefit-icon">
                                              {{
                                                option.settings.benefit_1_icon
                                                | image_url: width: 64
                                                | image_tag:
                                                  class: 'new-main-product__purchase-option-benefit-icon-image',
                                                  loading: 'lazy',
                                                  sizes: '20px',
                                                  widths: '20, 32, 48, 64',
                                                  alt: option.settings.benefit_1_icon.alt
                                              }}
                                            </span>
                                          {%- endif -%}
                                          <span class="new-main-product__purchase-option-benefit-text">
                                            {{ benefit_1_text | escape }}
                                          </span>
                                        </li>
                                      {%- endif -%}
                                      {%- if benefit_2_text != blank -%}
                                        <li class="new-main-product__purchase-option-benefits-item">
                                          {%- if option.settings.benefit_2_icon != blank -%}
                                            <span class="new-main-product__purchase-option-benefit-icon">
                                              {{
                                                option.settings.benefit_2_icon
                                                | image_url: width: 64
                                                | image_tag:
                                                  class: 'new-main-product__purchase-option-benefit-icon-image',
                                                  loading: 'lazy',
                                                  sizes: '20px',
                                                  widths: '20, 32, 48, 64',
                                                  alt: option.settings.benefit_2_icon.alt
                                              }}
                                            </span>
                                          {%- endif -%}
                                          <span class="new-main-product__purchase-option-benefit-text">
                                            {{ benefit_2_text | escape }}
                                          </span>
                                        </li>
                                      {%- endif -%}
                                    </ul>
                                  </div>
                                {%- endif -%}
                              </button>
                            {%- endfor -%}
                          {%- endif -%}
                        </div>
                      </div>
                      <div
                        class="new-main-product__purchase-panel{% if block.settings.default_tab == 'onetime' %} is-active{% endif %}"
                        data-purchase-panel="onetime"
                      >
                        <div class="new-main-product__purchase-options">
                          {%- for option in onetime_options -%}
                            {%- assign option_active = false -%}
                            {%- if forloop.first -%}
                              {%- assign option_active = true -%}
                            {%- endif -%}
                            {%- assign onetime_variant = product.variants[forloop.index0] -%}
                            {%- assign option_disabled = false -%}
                            {%- if onetime_variant == blank -%}
                              {%- assign option_disabled = true -%}
                            {%- endif -%}
                            {%- assign option_quantity = option.settings.items_count_text | default: 1 -%}
                            {%- assign onetime_display_price = blank -%}
                            {%- assign onetime_discount_percent = 0 -%}
                            {%- assign onetime_compare_price = blank -%}
                            {%- assign onetime_reference_price = blank -%}
                            {%- if onetime_variant != blank -%}
                              {%- assign onetime_price = onetime_variant.price -%}
                              {%- assign onetime_reference_price = onetime_variant.compare_at_price -%}
                            {%- if option.settings.discount_percent > 0 -%}
                              {%- assign onetime_discount_percent = option.settings.discount_percent -%}
                              {%- assign discount_amount = onetime_price | times: onetime_discount_percent | divided_by: 100.0 -%}
                              {%- assign discounted_price = onetime_price | minus: discount_amount | round -%}
                              {%- assign onetime_display_price = discounted_price | money -%}
                              {%- assign onetime_compare_price = onetime_price | money -%}
                            {%- else -%}
                              {%- assign onetime_display_price = onetime_price | money -%}
                              {%- if onetime_reference_price > onetime_price -%}
                                {%- assign onetime_compare_price = onetime_reference_price | money -%}
                                  {%- assign diff = onetime_reference_price | minus: onetime_price -%}
                                  {%- if onetime_reference_price != 0 -%}
                                    {%- assign onetime_discount_percent = diff | times: 100 | divided_by: onetime_reference_price | round -%}
                                  {%- endif -%}
                                {%- endif -%}
                              {%- endif -%}
                            {%- endif -%}
                            {%- if onetime_compare_price == blank and option.settings.compare_price_text != blank -%}
                              {%- assign onetime_compare_price = option.settings.compare_price_text | escape -%}
                            {%- endif -%}
                            <button
                              class="new-main-product__purchase-option{% if option_active %} is-active{% endif %}"
                              type="button"
                              data-purchase-option
                              {% if option.settings.discount_code != blank %}
                                data-discount-code="{{ option.settings.discount_code | escape }}"
                              {% endif %}
                              aria-pressed="{% if option_active %}true{% else %}false{% endif %}"
                              {% if option_disabled %}
                                disabled
                                aria-disabled="true"
                              {% endif %}
                            >
                              <div class="new-main-product__purchase-option-inputs" aria-hidden="true">
                                  {%- if onetime_variant != blank -%}
                                    <input type="hidden" name="id" value="{{ onetime_variant.id }}">
                                  {%- endif -%}
                                  <input type="hidden" name="quantity" value="{{ option_quantity }}">
                                  {%- if onetime_discount_percent > 0 -%}
                                    <input
                                      type="hidden"
                                      name="properties[_display_discount_percent]"
                                      value="{{ onetime_discount_percent }}"
                                    >
                                  {%- endif -%}
                                </div>
                              {%- if onetime_discount_percent > 0 -%}
                                <span class="new-main-product__purchase-option-badge">
                                  {{ onetime_discount_percent }}% {{ option.settings.discount_label | escape }}
                                </span>
                              {%- endif -%}
                              <div class="new-main-product__purchase-option-main">
                                <span class="new-main-product__purchase-option-radio" aria-hidden="true">
                                  <span class="new-main-product__purchase-option-dot"></span>
                                </span>
                                <div class="new-main-product__purchase-option-content">
                                  {%- if option.settings.title_text != blank -%}
                                    <div class="new-main-product__purchase-option-title">
                                      {{ option.settings.title_text | escape }}
                                    </div>
                                  {%- endif -%}
                                  <div class="new-main-product__purchase-option-meta">
                                    {%- if option.settings.servings_text != blank -%}
                                      <span class="new-main-product__purchase-option-meta-item">
                                        {{ option.settings.servings_text | escape }}
                                      </span>
                                    {%- endif -%}
                                  </div>
                                </div>
                                  <div class="new-main-product__purchase-option-prices">
                                    {%- if onetime_compare_price != blank -%}
                                      <span class="new-main-product__purchase-option-compare">
                                        {{ onetime_compare_price }}
                                      </span>
                                    {%- endif -%}
                                  {%- if onetime_display_price != blank -%}
                                    <span class="new-main-product__purchase-option-price">
                                      {{ onetime_display_price }}
                                    </span>
                                  {%- elsif option.settings.price_text != blank -%}
                                    <span class="new-main-product__purchase-option-price">
                                      {{ option.settings.price_text | escape }}
                                    </span>
                                  {%- endif -%}
                                  {%- if option.settings.unit_price_text != blank -%}
                                    <span class="new-main-product__purchase-option-unit">
                                      {{ option.settings.unit_price_text | escape }}
                                    </span>
                                  {%- endif -%}
                                  {%- if option.settings.discount_code != blank -%}
                                    <span class="new-main-product__purchase-option-code">
                                      {{ option.settings.discount_code | escape }}
                                    </span>
                                  {%- endif -%}
                                </div>
                              </div>
                              {%- assign benefit_1_text = option.settings.benefit_1_text | strip -%}
                              {%- assign benefit_2_text = option.settings.benefit_2_text | strip -%}
                              {%- if benefit_1_text != blank or benefit_2_text != blank -%}
                                <div class="new-main-product__purchase-option-benefits">
                                  <ul class="new-main-product__purchase-option-benefits-list" role="list">
                                    {%- if benefit_1_text != blank -%}
                                      <li class="new-main-product__purchase-option-benefits-item">
                                        {%- if option.settings.benefit_1_icon != blank -%}
                                          <span class="new-main-product__purchase-option-benefit-icon">
                                            {{
                                              option.settings.benefit_1_icon
                                              | image_url: width: 64
                                              | image_tag:
                                                class: 'new-main-product__purchase-option-benefit-icon-image',
                                                loading: 'lazy',
                                                sizes: '20px',
                                                widths: '20, 32, 48, 64',
                                                alt: option.settings.benefit_1_icon.alt
                                            }}
                                          </span>
                                        {%- endif -%}
                                        <span class="new-main-product__purchase-option-benefit-text">
                                          {{ benefit_1_text | escape }}
                                        </span>
                                      </li>
                                    {%- endif -%}
                                    {%- if benefit_2_text != blank -%}
                                      <li class="new-main-product__purchase-option-benefits-item">
                                        {%- if option.settings.benefit_2_icon != blank -%}
                                          <span class="new-main-product__purchase-option-benefit-icon">
                                            {{
                                              option.settings.benefit_2_icon
                                              | image_url: width: 64
                                              | image_tag:
                                                class: 'new-main-product__purchase-option-benefit-icon-image',
                                                loading: 'lazy',
                                                sizes: '20px',
                                                widths: '20, 32, 48, 64',
                                                alt: option.settings.benefit_2_icon.alt
                                            }}
                                          </span>
                                        {%- endif -%}
                                        <span class="new-main-product__purchase-option-benefit-text">
                                          {{ benefit_2_text | escape }}
                                        </span>
                                      </li>
                                    {%- endif -%}
                                  </ul>
                                </div>
                              {%- endif -%}
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    </div>
                  </div>
                {%- when 'subscription_benefits' -%}
                  {%- assign has_subscription_items = false -%}
                  {%- if block.settings.item_1_text != blank
                    or block.settings.item_2_text != blank
                    or block.settings.item_3_text != blank
                  -%}
                    {%- assign has_subscription_items = true -%}
                  {%- endif -%}
                  {%- if block.settings.heading_text != blank or has_subscription_items -%}
                    {%- capture subscription_benefits_style -%}
                      --new-main-product-subscription-benefits-padding-top: {{ block.settings.padding_top }}px;
                      --new-main-product-subscription-benefits-padding-bottom: {{ block.settings.padding_bottom }}px;
                      --new-main-product-subscription-benefits-padding-top-mobile: {{ block.settings.padding_top_mobile }}px;
                      --new-main-product-subscription-benefits-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;
                      --new-main-product-subscription-benefits-heading-color: {{ block.settings.heading_color }};
                      --new-main-product-subscription-benefits-heading-size: {{ block.settings.heading_size }}px;
                      --new-main-product-subscription-benefits-heading-size-mobile: {{ block.settings.heading_size_mobile }}px;
                      --new-main-product-subscription-benefits-text-color: {{ block.settings.text_color }};
                      --new-main-product-subscription-benefits-text-size: {{ block.settings.text_size }}px;
                      --new-main-product-subscription-benefits-text-size-mobile: {{ block.settings.text_size_mobile }}px;
                      --new-main-product-subscription-benefits-bg: {{ block.settings.background_color }};
                      --new-main-product-subscription-benefits-bg-mobile: {{ block.settings.background_color_mobile }};
                      --new-main-product-subscription-benefits-image-size: {{ block.settings.image_size }}px;
                      --new-main-product-subscription-benefits-image-size-mobile: {{ block.settings.image_size_mobile }}px;
                      --new-main-product-subscription-benefits-image-radius: {{ block.settings.image_radius }}px;
                    {%- endcapture -%}
                    <div
                      class="new-main-product__subscription-benefits"
                      style="{{ subscription_benefits_style | strip_newlines }}"
                      data-subscription-only
                      {{ block.shopify_attributes }}
                    >
                      {%- if block.settings.heading_text != blank -%}
                        <div class="new-main-product__subscription-benefits-heading">
                          {{ block.settings.heading_text }}
                        </div>
                      {%- endif -%}
                      {%- if has_subscription_items -%}
                        <ul class="new-main-product__subscription-benefits-list" role="list">
                          {%- if block.settings.item_1_text != blank -%}
                            <li class="new-main-product__subscription-benefits-item{% if block.settings.item_1_image != blank %} has-media{% endif %}">
                              {%- if block.settings.item_1_image != blank -%}
                                <span class="new-main-product__subscription-benefits-media">
                                  {{
                                    block.settings.item_1_image
                                    | image_url: width: 200
                                    | image_tag:
                                      class: 'new-main-product__subscription-benefits-image',
                                      loading: 'lazy',
                                      sizes: '72px',
                                      widths: '72, 96, 120, 160, 200',
                                      alt: block.settings.item_1_image.alt
                                  }}
                                </span>
                              {%- endif -%}
                              <div class="new-main-product__subscription-benefits-text">
                                {%- if block.settings.enable_item_1_icon -%}
                                  {%- assign has_subscription_benefit_popup = true -%}
                                  {%- assign subscription_benefits_block = block -%}
                                  {%- capture info_icon -%}
                                    <modal-opener class="new-main-product__subscription-benefits-icon" data-modal="#subscription_benefit_modal_{{ section.id }}">
                                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 15 15" fill="none">
                                        <path d="M7.5 10V7.5M7.5 5H7.50625M13.75 7.5C13.75 10.9518 10.9518 13.75 7.5 13.75C4.04822 13.75 1.25 10.9518 1.25 7.5C1.25 4.04822 4.04822 1.25 7.5 1.25C10.9518 1.25 13.75 4.04822 13.75 7.5Z" stroke="#7E7B7B" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                      </modal-opener>
                                    {%- endcapture -%}
                                    {%- assign info_icon_inserted = info_icon | append: '</p>' -%}
                                    {{ block.settings.item_1_text | replace_last: '</p>', info_icon_inserted }}
                                {% else %}
                                  {{ block.settings.item_1_text }}
                                {%- endif -%}
                              </div>
                            </li>
                          {%- endif -%}
                          {%- if block.settings.item_2_text != blank -%}
                            <li class="new-main-product__subscription-benefits-item{% if block.settings.item_2_image != blank %} has-media{% endif %}">
                              {%- if block.settings.item_2_image != blank -%}
                                <span class="new-main-product__subscription-benefits-media">
                                  {{
                                    block.settings.item_2_image
                                    | image_url: width: 200
                                    | image_tag:
                                      class: 'new-main-product__subscription-benefits-image',
                                      loading: 'lazy',
                                      sizes: '72px',
                                      widths: '72, 96, 120, 160, 200',
                                      alt: block.settings.item_2_image.alt
                                  }}
                                </span>
                              {%- endif -%}
                              <div class="new-main-product__subscription-benefits-text">
                                {{ block.settings.item_2_text }}
                              </div>
                            </li>
                          {%- endif -%}
                          {%- if block.settings.item_3_text != blank -%}
                            <li class="new-main-product__subscription-benefits-item{% if block.settings.item_3_image %} has-media{% endif %}">
                              {%- if block.settings.item_3_image -%}
                                <span class="new-main-product__subscription-benefits-media">
                                  {{
                                    block.settings.item_3_image
                                    | image_url: width: 200
                                    | image_tag:
                                      class: 'new-main-product__subscription-benefits-image',
                                      loading: 'lazy',
                                      sizes: '72px',
                                      widths: '72, 96, 120, 160, 200',
                                      alt: block.settings.item_3_image.alt
                                  }}
                                </span>
                              {%- endif -%}
                              <div class="new-main-product__subscription-benefits-text">
                                {{ block.settings.item_3_text }}
                              </div>
                            </li>
                          {%- endif -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- when 'purchase_cta' -%}
                  {%- capture purchase_cta_style -%}
                    --new-main-product-purchase-cta-padding-top: {{ block.settings.padding_top }}px;
                    --new-main-product-purchase-cta-padding-bottom: {{ block.settings.padding_bottom }}px;
                    --new-main-product-purchase-cta-padding-top-mobile: {{ block.settings.padding_top_mobile }}px;
                    --new-main-product-purchase-cta-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;
                    --new-main-product-purchase-cta-button-bg: {{ block.settings.button_bg }};
                    --new-main-product-purchase-cta-button-color: {{ block.settings.button_color }};
                    --new-main-product-purchase-cta-button-border: {{ block.settings.button_border }};
                    --new-main-product-purchase-cta-button-bg-hover:{{ block.settings.button_bg_hover }};
                    --new-main-product-purchase-cta-button-color-hover: {{ block.settings.button_color_hover }};
                    --new-main-product-purchase-cta-button-border-hover: {{ block.settings.button_border_hover }};
                    --new-main-product-purchase-cta-button-radius: {{ block.settings.button_radius }}px;
                    --new-main-product-purchase-note-color: {{ block.settings.note_text_color }};
                    --new-main-product-purchase-note-strong-color: {{ block.settings.note_strong_color }};
                    --new-main-product-purchase-note-size: {{ block.settings.note_text_size }}px;
                    --new-main-product-purchase-note-size-mobile: {{ block.settings.note_text_size_mobile }}px;
                  {%- endcapture -%}
                  {%if product.handle == "female-hormone-test-kit" or product.handle == "monthlies-zyklusbegleiter" %}
                <div class="customized-section-for-hormonal-test-kit">
                  <div class="pro-limited-offer">{{block.settings.pro_limited_offer }}</div>
                  <div class="pro-price"><span class="compare-price-only-price">{{ product.compare_at_price | money_with_currency  }}</span> {{ product.price | money_with_currency  }}</div>
                  <hr>
                  {{ block.settings.pro_custom_lines }}
                  <div class="cst-quant-cart-btn">
                    <div
                  id="Quantity-Form-{{ section.id }}"
                  class="product-form__input product-form__quantity{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} product-form__quantity-top{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {% comment %} TODO: enable theme-check once `item_count_for_variant` is accepted as valid filter {% endcomment %}
                  {% # theme-check-disable %}
                  {%- assign cart_qty = cart
                    | item_count_for_variant: product.selected_or_first_available_variant.id
                  -%}
                  {% # theme-check-enable %}
                  <span class="visually-hidden" id="quantity-label-{{ section.id }}">
                    {%- if cart_qty > 0 -%}
                      {{- 'products.product.quantity.in_cart_aria_label' | t: quantity: cart_qty -}}
                    {%- else -%}
                      {{- 'products.product.quantity.label' | t -}}
                    {%- endif -%}
                  </span>
                  <label
                    class="quantity__label form__label"
                    for="Quantity-{{ section.id }}"
                    aria-labelledby="quantity-label-{{ section.id }}"
                  >
                    <span aria-hidden="true">{{ 'products.product.quantity.label' | t }}</span>
                    <span class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %}" aria-hidden="true">
                      {%- render 'loading-spinner' -%}
                      <span
                        >(
                        {{- 'products.product.quantity.in_cart_html' | t: quantity: cart_qty -}}
                        )</span
                      >
                    </span>
                  </label>
                  <div class="price-per-item__container">
                    <quantity-input class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
                      <button class="quantity__button" name="minus" type="button">
                        <span class="visually-hidden">
                          {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-minus.svg' | inline_asset_content -}}
                        </span>
                      </button>
                      <input
                        class="quantity__input"
                        type="number"
                        name="quantity"
                        id="Quantity-{{ section.id }}"
                        data-cart-quantity="{{ cart_qty }}"
                        data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                          data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                          max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                        {% endif %}
                        step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                        value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        form="{{ product_form_id }}"
                      >
                      <button class="quantity__button" name="plus" type="button">
                        <span class="visually-hidden">
                          {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-plus.svg' | inline_asset_content -}}
                        </span>
                      </button>
                    </quantity-input>
                    {%- liquid
                      assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                      assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                      if cart_qty > 0
                        assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                      endif
                    -%}
                    {%- if product.quantity_price_breaks_configured? -%}
                      <price-per-item
                        id="Price-Per-Item-{{ section.id }}"
                        data-section-id="{{ section.id }}"
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      >
                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                          {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                          <div class="price-per-item">
                            {%- if variant_price_compare -%}
                              <dl class="price-per-item--current">
                                <dt class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </dt>
                                <dd>
                                  <s class="variant-item__old-price">
                                    {{ variant_price_compare | money_with_currency }}
                                  </s>
                                </dd>
                              </dl>
                            {%- endif -%}
                            {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                              {%- assign variant_price = product.selected_or_first_available_variant.price
                                | money_with_currency
                              -%}
                              <span class="price-per-item--current">
                                {{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}
                              </span>
                            {%- else -%}
                              {%- for price_break in volume_pricing_array -%}
                                {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                                  {%- assign price_break_price = price_break.price | money_with_currency -%}
                                  <span class="price-per-item--current">
                                    {{-
                                      'products.product.volume_pricing.price_at_each_html'
                                      | t: price: price_break_price
                                    -}}
                                  </span>
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}
                            {%- endif -%}
                          </div>
                        {%- else -%}
                          {%- assign variant_price = product.selected_or_first_available_variant.price
                            | money_with_currency
                          -%}
                          {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                          <div class="price-per-item">
                            {%- if variant_price_compare -%}
                              <dl class="price-per-item--current">
                                <dt class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </dt>
                                <dd>
                                  <s class="variant-item__old-price">
                                    {{ variant_price_compare | money_with_currency }}
                                  </s>
                                </dd>
                                <dt class="visually-hidden">
                                  {{ 'products.product.price.sale_price' | t }}
                                </dt>
                                <dd>
                                  <span class="price-per-item--current">
                                    {{-
                                      'products.product.volume_pricing.price_at_each_html'
                                      | t: price: variant_price
                                    -}}
                                  </span>
                                </dd>
                              </dl>
                            {%- else -%}
                              <span class="price-per-item--current">
                                {{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}
                              </span>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      </price-per-item>
                    {%- endif -%}
                  </div>
                  <div class="quantity__rules caption" id="Quantity-Rules-{{ section.id }}">
                    {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                      <span class="divider">
                        {{-
                          'products.product.quantity.multiples_of'
                          | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment
                        -}}
                      </span>
                    {%- endif -%}
                    {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                      <span class="divider">
                        {{-
                          'products.product.quantity.minimum_of'
                          | t: quantity: product.selected_or_first_available_variant.quantity_rule.min
                        -}}
                      </span>
                    {%- endif -%}
                    {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                      <span class="divider">
                        {{-
                          'products.product.quantity.maximum_of'
                          | t: quantity: product.selected_or_first_available_variant.quantity_rule.max
                        -}}
                      </span>
                    {%- endif -%}
                  </div>
                  {%- if product.quantity_price_breaks_configured? -%}
                    <volume-pricing class="parent-display" id="Volume-{{ section.id }}">
                      {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                        <span class="caption-large">{{ 'products.product.volume_pricing.title' | t }}</span>
                        <ul class="list-unstyled">
                          <li>
                            <span>{{ product.selected_or_first_available_variant.quantity_rule.min }}+</span>
                            {%- assign price = product.selected_or_first_available_variant.price
                              | money_with_currency
                            -%}
                            <span data-text="{{ 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price }}">
                              {{- 'sections.quick_order_list.each' | t: money: price -}}
                            </span>
                          </li>
                          {%- for price_break in product.selected_or_first_available_variant.quantity_price_breaks -%}
                            {%- assign price_break_price = price_break.price | money_with_currency -%}
                            <li class="{%- if forloop.index >= 3 -%}show-more-item hidden{%- endif -%}">
                              <span>
                                {{- price_break.minimum_quantity -}}
                                <span aria-hidden="true">+</span></span
                              >
                              <span data-text="{{ 'products.product.volume_pricing.price_at_each_html' | t: price: price_break_price }}">
                                {{- 'sections.quick_order_list.each' | t: money: price_break_price -}}
                              </span>
                            </li>
                          {%- endfor -%}
                        </ul>
                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size >= 3 -%}
                          <show-more-button>
                            <button
                              class="button-show-more link underlined-link"
                              id="Show-More-{{ section.id }}"
                              type="button"
                            >
                              <span class="label-show-more label-text"
                                ><span aria-hidden="true">+ </span>{{ 'products.facets.show_more' | t }}
                              </span>
                            </button>
                          </show-more-button>
                        {%- endif -%}
                      {%- endif -%}
                    </volume-pricing>
                  {%- endif -%}
                </div>
                  {% render 'buy-buttons',
                    block: block,
                    product: product,
                    product_form_id: product_form_id,
                    show_pickup_availability: true
                  %}
                 </div>
                </div>
                {%else %}
                  <div
                    class="new-main-product__purchase-cta"
                    style="{{ purchase_cta_style | strip_newlines }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if product != blank -%}
                      {%- assign variant = product.selected_or_first_available_variant -%}
                      {%- assign button_label = block.settings.button_text | default: '' -%}
                      {%- if button_label == blank -%}
                        {%- assign button_label = 'sections.new_main_product.purchase_cta_button' | t -%}
                      {%- endif -%}
                      {%- form 'product', product, id: 'new-main-product-cta-form', class: 'new-main-product__purchase-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                        {%- if block.settings.note_text != blank -%}
                          <div class="new-main-product__purchase-note">
                            <span class="new-main-product__purchase-note-icon" aria-hidden="true">
                              {%- if block.settings.note_icon != blank -%}
                                {{
                                  block.settings.note_icon
                                  | image_url: width: 64
                                  | image_tag:
                                    class: 'new-main-product__purchase-note-icon-image',
                                    loading: 'lazy',
                                    sizes: '20px',
                                    widths: '20, 32, 48, 64',
                                    alt: block.settings.note_icon.alt
                                }}
                              {%- else -%}
                                <span class="new-main-product__purchase-note-icon-placeholder"></span>
                              {%- endif -%}
                            </span>
                            <div class="new-main-product__purchase-note-text">
                              {{ block.settings.note_text }}
                            </div>
                          </div>
                        {%- endif -%}
                        <div class="new-main-product__purchase-form-inputs" data-purchase-form-inputs>
                          {%- if variant != blank -%}
                            <input type="hidden" name="id" value="{{ variant.id }}">
                            <input type="hidden" name="quantity" value="1">
                            <input type="hidden" name="selling_plan" value="">
                          {%- endif -%}
                        </div>
                        <button
                          class="new-main-product__purchase-submit"
                          type="submit"
                          name="add"
                          {% if variant == blank or variant.available == false %}
                            disabled
                          {% endif %}
                        >
                          {{ button_label }}
                        </button>
                      {%- endform -%}
                      {%- if block.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
                        <div class="new-main-product__purchase-payment" aria-label="{{ 'sections.footer.payment' | t }}">
                          <ul class="new-main-product__purchase-payment-list" role="list">
                            {%- for type in shop.enabled_payment_types -%}
                              <li class="new-main-product__purchase-payment-item">
                                {{ type | payment_type_svg_tag }}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- endif -%}
                    {%- else -%}
                      <div class="new-main-product__purchase-form">
                        <button class="new-main-product__purchase-submit" type="button" disabled>
                          {{ 'products.product.sold_out' | t }}
                        </button>
                      </div>
                    {%- endif -%}
                  </div>
              {% endif %}
                  
                {%- when 'purchase_card' -%}
                  {%- if product != blank -%}
                    {%- assign card_image = block.settings.image | default: product.featured_image -%}
                    {%- assign card_title = block.settings.title_text -%}
                    {%- if card_title == blank -%}
                      {%- assign card_title = product.title -%}
                    {%- endif -%}
                    {%- assign card_price = block.settings.price_text | default: '' -%}
                    {%- assign show_rating = false -%}
                    {%- if block.settings.rating_text != blank or block.settings.star_count > 0 -%}
                      {%- assign show_rating = true -%}
                    {%- endif -%}
                    {%- capture purchase_card_style -%}
                      --new-main-product-purchase-card-bg: {{ block.settings.background_color }};
                      --new-main-product-purchase-card-border-color: {{ block.settings.border_color }};
                      --new-main-product-purchase-card-radius: {{ block.settings.card_radius }}px;
                      --new-main-product-purchase-card-padding-y: {{ block.settings.padding_y }}px;
                      --new-main-product-purchase-card-padding-x: {{ block.settings.padding_x }}px;
                      --new-main-product-purchase-card-max-width: {{ block.settings.max_width }}px;
                      --new-main-product-purchase-card-title-color: {{ block.settings.title_color }};
                      --new-main-product-purchase-card-title-size: {{ block.settings.title_size }}px;
                      --new-main-product-purchase-card-price-color: {{ block.settings.price_color }};
                      --new-main-product-purchase-card-price-size: {{ block.settings.price_size }}px;
                      --new-main-product-purchase-card-rating-color: {{ block.settings.rating_color }};
                      --new-main-product-purchase-card-rating-size: {{ block.settings.rating_size }}px;
                      --new-main-product-purchase-card-star-color: {{ block.settings.star_color }};
                      --new-main-product-purchase-card-star-size: {{ block.settings.star_size }}px;
                      --new-main-product-purchase-card-image-size: {{ block.settings.image_size }}px;
                      --new-main-product-purchase-card-image-radius: {{ block.settings.image_radius }}px;
                      --new-main-product-purchase-card-button-bg: {{ block.settings.button_bg }};
                      --new-main-product-purchase-card-button-color: {{ block.settings.button_color }};
                      --new-main-product-purchase-card-button-border: {{ block.settings.button_border }};
                      --new-main-product-purchase-card-button-bg-hover: {{ block.settings.button_bg_hover }};
                      --new-main-product-purchase-card-button-color-hover: {{ block.settings.button_color_hover }};
                      --new-main-product-purchase-card-button-border-hover: {{ block.settings.button_border_hover }};
                      --new-main-product-purchase-card-button-size: {{ block.settings.button_size }}px;
                      --new-main-product-purchase-card-button-font-size: {{ block.settings.button_font_size }}px;
                    {%- endcapture -%}
                    <div
                      class="new-main-product__purchase-card"
                      style="{{ purchase_card_style | strip_newlines }}"
                      data-purchase-summary
                      data-price-prefix="{{ block.settings.price_prefix | escape }}"
                      data-price-suffix="{{ block.settings.price_suffix | escape }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="new-main-product__purchase-card-media">
                        {%- if card_image != blank -%}
                          {{
                            card_image
                            | image_url: width: 180
                            | image_tag:
                              class: 'new-main-product__purchase-card-image',
                              loading: 'lazy',
                              sizes: '72px',
                              widths: '72, 96, 120, 160, 180',
                              alt: card_image.alt
                          }}
                        {%- else -%}
                          {{
                            'image'
                            | placeholder_svg_tag: 'new-main-product__purchase-card-image new-main-product__purchase-card-image--placeholder'
                          }}
                        {%- endif -%}
                      </div>
                      <div class="new-main-product__purchase-card-body">
                        {%- if show_rating -%}
                          <div class="new-main-product__purchase-card-rating">
                            {%- if block.settings.star_count > 0 -%}
                              <div class="new-main-product__purchase-card-stars" aria-hidden="true">
                                {%- for i in (1..block.settings.star_count) -%}
                                  <span class="new-main-product__purchase-card-star">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" role="presentation">
                                      <path d="M5.76 1.15c.02-.05.06-.09.1-.11.04-.03.09-.04.14-.04s.1.01.14.04c.04.02.08.06.1.11l1.16 2.34c.08.15.19.29.33.39.14.1.3.16.47.18l2.58.38c.05.01.1.03.14.06.04.03.07.08.09.12.02.05.02.1.01.15-.01.05-.04.09-.08.12L9.05 6.72c-.12.12-.21.27-.27.43-.05.16-.07.34-.04.51l.44 2.57c.01.05 0 .1-.02.15-.02.05-.05.09-.09.12-.04.03-.09.05-.14.05-.05 0-.1-.01-.14-.03L6.49 9.29c-.15-.08-.32-.12-.49-.12s-.34.04-.49.12L3.2 10.5c-.04.02-.09.03-.14.03-.05 0-.1-.02-.14-.05-.04-.03-.07-.07-.09-.12-.02-.05-.02-.1-.01-.15l.44-2.57c.03-.17.01-.35-.04-.51-.05-.16-.15-.31-.27-.43L1.08 4.9c-.04-.04-.07-.08-.08-.13-.01-.05-.01-.1.01-.15.02-.05.05-.09.09-.12.04-.03.09-.05.14-.06l2.58-.38c.17-.02.33-.08.47-.18.14-.1.25-.24.33-.39L5.76 1.15z" fill="currentColor"/>
                                    </svg>
                                  </span>
                                {%- endfor -%}
                              </div>
                            {%- endif -%}
                            {%- if block.settings.rating_text != blank -%}
                              <span class="new-main-product__purchase-card-rating-text">
                                {{ block.settings.rating_text | escape }}
                              </span>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        {%- if card_title != blank -%}
                          <div class="new-main-product__purchase-card-title">{{ card_title | escape }}</div>
                        {%- endif -%}
                        <div
                          class="new-main-product__purchase-card-price"
                          data-summary-price
                          data-base-price="{{ card_price | escape }}"
                          aria-live="polite"
                        >
                          {{ card_price | escape }}
                        </div>
                      </div>
                      <button
                        class="new-main-product__purchase-card-button"
                        type="button"
                        data-summary-submit
                        {% if block.settings.button_aria_label != blank %}
                          aria-label="{{ block.settings.button_aria_label | escape }}"
                        {% endif %}
                      >
                        {{ block.settings.button_text | escape }}
                      </button>
                    </div>
                  {%- endif -%}
                {%- when 'expert' -%}
                  {%- if block.settings.text != blank or block.settings.name_text != blank or block.settings.role_text != blank or block.settings.background_image != blank or block.settings.background_image_mobile != blank or block.settings.image != blank or block.settings.image_mobile != blank -%}
                    {%- capture expert_style -%}
                      --new-main-product-expert-bg-image: {% if block.settings.background_image != blank %}url({{ block.settings.background_image | image_url: width: 2000 }}){% elsif block.settings.background_image_mobile != blank %}url({{ block.settings.background_image_mobile | image_url: width: 1200 }}){% else %}none{% endif %};
                      --new-main-product-expert-bg-image-mobile: {% if block.settings.background_image_mobile != blank %}url({{ block.settings.background_image_mobile | image_url: width: 1200 }}){% else %}var(--new-main-product-expert-bg-image){% endif %};
                      --new-main-product-expert-padding-top: {{ block.settings.padding_top }}px;
                      --new-main-product-expert-padding-bottom: {{ block.settings.padding_bottom }}px;
                      --new-main-product-expert-padding-top-mobile: {{ block.settings.padding_top_mobile }}px;
                      --new-main-product-expert-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;
                      --new-main-product-expert-text-color: {{ block.settings.text_color }};
                      --new-main-product-expert-text-size: {{ block.settings.text_size }}px;
                      --new-main-product-expert-text-size-mobile: {{ block.settings.text_size_mobile }}px;
                      --new-main-product-expert-text-line-height: {{ block.settings.text_line_height }}%;
                      --new-main-product-expert-text-weight: {{ block.settings.text_weight }};
                      --new-main-product-expert-name-color: {{ block.settings.name_color }};
                      --new-main-product-expert-name-size: {{ block.settings.name_size }}px;
                      --new-main-product-expert-name-size-mobile: {{ block.settings.name_size_mobile }}px;
                      --new-main-product-expert-name-line-height: {{ block.settings.name_line_height }}%;
                      --new-main-product-expert-name-weight: {{ block.settings.name_weight }};
                      --new-main-product-expert-role-color: {{ block.settings.role_color }};
                      --new-main-product-expert-role-size: {{ block.settings.role_size }}px;
                      --new-main-product-expert-role-size-mobile: {{ block.settings.role_size_mobile }}px;
                      --new-main-product-expert-role-line-height: {{ block.settings.role_line_height }}%;
                      --new-main-product-expert-role-weight: {{ block.settings.role_weight }};
                    {%- endcapture -%}
                    <div
                      class="new-main-product__expert"
                      style="{{ expert_style | strip_newlines }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="new-main-product__expert-card">
                        <div class="new-main-product__expert-grid{% if block.settings.image != blank or block.settings.image_mobile != blank %} new-main-product__expert-grid--media{% endif %}">
                          <div class="new-main-product__expert-body">
                            {%- if block.settings.image != blank or block.settings.image_mobile != blank -%}
                              <div class="new-main-product__expert-media">
                                <picture class="new-main-product__expert-picture">
                                  {%- if block.settings.image_mobile != blank -%}
                                    <source
                                      media="(max-width: 749px)"
                                      srcset="
                                        {{ block.settings.image_mobile | image_url: width: 360 }} 360w,
                                        {{ block.settings.image_mobile | image_url: width: 540 }} 540w,
                                        {{ block.settings.image_mobile | image_url: width: 720 }} 720w
                                      "
                                      sizes="(max-width: 749px) 100vw"
                                    >
                                  {%- endif -%}
                                  {%- if block.settings.image != blank -%}
                                    {{
                                      block.settings.image
                                      | image_url: width: 900
                                      | image_tag:
                                        class: 'new-main-product__expert-image',
                                        loading: 'lazy',
                                        sizes: '(min-width: 990px) 40vw, 100vw',
                                        widths: '360, 540, 720, 900, 1200',
                                        alt: block.settings.image.alt
                                    }}
                                  {%- else -%}
                                    {{
                                      block.settings.image_mobile
                                      | image_url: width: 900
                                      | image_tag:
                                        class: 'new-main-product__expert-image',
                                        loading: 'lazy',
                                        sizes: '100vw',
                                        widths: '360, 540, 720, 900',
                                        alt: block.settings.image_mobile.alt
                                    }}
                                  {%- endif -%}
                                </picture>
                              </div>
                            {%- endif -%}
                            
                            {%- if block.settings.name_text != blank -%}
                              <h3 class="new-main-product__expert-name new-main-product__expert-align--{{ block.settings.name_position }}">
                                {{ block.settings.name_text | escape }}
                              </h3>
                            {%- endif -%}
                            {%- if block.settings.role_text != blank -%}
                              <div class="new-main-product__expert-role new-main-product__expert-align--{{ block.settings.role_position }}">
                                {{ block.settings.role_text | escape | newline_to_br }}
                              </div>
                            {%- endif -%}
                            {%- if block.settings.text != blank -%}
                              <div class="new-main-product__expert-text new-main-product__expert-align--{{ block.settings.text_position }}">
                                {{ block.settings.text }}
                              </div>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                {%- when 'rating_bar' -%}
                  {% render 'rating-bar', rating_block: block %}
                {%- when 'image-with-text' -%}
                  <div class='img-txt-container {{block.settings.custom-class }}'>
                    <img src='{{block.settings.img | img_url: 'master'}}'>
                    <div>{{block.settings.text }}</div>
                  </div>

                {%- when 'purchase_subscription' -%}
                {%- when 'purchase_onetime' -%}
              {%- endcase -%}
            {%- endfor -%}
          {%- else -%}
          <h2 class="new-main-product__title">
            {{ 'sections.new_main_product.placeholder_title' | t }}
          </h2>
          <p class="new-main-product__text">
            {{ 'sections.new_main_product.placeholder_text' | t }}
          </p>
            <div class="new-main-product__content-placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  {%- if has_subscription_benefit_popup -%}
    <modal-dialog class="subscription-benefit-modal" id="subscription_benefit_modal_{{ section.id }}">
      <div class="subscription-benefit-modal__inner">
        {%- unless subscription_benefits_block.settings.popup_title == blank -%}
          <h2 class="subscription-benefit-modal__title">{{ subscription_benefits_block.settings.popup_title }}</h2>
        {%- endunless -%}
        {%- unless subscription_benefits_block.settings.popup_subtitle == blank -%}
          <p class="subscription-benefit-modal__subtitle">{{ subscription_benefits_block.settings.popup_subtitle }}</p>
        {%- endunless -%}
        {%- unless subscription_benefits_block.settings.popup_image == blank -%}
          {{ subscription_benefits_block.settings.popup_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'subscription-benefit-modal__image' }}
        {%- endunless -%}
        {%- unless subscription_benefits_block.settings.popup_description == blank -%}
          <div class="subscription-benefit-modal__description">{{ subscription_benefits_block.settings.popup_description }}</div>
        {%- endunless -%}
        {%- unless subscription_benefits_block.settings.time_badge == blank -%}
          <span class="subscription-benefit-modal__time-badge">{{ subscription_benefits_block.settings.time_badge }}</span>
        {%- endunless -%}
        {%- unless subscription_benefits_block.settings.popup_content == blank -%}
          <div class="subscription-benefit-modal__content">{{ subscription_benefits_block.settings.popup_content | replace: '[', '<span>' | replace: ']', '</span>' }}</div>
        {%- endunless -%}
        <span class="subscription-benefit-modal__close-button" id="ModalClose-{{ section.id }}">
          {%- render 'icon-close' -%}
        </span>
      </div>
    </modal-dialog>
  {%- endif -%}
</section>

{% schema %}
