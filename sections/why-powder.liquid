<style>
  .why-powder .inner_wrapper { display: flex; } 
  .why-powder .inner_wrapper slider-component { flex-basis: 56.3%; max-width: 56.3%;position: relative; border-radius: 0 100px 0 0; } 
  .why-powder .inner_wrapper slider-component::before { content: ""; width: 60vw; height: 100%; background: #ABD0CD; position: absolute; right: 0; z-index: 0; top: 0; border-radius: 0 100px 0 0; }
  .why-powder .pain_free_period { flex-basis: 43.7%; max-width: 43.7%;padding-top:80px; } 
  .why-powder slider-component { background:#ABD0CD;padding:80px 110px 80px 80px; }
  .why-powder .title-wrapper { display: block; text-align: center; margin-bottom: 50px;position:relative; } 
  .why-powder h2.title.h1  { font-size: 44px; font-family: Lora, sans-serif !important; font-weight: 600; text-align: center; letter-spacing: 0; margin-bottom: 30px; } 
  .why-powder .title-wrapper span  { font-size: 26px; text-align: center; max-width: 60%; margin: 60px auto; line-height: 1.3; }
  .why-powder .multicolumn-list.grid .multicolumn-list__item.grid__item { width: calc(50% - 20px) !important; max-width: calc(50% - 20px) !important; flex-basis: calc(50% - 20px) !important; background: #fff; padding-bottom: 20px; text-align: center; border-radius: 20px;overflow:hidden; }
  .why-powder .multicolumn-list.grid .multicolumn-list__item.grid__item img { width: calc(100% + 4px); margin-left: -2px; max-width: unset; }
  .why-powder .multicolumn-list.grid { column-gap: 40px;position:relative; }
  .why-powder h2.title.h1::before { content: "Why "; color: #CB342C; } 
  .why-powder h2.title.h1::after { content: "?"; color: #CB342C; }
  .why-powder .multicolumn-card__info p { font-size: 26px; font-family: 'Quicksand' !important; font-weight: 500; }
  .pain_free_period h2.section_heading { font-size: 44px; font-family: Lora, sans-serif !important; font-weight: 600; text-align: center; letter-spacing: 0; margin-bottom: 30px;position:relative; } 
  .pain_free_period h2.section_heading strong { font-family: inherit;font-weight:inherit; text-decoration: underline; text-decoration-color: #d43a32; text-underline-offset: 5px; }
  .why-powder .section--padding { background: #ecf1f4;padding-bottom:0px; } 
  .pain_free_period > div { height: 100%; background: #fff; display: flex; align-items: center; justify-content: center;position:relative;flex-direction:column;padding:0 75px; }
  .pain_free_period > div::before { content: ""; width: 60vw; height: 100%; position: absolute; left: 0; background: #fff; z-index: 0; }
  .pain_free_period .range-container.in-view { position: relative; flex-direction: column; }
  .pain_free_period .range-container .input_wrapper::before{content:"Days";line-height: 2; font-size: 15px; font-family: 'Lora';}
  .pain_free_period p#rangeText{padding:24px 20px;min-height:210px;}
  .section.why-powder .page-width { padding: 0; }
  .section.why-powder p#rangeText p span {padding-top:10px;}
  .section.why-powder p#rangeText p b {font-weight: 600;}
  .why-powder .multicolumn-list.grid::before { content: ""; height: 142px; width: 157px; position: absolute; bottom: -115px; left: 50%; transform: translateX(-50%); background: url('https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Vector_352.png?v=1724828432'); background-repeat: no-repeat; background-size: contain; }
  .section.why-powder .full_width_range .input_col{max-width:415px;}
  .why-powder .multicolumn-list.grid li:hover img { transform: scale(1.05); }
@media screen and (min-width:989px) {
  .why-powder .title-wrapper { display: block; text-align: left; margin-bottom: 50px; position: relative; max-width: 80%; margin: 0 auto 50px; }
  .why-powder .range-container {padding:40px }
}
  
@media screen and (max-width:1270px) and (min-width:767px) {
      .no_pain .title-wrapper .title , 
  .why-powder h2.title.h1 ,
  .pain_free_period h2.section_heading {font-size:clamp(1rem, 3.056vw, 44px);}
  .why-powder slider-component { padding: 40px; padding-bottom: 80px; } 
  .why-powder .title-wrapper span { font-size: 18px; text-align: center !important; display: inline-block; margin: 0 !important; width: 100%; max-width: unset; }
}

  @media screen and (max-width:990px) and (min-width:767px) {
    .why-powder .inner_wrapper slider-component {  padding-bottom: 80px; }
  }
  
@media screen and (max-width:767px) {
    .why-powder .multicolumn-list.grid::before { content: ""; height: 142px; width: 100px; position: absolute; bottom: -106px; left: 50%; transform: translateX(-50%); background-size: contain; background: url('https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Vector_352_1.png?v=1724925372'); background-repeat: no-repeat; }
}
  
</style>

<style> 
.range { position: relative; pointer-events: auto; }
.range__input, .range__input-fill, .range__counter { pointer-events: auto; }
span.range__counter { pointer-events: auto; }
.range__input-fill { transition: width 0.1s ease; }
.range__counter { transition: left 0.1s ease; z-index:10; }
.range:not(:last-child) { margin-bottom: 1.5em; }
.range input[type=range], .range input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; }
.range input[type=range], .range__input-fill { border-radius: 0.25em; height: 0.5em; width:100%; }
.range input[type=range] { background-color: #cee8e8; display: block; margin: 0.5em 0; padding: 0; }
.range input[type=range]:focus { outline: transparent; }
.range input[type=range]::-webkit-slider-thumb { background-color: #a6d0cd; border: 0; border-radius: 50%; cursor: pointer; position: relative; transition: background 0.1s linear; width: 57px; height: 57px; z-index: 99; box-shadow:none; outline:none; opacity:0; }
.range input[type=range]::-moz-range-thumb { background-color:#a6d0cd; box-shadow:none; outline:none; border: 0; border-radius: 50%; cursor: pointer; position: relative; transform: translateZ(1px); transition: background-color 0.1s linear; width: 57px; height: 57px; z-index: 99; opacity:0; }
.range input[type=range]::-moz-focus-outer { border: 0; }
.range__input, .range__input-fill { display: block; }
.range__input { position: relative; }
.range__input:active input[type=range]::-webkit-slider-thumb, .range input[type=range]:focus::-webkit-slider-thumb, .range input[type=range]::-webkit-slider-thumb:hover { background-color: var(--handleDownBg); }
.range__input:active input[type=range]::-moz-range-thumb, .range input[type=range]:focus::-moz-range-thumb, .range input[type=range]::-moz-range-thumb:hover { background-color: var(--handleDownBg); }
.range__input-fill, .range__counter { left: 0; pointer-events: none; position: absolute; }
.range__input-fill { background-color: var(--handleTrackBg); top: calc(50% - 0.25em); }
.range__counter { line-height: 1.8; height: 57px; width: 57px; background: #a6d0cd; border-radius: 50%; font-size: 30px; top: -13px; text-align: center; color: #fff; font-weight: 600; font-family: 'Lora'; }
.range__input-fill { top: 0; } .range input[type=range], .range__input-fill { border-radius: 20px; height: 31px; }
.range__counter { line-height: 2; } .range__input-fill { background-color: #8CBFBD; top: 0; }
.why-powder .range-container .input_wrapper { padding-left: 80px; position: relative;z-index:9; }
.range-container .input_wrapper::before { content: "Month"; background: #8CBFBD; color: #fff; padding-left: 10px; border-radius: 20px 0 0 20px; position: absolute; left: 0;z-index:9; width: 100px; height: 100%; line-height: 1.8; font-size: 18px; }
/* Dark mode */ @media (prefers-color-scheme: dark) { :root { --bg: #2e3138; --bgT: #2e313800; --fg: #e3e4e8; --fgT: #e3e4e800; --inputBg: #17181c; } }
@media screen and (max-width:989px) { 
.range__counter { height: 41px; width: 41px; font-size:24px; line-height:1.7; top:-8px; }
.range input[type=range], .range__input-fill { border-radius: 20px; height:25px; } 
.range-container .input_wrapper::before {font-size:11px;font-family:'Lora';line-height:2;width:70px;} 
.why-powder  .range-container .input_wrapper { padding-left: 55px; position: relative; }
.range input[type=range]::-webkit-slider-thumb { width: 41px; height: 41px; } 
.range input[type=range]::-moz-range-thumb { width: 41px; height: 41px; } 
.pain_free_period .range-container .input_wrapper::before { content: "Days"; line-height: 2.3; font-size: 11px; font-family: 'Lora'; }
  .why-powder .multicolumn-list.grid img.image_hover { position: absolute; top: -15px; right: -30px; z-index: 9; max-width: 80px; }
 }
</style>


{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-position: {{ section.settings.image_position }};
  }
{%- endstyle -%}

<link rel="stylesheet" href="{{ 'section-multicolumn.css' | asset_url }}" >

<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

<div class="{{ section.settings.custom_class }} section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="multicolumn page-width">
   
    <div class="inner_wrapper">
    <slider-component class="slider-mobile-gutter {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">
       <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %} {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }} {{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
      <span> {{ section.settings.description }}</span>
      </div>
        
      <ul id="Slider-{{ section.id }}"
        class="multicolumn-list grid grid--2-col{% if section.settings.columns_mobile == '1' %} grid--1-col-mobile{% endif %}{% if section.blocks.size > 3 %} grid--2-col-tablet{% else %} grid--3-col-tablet{% endif %}{% if section.settings.swipe_on_mobile and section.blocks.size > 1 %} slider slider--mobile{% endif %}"
        role="list"
      >
        <img class="image_hover" src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Group_c75a7053-8fef-4289-8acc-83493926ec36.png?v=1725426224" />
        {%- liquid
          if section.settings.image_ratio == 'adapt'
            assign highest_ratio = 0
            for block in section.blocks
              if block.settings.image.aspect_ratio > highest_ratio
                assign highest_ratio = block.settings.image.aspect_ratio
              endif
            endfor
          endif
        -%}

        {%- capture sizes -%}(min-width: 990px) {% if section.blocks.size <= 2 %}710px{% else %}550px{% endif %}, (min-width: 750px) {% if section.blocks.size == 1 %}710px{% else %}550px{% endif %},{% if section.settings.columns_mobile == '1' %} calc(100vw - 3rem){% else %} calc((100vw - 3rem) / 2){% endif %}{%- endcapture -%}
        {%- for block in section.blocks -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="multicolumn-card">
              {%- if block.settings.image != blank -%}
                <use-animate data-animate="zoom-fade" class="media-wrapper">
                  <div class="image-animate media media--{{ section.settings.image_ratio }}"
                    {%- if section.settings.image_ratio == 'adapt' %} style="--image-ratio-percent: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"{% endif -%}
                  >
                    {{ block.settings.image | image_url: width: 1420 | image_tag:
                      loading: 'lazy',
                      sizes: sizes,
                      widths: '275, 550, 710, 1420',
                      is: 'lazy-image'
                    }}
                  </div>
                  {%- if block.settings.button_link != blank -%}
                    <a href="{{ block.settings.button_link }}" class="full-unstyled-link">&nbsp;</a>
                  {%- endif -%}
                </use-animate>
              {%- endif -%}
              {%- if block.settings.title != blank or block.settings.text != blank or block.settings.button_label != blank -%}
                <div class="multicolumn-card__info">
                  <p class="multicolumn-card__title {{ block.settings.title_size }}">{{ block.settings.title | escape }}</p>
                  <div class="rte typeset">{{ block.settings.text }}</div>
                  {%- if block.settings.button_label != blank -%}
                    {%- if block.settings.button_style_secondary -%}
                      <a class="button button--cta"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                        <span class="label">{{ block.settings.button_label | escape }}</span>
                        {% render 'icon', icon: 'arrow' %}
                      </a>
                    {%- else -%}
                      <a class="button button--tertiary"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>
        <div class="pain_free_period">
          <div>
           <h2 class="section_heading"> {{ section.settings.second_heading }} </h2>
             <div class="full_width_range"> 
              <div class="range-container">
                <!-- <label for="rangeSlider">Range:</label> -->
                <!-- <div class="content_col">
                 <h2 class="title"> Experience the progress </h2>
                 <p class="description"> In 30 days, you'll start noticing the powder's impact, with boosted energy and a gentle uplift in your mood.  </p>
                </div> -->
                <div class="input_col">
                  <div class="input_wrapper"> 
                     <form>
                      <input id="floors" name="floors" type="range" min="1" max="3" value="1" step="0.1">
                    </form> 
                  </div>
                  <p id="rangeText">  {{ section.settings.range_text }}</p>
                </div>
               </div>
              </div>
          </div>
        </div>
        </div>
  </div>
</div>

