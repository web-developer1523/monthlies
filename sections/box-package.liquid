{{ 'section-box-package.css' | asset_url | stylesheet_tag }}

<div class="package-section">
    <div class="page-width">
        <h2 class="h1">{{ section.settings.title }}</h2>

        <div class="package-wrapper">
            <div class="package-item">
                <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Group_321_6b40cb8b-8791-4185-9799-647fcdfee12b.png?v=1681245293" alt="Item">
    
                <h4>{{ section.settings.title_1 }}</h4>
                <p>{{ section.settings.text_1 }}</p>
            </div>

            <div class="package-item">
                <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Group_320.png?v=1681245165" alt="Item">
    
                <h4>{{ section.settings.title_2 }}</h4>
                <p>{{ section.settings.text_2 }}</p>
            </div>

            <div class="package-item">
                <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Group_238.png?v=1681245168" alt="Item">
    
                <h4>{{ section.settings.title_3 }}</h4>
                <p>{{ section.settings.text_3 }}</p>
            </div>

            <div class="package-item">
                <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Group_194.png?v=1681245169" alt="Item">
    
                <h4>{{ section.settings.title_4 }}</h4>
                <p>{{ section.settings.text_4 }}</p>
            </div>
        </div>

        <a href="{{ section.settings.url }}" id="cta-included" class="button button--medium cta-primary">{{ section.settings.label }}</a>
    </div>
</div>

{% schema %}
    {
      "name": "box-packafe",
      "tag": "section",
      "class": "section",
      "settings": [
        {
            "type": "text",
            "label": "Title",
            "id": "title",
            "default": "Included in your Monthlies Box"
        },
        {
            "type": "text",
            "label": "Item 1 - Title",
            "id": "title_1",
            "default": "Quality products"
        },
        {
            "type": "text",
            "label": "Item 1 - Text",
            "id": "text_1",
            "default": "A recommended set of products curated by our experts for your unique needs"
        },
        {
            "type": "text",
            "label": "Item 2 - Title",
            "id": "title_2",
            "default": "Cycle guide"
        },
        {
            "type": "text",
            "label": "Item 2 - Text",
            "id": "text_2",
            "default": "A guide to explain you how products benefit you in every step of your cycle"
        },
        {
            "type": "text",
            "label": "Item 3 - Title",
            "id": "title_3",
            "default": "Lifestyle tips"
        },
        {
            "type": "text",
            "label": "Item 3 - Text",
            "id": "text_3",
            "default": "Improve your daily habits with our experts advise tips selected for you"
        },
        {
            "type": "text",
            "label": "Item 4 - Title",
            "id": "title_4",
            "default": "Optional consultation"
        },
        {
            "type": "text",
            "label": "Item 4 - Text",
            "id": "text_4",
            "default": "You can book a free consultation with one of our experts to review your experience after one month"
        },
        {
          "type": "url",
          "label": "Button URL",
          "id": "url"
        },
        {
          "type": "text",
          "label": "Button label",
          "id": "label",
          "default": "Take the quiz"
        }
      ],
      "presets": [
        {
          "name": "What's included"
        }
      ]
    }
{% endschema %}
    