  <!--Kit-desktop-design-start-->
  <section class="cst-we-test">
    <div class="container">
      <div class="what-grid">
    <!-- Left Column -->
    <div class="left-content">
      <h2>{{ section.settings.heading_main | replace:'<p>','' | replace:'</p>',''}}</h2>
      <p class="sub-title">
        {{ section.settings.subheading | replace:'<p>','' | replace:'</p>',''}}
      </p>
      <p class="description">
       {{ section.settings.description }}
      </p>
      <div class="test-box">
        <img src="{{ section.settings.side_image | image_url }}" alt="Female Hormone Test Box" />
      </div>
    </div>

    <!-- Right Column -->
    <div class="right-content">
      <div class="hormones-grid">
        {% for block in section.blocks %}
          <div class="hormone-item">
            <h4>{{ block.settings.hormone_name }}</h4>
            <p>
              {{ block.settings.hormone_description }}
            </p>
          </div>
        {% endfor %}
      </div>
      </div>
    </div>
  </div>
</section>
<!--Kit-desktop-design-end-->

<!--Kit-mobile-design-start-->
<section class="cst-test-kit">
  <div class="cst-test-content">
    <h3>{{ section.settings.heading_main | replace:'<p>','' | replace:'</p>',''}}</h3>
    <p class="subtext">
      {{ section.settings.subheading | replace:'<p>','' | replace:'</p>',''}}
    </p>
    <p class="desc">
      {{ section.settings.description }}
    </p>

    <div class="kit-box">
      <img src="{{ section.settings.side_image | image_url }}" alt="Kit">
    </div>

    <div class="accordion">
      {% for block in section.blocks %}
      <div class="accordion-item">
        <button class="accordion-header">{{ block.settings.hormone_name }} <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Arrows_46f6ecc2-4bf1-4474-9f89-d10ab6f6809e.png" alt="arrow"></button>
        <div class="accordion-content">
          <p>{{ block.settings.hormone_description }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
<!--Kit-mobile-design-end-->

    <script>
  document.querySelectorAll(".cst-test-kit .accordion-header").forEach(button => {
    button.addEventListener("click", () => {
      const item = button.parentElement;
      const openItem = document.querySelector(".cst-test-kit .accordion-item.active");

      if (openItem && openItem !== item) {
        openItem.classList.remove("active");
        openItem.querySelector(".accordion-header").classList.remove("active");
      }

      item.classList.toggle("active");
      button.classList.toggle("active");
    });
  });
</script>

