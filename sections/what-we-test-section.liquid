{% schema %}
{
  "name": "What We Test Section",
  "settings": [
    {
      "type": "richtext",
      "id": "heading_main",
      "label": "Main Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Your steroid hormones tell us if your primary hormones are within normal ranges. Abnormal levels may be causing symptoms that affect your cycle and overall well-being."
    },
    {
      "type": "image_picker",
      "id": "side_image",
      "label": "Left Side Image (Test Kit)"
    }
  ],
  "blocks": [
    {
      "type": "hormone_item",
      "name": "Hormone",
      "settings": [
        {
          "type": "text",
          "id": "hormone_name",
          "label": "Hormone Name",
          "default": "Oestradiol"
        },
        {
          "type": "textarea",
          "id": "hormone_description",
          "label": "Hormone Description",
          "default": "This hormone has various functions in the body, including supporting immune function, maintaining energy levels, and promoting overall well-being."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What We Test Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
