{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-position: {{ section.settings.image_position }};
  }
{%- endstyle -%}

<link rel="stylesheet" href="{{ 'section-multicolumn.css' | asset_url }}" >

<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

<div class="{{ section.settings.custom_class }} section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="multicolumn page-width">
    <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %} {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }} {{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">
        {{- section.settings.heading -}}
      </{{ section.settings.heading_tag }}>
      <span> {{ section.settings.description }}</span>
    </div>

    <slider-component class="slider-mobile-gutter {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">
      <ul
        id="Slider-{{ section.id }}"
        class="multicolumn-list grid grid--{{ section.settings.products_to_show }}-col-desktop   grid--1-col-mobile {% if section.settings.swipe_on_mobile and section.blocks.size > 1 %} slider slider--mobile{% endif %}"
        role="list"
      >
        {%- liquid
          if section.settings.image_ratio == 'adapt'
            assign highest_ratio = 0
            for block in section.blocks
              if block.settings.image.aspect_ratio > highest_ratio
                assign highest_ratio = block.settings.image.aspect_ratio
              endif
            endfor
          endif
        -%}

        {%- capture sizes -%}(min-width: 990px) {% if section.blocks.size <= 2 %}710px{% else %}550px{% endif %}, (min-width: 750px) {% if section.blocks.size == 1 %}710px{% else %}550px{% endif %},{% if section.settings.columns_mobile == '1' %} calc(100vw - 3rem){% else %} calc((100vw - 3rem) / 2){% endif %}{%- endcapture -%}
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="multicolumn-card">
              {%- if block.settings.image != blank -%}
                <use-animate data-animate="zoom-fade" class="media-wrapper">
                  <div
                    class="image-animate media media--{{ section.settings.image_ratio }}"
                    {%- if section.settings.image_ratio == 'adapt' %}
                      style="--image-ratio-percent: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                    {% endif -%}
                  >
                    {{
                      block.settings.image
                      | image_url: width: 1420
                      | image_tag: loading: 'lazy', sizes: sizes, widths: '275, 550, 710, 1420', is: 'lazy-image'
                    }}
                  </div>
                  {%- if block.settings.button_link != blank -%}
                    <a href="{{ block.settings.button_link }}" class="full-unstyled-link">&nbsp;</a>
                  {%- endif -%}
                </use-animate>
              {%- endif -%}
              {%- if block.settings.title != blank
                or block.settings.text != blank
                or block.settings.button_label != blank
              -%}
                <div class="multicolumn-card__info">
                  <p class="multicolumn-card__title {{ block.settings.title_size }}">
                    {{ block.settings.title | escape }}
                  </p>
                  <div class="rte typeset">{{ block.settings.text }}</div>
                  {%- if block.settings.button_label != blank -%}
                    {%- if block.settings.button_style_secondary -%}
                      <a
                        class="button button--cta"
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                      >
                        <span class="label">{{ block.settings.button_label | escape }}</span>
                        {% render 'icon', icon: 'arrow' %}
                      </a>
                    {%- else -%}
                      <a
                        class="button button--tertiary"
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>
  </div>
</div>
<style>
  
  .health_expert-new-section {
    background: #fff;
    padding: 0;
}
  .health_expert-new-section .page-width{
      padding: 50px 20px;
  }
.health_expert-new-section .title-wrapper .title {
    font-size: 40px;
}

.health_expert-new-section .title-wrapper .title strong {
    font-family: 'Lora';
    font-style: italic;
}

.health_expert-new-section p.multicolumn-card__title.h3 {
    font-size: 20px;
    text-align: left;
    font-family: 'Lora' ;
    color: #404040;
}

.health_expert-new-section .rte.typeset p {
    font-size: 16px !important;
    font-family: 'Quicksand' !important;
    font-weight: 400;
    text-align: left;
}

.health_expert-new-section .image-animate.media.media--landscape {
    width: 100% !important;
    padding-bottom: 0 !important;
}

.health_expert-new-section .image-animate.media.media--landscape img {
    position: static !important;
}
.health_expert-new-section .media-wrapper {
    width: 100%;
}
.health_expert .multicolumn-list.grid li.grid__item {
    max-width: 100%;
}
.health_expert-new-section .multicolumn-list.grid {
    column-gap: 20px;
    justify-content: space-around;
}
.health_expert-new-section .slick-track{
    display: flex !important;
}
.health_expert-new-section .slick-slide{
    height: inherit !important;
}
@media screen and (max-width:1200px){
  .health_expert-new-section .title-wrapper .title{
  font-size:34px;
  }
.health_expert-new-section .rte.typeset p{
font-size:14px !important;
}
.health_expert-new-section .multicolumn-list.grid {
    justify-content: space-evenly;
}
}

@media screen and (max-width:1024px){
    body .health_expert.health_expert-new-section .image-animate.media.media--landscape img {
           position: static !important;
        max-width: 100% !important;
        width: 100% !important;
        height: 100% !important;
  }
.health_expert.health_expert-new-section use-animate.media-wrapper{
width: 100%;
        padding: 0 10px;
}
.health_expert-new-section .multicolumn-list.grid{
        gap: 0;
}
.health_expert-new-section .title-wrapper .title{
        width: 100%;
        max-width: 450px;
        margin:0 auto;
}
}
@media screen and (max-width:989px){
       body .health_expert.health_expert-new-section .multicolumn-list.grid li.grid__item:first-child {
        padding-left: 0;
    }
.health_expert-new-section .multicolumn-card__info.appco_bg {
    padding: 0 0px 0 10px;
}
}
@media screen and (max-width:595px){
.health_expert-new-section .title-wrapper .title{
font-size:24px;
}
.health_expert-new-section p.multicolumn-card__title.h3{
font-size:19px ;
}
body .health_expert-new-section .multicolumn-list.grid{
        column-gap: 0;
}
}
</style>
