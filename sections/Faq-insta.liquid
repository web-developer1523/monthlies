<style>
  .instafeeds .ingredients_content.tab_content { display: block !important; max-width: 1440px; margin: 0 auto; padding:0px 70px; }
  .instafeeds .ingredients_content.tab_content .card_wrapper { gap: 40px; max-width: 1440px; margin: 0 auto; }
  .instafeeds .ingredients_content.tab_content .accordions { max-width: unset; }
  .instafeeds h2.title.h1 strong { font-family: inherit; color: #CB342C; }
  .instafeeds h2.title.h1 p{ font-size: 44px; font-family: Lora, sans-serif !important; font-weight: 600; text-align: center; letter-spacing: 0;text-align:center; }
  .instafeeds h2.title.h1 , .instafeeds h2.title.h1 * { margin-top: 0; }
  .instafeeds .ingredients_content .accordion_head { background-size: 20px;cursor: pointer; }
  .instafeeds .ingredients_content .accordion_head { font-size: 18px; font-weight: 700; line-height: 1.15; padding: 15px 25px;background-position:98% center; }
  .shopify-section.instafeeds { background: #ecf1f4; }
  .instafeeds .accordion_content p { margin-bottom: 10px !important; }
.instafeeds .ingredients_content .accordion { border-radius: 15px; border: 1px solid #cccccc6e; box-shadow: none; }
  .instafeeds .ingredients_content.tab_content .card_wrapper > div { flex: 1; } 
 .instafeeds .ingredients_content.tab_content .accordions { background: #fff; position: relative; padding-top: 80px; padding-bottom: 20px;height:100%; }
  .instafeeds .ingredients_content.tab_content .accordions::before { content: ""; width: 60vw; height: 100%; position: absolute; right: -40px; background: #fff; z-index: 0;top:0; }
  .instafeeds .ingredients_content.tab_content .accordions > * { position: relative; }
  .insta_col { padding: 55px 60px; border-radius: 100px 0 0 0; }
  .left_col { padding-top: 90px; } .faq_insta { background: #a6d0cd; }
  .insta_col{position:relative;}
  .insta_col::before { content: ""; width: 60vw; height: 100%; position: absolute; left: 0; background: #ecf1f4; z-index: 0; top:0; border-radius:100px 0 0 0; }
  .insta_col > * { position: relative; }
  .insta_col p { text-align: center; font-size: 26px; margin: 0; }
  .insta_col h2.title.h1, .insta_col h2.title.h1 * {margin-bottom:10px;}
  .faq_insta .ingredients_content .accordion_content , .custom_faq .ingredients_content .accordion_content { padding-bottom: 2px !important; }
  .faq_insta .ingredients_content .accordion_content p ,.custom_faq .ingredients_content .accordion_content p {line-height:1.4;}
  .instafeeds .ingredients_content .accordion { box-shadow:0 7px 28px #9191914d; }
  .instafeeds .ingredients_content .accordion:hover { box-shadow: 0 7px 28px #919191cc; }
  .instafeeds .ingredients_content .accordion:hover .accordion_head { color:#cb342c; }
    .instafeeds .ingredients_content .accordion .accordion_content {padding-right:25px;padding-left:25px;}
.instafeeds .ingredients_content .accordion .accordion_content {padding-top:10px;}
   

/* ingredients start*/
.ingredients_content .accordion_content ul li { line-height: 1.3; }
.ingredients_content .card_wrapper { gap: 130px; } 
.ingredients_content .image_wrapper { background: transparent; }
.ingredients_content .head_content {max-width:unset;} 
.ingredients_content .accordion_content{display:none;padding: 5px 30px 24px;} 
.ingredients_content .accordion { margin: 0; background: #fff; border-radius: 20px; box-shadow: 0 7px 28px hwb(0deg 57% 43% / 30%);margin-bottom:16px; } 
.ingredients_content .accordion_head { font-size: 22px; font-weight: 700;line-height:1.15;padding:24px 30px; } 
.ingredients_content .accordion_content p { margin: 0; font-weight: 500;font-size:18px;line-height:2; } 
.ingredients_content .accordion_content ul { margin: 0;padding-left:20px; } 
.ingredients_content .accordion_content ul li::marker { color: #CB342C; } 
.ingredients_content .accordions { width: 100%; max-width: 458px; }
.accordion_head { background: url('https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Arrows_c1666dd5-de58-42b1-884f-c7dbbd661ff3.png?v=1724759786'); background-repeat: no-repeat; background-position: 95% center; }
.accordion.active .accordion_head { color: #CB342C;background-image: url('https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Frame_513075.png?v=1724759768');padding-bottom:0px; }
.ingredients_content .accordions .swiper-container_supl .swiper-wrapper .accordion.swiper-slide {box-shadow: 0 7px 28px #9191914d; }
.ingredients_content .accordions .swiper-container_supl .swiper-wrapper .accordion.swiper-slide:hover { box-shadow: 0 7px 28px #919191cc; }
.ingredients_content .accordions .swiper-container_supl .swiper-wrapper .accordion.swiper-slide:hover .accordion_head { color:#cb342c;}


  /* ingredients end*/

  @media screen and (min-width:767px) {
    .instafeeds .ingredients_content.tab_content .card_wrapper > div {flex-basis:50%;max-width:50%;}
    .instafeeds .ingredients_content.tab_content .accordions h2.title.h1 + p { font-size: 18px; text-align: center; line-height: 1.3; margin-bottom: 40px;padding:0 30px; }

  }

  @media screen and (max-width:1250px) and (min-width:767px) {
  .instafeeds h2.title.h1 p { font-size:clamp(1rem, 3.056vw, 44px); }
  .home_insta .ingredients_content.tab_content .card_wrapper .insta_col { padding:40px; }
  .instafeeds .ingredients_content.tab_content { padding: 15px; padding-bottom:0;} 
  .insta_col::before { content: ""; width: 65vw; } 
  .insta_col::before { content: ""; width: 65vw; }
  .insta_col .feed_wrapper > img:first-of-type { max-width: 70%; }
  .insta_col .feed_wrapper .social_wrapper .social_field p { font-size: 12px; }
  .insta_col .feed_wrapper .social_wrapper { right:  0px; }
  img.insta_component_img { max-width: 100px; right: 70px; }
  .instafeeds .ingredients_content.tab_content .card_wrapper > div { justify-content:center;}
  }
    
@media screen and (max-width:989px) {
    
/* faqInsta start */
body .instafeeds .ingredients_content.tab_content { padding: 0; } 
body .home_insta .ingredients_content.tab_content .card_wrapper .left_col { padding-top: 0; z-index: 9; } 
body .instafeeds .ingredients_content.tab_content .accordions::before { display: none; } 
body .instafeeds .ingredients_content.tab_content .card_wrapper .insta_col { padding: 40px 16px 20px; background: #ecf1f4; border-radius: 70px 0 0 0; } 
body .instafeeds h2.title.h1 p { font-size: 24px;padding:0 40px; } 
body .instafeeds .ingredients_content.tab_content .accordions { padding-top: 40px; border-radius: 0 70px 0 0; padding-left: 15px; padding-right: 15px; }
body .instafeeds .ingredients_content.tab_content .accordions h1 { position: relative; z-index: 9999; }  
body .instafeeds .ingredients_content.tab_content .card_wrapper { display: flex;  gap: 0; }
body .instafeeds .insta_col::before { top: auto; bottom: -100px; left: auto; right: 0; }
body .instafeeds .insta_col p{font-size:18px;}
body .instafeeds .ingredients_content .accordion { margin-bottom: 16px; } 
body .faq_insta .ingredients_content .accordion_content p { font-size: 16px; } 
body .faq_insta .ingredients_content .accordion_content { padding-right: 20px; padding-left: 20px; } 
body .instafeeds .ingredients_content .accordion_head { padding: 12px 20px; } 
body .instafeeds .accordions > .title + p { text-align: center; font-size:18px; line-height:1.3; }
 body .instafeeds .insta_col::before { display: none; }
/* faqInsta end */
  
}

 @media screen and (max-width:989px) and (min-width:767px) {
   body .instafeeds .ingredients_content.tab_content .accordions { border-radius: 0; }
   } 

  @media screen and (max-width:767px) {
    body .instafeeds .ingredients_content.tab_content .accordions h2.title { margin-bottom: 0; }
    body .instafeeds .ingredients_content.tab_content .accordions h2.title + p { margin-top: 20px; margin-bottom: 30px; }
    .instafeeds .ingredients_content .accordion .accordion_content {padding-left:20px; padding-right:20px;}
  }
  
</style>  
<!-- Ingredients start  -->
     <div class="faq_insta">
      <div class="ingredients_content tab_content"> 
          <div class="card_wrapper">
            <div class="left_col en">
              <div class="accordions">
                <h2 class="title h1"> {{ section.settings.heading }} </h2> 
                <p> {{ section.settings.description }} </p>
                {% for block in section.blocks %}
                  {% if block.type == 'faq' %}
               <div class="accordion">
                 <div class="accordion_head"> {{ block.settings.en_title }}</div>
                 <div class="accordion_content">
                   <p>{{ block.settings.en_content }}</p>
                  </div>
               </div>
                    {% endif %}
                  {% endfor %}
             </div>
            </div>

               <div class="left_col german">
              <div class="accordions">
                <h2 class="title h1"> {{ section.settings.heading }} </h2> 
                <p> {{ section.settings.description }} </p>
                {% for block in section.blocks %}
                   {% if block.type == 'faq' %}
               <div class="accordion">
                 <div class="accordion_head"> {{ block.settings.de_title }}</div>
                 <div class="accordion_content">
                   <p>{{ block.settings.de_content }}</p>
                  </div>
               </div> 
                     {% endif %}
                  {% endfor%}
             </div>
            </div>
            
             <div class="insta_col"> 
               <h2 class="title h1"> {{ section.settings.sub_heading }} </h2> 
               <p class=""> #bywomenforwomen </p>
                  <div class="feed_wrapper">
                 <img class="" 
                  data-class="LazyLoad" 
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                  data-src="{{ section.settings.insta_feed | img_url: 'master' }}">
                {%- if section.settings.insta_component_img  %}
                 <img class="insta_component_img"
                  data-class="LazyLoad" 
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                   data-src="{{ section.settings.insta_component_img | img_url: 'master' }}">
                 {%- endif -%}
                   <div class="social_wrapper"> 
                      {%- for block in section.blocks -%}
                       {% if block.type == 'Socialicons' %}
                        <div class="social_field">  
                          <img class="social_icon" 
                            data-class="LazyLoad" 
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                  data-src="{{ block.settings.social_image | img_url: 'master' }}"> 
                          <p> <a href="{{ block.settings.social_link }}"> {{ block.settings.soical_text }} </a></p>
                        </div>
                       {% endif %}
                      {% endfor %}
                 </div>
               </div>
             </div>
           </div>
      </div>
       </div>
       <!-- Ingredients end  -->

{% schema %}
  {
    "name": "FAQ Insta",
    "class":"instafeeds",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading"
      },
       {
        "type": "richtext",
        "id": "sub_heading",
        "label": "Insta Heading"
      },
      {
        "type": "richtext",
        "id": "left_sub_heading",
        "label": "Left Heading"
      },
      {
        "type": "inline_richtext",
        "id": "left_description",
        "label": "Left Description"
      },
       {
        "type": "image_picker",
        "id": "insta_feed",
        "label": "Insta Image"
      },
      {
        "type": "image_picker",
        "id": "insta_component_img",
        "label": "Insta Component Image"
      },
      {
        "type": "image_picker",
        "id": "btn_arrow",
        "label": "Button icon"
      },
       {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.all.button_label.label",
          "info": "t:sections.all.button_label.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button_link.label"
        },
       {
        "type": "inline_richtext",
        "id": "description",
        "label": "Description"
      }
    ],
     "blocks": [
    {
      "type": "Socialicons",
      "name": "Social Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "social_image",
          "label": "Social Image"
        }, 
        {
          "type": "text",
          "id": "soical_text",
          "label": "Social Text"
        },
         {
          "type": "text",
          "id": "social_link",
          "label": "Social Link"
        }
      ]
    },
           {
      "type": "faq",
      "name": "Accordion FAQ",
      "settings": [
        {
          "type": "text",
          "id": "en_title",
          "label": "Add UK Title"
        }, 
       {
          "type": "richtext",
          "id": "en_content",
          "label": "Add UK Content"
        }, 
          {
          "type": "text",
          "id": "de_title",
          "label": "Add DE Title"
        }, 
          {
          "type": "richtext",
          "id": "de_content",
          "label": "Add DE Content"
        } 
      ]
    }
     ],
        "presets": [
      {
        "name": "FAQ Insta"
      }
    ]
  }
{% endschema %}

