{{ 'section-content-item.css' | asset_url | stylesheet_tag }}

<section class="page-width">
    <div class="content-item content-item--reverse">
        <div class="content-side">
            <div class="content-side-title">
                <h4>{{ section.settings.title }}</h4>
                <span class="content-side-free">{{ section.settings.free }}</span>
            </div>
    
            <div class="content-side-text-wrapper">
                <p class="content-side-text">{{ section.settings.text1 }}</p>
                <p class="content-side-text content-side-text--bold">
                    {{ section.settings.text2 }}
                </p>
            </div>
    
            <div class="content-buttons-wrapper">
                <div class="content-buttons">
                    <a
                    href="{{ section.settings.url_1 }}"
                    id="cta-hero"
                    class="button button--black">
                    {{ section.settings.label_1 }}
                    <svg
                      width="7"
                      height="12"
                      viewBox="0 0 7 12"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523"
                        stroke="white"
                        stroke-width="1.5" />
                    </svg>
                  </a>

                  {% assign url = "https://cdn.shopify.com/s/files/1/0708/7462/8371/files/CycleGuide_Example_EN_1.pdf?v=1688550225" %}
                  {% assign id = "cycle-guide-en" %}

                  {% if localization.language.iso_code == "de" %}
                    {% assign url = "https://cdn.shopify.com/s/files/1/0708/7462/8371/files/CycleGuide_Example_DE.pdf?v=1688550226" %}
                    {% assign id = "cycle-guide-de" %}
                  {% endif %}

                  <a href="{{ url }}" id="{{ id }}" target="_blank" download class="download-button">
                    <svg width="13" height="16" viewBox="0 0 13 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11.8782 14.1543V15.666C11.8782 15.7791 11.7741 15.8711 11.6455 15.8711H0.715827C0.587192 15.8711 0.483153 15.7791 0.483153 15.666V14.1543C0.483153 14.0412 0.587192 13.9492 0.715827 13.9492H11.6455C11.7741 13.9492 11.8782 14.0412 11.8782 14.1543ZM12.163 7.5168C12.1268 7.44033 12.042 7.39023 11.948 7.39023H8.99236V1.07617C8.99236 0.963086 8.88799 0.871094 8.75935 0.871094H3.60198C3.47334 0.871094 3.36897 0.963086 3.36897 1.07617V7.39023H0.413351C0.319285 7.39023 0.234525 7.44033 0.198294 7.5168C0.162396 7.59355 0.18234 7.68174 0.248818 7.74062L6.01613 12.8236C6.05967 12.8623 6.11884 12.884 6.18066 12.884C6.24249 12.884 6.30165 12.8623 6.3452 12.8236L12.1125 7.74062C12.179 7.68174 12.1989 7.59355 12.163 7.5168Z" fill="#252A31"/>
                    </svg>

                    {{ section.settings.label_2 }}
                  </a>
                </div>
            </div>
        </div>
    
        <img class="visual-side" src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/cycle-guide.png?v=1688546155" alt="Cycle guide">
    </div>
</section>

{% schema %}
    {
      "name": "cycle-guide",
      "tag": "section",
      "class": "section",
      "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Your Cycle Guide"
        },
        {
            "type": "text",
            "id": "free",
            "label": "Free",
            "default": "Free"
        },
        {
            "type": "text",
            "id": "text1",
            "label": "Text 1",
            "default": "Gain a deeper understanding of your unique symptoms and optimal product usage in your personalised cycle guide, expertly created based on insights from your quiz."
        },
        {
            "type": "text",
            "id": "text2",
            "label": "Text 2",
            "default": "Free with your first purchase in .pdf and print"
        },
        {
            "type": "url",
            "id": "url_1",
            "label": "URL 1"
        },
        {
            "type": "text",
            "id": "label_1",
            "label": "Label 1",
            "default": "Take the quiz"
        },
        {
            "type": "url",
            "id": "url_2",
            "label": "URL 2"
        },
        {
            "type": "text",
            "id": "label_2",
            "label": "Label 2",
            "default": "Download example"
        }
      ],
      "presets": [
        {
          "name": "cycle-guide"
        }
      ]
    }
  {% endschema %}