<link rel="stylesheet" href="{{ 'timeline.css' | asset_url }}">
<section class="timeline-section">
  <h2>
    {{ section.settings.heading }}
  </h2>

  <div class="timeline-wrapper">
    <!-- Left Image -->
    <div class="timeline-image">
      <img
        data-class="LazyLoad" 
        src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
        data-src="{{ section.settings.main_image | image_url:width:1000 }}"
        data-mob-src="{{ section.settings.main_image | image_url:500 }}"
        alt="{{ section.settings.main_image.alt }}"
        width="100%"
        height="100%"
        class="graph-image"
      >
    </div>

    <!-- Right Content -->
    <div class="timeline-content">
      {% for block in section.blocks %}
        <div class="timeline-box">
          <div class="timeline-cld">
            <img
              data-class="LazyLoad" 
              src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
              data-src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Calendar_{{ forloop.index }}.svg?v=1744285088"
              alt=""
              width="100%"
              height="100%"
              class="calendar-icon"
            >
          </div>
          <div class="box-text">
            <h4>{{ block.settings.cycle_heading }}</h4>
            <p>
              {{ block.settings.cycle_text | replace: '<p>', '' | replace: '</p>', '' }}
            </p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="timeline-btm">
    <p class="disclaimer">
      {{ section.settings.cycle_paragraph }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Timeline section",
  "class": "cst-product-timeline-sec",
  "settings": [
      {
        "type": "html",
        "id": "heading",
        "label": "Heading"
      },
      {
         "type":"image_picker",
         "id":"main_image",
         "label":"Image"
      },
      {
         "type":"richtext",
         "id":"cycle_paragraph",
         "label":"Paragraph"
      }
  ],
  "blocks":[
      {
         "type":"cycle",
         "name":"Cycle",
          "limit": 3,
         "settings":[
            {
               "type":"text",
               "id":"cycle_heading",
               "label":"Cycle heading"
            },
            {
               "type":"richtext",
               "id":"cycle_text",
               "label":"Cycle Text"
            }
         ]
      }
   ],
  "presets": [
    {
    "name": "Timeline section"
    }
  ]
}
{% endschema %}
