{%- if section.blocks.size > 0 -%}
  {{ 'section-custom-features.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign background_color = section.settings.background_color
    assign text_color = section.settings.text_color
    assign image_position = section.settings.image_position
    assign main_image = section.settings.image
    assign mobile_image = section.settings.image_mobile
    assign title = section.settings.title
    assign custom_icon = section.settings.custom_icon
    assign badge_blocks = section.blocks | where: "type", "badge"
    assign feature_blocks = section.blocks | where: "type", "feature_item"
    assign button_blocks = section.blocks | where: "type", "custom_button"
  -%}

  {% render 'section-paddings',
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom,
    padding_top_mobile: section.settings.padding_top_mobile,
    padding_bottom_mobile: section.settings.padding_bottom_mobile
  %}

  <section class="app-features section-{{ section.id }} section-{{ section.id }}--padding page-width" style="
    --section-background: {{ background_color |  default: '#ECF1F4' }};
    --section-color: {{ text_color |  default: '#404040' }};
  ">
    <div class="app-features__container page-width {% if image_position == 'right' %}app-features__container--reverse{% endif %}">

      {%- if badge_blocks.size > 0 -%}
        <div class="app-features__badges">
          {%- for block in badge_blocks -%}
            {%- if block.settings.badge_image != blank -%}
              <a href="{{ block.settings.url }}" class="app-features__badge-link" {{ block.shopify_attributes }}>
                {{ block.settings.badge_image | image_url: width: nil | image_tag: loading: 'lazy' }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if main_image != blank -%}
        <div class="app-features__image">
          <picture>
            {%- if mobile_image != blank -%}
              <source
                media="(max-width: 899px)"
                srcset="{{ mobile_image | image_url: width: 400 }} 400w, {{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 800 }} 800w"
                sizes="100vw"
              >
            {%- endif -%}

            {{ main_image | image_url: width: 1200 | image_tag:
              class: 'app-features__img',
              loading: 'lazy',
              widths: '400, 800, 1200',
              sizes: '(min-width: 900px) 50vw, 100vw'
            }}
          </picture>
        </div>
      {%- endif -%}

      <div class="app-features__content">
        {%- if title != blank -%}
          <h2 class="app-features__title">{{ title }}</h2>
        {%- endif -%}

        {%- if feature_blocks.size > 0 -%}
          <ul class="app-features__list">
            {%- for block in feature_blocks -%}
              <li class="app-features__item" {{ block.shopify_attributes }}>
                {%- if custom_icon != blank -%}
                  <div class="app-features__icon">
                    {{ custom_icon | image_url: width: 120 | image_tag:
                      loading: 'lazy',
                      alt: custom_icon.alt | escape
                    }}
                  </div>
                {%- endif -%}

                {%- if block.settings.richtext != blank -%}
                  <div class="app-features__text">
                    {{ block.settings.richtext }}
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if button_blocks.size > 0 -%}
          <div class="app-features__actions">
            {%- for block in button_blocks -%}
              {%- if block.settings.label != blank -%}
                <a href="{{ block.settings.url | default: '#' }}"
                  class="app-features__btn"
                  {{ block.shopify_attributes }}
                  style="
                    --button-background: {{ block.settings.button_background | default: '#CB342C' }};
                    --button-text: {{ block.settings.button_text | default: '#ffffff' }};
                    --button-border: {{ block.settings.button_border_color | default: '#CB342C' }};
                    --button-radius: {{ block.settings.button_radius | default: 40 }}px;
                  "
                >
                  {{ block.settings.label | escape }}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "App Features",
  "settings": [
    {
      "type": "header",
      "content": "Image settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Main image (Mobile)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "App features"
    },
    {
      "type": "header",
      "content": "List icon"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Checkmark icon"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ECF1F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#404040"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Item",
      "settings": [
        {
          "type": "richtext",
          "id": "richtext",
          "label": "Text",
          "default": "<p>Feature description</p>"
        }
      ]
    },
    {
      "type": "custom_button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Background Color",
          "default": "#CB342C"
        },
        {
          "type": "color",
          "id": "button_text",
          "label": "Text Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_border_color",
          "label": "Border Color",
          "default": "#CB342C"
        },
        {
          "type": "range",
          "id": "button_radius",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "px",
          "label": "Border Radius",
          "default": 40
        }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "badge_image",
          "label": "Badge Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Badge Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "App Features",
      "blocks": [
        {
          "type": "feature_item"
        },
        {
          "type": "feature_item"
        },
        {
          "type": "custom_button"
        }
      ]
    }
  ]
}
{% endschema %}