    object-fit: cover;
    border-radius: 20px;
}
.sorgfaltig .faq-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
}
.sorgfaltig .svg-wrapper {
    width: 44px !important;
    height: 44px;
    background: #ecf1f4;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}
.sorgfaltig .faq-header svg {
