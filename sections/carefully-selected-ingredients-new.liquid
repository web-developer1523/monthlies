    margin-bottom: 16px;
    max-width: 300px;
    font-family: Lora, serif !important;
}
.sorgfaltig .sorgfaltig-content h2 strong {
    font-family: Lora, serif !important;
    color: #cb342c;
}
.sorgfaltig .sorgfaltig-content .button-wrapper-links a {
    color: #404040;
}
.sorgfaltig .sorgfaltig-content p {
    color: #404040;
    text-align: left;
    font-family: "Quicksand", sans-serif;
    font-size: 20px;
    line-height: 1.4;
    font-weight: 400;
    width: 100%;
    max-width: 505px;
    margin-bottom: 0 !important;
    margin-top: 0;
}
.sorgfaltig .faq-content p {
    color: #404040 !important;
    text-align: left;
    font-size: 19px !important;
    line-height: 140% !important;
    font-weight: 400;
}
.sorgfaltig .faq-box {
    margin-top: 0;
}

.sorgfaltig .sorgfaltig-grid-inner {
