}

@media (max-width: 1200px) {
    .sorgfaltig .sorgfaltig-container {
        padding: 56px 16px;
    }
.sorgfaltig .sorgfaltig-content h2{
      font-size: 34px;
}

    .sorgfaltig .sorgfaltig-content p {
        font-size: 16px;
    }

    .sorgfaltig .faq-header span {
        font-size: 16px;
    }

   .sorgfaltig  .faq-content p {
        font-size: 16px !important;
    }
}
@media (max-width: 1023px) {
     .sorgfaltig .sorgfaltig-grid {
        grid-template-columns: 1fr;
    }

    .sorgfaltig .sorgfaltig-img img {
        width: 100%;
    }

    .sorgfaltig .sorgfaltig-img-content {
        padding: 20px 0;
    }
    .sorgfaltig .faq-header span {
        font-size: 16px !important;
    }
   .sorgfaltig  a.cst-btn-faq {
        display: none;
    }
}

@media (max-width: 767px) {
    .sorgfaltig .sorgfaltig-img img {
        height: 150px;
        object-fit: cover;
        border-radius: 20px;
        width: 100%;
    }
}
@media (max-width:575px) {
.sorgfaltig .sorgfaltig-content h2{
      font-size: 24px;
}
.cst-custom-homepage-new .faq-header{
    padding: 10px 16px 10px 24px;
}
.sorgfaltig-content   .button-wrapper-links {
    gap: 30px;
}
}
    
</style>
<script>
  const faqItems = document.querySelectorAll(".faq-item");
  
  faqItems.forEach(item => {
      const header = item.querySelector(".faq-header");
      const content = item.querySelector(".faq-content");
      const svg = item.querySelector("svg");
  
      header.addEventListener("click", () => {
  
          // Close all others
          faqItems.forEach(other => {
              if (other !== item) {
                  other.querySelector(".faq-content").style.maxHeight = "0";
                  other.querySelector("svg").style.transform = "rotate(0deg)";
              }
          });
  
          // Toggle this one
          if (content.style.maxHeight && content.style.maxHeight !== "0px") {
              content.style.maxHeight = "0";
              svg.style.transform = "rotate(0deg)";
          } else {
              content.style.maxHeight = content.scrollHeight + "px";
              svg.style.transform = "rotate(180deg)";
          }
      });
  });
  </script>
  
{% schema %}
{
  "name": "Carefully Ingredients New",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Sorgfältig ausgewählte Inhaltsstoffe"
    },
    {
      "type": "richtext",
      "id": "main_paragraph_1",
      "label": "Paragraph 1",
      "default": "<p>Gesunde Hormone benötigen eine kontinuierliche Versorgung mit essenziellen Nährstoffen und einen gesunden Lebensstil.</p>"
    },
    {
      "type": "richtext",
      "id": "main_paragraph_2",
      "label": "Paragraph 2",
      "default": "<p>Aus diesem Grund haben wir monthlies entwickelt.</p>"
    },
    {
        "type": "text",
        "id": "btn_text",
        "label": "Button text"
    },
    {
        "type": "url",
        "id": "btn_url",
        "label": "Button Url"
    }
  ],

  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "faq_title",
          "label": "FAQ Title",
          "default": "Reine Nährstoffe ohne Kompromisse - perfekt für dich"
        },
        {
          "type": "richtext",
          "id": "faq_text",
          "label": "FAQ Content"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "ingredient_image",
          "label": "Ingredient Image"
        },
        {
            "type": "url",
            "id": "link_url",
            "label": "Ingredient Url"
        },
        {
          "type": "text",
          "id": "ingredient_label",
          "label": "Small Label (e.g., Zitronenmelisse)",
          "default": "Ingredient Label"
        },
        {
          "type": "text",
          "id": "ingredient_title",
          "label": "Heading",
          "default": "Ingredient title"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Carefully Ingredients New"
    }
  ]
}
{% endschema %}
