<section class="sorgfaltig">
    <div class="container">
        <div class="sorgfaltig-container">
            <div class="sorgfaltig-grid">
                <div class="sorgfaltig-grid-item">
                    <div class="sorgfaltig-content">
                        <h2>{{ section.settings.main_heading }}</h2>
                        <div class="button-wrapper-links">
                        <p>{{ section.settings.main_paragraph_1 | replace: '<p>','' | replace: '</p>','' }}<span><img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Group_514149.png?v=1765453091"/></span></p>
                        <p>{{ section.settings.main_paragraph_2 | replace: '<p>','' | replace: '</p>','' }}<span><img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Group_514149.png?v=1765453091"/></span></p>
                        </div>
                    </div>
                </div>

                <div class="sorgfaltig-grid-item">
                    <div class="faq-box">
                        {% for block in section.blocks %}
                            {% if block.type == 'faq' %}
                            <div class="faq-item">
                                <div class="faq-header">
                                    <span>{{ block.settings.faq_title }}</span>
                                    <div class="svg-wrapper">
                                      <svg xmlns="http://www.w3.org/2000/svg" width="12" height="21" viewBox="0 0 12 21" fill="none">
                                        <path d="M12 10.0806L2.87909 20.1611L2.87909 15.9609L7.19953 10.0806L2.87909 4.20023L2.87909 -3.48836e-07L12 10.0806Z" fill="#CB342C"/>
                                        <path d="M9.12109 10.0806L0.000185913 20.1611L0.000186123 15.9609L4.32062 10.0806L0.000185757 4.20023L0.000185966 -3.48836e-07L9.12109 10.0806Z" fill="#96B8B5"/>
                                        </svg>
                                    </div>
                                </div>
                                <div class="faq-content">
                                    {{ block.settings.faq_text }}
                                </div>
                            </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <a href="{{section.settings.btn_url }}" class="cst-btn-faq">{{section.settings.btn_text }}</a>

                    {% comment %} <div class="sorgfaltig-grid-inner">
                        {% for block in section.blocks %}
                            {% if block.type == 'ingredient' %}
                            <div class="sorgfaltig-box">
                                <div class="sorgfaltig-img">
                                    <a href="{{ block.settings.link_url }}"><img src="{{ block.settings.ingredient_image | img_url: 'medium' }}" alt=""></a>
                                    <div class="plus-icon">
                                      <a href="{{ block.settings.link_url }}">
                                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                                        <path d="M7.75 0.75V14.75M0.75 7.75004H14.75" stroke="#404040" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                      </a>
                                    </div>
                                </div>
                                <div class="sorgfaltig-img-content">
                                    <span>{{ block.settings.ingredient_label }}</span>
                                    <h3>{{ block.settings.ingredient_title }}</h3>
                                </div>
                            </div>
                            {% endif %}
                        {% endfor %}
                    </div> {% endcomment %}

                </div>
            </div>
        </div>
    </div>
</section>

<style>
 .cst-custom-homepage-new  .kann-ich-monthlies-einnehmen {
    border-radius: 20px;
    padding: 96px 20px !important;
    margin: 0 auto;
    max-width: 1440px;
