    border-radius: 16px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 8px;
    right: 8px;
    left: auto;
    transform: translateX(0);
}
.sorgfaltig-content .button-wrapper-links span {
    margin-left: 10px;
}
.sorgfaltig .sorgfaltig-container {
     background: #ABD0CD;
    border-radius: 20px;
    padding: 70px 70px 50px ;
}

.sorgfaltig .sorgfaltig-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
}

.sorgfaltig .sorgfaltig-content h2 {
    font-weight: 600;
    color: #404040;
    text-align: left;
    font-size: 40px;
    letter-spacing: -0.02em;
