
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css" />
<div class="section-wrapper">

      
    <div class="grid-mainflex">
  <div class="grid-insta-wrapper">
    <h1>{{ section.settings.heading_main }}</h1>
    <h2>{{ section.settings.heading_sub }}</h2>
</div>
    <div class="buttons instafeedone appco_bg">
    <div class="buttons innerinsta">
        <a href="" class="button-item">
            
            <img src="//28x0yj2hddoy41t5-70874628371.shopifypreview.com/cdn/shop/files/Instagram_png.svg?v=1765452306">
             Follow on Instagram
        </a>

        <a href="" class="button-item">
            
            <img src="//28x0yj2hddoy41t5-70874628371.shopifypreview.com/cdn/shop/files/tiktok_png.svg?v=1765452335">
             Follow on TikTok
        </a>
      </div>
      <div class="hashtag">{{ section.settings.hashtag_text }}</div>
    </div>
</div>
    <div class="image-row">
        <img src="{{ section.settings.desktop_img_1 | image_url }}" />
        <img src="{{ section.settings.desktop_img_2 | image_url }}" />
        <img src="{{ section.settings.desktop_img_3 | image_url }}" />
        <img src="{{ section.settings.desktop_img_4 | image_url }}" />
        <img src="{{ section.settings.desktop_img_5 | image_url }}" />
    </div>

 <div class="mobile-slider">
    <div><img src="{{ section.settings.mobile_img_1 | image_url }}" /></div>
    <div><img src="{{ section.settings.mobile_img_2 | image_url }}" /></div>
    <div><img src="{{ section.settings.mobile_img_3 | image_url }}" /></div>
    <div><img src="{{ section.settings.mobile_img_4 | image_url }}" /></div>
    <div><img src="{{ section.settings.mobile_img_5 | image_url }}" /></div>
</div>

    <div class="buttons desktop">
        <a href="{{ section.settings.instagram_link }}" class="button-item">
            {% if section.settings.instagram_icon %}
            <img src="{{ section.settings.instagram_icon | image_url }}" />
            {% endif %} {{ section.settings.instagram_text }}
        </a>

        <a href="{{ section.settings.tiktok_link }}" class="button-item">
            {% if section.settings.tiktok_icon %}
            <img src="{{ section.settings.tiktok_icon | image_url }}" />
            {% endif %} {{ section.settings.tiktok_text }}
        </a>
    </div>
</div>


<style>
  .buttons.desktop {
    display: none;
}
.buttons.instafeedone {
    display: flex;
    justify-content: start;
    gap: 4px;
    margin-top: 0;
    flex-direction: column;
    align-items: start;
}
  .grid-mainflex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
}
  .mobile-slider.slick-initialized {
    display: none;
}
.grid-insta-wrapper {
    display: flex;
    flex-direction: column;
    align-items: baseline;
}
.section-wrapper {
    max-width: 100%;
    margin: 0 auto;
    text-align: center;
    padding: 40px 0;
}
.section-wrapper h1 {
    font-size: 40px;
    letter-spacing: 0;
    margin: 0;
    font-weight: 600;
}
.section-wrapper h2 {
    font-size: 38px;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0;
    font-style: italic;
}
.hashtag {
    color: #CB342C;
    font-size: 19px;
    font-weight: 400;
}
.image-row {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 20px;
}
.image-row img {
    max-width: 100%;
    height: 389px;
    object-fit: cover;
    border-radius: 20px;
    width: 100%;
}
.buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
}
.button-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #404040;
    text-decoration: none;
    font-weight: 400;
    background: #fff;
    padding: 14px 22px;
    border-radius: 40px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    font-size: 16px;
}
.button-item img {
    width: 24px;
}
/* Mobile slider */
@media(max-width:991px) {
    .section-wrapper h1 {
        font-size: 34px; 
    }

     .section-wrapper h2 {
        font-size:34px;
    }
  .buttons.desktop {
    display: inline-flex;
}
.buttons.innerinsta{
display:none;
}

}
@media(max-width: 768px) {
  .grid-insta-wrapper {
    align-items: center;
}
  .grid-mainflex {
        padding: 0 20px 25px;
    flex-direction:column;
}
   .image-row {
        display: none;
    }

.mobile-slider.slick-initialized{
        display: block;
    }
    .mobile-slider .slick-slide {
    padding: 6px;
}
.section-wrapper {
    padding: 40px 0;
}

    .mobile-slider img {
        width: 100%;
        height: 200px; 
        object-fit: cover;
        border-radius: 8px;
    }

    .section-wrapper h1 {
        font-size: 24px; 
        font-weight: 600;
        margin-bottom: 0;
    }

     .section-wrapper h2 {
        font-size: 24px;
        margin-bottom: 8px;
    }
    .buttons {
        flex-direction: row;
        justify-content: center;
        gap: 12px;
    }

     .button-item {
        background: #fff;
        padding: 10px 14px;
        font-size: 14px;
        gap: 6px;
    }

    .button-item img {
        width: 20px;
        height: 20px;
    }
}
@media(max-width: 480px) {
    .mobile-slider img {
        width: 100%;
        height: 120px;
        object-fit: cover;
        border-radius: 12px;
    }
  }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
<script>
$(document).ready(function(){
    $('.mobile-slider').slick({
        arrows: false,
        dots: false,
        slidesToShow: 4,   // show 4 slides at once
        slidesToScroll: 4, // scroll 4 slides at a time
        autoplay: false,
        responsive: [
            {
                breakpoint: 480,
                settings: {
                    slidesToShow:4,
                    slidesToScroll: 2
                }
            }
        ]
    });
});
</script>
