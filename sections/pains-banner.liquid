{{ 'section-pains-banner.css' | asset_url | stylesheet_tag }}

<div class="pains-flex-container pains ctas-en">
  <span>{{ section.settings.pain }}</span>
  <span>{{ section.settings.pain_2 }}</span>
  <span>{{ section.settings.pain_3 }}</span>
  <span>{{ section.settings.pain_4 }}</span>
</div>


{% schema %}
  {
    "name": "pains-banner",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "label": "Pain",
        "id": "pain",
        "default": "Cramps"
      }, {
        "type": "text",
        "label": "Pain",
        "id": "pain_2",
        "default": "Mood Swings"
      }, {
        "type": "text",
        "label": "Pain",
        "id": "pain_3",
        "default": "Sleep"
      }, {
        "type": "text",
        "label": "Pain",
        "id": "pain_4",
        "default": "Bloating"
      }
    ],
    "presets": [
      {
        "name": "pains banner"
      }
    ]
  }
{% endschema %}