{{ 'section-founders-and-experts.css' | asset_url | stylesheet_tag }}

{% capture slider_settings %}
	{
    "slidesPerView": 1,
    "allowTouchMove": true,
		"effect": "cards",
    "pagination": {
      "el": ".founders-and-experts__swiper-pagination",
      "clickable": true
    },
    "breakpoints": {
      "768": {
        "allowTouchMove": false
      }
    }
	}
{% endcapture  %}

{%- liquid
  assign image_mobile = section.settings.image_desktop | image_url

  unless section.settings.image_mobile == blank
    assign image_mobile = section.settings.image_mobile | image_url
  endunless
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --founders-and-experts-border-radius: {{ section.settings.radius_top_left_desktop }}px;
    --founders-and-experts-text-color: {{ section.settings.text_color }};
    --founders-and-experts-accent-background-image: url("{{ image_mobile }}");
    --founders-and-experts-accent-background: {{ section.settings.accent_background }};
    --founders-and-experts-main-background: {{ section.settings.main_background }};
    --founders-and-experts-subheading-color: {{ section.settings.subheading_color }};
    --founders-and-experts-margin-top: {{ section.settings.margin_top }}px;

    @media screen and (max-width: 768px) {
      --founders-and-experts-border-radius: {{ section.settings.radius_top_left_mobile }}px;
    }
  }
{% endstyle %}

<div class="founders-and-experts__wrapper">
  <div class="founders-and-experts__container">
    <div class="founders-and-experts__info">
      {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.text != blank -%}
        <div class="founders-and-experts__content">
          {%- unless section.settings.heading == blank -%}
            <h2 class="founders-and-experts__heading">{{ section.settings.heading }}</h2>
          {%- endunless -%}

          {%- unless section.settings.subheading == blank -%}
            <h4 class="founders-and-experts__subheading">{{ section.settings.subheading }}</h4>
          {%- endunless -%}

          {%- unless section.settings.text == blank -%}
            <p class="founders-and-experts__text">{{ section.settings.text }}</p>
          {%- endunless -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="swiper founders-and-experts__swiper" {% render 'slider-attribute', config: slider_settings %}>
          <div class="swiper-wrapper founders-and-experts__card-list">
            {%- for block in section.blocks -%}
              <div class="swiper-slide founders-and-experts__expert-card">
                {%- unless block.settings.card_avatar == blank -%}
                  {{ block.settings.card_avatar 
                    | image_url: width: block.settings.card_avatar.width 
                    | image_tag: class: 'expert-card__avatar', loading: 'lazy' }}
                {%- endunless -%}

                {%- unless block.settings.card_content == blank -%}
                  <div class="expert-card__content">{{ block.settings.card_content }}</div>
                {%- endunless -%}

                {%- unless block.settings.card_button_text == blank -%}
                  <modal-opener class="expert-card__popup-trigger" data-modal="#PopupModal-{{ block.id }}">{{ block.settings.card_button_text }}</modal-opener>
                {%- endunless -%}
              </div>
            {%- endfor -%}
          </div>

          <div class="founders-and-experts__swiper-pagination"></div>
        </div>

        {%- for block in section.blocks -%}
          {%- if block.settings.popup_avatar != blank or block.settings.popup_content != blank -%}
            <modal-dialog 
              id="PopupModal-{{ block.id }}" 
              class="founders-and-experts__popup" 
              style="
              --founders-and-experts-popup-content-backround: {{ section.settings.popup_content_background }};
              --founders-and-experts-popup-content-color: {{ section.settings.popup_content_color }};
              --founders-and-experts-popup-overlay-opacity: {{ section.settings.popup_overlay_opacity }}%;
              --founders-and-experts-popup-overlay-color-rgb: {{ section.settings.popup_overlay_color.rgb }};
              ">
              <button
                id="ModalClose-{{ block.id }}"
                type="button"
                class="founders-and-experts__popup-toggle"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                {%- render 'icon-close' -%}
              </button>

              <div class="founders-and-experts__content">
                {%- unless block.settings.popup_avatar == blank -%}
                  {{ block.settings.popup_avatar 
                      | image_url: width: block.settings.popup_avatar.width
                      | image_tag: class: 'founders-and-experts__content-media', loading: 'lazy'  }}
                {%- endunless -%}

                {%- unless block.settings.popup_content == blank -%}
                  <div class="founders-and-experts__content-text">
                    {{ block.settings.popup_content }}
                  </div>                      
                {%- endunless -%}
              </div>
            </modal-dialog>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- unless section.settings.image_desktop == blank -%}
      <div class="founders-and-experts__media-wrapper">
        <picture>
          {%- unless section.settings.image_mobile == blank -%}
            <source srcset="{{ section.settings.image_mobile | image_url }}" media="(max-width: 768px)">
          {%- endunless -%}

          {{ section.settings.image_desktop 
            | image_url: width: section.settings.image_desktop.width 
            | image_tag: class: 'founders-and-experts__media', loading: 'lazy' }}
        </picture>
      </div>
    {%- endunless -%}
  </div>
</div>

{% schema %}
{
  "name": "Founders & Experts",
  "tag": "section",
  "class": "founders-and-experts",
  "settings": [
    {
      "type": "color",
      "id": "main_background",
      "label": "Main background",
      "default": "#ECF1F4"
    },
    {
      "type": "color",
      "id": "accent_background",
      "label": "Accent background",
      "default": "#ABD0CD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#404040"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": -100,
      "max": 0,
      "default": 0,
      "unit": "px",
      "step": 1
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile (optional)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "3 Frauen, 3 Kontinente"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Entwickelt von Frauen, für Frauen"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#CB342C"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "monthlies ist eine wegweisende Marke für Frauengesundheit, gegründet von Expertinnen, die sich der Verbesserung der Menstruationsgesundheit verschrieben hat."
    },
    {
      "type": "header",
      "content": "Border radius"
    },
    {
      "type": "range",
      "id": "radius_top_left_desktop",
      "label": "Radius top left desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius_top_left_mobile",
      "label": "Radius top left mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Popup"
    },
    {
      "type": "range",
      "id": "popup_overlay_opacity",
      "label": "Overlay opacity",
      "min": 1,
      "max": 100,
      "default": 80,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "popup_overlay_color",
      "label": "Overlay color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "popup_content_background",
      "label": "Content background",
      "default": "#FFF"
    },
    {
      "type": "color",
      "id": "popup_content_color",
      "label": "Content color",
      "default": "#000"
    }
  ],
  "blocks": [
    {
      "type": "card_popup",
      "name": "Card & Popup",
      "settings": [
        {
          "type": "header",
          "content": "Card"
        },
        {
          "type": "image_picker",
          "id": "card_avatar",
          "label": "Avatar"
        },
        {
          "type": "richtext",
          "id": "card_content",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "card_button_text",
          "label": "Button text"
        },
        {
          "type": "header",
          "content": "Popup"
        },
        {
          "type": "image_picker",
          "id": "popup_avatar",
          "label": "Avatar"
        },
        {
          "type": "richtext",
          "id": "popup_content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Founders & Experts"
    }
  ]
}
{% endschema %}