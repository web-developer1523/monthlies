  <!-- JQuery + Slick JS -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
  
 <script>
(function($){
  // Utility: whether slider should be active (mobile)
  function isMobile() {
    return window.matchMedia('(max-width: 768.98px)').matches;
  }

  function initSlickIfNeeded() {
    var $slider = $('.benefits-slider');

    if ($slider.length === 0) {
      console.log('benefits-slider element not found');
      return;
    }

// If visible (mobile css shows it), and not initialized -> init
if ($slider.is(':visible') && !$slider.hasClass('slick-initialized') && isMobile()) {
  console.log('Initializing slick slider (mobile).');
  $slider.slick({
    dots: false,
    arrows: false,
    infinite: true,
    slidesToShow: 2,
    slidesToScroll: 1,
    centerMode: true,
    centerPadding: '20px',
    mobileFirst: true,
    adaptiveHeight: true,
 responsive: [

    {
      breakpoint: 320,
      settings: {
        slidesToShow: 1,
        centerPadding: '35px'  
      }
    },

    {
      breakpoint: 480,
      settings: {
        slidesToShow: 2,
        centerPadding: '25px'   // normal side-cut
      }
    },

    {
      breakpoint: 768,
      settings: {
        slidesToShow: 2,
        centerPadding: '15px'
      }
    },

    // Desktop (slider off)
    {
      breakpoint: 9999,
      settings: "unslick"
    }
  ]
  });

  $slider.attr('aria-hidden', 'false');
}
    // If not visible (desktop), but slick was initialized -> destroy it
    else if (!$slider.is(':visible') && $slider.hasClass('slick-initialized')) {
      console.log('Destroying slick (desktop view).');
      $slider.slick('unslick');
      $slider.attr('aria-hidden','true');
    }
  }

  // Run after all assets loaded (images may affect size)
  $(window).on('load', function(){
    try {
      initSlickIfNeeded();
    } catch (e) {
      console.error('Error initializing slick on load:', e);
    }
  });

  // Also handle resize / orientation change
  var resizeTimer;
  $(window).on('resize orientationchange', function(){
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function(){
      try {
        initSlickIfNeeded();
      } catch (e) {
        console.error('Error initializing/destroying slick on resize:', e);
      }
    }, 140);
  });

  // For debugging: log any JS errors
  window.addEventListener('error', function(e){
    console.error('Global JS error:', e.message, e.filename+':'+e.lineno);
  });
})(jQuery);
</script>
  <style>
    section {
      padding: 60px 0;
    }
    /* ---------- TITLE ---------- */
.benefits-title {
    text-align: center;
    font-size: 40px;
    color: #404040;
    line-height: 41px;
    font-weight: 600;
    max-width: 770px;
        font-style: italic;
    margin: 0 auto 56px;
}
    
    .benefits-title em {
      font-style: italic;
    }
    .benefit-text br {
      display: block;
  }
    /* ---------- GRID FOR DESKTOP ---------- */
 .benefits-wrapper-desktop {
    width: 100%;
    max-width: 1440px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
    padding:0 20px 98px;
}
    
    .benefit-card {
      background: #ffffff;
      border-radius: 24px;
      overflow: hidden;
      position: relative;
      padding-bottom: 20px;
    box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .benefit-card img {
      width: 100%;
      display: block;
    }
    
    /* Icon in the circle */
    .benefit-icon {
     {% comment %} width: 45px;
    height: 45px; {% endcomment %}
    background: #8fc7c3;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 23%;
    }
    
    .benefit-icon img {
      width: 45px;
      height: 45px;
    }
    
  .benefit-text {
     text-align: center;
    font-size: 19px;
    font-weight: 600;
    padding: 0 10px;
    line-height: normal;
    margin-top: 30px;
    margin-bottom: 0;
}
    /* ---------- MOBILE SLICK SLIDER ---------- */
    .benefits-slider {
      display: none !important;
    }

    @media (max-width: 1200px) {
      .benefits-title{
         font-size: 34px;
      }
    .benefit-icon {
    bottom: 28%;
}
.benefit-text {
    font-size: 16px;
}
    }
    @media (max-width: 991px) {
    .benefit-icon {
        bottom: 35%;
    }
}
    
    @media (max-width: 768px) {
      /* Hide desktop grid */
      .benefits-wrapper-desktop {
        display: none;
      }
    .benefits-slider  .slick-track{
    display: flex !important;
}
  .benefits-slider .slick-slide
{
    height: inherit !important;
}
      /* Show slick slider */
      .benefit-icon {
        bottom: 15%;
      }
      .benefits-slider {
        display: block !important;
        width: 100%;
        margin: auto;
      }
      .benefit-text {
        font-size: 14px;
      }
      .benefit-card {
        margin: 10px;
      }
      
      .benefits-title {
        font-size: 26px;
        padding: 0 15px;
        margin: 0 auto 30px;
        line-height:normal;
      }
    }
    @media (max-width: 595px) {
            .benefits-title {
        font-size: 24px;
      }
      .benefit-icon {
        bottom: 24%;
      }
      .benefit-text br {
    display: block;
}
    }
    @media (max-width:480px) {
      .benefit-icon img {
    width: 40px;
    height: 40px;
}
        .benefit-icon {
               bottom: 21%;
    }
  .benefit-text {
    font-size: 16px;
    font-weight: 700;
}
    }
      @media (min-width: 320px) and (max-width: 375px) {
          .benefit-icon {
        bottom: 25%;
    }
      }
    </style>
