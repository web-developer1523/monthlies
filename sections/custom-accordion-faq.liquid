{%- if section.blocks.size > 0 -%}
  {{ 'section-custom-accordion-faq.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign link_icon = section.settings.link_icon
    assign heading = section.settings.heading
    assign faq_blocks = section.blocks | where: 'type', 'faq_item'
    assign link_blocks = section.blocks | where: 'type', 'header_link'
  -%}

  {% render 'section-paddings',
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom,
    padding_top_mobile: section.settings.padding_top_mobile,
    padding_bottom_mobile: section.settings.padding_bottom_mobile
  %}

  <section class="faq-tabs section-{{ section.id }}--padding page-width"
    style="
      --background-color: {{ section.settings.background_color }};
      --text-color: {{ section.settings.text_color }};
      --text-color-highlight: {{ section.settings.text_color_highlight }};
    "
  >
    <div class="faq-tabs__container">
      <div class="faq-tabs__header">
        {%- if heading != blank -%}
          <h2 class="faq-tabs__heading">{{ heading }}</h2>
        {%- endif -%}

        {%- if link_blocks.size > 0 -%}
          <div class="faq-tabs__sublinks">
            {%- for block in link_blocks -%}
              {%- if block.settings.link_text != blank -%}
                <a href="{{ block.settings.link_url | default: '#' }}" class="faq-tabs__link" {{ block.shopify_attributes }} style="--link-icon: url({{ link_icon | image_url: width: 40 }});">
                  {{ block.settings.link_text }}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div class="faq-tabs__main">
        {%- for block in faq_blocks -%}
          <div class="faq-tabs__item" {{ block.shopify_attributes }}>
            <input
              type="checkbox"
              id="tab-{{ section.id }}-{{ forloop.index }}"
              class="faq-tabs__input"
            >

            <label for="tab-{{ section.id }}-{{ forloop.index }}" class="faq-tabs__label">
              <span class="faq-tabs__question-text">{{ block.settings.question }}</span>
              <span class="faq-tabs__arrow">
                {% render 'icons', name: 'tab_arrow' %}
              </span>
            </label>

            <div class="faq-tabs__pane">
              <div class="faq-tabs__answer rte">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FAQ Tabs",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Das ist keine Magie, sondern <strong>Wissenschaft</strong>."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#b2cdc6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color_highlight",
      "label": "Highlight text color (Strong)",
      "default": "#CB342C"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "image_picker",
      "id": "link_icon",
      "label": "Link external icon"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding top mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom mobile",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Bessere Absorption"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Detailed answer content goes here.</p>"
        }
      ]
    },
    {
      "type": "header_link",
      "name": "Header Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Vollständige Liste"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Tabs",
      "blocks": [
        { "type": "header_link", "settings": { "link_text": "Vollständige Liste" } },
        { "type": "header_link", "settings": { "link_text": "Klinische Studien" } },
        { "type": "faq_item", "settings": { "question": "Bessere Absorption" } },
        { "type": "faq_item", "settings": { "question": "Bessere Wirksamkeit" } }
      ]
    }
  ]
}
{% endschema %}