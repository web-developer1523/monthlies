<section class="energieniveau">
    <div class="container">
        <div class="energieniveau-inner">
            <div class="row">

                <!-- LEFT SIDE -->
                <div class="col-md-6">
                    <div class="energieniveau-content">

                        <!-- TAB TITLES -->
                        <ul class="cycle-tabs">
                            {% assign tab_index = 1 %}
                            {% for block in section.blocks %}
                                {% if block.type == 'tab_block' %}
                                    <li class="{% if forloop.first %}active{% endif %}"
                                        data-tab="{{ tab_index }}"
                                        data-block-id="{{ block.id }}">
                                        {{ block.settings.tab_title }}
                                        <span>{{forloop.index }}</span>
                                    </li>
                                    {% assign tab_index = tab_index | plus: 1 %}
                                {% endif %}
                            {% endfor %}
                        </ul>

                        <!-- TAB CONTENT -->
                        <div class="cycle-content">

                            {% assign tab_index = 1 %}
                            {% for block in section.blocks %}
                                {% if block.type == 'tab_block' %}
                                    <div class="content-box {% if forloop.first %}active{% endif %}"
                                        id="tab{{ tab_index }}"
                                        data-block-id="{{ block.id }}"
                                    >

                                        <div class="content-box-inner">

                                            <!-- Heading -->
                                            <h2>{{ block.settings.heading }}</h2>

                                            <!-- TAGS FILTERED BY PARENT TAB -->
                                            <div class="cycle-tags-inner">
                                                <div class="tags">

                                                    {% for tag_block in section.blocks %}
                                                        {% if tag_block.type == 'tag_item'
                                                            and tag_block.settings.parent_tab == block.id %}
                                                            <div class="tags-item">
                                                                <a href="#">
                                                                    {% if tag_block.settings.tag_icon %}
                                                                        <img src="{{ tag_block.settings.tag_icon | image_url }}" alt="">
                                                                    {% endif %}
                                                                    {{ tag_block.settings.tag_text }}
                                                                </a>
                                                            </div>
                                                        {% endif %}
                                                    {% endfor %}

                                                </div>
                                            </div>
                                                <!-- BUTTON TAGS -->
                                                <div class="tags">

                                                    {% if block.settings.btn1 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_1 %}
                                                                <img src="{{ block.settings.icon_image_1 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn1 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn2 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_2 %}
                                                                <img src="{{ block.settings.icon_image_2 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn2 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn3 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_3 %}
                                                                <img src="{{ block.settings.icon_image_3 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn3 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn4 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_4 %}
                                                                <img src="{{ block.settings.icon_image_4 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn4 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn5 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_5 %}
                                                                <img src="{{ block.settings.icon_image_5 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn5 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn6 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_6 %}
                                                                <img src="{{ block.settings.icon_image_6 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn6 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn7 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_7 %}
                                                                <img src="{{ block.settings.icon_image_7 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn7 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn8 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_8 %}
                                                                <img src="{{ block.settings.icon_image_8 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn8 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn9 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_9 %}
                                                                <img src="{{ block.settings.icon_image_9 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn9 }}
                                                        </a>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn10 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_10 %}
                                                                <img src="{{ block.settings.icon_image_10 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn10 }}
                                                        </a>
                                                    </div>
                                                    {% endif %}
                                                
                                                </div>
                                                
                                            <!-- PERCENTAGE -->
                                            <div class="percentage-container">

                                                {% if block.settings.percent != blank or block.settings.percent_text != blank %}
                                                <div class="percent-inner">
                                                    <h2>{{ block.settings.percent }}</h2>
                                                    <p>{{ block.settings.percent_text }}</p>
                                                </div>
                                                {% endif %}
                                            
                                                {% if block.settings.percent1 != blank or block.settings.percent_text1 != blank %}
                                                <div class="percent-inner">
                                                    <h2>{{ block.settings.percent1 }}</h2>
                                                    <p>{{ block.settings.percent_text1 }}</p>
                                                </div>
                                                {% endif %}
                                            
                                                {% if block.settings.percent2 != blank or block.settings.percent_text2 != blank %}
                                                <div class="percent-inner">
                                                    <h2>{{ block.settings.percent2 }}</h2>
                                                    <p>{{ block.settings.percent_text2 }}</p>
                                                </div>
                                                {% endif %}
                                            
                                                {% if block.settings.percent3 != blank or block.settings.percent_text3 != blank %}
                                                <div class="percent-inner">
                                                    <h2>{{ block.settings.percent3 }}</h2>
                                                    <p>{{ block.settings.percent_text3 }}</p>
                                                </div>
                                                {% endif %}
                                            
                                            </div>                                            
                                        </div>
                                    </div>

                                    {% assign tab_index = tab_index | plus: 1 %}
                                {% endif %}
                            {% endfor %}

                        </div>

                    </div>
                </div>

                <!-- RIGHT IMAGE -->
                <div class="col-md-6">
                    <div class="cycle-image">
                        {% for block in section.blocks %}
                            {% if block.type == 'tab_block' and forloop.first %}
                                {% if block.settings.tab_image %}
                                    <img id="cycle-img" class="desktop-image" src="{{ block.settings.tab_image | image_url }}" alt="">
                                {% endif %}
                                {% if block.settings.mobile_tab_image %}
                                    <img id="cycle-img" class="mobile-image" src="{{ block.settings.mobile_tab_image | image_url }}" alt="">
                                {% endif %}
                                
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

            </div>
        </div>

        <!-- DISCLAIMER -->
        <div class="aussagen-text-inner">
            {{ section.settings.bottom_disclaimer }}
        </div>
    </div>
</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
{% comment %} <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script> {% endcomment %}
<script>
$(function () {
    $(".cycle-tabs li").on("click", function () {
        const tabNumber = $(this).data("tab"); // number

        // Change active tab class
        $(".cycle-tabs li").removeClass("active");
        $(this).addClass("active");

        // Show corresponding content box
        $(".content-box").removeClass("active");
        $("#tab" + tabNumber).addClass("active");

    });
});
</script>
