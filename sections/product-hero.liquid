{%- liquid
    assign product = nil
 
    unless section.settings.product == blank
      assign product = section.settings.product
    endunless
-%}

{%- if product.available -%}
  {{ 'section-product-hero.css' | asset_url | stylesheet_tag }}

  {% style %}
    #shopify-section-{{ section.id }} {
      --product-hero-background-color: {{ section.settings.background }};
      --product-hero-text-color: {{ section.settings.color }};
      --product-hero-radius-top-right: {{ section.settings.radius_top_right_desktop }}px;
      --product-hero-image-position: {{ section.settings.image_position_desktop }};

      @media screen and (max-width: 768px) {
        --product-hero-image-position: {{ section.settings.image_position_mobile }};
        --product-hero-radius-top-right: {{ section.settings.radius_top_right_mobile }}px;
      }
    }
  {% endstyle %}

  <div class="product-hero__container">
    {%- unless section.settings.image_desktop == blank -%}
      <div class="product-hero__media">
        <picture>
          {%- unless section.settings.image_mobile == blank -%}
            <source srcset="{{ section.settings.image_mobile | image_url }}" media="(max-width: 768px)">
          {%- endunless -%}

          {{ section.settings.image_desktop 
            | image_url: width: section.settings.image_desktop.width 
            | image_tag: class: 'product-hero__media-image', loading: 'lazy' }}
        </picture>
      </div>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <div class="product-hero__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'review' -%}
              {%- if block.settings.review_image != blank or block.settings.review_text != blank -%}
                <div class="product-hero__review">
                  {%- unless block.settings.review_image == blank -%}
                    {{ block.settings.review_image 
                      | image_url: width: block.settings.review_image.width 
                      | image_tag: class: 'product-hero__review-image', loading: 'lazy' }}
                  {%- endunless -%}

                  {%- unless block.settings.review_text == blank -%}
                    <p class="product-hero__review-text">{{ block.settings.review_text }}</p>
                  {%- endunless -%}
                </div>
              {%- endif -%}

            {%- when 'content' -%}
              {%- unless block.settings.content == blank -%}
                <div class="product-hero__content-wrapper">
                  {{ block.settings.content }}
                </div> 
              {%- endunless -%}
              
            {%- when 'button' -%}
              {%- assign product_form_id = 'product-form-' | append: section.id -%}

              {% capture button_style %}
                --product-hero-button-background: {{ block.settings.button_background }};
                --product-hero-button-color: {{ block.settings.button_color }};
              {% endcapture %}

              {%- unless product == blank -%}
                {%- render 'buy-buttons',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  class: 'product-hero__button',
                  style: button_style
                -%}
              {%- endunless -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Product hero",
  "tag": "section",
  "class": "product-hero",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile (optional)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Image position desktop",
      "default": "row",
      "options": [
        {
          "value": "row",
          "label": "Image first"
        },
        {
          "value": "row-reverse",
          "label": "Image second"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Image position mobile",
      "default": "column-reverse",
      "options": [
        {
          "value": "column",
          "label": "Image first"
        },
        {
          "value": "column-reverse",
          "label": "Image second"
        }
      ]
    },
    {
      "type": "header",
      "content": "Border radius"
    },
    {
      "type": "range",
      "id": "radius_top_right_desktop",
      "label": "Radius top right desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 100
    },
    {
      "type": "range",
      "id": "radius_top_right_mobile",
      "label": "Radius top right mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select product"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "review_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "review_text",
          "label": "Text",
          "default": "Over 21M tests since 2023"
        }
      ]
    },
    {
      "type": "content",
      "name": "Content",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<h2>Female Hormone Test Kit</h2>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Text",
          "default": "Add to Cart"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Background color",
          "default": "#CB342C"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Text color",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product hero"
    }
  ]
}
{% endschema %}