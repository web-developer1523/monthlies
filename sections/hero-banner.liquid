{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}
{%- if section.settings.image != blank or section.settings.video != blank -%}
  <div
    class="hero-banner"
    style="
      --section-height: {% if section.settings.section_height_type == 'full' %}100vh;{% else %}{{ section.settings.section_height }}px;{% endif %}
      --section-height-mobile: {% if section.settings.section_height_type == 'full' %}100vh;{% else %}{{ section.settings.section_height_mobile }}px;{% endif %}
    "
  >
    <div class="hero-banner__media" style="--media-brightness: {{ section.settings.background_brightness }}">
      {%- if section.settings.media_type == 'video' and section.settings.video != blank -%}
        {% render 'video',
          video: section.settings.video,
          video_mobile: section.settings.video_mobile,
          media_request: 749,
          playsinline: true,
          controls: false,
          loop: true,
          muted: true,
          autoplay: true
        %}
      {%- elsif section.settings.media_type == 'image' and section.settings.image != blank -%}
        {% render 'picture',
          image: section.settings.image,
          image_mobile: section.settings.image_mobile,
          mobile_breakpoint: 749,
          loading: 'eager',
          fetchpriority: 'high'
        %}
      {%- endif -%}
      <div class="hero-banner__content">
        <div class="hero-banner__main-content">
          {%- unless section.settings.heading == blank -%}
            <h2 class="hero-banner__heading">{{ section.settings.heading }}</h2>
          {%- endunless -%}
          {%- unless section.settings.subtitle == blank -%}
            <p class="hero-banner__subtitle">{{ section.settings.subtitle }}</p>
          {%- endunless -%}
          {%- unless section.settings.button_text == blank -%}
            <a href="{{ section.settings.button_url }}" class="hero-banner__button">
              {{- section.settings.button_text -}}
            </a>
          {%- endunless -%}
        </div>
        {%- assign logo_blocks = section.blocks | where: 'type', 'logo_item' -%}
        {%- if logo_blocks.size > 0 -%}
          <div class="hero-logos-content">
            {%- for logo_item in logo_blocks -%}
              {%- unless logo_item.settings.logo == blank -%}
                <picture>
                  {%- unless logo_item.settings.logo_mobile == blank -%}
                    <source
                      srcset="{{ logo_item.settings.logo_mobile | image_url: height: 120 }}"
                      media="(width <= 900px)"
                    >
                  {%- endunless -%}
                  {{
                    logo_item.settings.logo
                    | image_url: width: 400
                    | image_tag: class: 'hero-logos-content__logo-item'
                  }}
                </picture>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
    {%- assign logo_links_blocks = section.blocks | where: 'type', 'logo_links' -%}
    {%- if review_blocks.size > 0 or logo_links_blocks.size > 0 -%}
      <div class="hero-banner__extra-blocks">
        {%- if review_blocks.size > 0 -%}
          {%- assign review_block = review_blocks[0] -%}
          <div class="hero-review-block">
            {%- unless review_block.settings.image == blank -%}
              {{ review_block.settings.image | image_url: width: 300 | image_tag: class: 'hero-review-block__image' }}
            {%- endunless -%}
            {%- if review_block.settings.rating_text != blank or review_block.settings.text != blank -%}
              <div class="hero-review-block__info">
                <div class="hero-review-block__rating-text">
                  {%- render 'icon', icon: 'review-stars' -%}
                  {{ review_block.settings.rating_text }}
                </div>
                {%- unless review_block.settings.text == blank -%}
                  <p class="hero-review-block__text">
                    {{ review_block.settings.text }}
                  </p>
                {%- endunless -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if logo_links_blocks.size > 0 -%}
          {%- assign logo_links_block = logo_links_blocks[0] -%}
          <div class="hero-logo-links-block">
            {%- unless logo_links_block.settings.title == blank -%}
              <p class="hero-logo-links-block__title">{{ logo_links_block.settings.title }}</p>
            {%- endunless -%}
              {%- unless logo_links_block.settings.logo_1 == blank -%}
                {{
                  logo_links_block.settings.logo_1
                  | image_url: height: 59
                  | image_tag: class: 'hero-logo-links-block__logo'
                }}
              {%- endunless -%}
              {%- unless logo_links_block.settings.logo_2 == blank -%}
                {{
                  logo_links_block.settings.logo_2
                  | image_url: height: 59
                  | image_tag: class: 'hero-logo-links-block__logo'
                }}
              {%- endunless -%}
            </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "video",
          "label": "Video"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "video"
    },
    {
      "type": "header",
      "content": "Video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video mobile",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "select",
      "id": "section_height_type",
      "label": "Section height type",
      "options": [
        {
          "value": "full",
          "label": "Full screen height"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 400,
      "max": 900,
      "step": 5,
      "unit": "px",
      "label": "Section height",
      "default": 710,
      "visible_if": "{{ section.settings.section_height_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "min": 400,
      "max": 900,
      "step": 5,
      "unit": "px",
      "label": "Section height mobile",
      "default": 710,
      "visible_if": "{{ section.settings.section_height_type == 'custom' }}"
    },
    {
      "type": "range",
      "id": "background_brightness",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Background brightness",
      "default": 0.4
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Das <i>natürliche</i> Mittel gegen Periodenschmerzen, das wirkt"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "26 wissenschaftlich geprüfte Inhaltsstoffe, die perfekt auf deinen Körper abgestimmt sind, um Menstruationsbeschwerden zu bekämpfen."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "monthlies entdecken"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "name": "Logo item",
      "type": "logo_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "image_picker",
          "id": "logo_mobile",
          "label": "Logo mobile"
        }
      ]
    },
    {
      "name": "Review",
      "type": "review",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating text",
          "default": "4.6 Sterne"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "2.000+ Frauen vertrauen monthlies"
        }
      ]
    },
    {
      "name": "Logo links",
      "type": "logo_links",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Du findest uns auch hier:"
        },
        {
          "type": "image_picker",
          "id": "logo_1",
          "label": "Logo 1"
        },
        {
          "type": "image_picker",
          "id": "logo_2",
          "label": "Logo 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
