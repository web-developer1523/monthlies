{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-position: {{ section.settings.image_position }};
  }

  /* 4 columns on desktop, sensible widths */
  @media (min-width:990px){
    #shopify-section-{{ section.id }} .oath-4col .multicolumn-list{
      display:grid;
      grid-template-columns:repeat(4,minmax(280px,1fr));
      gap:24px;
      align-items:start;
    }
    #shopify-section-{{ section.id }} .oath-4col .multicolumn-card{max-width:none;margin:0}
    #shopify-section-{{ section.id }} .oath-4col .grid__item{min-width:0}
  }

  /* Rounded pastel cards (no forced equal-height) */
  #shopify-section-{{ section.id }} .oath-pastels .multicolumn-list__item{background:transparent}
  #shopify-section-{{ section.id }} .oath-pastels .multicolumn-card{
    background:#f5f7f9;
    border-radius:20px;
    padding:20px;
    text-align:center;
    height:auto;           /* <- important: removes tall “pill” */
    display:block;         /* was flex; block keeps natural height */
  }

  /* Per-card colors */
  #shopify-section-{{ section.id }} .oath-pastels .multicolumn-list__item:nth-child(1) .multicolumn-card{background:#eaf6ef}
  #shopify-section-{{ section.id }} .oath-pastels .multicolumn-list__item:nth-child(2) .multicolumn-card{background:#fdecea}
  #shopify-section-{{ section.id }} .oath-pastels .multicolumn-list__item:nth-child(3) .multicolumn-card{background:#f3f0fd}
  #shopify-section-{{ section.id }} .oath-pastels .multicolumn-list__item:nth-child(4) .multicolumn-card{background:#fcebf7}
{%- endstyle -%}
<link rel="stylesheet" href="{{ 'section-multicolumn.css' | asset_url }}" >

<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}">
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

<div class="{{ section.settings.custom_class }} section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="multicolumn page-width">
    <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %} {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }} {{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">
        {{- section.settings.heading -}}
      </{{ section.settings.heading_tag }}>
      <span> {{ section.settings.description }}</span>
    </div>

    <slider-component class="slider-mobile-gutter {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">
      <ul
        id="Slider-{{ section.id }}"
        class="multicolumn-list grid grid--2-col{% if section.settings.columns_mobile == '1' %} grid--1-col-mobile{% endif %}{% if section.blocks.size > 3 %} grid--2-col-tablet{% else %} grid--3-col-tablet{% endif %}{% if section.settings.swipe_on_mobile and section.blocks.size > 1 %} slider slider--mobile{% endif %}"
        role="list"
      >
        {%- liquid
          if section.settings.image_ratio == 'adapt'
            assign highest_ratio = 0
            for block in section.blocks
              if block.settings.image.aspect_ratio > highest_ratio
                assign highest_ratio = block.settings.image.aspect_ratio
              endif
            endfor
          endif
        -%}

        {%- capture sizes -%}(min-width: 990px) {% if section.blocks.size <= 2 %}710px{% else %}550px{% endif %}, (min-width: 750px) {% if section.blocks.size == 1 %}710px{% else %}550px{% endif %},{% if section.settings.columns_mobile == '1' %} calc(100vw - 3rem){% else %} calc((100vw - 3rem) / 2){% endif %}{%- endcapture -%}
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="multicolumn-card">
              {%- if block.settings.image != blank -%}
                <use-animate data-animate="zoom-fade" class="media-wrapper">
                  <div
                    class="image-animate media media--{{ section.settings.image_ratio }}"
                    {%- if section.settings.image_ratio == 'adapt' %}
                      style="--image-ratio-percent: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                    {% endif -%}
                  >
                    <img 
                      data-class="LazyLoad" 
                       src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
                      data-src="{{ block.settings.image | image_url }}" 
                      data-mob-src="{{ block.settings.image | image_url}}" 
                      sizes="{{ sizes }}"
                      loading="lazy"
                      is="lazy-image"
                      alt="">
                  </div>
                  {%- if block.settings.button_link != blank -%}
                    <a href="{{ block.settings.button_link }}" class="full-unstyled-link">&nbsp;</a>
                  {%- endif -%}
                </use-animate>
              {%- endif -%}
              {%- if block.settings.title != blank
                or block.settings.text != blank
                or block.settings.button_label != blank
              -%}
                <div class="multicolumn-card__info">
                  <p class="multicolumn-card__title {{ block.settings.title_size }}">
                    {{ block.settings.title | escape }}
                  </p>
                  <div class="rte typeset">{{ block.settings.text }}</div>
                  {%- if block.settings.button_label != blank -%}
                    {%- if block.settings.button_style_secondary -%}
                      <a
                        class="button button--cta"
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                      >
                        <span class="label">{{ block.settings.button_label | escape }}</span>
                        {% render 'icon', icon: 'arrow' %}
                      </a>
                    {%- else -%}
                      <a
                        class="button button--tertiary"
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>
    {% if section.settings.btn_text != blank %}
    <div class="button_for_bg">
      <a class="personalize-app button button--medium cta-secondary" href="{{ section.settings.btn_link }}">
        {{ section.settings.btn_text }}
          </a>  
      </div>
      {%endif %}
  </div>

</div>

