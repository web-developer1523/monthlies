<section class="cst-bg-creame hero-sec">
<div class="cst-bg-creame container">

<!-- TOP REVIEW ROW -->
<div class="cst-bg-creame review-row">

{% if section.settings.review_faces != blank %}
<img src="{{ section.settings.review_faces | image_url }}" alt="review faces" class="cst-bg-creame review-faces">
{% endif %}

<div class="cst-bg-creame star-block">

<div class="cst-bg-creame stars-wrap">

{% if section.settings.star_image != blank %}
<img src="{{ section.settings.star_image | image_url }}" alt="arrow" class="cst-bg-creame arrow-icon">
{% endif %}

{% if section.settings.rating_text != blank %}
<p class="cst-bg-creame rating-text">{{ section.settings.rating_text }}</p>
{% endif %}

</div>

{% if section.settings.trust_text != blank %}
<p class="cst-bg-creame trust-text">{{ section.settings.trust_text }}</p>
{% endif %}

</div>
</div>

<!-- HEADING + BUTTON -->
{% if section.settings.hero_heading != blank %}
<h1 class="cst-bg-creame hero-heading">
{{ section.settings.hero_heading }}
</h1>
{% endif %}

{% if section.settings.button_text != blank %}
<a href="{{ section.settings.button_link }}" class="cst-bg-creame hero-btn">
{{ section.settings.button_text }}
</a>
{% endif %}

</div>
</section>
<style>

/* MAIN HERO SECTION */
.cst-bg-creame.hero-sec {
position: relative;
background: url("{{ section.settings.bg_image | image_url }}") no-repeat center/cover;
padding: 16px 40px;
height: 480px;
display: flex;
align-items: center;
border-top-right-radius: 120px;
background-position: right;
max-width:100%;
margin:0 auto;
}

.cst-bg-creame.container {
width: 100%;
}

/* REVIEW ROW */
.cst-bg-creame.review-row {
display: flex;
align-items: center;
gap: 14px;
margin-bottom: 20px;
}

.cst-bg-creame.review-faces {
max-width: 125px;
}

.cst-bg-creame.star-block {
position: relative;
}

.cst-bg-creame.stars-wrap {
display: flex;
gap: 5px;
align-items: center;
}

.cst-bg-creame.rating-text {
font-size: 12px;
color: #404040;
margin: 0;
font-weight: 500;
}

.cst-bg-creame.trust-text {
font-size: 15px;
color: #404040;
margin: 9px 0 0;
font-weight: bold;
}

.cst-bg-creame.hero-heading {
    font-size: 40px;
    line-height: 1.3;
    font-weight: 600;
    color: #404040;
    margin: 20px 0;
    max-width: 800px;
}
.cst-bg-creame.hero-heading span{
display:block;
font-size: 40px;
line-height: 1.3;
font-weight: 600;
color: #404040;
font-family: Lora,serif!important;
}
.cst-bg-creame.hero-btn {
    display: inline-block;
    background: #b62820;
    color: #fff;
    padding: 9px 49px;
    border-radius: 50px;
    font-size: 16px;
    text-decoration: none;
    font-weight: 600;
box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0p
}

/* PRODUCT IMAGE (if you add later) */
.cst-bg-creame.product-img {
position: absolute;
right: 60px;
bottom: 40px;
width: 260px;
}


/* ============================
RESPONSIVE
============================ */

@media (max-width: 1100px) {
.cst-bg-creame.hero-heading{
max-width:650px;
font-size: 34px;
}
.cst-bg-creame.hero-heading span{
display: unset;
font-size: 34px;
}
}
@media (max-width: 991px) {
.cst-bg-creame.hero-heading {
    max-width: 566px;
}
}

@media (max-width: 789px) {

.cst-bg-creame.hero-sec {
height: 380px;
border-top-right-radius: 80px;
padding: 16px 20px;
background: url(//miof9e7jhsbppee3-70874628371.shopifypreview.com/cdn/shop/files/IMG_7398_3.png?v=1765447428);
background-repeat: no-repeat;
background-position: 86% 30%;
}


}

@media (max-width: 768px) {

.cst-bg-creame.product-img {
width: 180px;
position: static;
margin: 20px auto 0;
display: block;
}

.cst-bg-creame.hero-heading {
font-size: 22px;
max-width: 450px;
}
.cst-bg-creame.hero-heading span {
font-size: 22px;
}
.cst-bg-creame.hero-btn {
font-size: 15px;
padding: 12px 24px;
}

}

@media (max-width: 595px) {
    .cst-bg-creame.hero-heading, .cst-bg-creame.hero-heading span {
        font-size: 15px;
        max-width: 228px;
    }

    .cst-bg-creame.star-block {
        position: relative;
        max-width: 197px;
    }
.cst-bg-creame.trust-text {
font-size: 12px;
margin-top:0;
}
}
@media (max-width:480px) {
    .cst-bg-creame.review-row{
    gap:0;
    }
    .cst-bg-creame.hero-heading, .cst-bg-creame.hero-heading span {
        font-size: 13px;
        max-width: 174px;
    }
    .cst-bg-creame.review-faces {
        max-width: 42px;
    }
    .cst-bg-creame.trust-text {
        font-size: 10px;
        margin-top: 0;
        max-width: 153px;
    }
    .cst-bg-creame.rating-text {
        font-size: 9px;
    }
.cst-bg-creame.hero-sec{
height: 370px;
background-position: 86% 54%;
}
}
</style>

{% schema %}

{
"name": "Experience Manageable New",
"settings": [
{
"type": "image_picker",
"id": "review_faces",
"label": "Review Faces Image"
},
{
"type": "image_picker",
"id": "star_image",
"label": "Star Image"
},
{
"type": "image_picker",
"id": "bg_image",
"label": "Background Image"
},
{
"type": "inline_richtext",
"id": "rating_text",
"label": "Rating Text"
},
{
"type": "inline_richtext",
"id": "trust_text",
"label": "Trust Text"
},
{
"type": "inline_richtext",
"id": "hero_heading",
"label": "Hero Heading"
},
{
"type": "text",
"id": "button_text",
"label": "Button Text",
"default": "Buy monthlies"
},
{
"type": "url",
"id": "button_link",
"label": "Button Link"
}
],
"presets": [
{
"name": "Experience Manageable New"
}
]
}


{% endschema %}