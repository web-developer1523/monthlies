{{ 'section-intake-questions.css' | asset_url | stylesheet_tag }}

{% render 'section-paddings',
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

{%- capture section_style -%}
  --intake-questions-bg: {{ section.settings.background_color }};
  --intake-questions-heading-color: {{ section.settings.heading_color }};
  --intake-questions-heading-size: {{ section.settings.heading_size }}px;
  --intake-questions-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
  --intake-questions-heading-max-width: {{ section.settings.heading_max_width }}px;
  --intake-questions-heading-align: {{ section.settings.heading_align }};
  --intake-questions-item-bg: {{ section.settings.item_background }};
  --intake-questions-item-color: {{ section.settings.item_text_color }};
  --intake-questions-item-size: {{ section.settings.item_text_size }}px;
  --intake-questions-item-size-mobile: {{ section.settings.item_text_size_mobile }}px;
  --intake-questions-item-radius: {{ section.settings.item_radius }}px;
  --intake-questions-item-border: {{ section.settings.item_border }};
  --intake-questions-last-max-width: {{ section.settings.last_item_max_width }}px;
  --intake-questions-arrow-bg: {{ section.settings.arrow_bg }};
  --intake-questions-arrow-primary: {{ section.settings.arrow_primary }};
  --intake-questions-arrow-secondary: {{ section.settings.arrow_secondary }};
  --intake-questions-bg-mobile: {{ section.settings.background_color_mobile }};
  --intake-questions-heading-color-mobile: {{ section.settings.heading_color_mobile }};
  --intake-questions-item-bg-mobile: {{ section.settings.item_background_mobile }};
  --intake-questions-item-color-mobile: {{ section.settings.item_text_color_mobile }};
  --intake-questions-item-border-mobile: {{ section.settings.item_border_mobile }};
  --intake-questions-arrow-bg-mobile: {{ section.settings.arrow_bg_mobile }};
  --intake-questions-arrow-primary-mobile: {{ section.settings.arrow_primary_mobile }};
  --intake-questions-arrow-secondary-mobile: {{ section.settings.arrow_secondary_mobile }};
{%- endcapture -%}

<section class="intake-questions section-{{ section.id }}--padding" style="{{ section_style | strip_newlines }}" {% if section.settings.id %}id="{{ section.settings.id }}"{% endif %}>
  <div class="intake-questions__inner page-width">
    {%- if section.settings.heading != blank -%}
      <div class="intake-questions__header">
        <h2 class="intake-questions__heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- liquid
      assign faq_items = blank
      if product != blank and product.metafields.custom.product_faqs != blank
        assign faq_items = product.metafields.custom.product_faqs.value
      endif
      assign items_count = section.blocks.size
      if faq_items != blank
        assign items_count = faq_items.size
      endif
      assign is_odd = items_count | modulo: 2
    -%}
    <div class="intake-questions__list">
      {%- if faq_items != blank -%}
        {%- for faq in faq_items -%}
          {%- assign item_text = faq.question | metafield_text | strip -%}
          {%- assign item_answer = faq.answer -%}
          {%- if item_text != blank -%}
            {%- assign is_full = false -%}
            {%- if is_odd == 1 and forloop.last -%}
              {%- assign is_full = true -%}
            {%- endif -%}
            {%- capture item_classes -%}
              intake-questions__item{% if is_full %} intake-questions__item--full{% endif %}
            {%- endcapture -%}
            {%- capture item_content -%}
              <span class="intake-questions__item-text">{{ item_text | escape | newline_to_br }}</span>
              <span class="intake-questions__arrow" aria-hidden="true">
                <svg class="intake-questions__arrow-icon" width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect class="intake-questions__arrow-bg" width="44" height="44" rx="22" fill="var(--intake-questions-arrow-bg, #ecf1f4)"/>
                  <path class="intake-questions__arrow-path" d="M28 22L18.8791 32.0805L18.8791 27.8803L23.1995 22L18.8791 16.1197L18.8791 11.9194L28 22Z" fill="var(--intake-questions-arrow-primary, #cb342c)"/>
                  <path class="intake-questions__arrow-path intake-questions__arrow-path--back" d="M25.1211 22L16.0002 32.0805L16.0002 27.8803L20.3206 22L16.0002 16.1197L16.0002 11.9194L25.1211 22Z" fill="var(--intake-questions-arrow-secondary, #96b8b5)"/>
                </svg>

              </span>
            {%- endcapture -%}
            <details class="{{ item_classes | strip }}">
              <summary class="intake-questions__summary">
                {{ item_content }}
              </summary>
              {%- if item_answer != blank -%}
                <div class="intake-questions__content rte">
                  {{ item_answer | metafield_tag }}
                </div>
              {%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign item_text = block.settings.text | strip -%}
          {%- assign item_answer = block.settings.answer -%}
          {%- if item_text != blank -%}
            {%- assign is_full = false -%}
            {%- if is_odd == 1 and forloop.last -%}
              {%- assign is_full = true -%}
            {%- endif -%}
            {%- capture item_classes -%}
              intake-questions__item{% if is_full %} intake-questions__item--full{% endif %}
            {%- endcapture -%}
            {%- capture item_content -%}
              <span class="intake-questions__item-text">{{ item_text | escape | newline_to_br }}</span>
              <span class="intake-questions__arrow" aria-hidden="true">
                {% render 'icon-question-arrow' %}

              </span>
            {%- endcapture -%}
            <details class="{{ item_classes | strip }}" {{ block.shopify_attributes }}>
              <summary class="intake-questions__summary">
                {{ item_content }}
              </summary>
              {%- if item_answer != blank -%}
                <div class="intake-questions__content rte">
                  {{ item_answer }}
                </div>
              {%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Intake Questions",
  "tag": "section",
  "class": "intake-questions-section",
  "settings": [
    {
      "type": "text",
      "id": "id",
      "label": "ID",
      "info": "For anchors"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (Mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (Mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kann ich monthlies einnehmen, wenn ich..."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "heading_color_mobile",
      "label": "Heading color (Mobile)",
      "default": "#4a4a4a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (Desktop)",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (Mobile)",
      "min": 22,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading max width",
      "min": 320,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Items"
    },
    {
      "type": "color",
      "id": "item_background",
      "label": "Item background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "item_background_mobile",
      "label": "Item background (Mobile)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Item text color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "item_text_color_mobile",
      "label": "Item text color (Mobile)",
      "default": "#4a4a4a"
    },
    {
      "type": "range",
      "id": "item_text_size",
      "label": "Item text size (Desktop)",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_text_size_mobile",
      "label": "Item text size (Mobile)",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "item_radius",
      "label": "Item radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "item_border",
      "label": "Item border",
      "default": "#eef2f4"
    },
    {
      "type": "color",
      "id": "item_border_mobile",
      "label": "Item border (Mobile)",
      "default": "#eef2f4"
    },
    {
      "type": "range",
      "id": "last_item_max_width",
      "label": "Last item max width (Desktop)",
      "min": 360,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 680
    },
    {
      "type": "header",
      "content": "Arrow"
    },
    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Arrow background",
      "default": "#ecf1f4"
    },
    {
      "type": "color",
      "id": "arrow_bg_mobile",
      "label": "Arrow background (Mobile)",
      "default": "#ecf1f4"
    },
    {
      "type": "color",
      "id": "arrow_primary",
      "label": "Arrow color 1",
      "default": "#cb342c"
    },
    {
      "type": "color",
      "id": "arrow_primary_mobile",
      "label": "Arrow color 1 (Mobile)",
      "default": "#cb342c"
    },
    {
      "type": "color",
      "id": "arrow_secondary",
      "label": "Arrow color 2",
      "default": "#96b8b5"
    },
    {
      "type": "color",
      "id": "arrow_secondary_mobile",
      "label": "Arrow color 2 (Mobile)",
      "default": "#96b8b5"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f2f5f6"
    },
    {
      "type": "color",
      "id": "background_color_mobile",
      "label": "Section background (Mobile)",
      "default": "#f2f5f6"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "... ein hormonelles Verhütungsmittel benutze?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Intake Questions",
      "category": "Custom",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question",
          "settings": {
            "text": "... eine Fruchtbarkeitsbehandlung durchführe?"
          }
        },
        {
          "type": "question",
          "settings": {
            "text": "... bereits Nahrungsergänzungsmittel einnehme"
          }
        },
        {
          "type": "question",
          "settings": {
            "text": "... versuche, schwanger zu werden"
          }
        },
        {
          "type": "question",
          "settings": {
            "text": "... PCOS habe"
          }
        },
        {
          "type": "question",
          "settings": {
            "text": "... Endometriose habe"
          }
        },
        {
          "type": "question",
          "settings": {
            "text": "... stille oder schwanger bin"
          }
        }
      ]
    }
  ]
}
{% endschema %}
