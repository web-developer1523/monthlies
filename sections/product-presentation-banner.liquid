{{ 'section-product-presentation-banner.css' | asset_url | stylesheet_tag }}

{% render 'section-paddings',
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

<div
  class="product-presentation-banner section-{{ section.id }}--padding"
  style="--background: {{ section.settings.background }}"
>
  <div class="product-presentation-banner__content-wrapper page-width">
    {%- if section.settings.title != blank
      or section.settings.subtitle != blank
      or section.settings.button_text != blank
    -%}
      <div class="product-presentation-banner__text">
        {%- unless section.settings.title == blank -%}
          <h2 class="product-presentation-banner__title">{{ section.settings.title }}</h2>
        {%- endunless -%}
        {%- unless section.settings.subtitle == blank -%}
          <div class="product-presentation-banner__subtitle">{{ section.settings.subtitle }}</div>
        {%- endunless -%}
        {%- unless section.settings.button_text == blank -%}
          <a class="product-presentation-banner__button" href="{{ section.settings.button_url }}">
            {{- section.settings.button_text -}}
          </a>
        {%- endunless -%}
      </div>
    {%- endif -%}
    {%- unless section.settings.image == blank -%}
      <div class="product-presentation-banner__image">
        {{ section.settings.image | image_url: width: 1000 | image_tag }}
        {%- if section.settings.badge_title != blank
          or section.settings.badge_subtitle != blank
          or section.settings.badge_subtitle != blank
        -%}
          <div class="product-presentation-banner__badge">
            {%- unless section.settings.badge_title == blank -%}
              <span class="product-presentation-banner__badge-title">{{ section.settings.badge_title }}</span>
            {%- endunless -%}
            {%- unless section.settings.badge_price == blank -%}
              <span class="product-presentation-banner__badge-price">{{ section.settings.badge_price }}</span>
            {%- endunless -%}
            {%- unless section.settings.badge_subtitle == blank -%}
              <span class="product-presentation-banner__badge-subtitle">{{ section.settings.badge_subtitle }}</span>
            {%- endunless -%}
          </div>
        {%- endif -%}
      </div>
    {%- endunless -%}
    {%- if section.blocks.size > 0 -%}
      <div class="product-presentation-banner__pricing-blocks">
        <div class="product-presentation-banner__pricings">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank
              or block.settings.compare_at_price != blank
              or block.settings.actual_price != blank
            -%}
              <div class="product-presentation-banner__pricing">
                {%- if block.settings.compare_at_price != blank or block.settings.actual_price != blank -%}
                  <div class="product-presentation-banner__price">
                    {%- unless block.settings.compare_at_price == blank -%}
                      <span class="product-presentation-banner__compare-at-price">
                        {{- block.settings.compare_at_price -}}
                      </span>
                    {%- endunless -%}
                    {%- unless block.settings.actual_price == blank -%}
                      <span class="product-presentation-banner__actual-price">{{ block.settings.actual_price }}</span>
                    {%- endunless -%}
                  </div>
                {%- endif -%}
                {%- unless block.settings.text == blank -%}
                  <span class="product-presentation-banner__service">{{ block.settings.text | newline_to_br }}</span>
                {%- endunless -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- unless section.settings.total_price == blank -%}
          <div class="product-presentation-banner__total-price">
            {{ section.settings.total_price }}
          </div>
        {%- endunless -%}
      </div>
    {%- endif -%}
    {%- unless section.settings.button_text == blank -%}
      <div class="product-presentation-banner__mobile-button-wrapper">
        <a class="product-presentation-banner__button" href="{{ section.settings.button_url }}">
          {{- section.settings.button_text -}}
        </a>
      </div>
    {%- endunless -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Banner",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ECF1F4"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Spüre selbst den <br>Unterschied mit dem <strong><i>monthlies Zyklusbegleiter</i></strong><p>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Alles, was du als Frau für Gesundheit und hormonelles Wohlbefinden brauchst - in nur einem Löffel.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "monthlies Abo entdecken"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "total_price",
      "label": "Total price",
      "default": "39,90€/Monat"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge title",
      "default": "Spare"
    },
    {
      "type": "text",
      "id": "badge_price",
      "label": "Badge price",
      "default": "385€"
    },
    {
      "type": "text",
      "id": "badge_subtitle",
      "label": "Badge subtitle",
      "default": "im Abo"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "name": "Cost",
      "type": "cost",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Text"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare at price",
          "default": "30€"
        },
        {
          "type": "text",
          "id": "actual_price",
          "label": "Actual price",
          "default": "Kostenlos"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Presentation Banner"
    }
  ]
}
{% endschema %}
