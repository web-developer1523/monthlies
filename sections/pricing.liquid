{{ 'section-pricing.css' | asset_url | stylesheet_tag }}

<section class="pricing" id="pricing">
  <div class="pricing-title">
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="pricing-subtitle">
    <p class="subhead">{{ section.settings.text }}</p>
  </div>

  <div class="pricing-wrapper">
    <div class="product-column" id="product-column-1">
      <div class="limited"></div>

      <!-- Show product image -->
      <div class="product-img">
        <img
          src="{{ section.settings.product1_image | img_url: '480x480' }}"
          alt="{{ section.settings.product_title }}"
        >
      </div>

      <div class="product-content">
        <!-- Show product title -->
        <h2>{{ section.settings.product1_title }}</h2>

        <!-- Show product price -->
        <div class="price">
          {% assign product = all_products['monthlies-starter-pack'] %}
           {% comment %}{{ section.settings.product1_price | money }} {% endcomment %}
          <span class="price">£{{ section.settings.product1_price | money_without_currency }}</span>

          <span class="compared-price">{{ section.settings.product1_compare_at_price | money }}</span>
          {% if section.settings.product1_price_tag != blank %}
            <span class="price-tag">{{ section.settings.product1_price_tag }}</span>
          {% endif %}
        </div>

        <!-- Show price per serving -->
        <div class="servings">
          {{ section.settings.product1_supply }}
        </div>

        <!-- Show title for bullets list -->
        <h3>{{ section.settings.product1_bullets_title }}</h3>
        <p>One-time purchase
<br/>30 servings</p>
        <!-- Show bullet list -->
        <ul class="check-list">
          {% for j in (1..6) %}
            {% assign bullet_key = 'product1_bullet' | append: j %}
            {% assign bullet = section.settings[bullet_key] %}
            {% if bullet != blank %}
              <li>{{ bullet }}</li>
            {% endif %}
          {% endfor %}
        </ul>

        
     <div class="cta-column">
{% assign page_url = request.path %}
{% if page_url contains 'value' %}
<a href="https://www.withmonthlies.com/pages/go-to-checkout-a-one" id="cta-checkout-monthlies-a-one" class="price-cta-button">{{ section.settings.buy_now_text }}</a>
{% else %}
<a href="https://www.withmonthlies.com/pages/go-to-checkout-b-one" id="cta-checkout-monthlies-b-one" class="price-cta-button">{{ section.settings.buy_now_text }}</a>
{% endif %}
       
</div>
      </div>
    </div>
    
      <div class="product-column product-column-limited" id="product-column-2">
        <div class="limited">Spring sale! Offer ends May 6th</div>
        <!-- Show product image -->
        <div class="product-img">
          <img
            src="{{ section.settings.product2_image | img_url: '480x480' }}"
            alt="{{ section.settings.product2_title }}"
          >
        </div>

        <div class="product-content">
          <!-- Show product title -->
          <span class="subscription-title">Subscription</span>
          <h2>{{ section.settings.product2_title }}</h2>

          <!-- Show product price -->
          <div class="price">
            {% assign product = all_products['monthlies-cycle-wellbeing'] %}
           {% comment %}{{ section.settings.product2_price | money }} {% endcomment %}
            <span class="price">£{{ section.settings.product2_price | money_without_currency }}</span>
            <span class="compared-price">£{{ section.settings.product2_compare_at_price | money_without_currency }}</span> 

            {% if section.settings.product2_price_tag != blank %}
              <span class="price-tag">{{ section.settings.product2_price_tag }}</span>
            {% endif %}
          </div>
          <!-- Show price per serving -->
          <div class="servings">
            {{ section.settings.product2_supply }}
          </div>

          <!-- Show title for bullets list -->
          <h3>{{ section.settings.product2_bullets_title }}</h3>
          <p>Monthly subscription<br />
30 servings</p>
          <!-- Show bullet list -->
          <ul class="check-list">
            {% for j in (1..6) %}
              {% assign bullet_key = 'product2_bullet' | append: j %}
              {% assign bullet = section.settings[bullet_key] %}
              {% if bullet != blank %}
                <li>{{ bullet }}</li>
              {% endif %}
            {% endfor %}
          </ul>

<div class="cta-column">
   
{% assign page_url = request.path %}
  {% if page_url contains 'value' %}
    <a href="https://www.withmonthlies.com/pages/go-to-checkout-a-sub" id="cta-checkout-monthlies-a-sub" class="price-cta-button">{{ section.settings.start_now_text }}</a>  
  {% else %}
    <a href="https://www.withmonthlies.com/pages/go-to-checkout-b-sub" id="cta-checkout-monthlies-b-sub" class="price-cta-button">{{ section.settings.start_now_text }}</a>  
  {% endif %}
  {% comment %}

  
          <div class="disclaimer">
            {{ section.settings.disclaimer2 }}
          </div> {% endcomment %}

</div>
                    <div class="guarantee-bottom">Cancel anytime.<br/>90-day money back guarantee.</div>

        </div>
      </div>

      <div class="product-column" id="product-column-3">
        <div class="limited"></div>

        <!-- Show product image -->
        <div class="product-img">
          <img
            src="{{ section.settings.product3_image | img_url: '480x480' }}"
            alt="{{ section.settings.product1_title }}"
          >
        </div>

        <div class="product-content">
          <!-- Show product title -->
          <h2>{{ section.settings.product3_title }}</h2>

          <!-- Show product price -->
          <div class="price">
            {% assign product = all_products['hormonal-test'] %}
           {% comment %}{{ section.settings.product3_price | money }} {% endcomment %}
            <span class="price">£{{ section.settings.product3_price | money_without_currency }}</span>
            {% if section.settings.product3_price_tag != blank %}
              <span class="price-tag">{{ section.settings.product3_price_tag }}</span>
            {% endif %}
          </div>
          <!-- Show price per serving -->
          <div class="servings">
            {{ section.settings.product3_supply }}
          </div>

          <!-- Show title for bullets list -->
          <h3>{{ section.settings.product3_bullets_title }}</h3>
<p>One-time purchase<br/>
At-home hormone test</p>
          <!-- Show bullet list -->
          <ul class="check-list">
            {% for j in (1..6) %}
              {% assign bullet_key = 'product3_bullet' | append: j %}
              {% assign bullet = section.settings[bullet_key] %}
              {% if bullet != blank %}
                <li>{{ bullet }}</li>
              {% endif %}
            {% endfor %}
          </ul>
 
         <div class="cta-column">
          <a href="https://www.withmonthlies.com/pages/go-to-checkout-hormonal" id="cta-checkout-monthlies-horm" class="price-cta-button">{{ section.settings.buy_now_text }}</a>   
        </div>
        </div>
      </div>
  </div>
</section>
