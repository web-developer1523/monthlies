{{ 'section-pricing.css' | asset_url | stylesheet_tag }}

<section class="pricing" id="pricing">
  <div class="pricing-title">
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="pricing-subtitle">
    <p class="subhead">{{ section.settings.text }}</p>
  </div>

  <div class="pricing-wrapper">

    <div class="product-column" id="product-column-3">
      <!-- Show product image -->
      <div class="product-img">
        {% if section.settings.product3_description != blank %}
            <div class="product-tag">
              <div class="product-tag-icon">
                    {{ icon_svg | default: '' | raw }}
              </div>
              <div class="product-tag-description">
                {{ section.settings.product3_description }}
              </div>
            </div>
          {% endif %}
        <img
          src="{{ section.settings.product3_image | img_url: '480x480' }}"
          alt="{{ section.settings.product1_title }}"
        >
      </div>

      <div class="product-content">
        <div class="horm-step"><span>{{ section.settings.product3_step }}</span></div>
        <h3>{{ section.settings.product3_bullets_title }}</h3>
        <!-- Show product title -->
        <h2>{{ section.settings.product3_title }}</h2>

        <!-- Show product price -->
        <div class="price">
          {{ section.settings.product3_price | money }}
          <span class="compared-price">{{ section.settings.product3_compare_at_price | money }}</span>
        </div>
        <!-- Show price per serving -->
        <div class="servings">
          {{ section.settings.product3_supply }}
        </div>

        <!-- Show title for bullets list -->

        <!-- Show bullet list -->
        <ul class="check-list">
          {% for j in (1..6) %}
            {% assign bullet_key = 'product3_bullet' | append: j %}
            {% assign bullet = section.settings[bullet_key] %}
            {% if bullet != blank %}
              <li>{{ bullet }}</li>
            {% endif %}
          {% endfor %}
          <div class="product-disclaimer">
          <span class="disclaimer-icon">
            <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/bottle.png?v=1695131093" />
          </span>
          <p>
           {{ section.settings.product_disclaimer_text }}
          </p>
        </div>
        </ul>

        

        {% if shop.locale == 'de' %}
          <a href="/de/products/hormonal-test" id="cta-buyhorm" class="button">
            {{ section.settings.start_now_text }}
            <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523" stroke="white" stroke-width="1.5"></path>
            </svg>
          </a>
        {% else %}
          <a href="/products/hormonal-test" id="cta-buyhorm" class="button">
            {{ section.settings.start_now_text }}
            <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523" stroke="white" stroke-width="1.5"></path>
            </svg>
          </a>
        {% endif %}

        <div class="disclaimer">
          {{ section.settings.disclaimer3 }}
        </div>
      </div>
    </div>
    

    <div class="product-column" id="product-column-2">
