<script>
function changeButton(event) {
  event.preventDefault();
  
  var button = event.target.closest('a');
  var icon = button.querySelector('#buttonIcon');
  
  button.textContent = 'Returning customers only. Please take the Hormone Test first.'; // Replace 'New Text' with the text you want

  button.style.backgroundColor = '#E76464';
  button.style.color = 'white';
  button.style.fontSize = '16px';
  button.style.lineHeight = '1.2em';

  // Hide the SVG icon
  icon.style.display = 'none';
  
  // Append icon again to the button
  button.appendChild(icon);
}
</script>
