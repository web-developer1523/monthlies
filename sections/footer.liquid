{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<div class="footer" style="--background: {{ section.settings.background }}">
  <div class="page-width footer__header">
    {%- unless section.settings.menu == blank -%}
      <div class="footer__menu">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    {%- endunless -%}
    <div class="footer__localization-copyright">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form>
          {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="caption-large visually-hidden" id="FooterCountryLabel">
                {{ 'localization.country_label' | t }}
              </h2>
              {%- render 'country-localization', localPosition: 'FooterCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
      {%- unless section.settings.copyright_text == blank -%}
        <div class="footer__copyright">{{ section.settings.copyright_text }}</div>
      {%- endunless -%}
    </div>
    {%- unless section.settings.enable_payment_icons == blank -%}
      <div class="footer__payment">
        <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
        <ul class="payment__list" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="payment__item">
              {{ type | payment_type_svg_tag }}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endunless -%}
  </div>
  {%- unless section.settings.footer_text == blank -%}
    <div class="footer__text-wrapper">
      <div class="page-width footer__text">
        {{ section.settings.footer_text }}
      </div>
    </div>
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country selector",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2025, monthlies. Alle Rechte vorbehalten."
    },
    {
      "type": "checkbox",
      "id": "enable_payment_icons",
      "label": "Enable payment icons",
      "default": true
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Footer text"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
