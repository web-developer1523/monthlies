{{ 'section-experts-campaign.css' | asset_url | stylesheet_tag }}

<div class="experts">
  <div class="page-width">
    <div class="experts-container">
      <div class="experts-content">
        <h2>{{ section.settings.title }}</h2>
        <div class="experts-leading">{{ section.settings.text }}</div>
        <a
          href="{{ section.settings.url }}"
          id="cta-experts"
          class="button button--black">
          {{ section.settings.label }}
          <svg
            width="7"
            height="12"
            viewBox="0 0 7 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <path
              d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523"
              stroke="white"
              stroke-width="1.5" />
          </svg>
        </a>
      </div>

      <div class="experts-wrapper">
        <div class="expert">
          <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Ashley.png?v=1687446633" alt="Expert">
          <h4>{{ section.settings.name_1 }}</h4>
          <p class="expert-field">{{ section.settings.field_1 }}</p>
          <p class="expert-text">{{ section.settings.text_1 }}</p>

          <a href="javascript:;" class="button button--medium cta-play-video-expert">
            <svg
              width="25"
              height="24"
              viewBox="0 0 25 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path d="M24.44 11.5545C24.2421 5.35986 19.2349 0.352691 13.0405 0.154868C9.66994 0.0479275 6.51656 1.33088 4.18608 3.73705C1.94565 6.05017 0.768494 9.09963 0.87146 12.3241C1.06912 18.5185 6.07639 23.5258 12.2707 23.7235C12.3997 23.7276 12.5275 23.7296 12.6556 23.7296C15.8761 23.7296 18.8839 22.4553 21.1252 20.1413C23.3656 17.8284 24.5429 14.7787 24.44 11.5545ZM19.3416 18.4139C17.5723 20.2407 15.1978 21.2467 12.6556 21.2467C12.554 21.2467 12.4523 21.245 12.3499 21.2419C7.46113 21.0857 3.50935 17.1339 3.35308 12.2449C3.2718 9.69857 4.20098 7.29058 5.96961 5.46465C7.73891 3.63788 10.1134 2.63188 12.6556 2.63188C12.7573 2.63188 12.8589 2.63354 12.9614 2.63668C17.8501 2.79279 21.8019 6.74462 21.9582 11.6336C22.0395 14.18 21.1101 16.588 19.3416 18.4139Z" fill="#252A31" />
              <path d="M16.5228 11.2542L11.2944 7.50529C10.7367 7.10534 9.9603 7.50397 9.9603 8.19031V15.6882C9.9603 16.3746 10.7367 16.7732 11.2944 16.3732L16.5227 12.6242C16.9918 12.288 16.9918 11.5906 16.5228 11.2542Z" fill="#252A31" />
            </svg>

            Play video
          </a>

          <div class="video-popup-expert">
            <svg
              fill="#FFFFFF"
              width="100pt"
              height="100pt"
              version="1.1"
              class="video-close-expert"
              viewBox="0 0 100 100"
              xmlns="http://www.w3.org/2000/svg">
              <path d="m73.336 22.422-23.336 23.336-23.336-23.336-4.2422 4.2422 23.336 23.336-23.336 23.336 4.2422 4.2422 23.336-23.336 23.336 23.336 4.2422-4.2422-23.336-23.336 23.336-23.336z" />
            </svg>

            {% assign videoUrl = "https://cdn.shopify.com/videos/c/o/v/5a30ac11ccee4962b8c2faecea0f29bc.mp4" %}

            {% if localization.language.iso_code == "fr" %}
              {% assign videoUrl = "https://cdn.shopify.com/videos/c/o/v/6b9d24fdbeb04b468ab3800402e71bca.mp4" %}
            {% elsif localization.language.iso_code == "de" %}
              {% assign videoUrl = "https://cdn.shopify.com/videos/c/o/v/ecd1b4a1c055485ba7fbd69f7d09b5ce.mp4" %}
            {% endif %}

            <video
              width="320"
              controls
              class="video-expert">
              <source src="{{ videoUrl }}" type="video/mp4">
            </video>
          </div>
        </div>

        <div class="expert">
          <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Cassandra.png?v=1687446633" alt="Expert">
          <h4>{{ section.settings.name_2 }}</h4>
          <p class="expert-field">{{ section.settings.field_2 }}</p>
          <p class="expert-text">{{ section.settings.text_2 }}</p>
        </div>

        <div class="expert">
          <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Mel.png?v=1687446632" alt="Expert">
          <h4>{{ section.settings.name_3 }}</h4>
          <p class="expert-field">{{ section.settings.field_3 }}</p>
          <p class="expert-text">{{ section.settings.text_3 }}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const videoBtnExp = document.querySelector(".cta-play-video-expert");
  const videoPopupExp = document.querySelector(".video-popup-expert");
  const videoCloseExp = document.querySelector(".video-close-expert");
  const videoExp = document.querySelector(".video-expert");

  videoBtnExp.addEventListener("click", () => {
    videoPopupExp.style.display = "flex";
    videoExp.play();
  });

  videoCloseExp.addEventListener("click", () => {
    videoPopupExp.style.display = "none";
    videoExp.pause();
    videoExp.currentTime = 0;
  });
</script>

{% schema %}
  {
    "name": "experts campaign",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "label": "Title",
        "default": "Our experts",
        "id": "title"
      },
      {
        "type": "richtext",
        "label": "Text",
        "default": "<p>We are a team of women experts specialised in hormonal balance, menstrual health and natural solutions. Take our cycle quiz for personalized recommendations based on your symptoms. Check in with us to find what works for you!</p>",
        "id": "text"
      },
      {
        "type": "url",
        "label": "Button URL",
        "id": "url"
      },
      {
        "type": "text",
        "label": "Button Label",
        "id": "label",
        "default": "Take the quiz"
      }, {
        "type": "text",
        "label": "Name",
        "default": "Dr. Ashley Florestal",
        "id": "name_1"
      }, {
        "type": "text",
        "label": "Field",
        "default": "Licensed Naturopath",
        "id": "field_1"
      }, {
        "type": "text",
        "label": "Text",
        "default": "Ashley focusses on women's health, hormones and fertility. She helps patients achieve hormonal balance, prepare for pregnancy, and optimize their health through her clinical practice and ongoing education.",
        "id": "text_1"
      }, {
        "type": "text",
        "label": "Name",
        "default": "Dr. Cassandra Paiano",
        "id": "name_2"
      }, {
        "type": "text",
        "label": "Field",
        "default": "Licensed Naturopath",
