<!-- Brand Section -->
<section class="brand-section">
    <div class="brand-logos-wrapper">

        {% if section.settings.brand_logo_1 != blank %}
        <div class="brand-logo">
            <img src="{{ section.settings.brand_logo_1 | img_url: 'master' }}" alt="brand-logo-1">
        </div>
        {% endif %}

        {% if section.settings.brand_logo_2 != blank %}
        <div class="brand-logo">
            <img src="{{ section.settings.brand_logo_2 | img_url: 'master' }}" alt="brand-logo-2">
        </div>
        {% endif %}

        {% if section.settings.brand_logo_3 != blank %}
        <div class="brand-logo">
            <img src="{{ section.settings.brand_logo_3 | img_url: 'master' }}" alt="brand-logo-3">
        </div>
        {% endif %}

        {% if section.settings.brand_logo_4 != blank %}
        <div class="brand-logo">
            <img src="{{ section.settings.brand_logo_4 | img_url: 'master' }}" alt="brand-logo-4">
        </div>
        {% endif %}

    </div>
</section>
<style>
    .brand-section {
        width: 100%;
        padding: 70px 0 60px 0 !important;
    }
    .brand-logos-wrapper {
        display: flex;
        justify-content: space-around;
        align-items: start;
        max-width: 1440px;
        margin: 0 auto;
        gap: 0.5rem;
        padding: 0;
    }
 .brand-logo img {
    max-height: 58px;
    width: auto;
    object-fit: contain;
    filter: none;
}
    
    /* Mobile slider styles */
    @media (max-width: 700px) {
        .brand-logos-wrapper {
            display: flex;
            overflow-x: auto;
            gap:34px;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
        }
        .brand-logo {
            flex: 0 0 auto;
            scroll-snap-align: start;
        }
        .brand-logo img {
                max-width: 98px;
        max-height: 35px;
        }
        .brand-section {
            border-radius: 0 0 18px 18px;
              padding: 25px 0;
        }
    }
    </style>
{% schema %}
{
  "name": "Brand Logos Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "brand_logo_1",
      "label": "Brand Logo 1"
    },
    {
      "type": "image_picker",
      "id": "brand_logo_2",
      "label": "Brand Logo 2"
    },
    {
      "type": "image_picker",
      "id": "brand_logo_3",
      "label": "Brand Logo 3"
    },
    {
      "type": "image_picker",
      "id": "brand_logo_4",
      "label": "Brand Logo 4"
    }
  ],
  "presets": [
    {
      "name": "Brand Logos Section",
      "category": "Brand"
    }
  ]
}
{% endschema %}
