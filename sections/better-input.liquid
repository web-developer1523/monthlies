{% schema %}
{
  "name": "Better Input",
  "tag": "section",
  "class": "section cst-better-inputs-sec",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "richtext",
      "id": "Title",
      "label": "Heading"
    },
     {
      "type": "richtext",
      "id": "note",
      "label": "Add Note"
    },
     {
      "type": "inline_richtext",
      "id": "section_description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header.content"
    }, {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "t:sections.all.padding.padding_top.unit",
      "label": "t:sections.all.padding.padding_top.label",
      "default": 36
