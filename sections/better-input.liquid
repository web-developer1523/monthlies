{{ 'better-input.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'slick-slider.css' | asset_url }}">

<!--
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
-->
<style>
    .main_img_desk img   {
      max-width: 257px;
      padding
  }
      .main_img_mobile img {
      max-width: 257px;
      padding: 35px;
      margin-top: 21px;
  }
    @media screen and (max-width:989px) {
      .trigger_slider .action_image { position: relative; text-align: center; max-width: 400px; margin: 0 auto; }
      .trigger_slider .action { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
      .trigger_slider img.mobile_hover_img { display: none; }
      .trigger_slider .card { padding: 24px; position: relative; width: 100%; height: 100%; text-align: left; transition: transform 0.6s; transform-style: preserve-3d; background: #fff; border-radius: 20px; border: 2px solid transparent; height: 200px; }
      .trigger_slider .card.slick-slide.slick-current.slick-active.slick-center { border: 2px solid #CB342C; }
      .trigger_slider .slick-slide { margin: 0 8px; }
      .trigger_slider .card h2 { margin-top: 0; margin-bottom: 10px; font-size: 16px; font-weight: 700; font-family: 'Quicksand' !important;letter-spacing:0; }
      .trigger_slider .card p { margin-top: 10px;line-height:1.2;letter-spacing:0; }
      .trigger_slider a[class*="slide"] { display: inline-block; position: absolute; }
      .trigger_slider a[class*="slide"] { width: 85px; height: 90px; display: flex; align-items: center; justify-content: space-around; }
      .trigger_slider .action_image { margin: 60px auto 30px; }
      .trigger_slider a.slide1 { left: 27%; top: -10%; }
      .trigger_slider a.slide2 { right: 31%; top: -2%; }
      .trigger_slider a.slide3 { bottom: 40%; right: 10%; }
      .trigger_slider a.slide4 { bottom: 2%; right: 16%; }
      .trigger_slider a.slide5 { bottom: -7%; left: 40%; }
      .trigger_slider a.slide6 { bottom: 16%; left: 28%; }
      .trigger_slider a.slide7 { left: 14%; bottom: 50%; }
      .trigger_slider a.active img.mobile_not_hover { display: none !important; }
      .trigger_slider a.active img.mobile_hover_img { display: block !important; }
      section[id*="better_input"] .page-width { padding: 0; }
      section[id*="better_input"] p.description {padding-left:20px;padding-right:20px;}
      /* stars new position css start */
      .trigger_slider a.slide3 { bottom: 40%; right: 20%; }
      .trigger_slider a.slide2 { right: 33%; top: 0%; }
      .trigger_slider a.slide1 { left: 28%; top: 0%; }
      .trigger_slider a.slide7 { left: 18%; bottom: 50%; }
      .trigger_slider a.slide4 { bottom: 6%; right: 16%; }
      /* stars new position css end */
    }
    @media screen and (min-width:989px) {
      .card.active { visibility: visible; }
      .card.active img.not_hover { visibility: hidden; display: none; }
      .card.active img.hover_img { visibility: visible; display: block; }
    }
  @media screen and (max-width:380px) {
    .trigger_slider .card {padding:20px;}
  }
</style>

<div id="better_input_output" class="page-width{% if section.settings.narrow %} page-width--inner{% endif %}">
  <div class="rich-text section--padding {{ section.settings.custom_class }}">
    <div class="heading ">
      <h2>{{ section.settings.Title }}</h2>
      <p class="description">{{ section.settings.section_description }}</p>
    </div>

    <div class="desktop better_input_container d-flex">
      <div class="left_side">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'Slide' -%}
              <div class="card">
                <h5 class="card_heading">
                  {{ block.settings.heading }}
                  <span class="absolute">
                    <span class="red_line"></span>
                    <img
                      class="not_hover"
                      data-class="LazyLoad" 
                      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                      data-src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/white_star.png?v=1723612522"
                    >
                    <img
                      class="hover_img"
                      data-class="LazyLoad"
                      data-src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/hover-star.png?v=1723612499"
                    >
                  </span>
                </h5>
                <div class="dsc">{{ block.settings.dsc }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      <div class="main_img_desk">
        <img 
          data-class="LazyLoad"
          src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
          data-src="{{ section.settings.image | img_url: 'master' }}">
      </div>
      <div class="right_side">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'Slide1' -%}
              <div class="card">
                <h5 class="card_heading">
                  {{ block.settings.heading }}
                  <span class="absolute">
                    <span class="red_line"></span>
                    <img                      
                      class="not_hover"
                      data-class="LazyLoad"
                      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
                      data-src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/white_star.png?v=1723612522"
                    >
                    <img
                      class="hover_img"
                      data-class="LazyLoad" 
                      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                      data-src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/hover-star.png?v=1723612499"
                    >
                  </span>
                </h5>
                <div class="dsc">{{ block.settings.dsc }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

