      "label": "t:sections.all.padding.padding_bottom.label",
      "default": 36
    },
     {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      }
  ],
   "blocks": [
  {
    "type": "Slide",
    "name": "Slide",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "inline_richtext",
        "id": "dsc",
        "label": "dsc"
      }
    ]
  },
      {
    "type": "Mobileslide",
    "name": "Mobileslide",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "inline_richtext",
        "id": "dsc",
        "label": "dsc"
      }
    ]
  },
   {
    "type": "Slide1",
    "name": "Slide1",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "inline_richtext",
        "id": "dsc",
        "label": "dsc"
      }
    ]
  }
],
  "presets": [
    {
      "name": "Better Input"
    }
  ]
}
{% endschema %}

<script type="lazyload_js" data-src="{{ 'jQuery.js' | asset_url }}" ></script>
<script type="lazyload_js" data-src="{{ 'slick-js.js' | asset_url }}" ></script>
<!--
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
-->

<script type="lazyload_js">
      jQuery(document).ready(function() {
      // Function to initialize the slider
      function initializeSlider() {
          // Get the viewport width using window.innerWidth
          var viewportWidth = window.innerWidth || document.documentElement.clientWidth;

          // Check if the screen width is mobile (<= 768px)
          if (viewportWidth <= 768) {
              // If the slider has already been initialized, un-slick it first
              if (jQuery('.better_slider').hasClass('slick-initialized')) {
                  jQuery('.better_slider').slick('unslick');
              }

              // Now, initialize the slider with your settings for mobile
              jQuery('.better_slider').slick({
                  centerMode: true,
                  centerPadding: '54px', // Default for smaller screens
                  slidesToShow: 1,       // Only show 1 slide on mobile
                  arrows: false,
                  responsive: [
                      {
                          breakpoint: 768, // Mobile specific settings
                          settings: {
                              arrows: false,
                              centerMode: true,
                              centerPadding: '40px',
                              slidesToShow: 1  // Show 1 slide on mobile
                          }
                      },
                      {
                          breakpoint: 480, // Smaller mobile screens (if needed)
                          settings: {
                              arrows: false,
                              centerMode: true,
                              centerPadding: '40px',
                              slidesToShow: 1  // Still show 1 slide
                          }
                      }
                  ]
              });
          }
      }

      // Initialize the slider on page load
      initializeSlider();

      // Reinitialize slider when the window is resized (with explicit check for mobile)
      jQuery(window).resize(function() {
          initializeSlider();
      });

      // Set up click functionality for slide navigation
      jQuery('a[data-slide]').click(function (e) {
          e.preventDefault();
          var slideno = jQuery(this).data('slide');
          jQuery('.better_slider').slick('slickGoTo', slideno - 1);
          jQuery(this).addClass('active');
          jQuery(this).siblings().removeClass('active');
      });

      // Update 'active' class on afterChange event
      jQuery('.better_slider').on('afterChange', function(event, slick, currentSlide) {
          // Remove 'active' class from all anchors
          jQuery('a[data-slide]').removeClass('active');

          // Add 'active' class to the anchor corresponding to the current slide
          jQuery('a[data-slide="' + (currentSlide + 1) + '"]').addClass('active');
      });

      // Add 'active' class to the second card on the left side
      jQuery('.left_side .card:nth-of-type(2)').addClass('active');

      // Hover effect to add/remove 'active' class on cards
      jQuery('.card').on('mouseenter', function() {
          jQuery('.card').removeClass('active');
      });

      jQuery('.card').on('mouseleave', function() {
          jQuery(this).addClass('active');
      });
  });
</script>
