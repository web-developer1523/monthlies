<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css">
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css">

<section class="styled-by-you page-width {{section.settings.custom_class }}">
  <h2>{{ section.settings.title }}</h2>
  {{ section.settings.subheading }}

  <div class="slider-new">
    {% for block in section.blocks %}
      <div class="item">
        <div class="item-content">
          {% if block.settings.video_url != blank %}
            <div class="video-wrapper">
              <video 
                class="look-video" 
                playsinline 
                muted 
                loop 
                preload="metadata"
                poster="{{ block.settings.video_poster | image_url }}">
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
              <div class="play-overlay">
                <svg viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </div>
            </div>
          {% else %}
            <div class="video-wrapper">
              <img src="{{ block.settings.image | image_url }}"/>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  

  {% if section.settings.btn_link != blank %}
    <a class="cta-button" href="{{ section.settings.btn_link }}">
      {{ section.settings.btn_text }}
    </a>
  {% endif %}
</section>

<script>
$('.slider-new').slick({
  centerMode: true,
  centerPadding: '0px',
  slidesToShow: 5,
  dots: true,
  arrows: true,
  infinite: true,
  responsive: [
    {
      breakpoint: 1340,
      settings: {
        slidesToShow: 4
      }
    },
    {
      breakpoint: 1024,
      settings: {
        slidesToShow: 3
      }
    },
    {
      breakpoint: 768,
      settings: {
        slidesToShow: 2
      }
    },
    {
      breakpoint: 480,
      settings: {
        slidesToShow: 2
      }
    }
  ]
});
</script>
<script>
  {% comment %} $(document).ready(function() {
    $('.video-wrapper .play-overlay').on('click', function() {
      const $wrapper = $(this).closest('.video-wrapper');
      const video = $wrapper.find('video')[0]; 
      if (video.paused) {
        video.play();
        $(this).fadeOut(); 
      } else {
        video.pause();
        $(this).fadeIn(); 
      }
    });

    $('.slider-new').on('beforeChange', function(event, slick, currentSlide, nextSlide){
      $('.look-video').each(function() {
        this.pause();
        $(this).siblings('.play-overlay').fadeIn(); 
      });
    });

  }); {% endcomment %}
</script>

<style>
  .styled-by-you .video-wrapper img {
    width: 100%;
height: 444px;
object-fit: cover;
border-radius: 16px;
display: block;
}
  /* Section */
.styled-by-you {
  text-align: center;
  padding: 50px 0;
  background:rgb(255, 255, 255); 
  width: 100%; 
  max-width:100%;
}

/* Headings */
.styled-by-you h2 {
  font-size: 40px;
  margin-bottom: 0;
  color: #252a31;
  margin-top: 0;
  font-weight: 600;
  font-family: Lora, sans-serif !important;
}
.styled-by-you p {
  font-size: 18px;
  margin: 7px 0 26px;
  color: #252a31;
  font-weight: 500;
  line-height: normal;
}
/* Slider items */
.styled-by-you .slider-new .item-content {
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 6px 20px rgba(0,0,0,0.1);
  height: 100%;
}

.styled-by-you .video-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

.styled-by-you .video-wrapper video {
  width: 100%;
  height: 444px;
  object-fit: cover;
  border-radius: 16px;
  display: block;
}

/* Play button overlay */
.styled-by-you .play-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: transparent;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    border: 3px solid #fff;
    justify-content: center;
    cursor: pointer;
    transition: 0.3s ease;
}

.styled-by-you .play-overlay svg {
  fill: #fff;
  width: 20px;
  height: 20px;
}

.styled-by-you .slick-dotted.slick-slider {
    max-width: 1500px;
    margin: 0 auto 30px;
}

.styled-by-you .slick-prev,
.styled-by-you .slick-next {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background-color: #fff;   /* white background */
  box-shadow: 0 2px 6px rgba(0,0,0,0.15); /* optional: subtle shadow */
  z-index: 10;
}
.styled-by-you .slick-prev:before,
.styled-by-you .slick-next:before {
  content: "" !important;
}
.styled-by-you .slick-prev:before, .styled-by-you .slick-next:before {
  font-size: 20px;
  color: #000;
  opacity: 1;
}
.styled-by-you .slick-initialized .slick-slide{
      margin: 0 5px;
}
.styled-by-you .slick-dots {
  bottom: -45px;
}
.styled-by-you .slick-dots li {
  margin: 0 5px;

}
.styled-by-you .slick-dots li button:before {
  font-size: 10px;
  color: #abd0cd;
  opacity: 1;
  background: transparent !important;
}
.styled-by-you .slick-dots li.slick-active button:before {
  opacity: 1;
  color: #000;
  background:transparent !important;
}
.styled-by-you button.slick-prev.slick-arrow, .styled-by-you button.slick-next.slick-arrow {
  width: 50px;
    height: 50px;
    transform: unset;
}
.styled-by-you .slick-prev {
  background-image: url("https://cdn.shopify.com/s/files/1/0708/7462/8371/files/leftarrownew1.png?v=1758630821");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 20px 20px;
  left: 25px;
}

/* right arrow */
.styled-by-you .slick-next {
  background-image: url("https://cdn.shopify.com/s/files/1/0708/7462/8371/files/rightarrownew1.png?v=1758630822");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 20px 20px;
  right: 25px;
}
@media screen and (max-width:767px){
  .styled-by-you .video-wrapper img {
    height: 320px;
}
  .styled-by-you .video-wrapper video{
  height:320px;
  }
  .styled-by-you h2{
  font-size:24px;
  line-height:normal;
}
}
@media screen and (max-width:575px){
  .styled-by-you button.slick-prev.slick-arrow, .styled-by-you button.slick-next.slick-arrow {
    width: 30px;
    height: 30px;
}
  .styled-by-you .slick-prev{
  left:0;
  }
 .styled-by-you .slick-next{
  right:0;
  }
  .styled-by-you p{
  font-size:15px;
}
}
</style>
{% schema %}
{
  "name": "UCG Creater Section",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "name": "Slide",
      "type": "slide",
      "settings": [
          {
            "type": "url",
            "id": "video_url",
            "label": "Video URL"
          },
          {
            "type": "image_picker",
            "id": "video_poster",
            "label": "Video Poster Image"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
      ]
    }
  ],
  "presets": [
    {
      "name": "UCG Creater Section"
    }
  ]
}
{% endschema %}
