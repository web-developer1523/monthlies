<style>
  .range {
  position: relative;
 pointer-events: auto;
}

.range__input,
.range__input-fill,
.range__counter {
pointer-events: auto;
}
  span.range__counter {
    pointer-events: auto;
}
  
  
.range__input-fill {
    transition: width 0.1s ease; /* Adjust the duration as needed */
}

.range__counter {
    transition: left 0.1s ease; 
  z-index:10;
}
   .range:not(:last-child) {
            margin-bottom: 1.5em;
        }

        .range input[type=range],
        .range input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none; 
        }

        .range input[type=range],
        .range__input-fill {
            border-radius: 0.25em;
            height: 0.5em;
          width:100%;
        }

        .range input[type=range] {
            background-color: #cee8e8;
            display: block;
            margin: 0.5em 0;
            padding: 0;
        }

        .range input[type=range]:focus {
            outline: transparent;
        }

        .range input[type=range]::-webkit-slider-thumb {
            background-color: #a6d0cd;
            border: 0;
            border-radius: 50%;
            cursor: pointer;
            position: relative;
            transition: background 0.1s linear;
            width: 57px;
            height: 57px;
            z-index: 99;
            box-shadow:none;
            outline:none;
            opacity:0;
        }

        .range input[type=range]::-moz-range-thumb {
            background-color:#a6d0cd;
          box-shadow:none;
          outline:none;
            border: 0;
            border-radius: 50%;
            cursor: pointer;
            position: relative;
            transform: translateZ(1px);
            transition: background-color 0.1s linear;
            width: 57px;
            height: 57px;
            z-index: 99;
            opacity:0;
        }

        .range input[type=range]::-moz-focus-outer {
            border: 0;
        }

        .range__input,
        .range__input-fill {
            display: block;
        }

        .range__input {
              position: relative;
        }

        .range__input:active input[type=range]::-webkit-slider-thumb,
        .range input[type=range]:focus::-webkit-slider-thumb,
        .range input[type=range]::-webkit-slider-thumb:hover {
            background-color: var(--handleDownBg);
        }

        .range__input:active input[type=range]::-moz-range-thumb,
        .range input[type=range]:focus::-moz-range-thumb,
        .range input[type=range]::-moz-range-thumb:hover {
            background-color: var(--handleDownBg);
        }

        .range__input-fill,
        .range__counter {
            left: 0;
            pointer-events: none;
            position: absolute;
        }

        .range__input-fill {
            background-color: var(--handleTrackBg);
            top: calc(50% - 0.25em);
        }

.range__counter {
    line-height: 1.8;
    height: 57px;
    width: 57px;
    background: #a6d0cd; 
    border-radius: 50%;
    font-size: 30px;
    top: -13px;
    text-align: center;
    color: #fff;
    font-weight: 600;
    font-family: 'Lora';
}
        .range__input-fill {
            top: 0;
        }

        .range input[type=range],
        .range__input-fill {
            border-radius: 20px;
            height: 31px;
        }

        .range__counter {
            line-height: 2;
        }

        .range__input-fill {
            background-color: #8CBFBD;
            top: 0;
        }
.range-container .input_wrapper { padding-left: 80px; position: relative; }
  .range-container .input_wrapper::before { content: "Month"; background: #8CBFBD; color: #fff; padding-left: 10px; border-radius: 20px 0 0 20px; position: absolute; left: 0;z-index:9; width: 100px; height: 100%; line-height: 1.8; font-size: 18px; }
        /* Dark mode */
        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #2e3138;
                --bgT: #2e313800;
                --fg: #e3e4e8;
                --fgT: #e3e4e800;
                --inputBg: #17181c;
            }
        }

  @media screen and (max-width:989px) {
    .range__counter { 
    height: 41px;
    width: 41px; 
      font-size:24px;
      line-height:1.7;
      top:-8px;
}
      .range input[type=range],
        .range__input-fill {
            border-radius: 20px;
            height:25px;
        }
.range-container .input_wrapper::before {font-size:11px;font-family:'Lora';line-height:2;width:70px;}
    .range-container .input_wrapper {
    padding-left: 55px;
    position: relative;
}
  .range input[type=range]::-webkit-slider-thumb {
             width: 41px;
            height: 41px; 
        }

        .range input[type=range]::-moz-range-thumb {
             width: 41px;
            height: 41px; 
        }
    
  }
</style>


