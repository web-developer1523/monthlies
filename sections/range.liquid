<script type="lazyload_js">
  window.addEventListener("DOMContentLoaded", () => {
    new FloorRange("#floors", "#rangeText");
  });

  class FloorRange {
    constructor(id, textId) {
      this.el = document.querySelector(id);
      this.fill = document.querySelector(".range__input-fill");
      this.counter = document.querySelector(".range__counter");
      this.elWithCSSVar = document.documentElement;
      this.textEl = document.querySelector(textId);
      this.hasAnimated = false; // Flag to ensure animation runs only once

      if (this.el) {
        this.buildSlider();
        this.el.addEventListener("input", this.changeValue.bind(this));
        this.el.addEventListener("change", this.changeValue.bind(this));
        this.counter.addEventListener("mousedown", this.startDragging.bind(this));
        this.counter.addEventListener("touchstart", this.startDragging.bind(this));

        // Set up the IntersectionObserver
        this.setupIntersectionObserver();
      }
    }

    buildSlider() {
      // Your existing buildSlider code
      let rangeWrap = document.createElement("div");
      rangeWrap.className = "range";
      this.el.parentElement.insertBefore(rangeWrap, this.el);

      let rangeInput = document.createElement("span");
      rangeInput.className = "range__input";
      rangeWrap.appendChild(rangeInput);

      let rangeFill = document.createElement("span");
      rangeFill.className = "range__input-fill";
      rangeInput.appendChild(this.el);
      rangeInput.appendChild(rangeFill);
      this.fill = rangeFill;

      let counter = document.createElement("span");
      counter.className = "range__counter";
      counter.textContent = "0";
      rangeInput.appendChild(counter);
      this.counter = counter;

      let maxFloorOvershoot = 3;
      this.elWithCSSVar.style.setProperty("--maxFloors", +this.el.max + maxFloorOvershoot);
      this.changeValue();
    }

    changeValue() {
      if (+this.el.value > this.el.max) this.el.value = this.el.max;
      else if (+this.el.value < this.el.min) this.el.value = this.el.min;

      this.elWithCSSVar.style.setProperty("--floors", +this.el.value);

      let pct = (this.el.value - this.el.min) / (this.el.max - this.el.min),
          fillWidth = pct * 100;

      if (this.counter) {
        let adjLeftEm = 2 * pct;
        this.counter.textContent = this.el.value;
        this.counter.style.left = `calc(${fillWidth}% - ${adjLeftEm}rem*2)`;
      }
      if (this.fill) {
        let thumbEm = 1 - pct;
        this.fill.style.width = `calc(${fillWidth}% + ${thumbEm}em)`;
      }

      let values = parseFloat(this.el.value);
      let roundedValue = values < 1.5 ? Math.floor(values) : Math.ceil(values);

      this.counter.textContent = roundedValue;
      this.updateText(roundedValue);
    }

    updateText(roundedValue) {
      if (roundedValue == 1) {
        this.textEl.innerHTML = '<p class="en"> <span class="title"> {{ section.settings.en_title1 }} </span> <span> {{ section.settings.en_content1 }} </span></p><p class="german"> <span class="title"> {{ section.settings.de_title1 }} </span> <span> {{ section.settings.de_content1 }}</span></p>';
      } else if (roundedValue == 2) {
        this.textEl.innerHTML = '<p class="en"> <span class="title"> {{ section.settings.en_title2 }}</span> <span> {{ section.settings.en_content2 }} </span></p><p class="german"> <span class="title"> {{ section.settings.de_title2 }}  </span>  <span> {{ section.settings.de_content2 }}</span></p> ';
      } else if (roundedValue == 3) {
        this.textEl.innerHTML = '<p class="en"> <span class="title"> {{ section.settings.en_title3 }}</span> <span> {{ section.settings.en_content3 }} </span></p> <p class="german"> <p class="german"> <span class="title"> {{ section.settings.de_title3 }} </span> <span> {{ section.settings.de_content3 }}</span></p>';
      } 

      // Trigger animation only if not already done
      if (!this.hasAnimated) {
        this.animateCounter();
        this.hasAnimated = true;
      }
    }

    animateCounter() {
      jQuery('.count').each(function () {
        jQuery(this).prop('Counter', 0).animate({
          Counter: jQuery(this).text()
        }, {
          duration: 1000,
          easing: 'swing',
          step: function (now) {
            jQuery(this).text(Math.ceil(now));
          }
        });
      });
    }

    startDragging(event) {
      event.preventDefault();
      const onMove = (e) => this.dragMove(e);
      const onEnd = () => {
        document.removeEventListener("mousemove", onMove);
        document.removeEventListener("mouseup", onEnd);
        document.removeEventListener("touchmove", onMove);
        document.removeEventListener("touchend", onEnd);
      };

      document.addEventListener("mousemove", onMove);
      document.addEventListener("mouseup", onEnd);
      document.addEventListener("touchmove", onMove);
      document.addEventListener("touchend", onEnd);

      this.dragMove(event);
    }

    dragMove(event) {
      const rect = this.el.parentElement.getBoundingClientRect();
      const offsetX = (event.clientX || event.touches[0].clientX) - rect.left;
      const pct = Math.max(0, Math.min(1, offsetX / rect.width));
      const step = parseFloat(this.el.step);
      const newValue = Math.round((pct * (this.el.max - this.el.min) + +this.el.min) / step) * step;

      this.el.value = newValue;
      this.changeValue();
    }

    setupIntersectionObserver() {
      const observerOptions = {
        root: null, // Use viewport as the root
        rootMargin: '0px',
        threshold: 0.1 // Trigger when 10% of the section is visible
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !this.hasAnimated) {
            this.changeValue(); // Ensure it updates the text for the first time
          }
        });
      }, observerOptions);

      const section = document.querySelector('#slider-section');
      if (section) {
        observer.observe(section);
      }
    }
  }
</script>


  
<script type="lazyload_js">
 function observeSection() {
    // Function to handle adding the class when the section comes into view
    function handleIntersection(entries) {
        entries.forEach(entry => {
            console.log('Entry:', entry); // Log entry details for debugging
            if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                console.log('Element is in view:', entry.target); // Log when element comes into view
            } else {
                entry.target.classList.remove('in-view');
                console.log('Element is out of view:', entry.target); // Log when element goes out of view
            }
        });
    }

    // Create an Intersection Observer
    const observer = new IntersectionObserver(handleIntersection, {
        threshold: 1 // Adjust as needed
    });

    // Target the sections you want to observe
    const targetSections = document.getElementsByClassName('range-container');

    // Ensure targetSections is not empty
    if (targetSections.length === 0) {
        console.error('No elements found with class "range-container"');
    }

    // Convert HTMLCollection to an array and observe each element
    Array.from(targetSections).forEach(section => {
        console.log('Observing:', section); // Log each element being observed
        observer.observe(section);
    });
}

// Call observeSection after the DOM content has loaded
document.addEventListener('DOMContentLoaded', () => {
    observeSection();
});



</script>
<script type="lazyload_js">
        // Get references to the slider and the display element
        const slider = document.getElementById('floors');
        const valueDisplay = document.getElementById('valueDisplay');

        // Function to update the display with the slider's value
        function updateValue() {
              let calculatedValue = 60 + slider.value * 10;
        
        // Limit the value to be no more than 85
        if (calculatedValue > 85) {
            calculatedValue = 85;
        }
        
        // Update the display with the limited value
        valueDisplay?.textContent = calculatedValue;
        }

        // Set up an event listener for the 'input' event
        slider.addEventListener('input', updateValue);
        
        // Initial update in case the page is loaded with a value
        updateValue();



  
    </script>

