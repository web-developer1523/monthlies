{% comment %} {{ 'section-how-it-works.css' | asset_url | stylesheet_tag }} {% endcomment %}

<div class="steps-section page-width">
  <h2 class="h1">{{ section.settings.title }}</h2>

  <div class="steps-wrapper">
      <div class="step">
          <img src="{{ section.settings.step_1_image | img_url: 'master' }}" alt="Step" />

          <h4>{{ section.settings.title_1 }}</h4>
          <p>{{ section.settings.text_1 }}</p>
          <p class="step-disclaimer">{{ section.settings.disclaimer_1 }}</p>

          {% if section.settings.step_1_url != blank and section.settings.step_1_btn_label != blank %}
          <a href="{{ section.settings.step_1_url }}" id="cta-how-it-works-horm1" class="button button--inverted-black">
              {{ section.settings.step_1_btn_label }}

              <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523" stroke="white" stroke-width="1.5" />
              </svg>
          </a>
          {% endif %}
      </div>

      <div class="step">
          <img src="{{ section.settings.step_2_image | img_url: 'master' }}" alt="Step" />

          <h4>{{ section.settings.title_2 }}</h4>
          <p>{{ section.settings.text_2 }}</p>
          <p class="step-disclaimer">{{ section.settings.disclaimer_2 }}</p>
          {% if section.settings.step_2_url != blank and section.settings.step_2_btn_label != blank %}
          <a href="{{ section.settings.step_2_url }}" id="cta-how-it-works-horm2" class="button button--inverted-black">
              {{ section.settings.step_2_btn_label }}

              <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523" stroke="white" stroke-width="1.5" />
              </svg>
          </a>
          {% endif %}
      </div>

      <div class="step">
          <img src="{{ section.settings.step_3_image | img_url: 'master' }}" alt="Step" />

          <h4>{{ section.settings.title_3 }}</h4>
          <p>{{ section.settings.text_3 }}</p>
          <p class="step-disclaimer">{{ section.settings.disclaimer_3 }}</p>
          {% if section.settings.step_3_url != blank and section.settings.step_3_btn_label != blank %}
          <a href="{{ section.settings.step_3_url }}" id="cta-how-it-works-horm3" class="button button--inverted-black">
              {{ section.settings.step_3_btn_label }}

              <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523" stroke="white" stroke-width="1.5" />
              </svg>
          </a>
          {% endif %}
      </div>
  </div>
  {% if section.settings.url != blank and section.settings.label != blank %}
  <div class="how-it-works-buttons">
      <a href="{{ section.settings.url }}" id="cta-how-it-works-horm-main" class="button button--black">
          {{ section.settings.label }}

          <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523" stroke="white" stroke-width="1.5" />
          </svg>
      </a>
  </div>
  {% endif %}

  <div class="video-popup">
      <svg fill="#FFFFFF" width="100pt" height="100pt" version="1.1" class="video-close" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <path d="m73.336 22.422-23.336 23.336-23.336-23.336-4.2422 4.2422 23.336 23.336-23.336 23.336 4.2422 4.2422 23.336-23.336 23.336 23.336 4.2422-4.2422-23.336-23.336 23.336-23.336z" />
      </svg>

      {% assign videoUrl = "https://cdn.shopify.com/videos/c/o/v/5a30ac11ccee4962b8c2faecea0f29bc.mp4" %} {% if localization.language.iso_code == "fr" %} {% assign videoUrl =
      "https://cdn.shopify.com/videos/c/o/v/6b9d24fdbeb04b468ab3800402e71bca.mp4" %} {% elsif localization.language.iso_code == "de" %} {% assign videoUrl = "https://cdn.shopify.com/videos/c/o/v/ecd1b4a1c055485ba7fbd69f7d09b5ce.mp4" %} {%
      endif %}

      <video width="320" controls class="video">
          <source src="{{ videoUrl }}" type="video/mp4" />
      </video>
  </div>
</div>


<script>
  const videoBtn = document.querySelector(".cta-play-video");
  const videoPopup = document.querySelector(".video-popup");
  const videoClose = document.querySelector(".video-close");
  const video = document.querySelector(".video");

  videoBtn.addEventListener("click", () => {
    videoPopup.style.display = "flex";
    video.play();
  });

  videoClose.addEventListener("click", () => {
    videoPopup.style.display = "none";
    video.pause();
    video.currentTime = 0;
  });
</script>
<style>
  .steps-section {
    padding-top: 40px;
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
}

.steps-section h2 {
    text-align: center;
    font-weight: 500;
    font-size: 40px !important;
}

.steps-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 140px;
    margin-top: 40px;
    margin-bottom: 60px;
    flex-wrap: wrap;
}

.step {
    max-width: 277px;
}

.step-disclaimer {
    padding-left: 24px;
    position: relative;
    font-size: 14px;
  font-weight:500;
  opacity: .8;
}

.step-disclaimer::after {
    content: "";
    position: absolute;
    height: 100%;
    width: 5px;
    border-radius: 10px;
    background-color: #E76464;
    left: 0; 
    top: 0;
}

.step img {
    max-width: 255px;
    width: 100%;
}

.step h4 {
    font-weight: 600;
    font-size: 20px;
    margin-bottom: 20px;
}

.step p {
    font-size: 16px;
    margin-bottom: 20px;
}

.how-it-works-buttons {
    display: flex;
    align-items: center;
  flex-direction: column;
    gap: 10px;
}

.how-it-works-buttons .cta-primary {
    margin: 0;
}

.video-popup {
    position: fixed;
    left: 0;
    top: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, .7);
    z-index: 50;
    display: none;
    justify-content: center;
    align-items: center;
}

.video-close {
    position: absolute;
    right: 30px;
    top: 30px;
    width: 30px;
    height: 30px;
    cursor: pointer;
}

@media (max-width: 481px) {
    .steps-wrapper {
        gap: 40px;
    }

    .steps-section .button {
        width: 100% !important;
    }

    .steps-section h2 {
        font-size: 28px !important;
    }

    .step {
        max-width: 100%;
        text-align: left;
    }

    .step img {
    display: block;
    max-height: 200px;
    width: auto;
    margin: 0 auto;
}

    .how-it-works-buttons {
        flex-direction: column;
        width: 100%;
        text-align: center;
    }

    .steps-wrapper {
        margin-bottom: 20px;
    }
}
</style>
