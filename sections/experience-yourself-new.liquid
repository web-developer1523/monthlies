    }
    
    .product-image {
    max-width: 100%;
    width: 100%;
    position: relative;
    margin-bottom: 20px;
    }
    
    .product-image img {
    {% comment %} width: 100%; {% endcomment %}
    max-width: 100%;
    height: auto;
    }
    
    .price-info {
    width: 100%;
    max-width: 100%;
    position: relative;
    }
    
    .temp-info {
    margin-top: 0;
    }
    
    .price-list {
