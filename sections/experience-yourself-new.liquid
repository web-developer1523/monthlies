    margin: 18px 0 25px;
    }
    

    
.savings-badge {
    /* width: 120px; */
    /* height: 120px; */
    /* top: 15px; */
    right: -45px;
}
    
    .savings-amount {
    font-size: 28px;
    }
    
    .savings-label {
    font-size: 13px;
    }
    
    .savings-subtext {
    font-size: 11px;
    }
    
    .price-list li {
    font-size: 15px;
    }
    
