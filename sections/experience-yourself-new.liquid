    }
    
    .price-bottom {
    font-size: 16px;
    text-align: left;
    margin-top: 15px;
    }
    
    .savings-badge {
    top: 20px;
    right: 20px;
    width: 100px;
    height: 100px;
    }
    
    .savings-label {
    font-size: 11px;
