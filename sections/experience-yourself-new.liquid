<section class="monthliesconsultation-cst">
    <div class="container ">
        <div>
            <div class="promo-container">
                <div class="promo-grid">

                    <!-- LEFT COLUMN -->
                    <div class="promo-left">
                        {% if section.settings.title != blank %}
                        <h1>{{ section.settings.title }}</h1>
                        {% endif %}

                        {% if section.settings.subtext != blank %}
                        <p class="subtext">{{ section.settings.subtext }}</p>
                        {% endif %}

                        {% if section.settings.cta_text != blank %}
                        <a href="{{ section.settings.cta_link }}" class="cta-btn cta-btn-desktop">{{ section.settings.cta_text }}</a>
                        {% endif %}
                    </div>

                    <!-- RIGHT COLUMN -->
                    <div class="promo-right">
                        <div class="product-image">
                            {% if section.settings.product_image != blank %}
                            <img class="desktop-image" src="{{ section.settings.product_image | img_url: 'master' }}" alt="Product">
                            {% endif %}
                            {% if section.settings.product_image_mobile != blank %}
                            <img class="mobile-image" src="{{ section.settings.product_image_mobile | img_url: 'master' }}" alt="Product">
                            {% endif %}
                           
                        </div>

                        <div class="price-info">
                            <div class="temp-info">
                                <ul class="price-list">

                                    {% if section.settings.price_item_1_label != blank %}
                                    <li>
                                        <span>{{ section.settings.price_item_1_label }}</span>
                                        <span>
                                            <span class="strike">{{ section.settings.price_item_1_strike }}</span>
                                            <strong>{{ section.settings.price_item_1_value }}</strong>
                                        </span>
                                    </li>
                                    {% endif %}

                                    {% if section.settings.price_item_2_label != blank %}
                                    <li>
                                        <span>{{ section.settings.price_item_2_label }}</span>
                                        <span>
                                            <span class="strike">{{ section.settings.price_item_2_strike }}</span>
                                            <strong>{{ section.settings.price_item_2_value }}</strong>
                                        </span>
                                    </li>
                                    {% endif %}

                                    {% if section.settings.price_item_3_label != blank %}
                                    <li>
                                        <span>{{ section.settings.price_item_3_label }}</span>
                                        <span>
                                            <span class="strike">{{ section.settings.price_item_3_strike }}</span>
                                            <strong>{{ section.settings.price_item_3_value }}</strong>
                                        </span>
                                    </li>
                                    {% endif %}

                                    {% if section.settings.price_item_4_label != blank %}
                                    <li>
                                        <span>{{ section.settings.price_item_4_label }}</span>
                                        <span>
                                            <span class="strike">{{ section.settings.price_item_4_strike }}</span>
                                            <strong>{{ section.settings.price_item_4_value }}</strong>
                                        </span>
                                    </li>
                                    {% endif %}

                                </ul>

                                {% if section.settings.monthly_price != blank %}
                                <div class="price-bottom">
                                    {{ section.settings.monthly_price }}
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                </div>

                {% if section.settings.cta_text_mobile != blank %}
                <a href="{{ section.settings.cta_link }}" class="cta-btn cta-btn-mobile">{{ section.settings.cta_text_mobile }}</a>
                {% endif %}

            </div>
        </div>
    </div>
</section>


<style>
 /* Container */
.promo-container {
padding: 60px 20px;
font-family: "Inter", sans-serif;
}
.monthliesconsultation-cst {
    background: #ecf1f4;
    border-top-right-radius: 120px;
}
/* GRID */
.promo-left h1 span {
    font-family: 'Lora';
    color: #CB342C;
    font-style: italic;
}
.promo-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: center;
}
.promo-right {
    display: flex;
    position: relative;
    gap: 20px;
}

.price-info {
    flex: 1;
    position: relative;
    padding-left: 40px;
}
/* LEFT SIDE */
.promo-left h1 {
    font-size: 40px;
    line-height: 1.3;
    color: #222;
    font-weight: 600;
}

.highlight {
    color: #d6453d;
}

.subtext {
    margin: 20px 0 30px;
    color: #404040;
    font-weight:500;
    font-size: 16px;
    max-width: 480px;
    line-height: 1.4;
}

.cta-btn {
    background: #CB342C;
    padding: 14px 28px;
    border-radius: 40px;
    color: white;
    border: none;
    font-size: 16px;
    font-weight:600;
    cursor: pointer;
    box-shadow:rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
    text-decoration:none;
}

.cta-btn-mobile {
    display: none;
}

/* RIGHT SIDE */
.product-image{
    width: 100%;
    max-width: 50%;
    position: relative;
}
.product-image img {
    max-width: 480px;
    height: auto;
    position: relative;
    z-index: 1;
}

/* PRICE LIST */
.price-list {
    list-style: none;
    padding: 0;
    margin: 20px 0;
    width: 100%;
    
}

.price-list li {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    font-size: 16px;
    color: #333;
    line-height: 1.4;
    flex-wrap: nowrap !important;
}

.strike {
    text-decoration: line-through;
    color: #404040;
    margin-left: 10px;
    text-decoration-color: #d6453d;
    text-decoration-thickness: 2px;
}
.price-bottom {
    margin-top: 20px;
    border-top: 1px solid #ccc;
    padding-top: 12px;
    font-weight: 700;
    font-size: 18px;
    text-align: right;
}
.price-list strong {
    padding-left: 10px;
    color: #404040;
}

/* SAVINGS BADGE */
.savings-badge {
    position: absolute;
    top: 350px;
    right: -150px;
    width: 140px;
    height: 140px;
    background: #d6453d;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 4px 12px rgba(214, 69, 61, 0.3);
    transform: rotate(8deg);
    z-index: 10;
}
.savings-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.savings-label {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 4px;
}

.savings-amount {
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
}

.savings-subtext {
    font-size: 12px;
    font-weight: 500;
    margin-top: 4px;
}
.temp-info {
    height: 100%;
    display: flex;
    flex-direction: column;
    /* justify-content: center; */
    margin-top: 59px;
}
.price-span {
display: flex;
align-items: center;
justify-content: space-between;
}
.temp-info span {
    display: flex;
        font-size: 16px;
    font-weight: 500;
    color:#404040;
}
.cst-custom-homepage-new .mobile-image {
    display: none;
}
/* RESPONSIVE */
@media (max-width: 1399px) {
    .promo-container {
    padding: 50px 20px;
    }
    
    .promo-left h1 {
    font-size: 36px;
    }
    

    
.savings-badge {
    width: 100px;
    height: 100px;
    top: 184px;
    right: 15px;
}

    
    .savings-amount {
    font-size: 25px;
    }
}

@media (max-width:1300px) {
   .product-image img {
    max-width: 410px;
}
  .promo-left h1 {
    font-size: 28px;
    }
}

@media (max-width: 1200px) {
 .promo-container {
    padding: 50px 0;
    }
}
@media (max-width: 1024px) {
.cta-btn {
    padding: 14px 22px;
}
    .promo-grid {
    gap: 30px;
    }
    
  
