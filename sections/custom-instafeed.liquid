{{ 'section-custom-instafeed.css' | asset_url | stylesheet_tag }}

{% liquid
  assign title = section.settings.title
  assign sub_title = section.settings.sub_title
  assign hashtag = section.settings.hashtag
  assign background_color = section.settings.background_color
%}

{% render 'section-paddings',
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

{%- capture social_buttons_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'social_link' and block.settings.link != blank -%}
      <a
        href="{{ block.settings.link }}"
        class="insta-community__btn"
        target="_blank"
        style="--btn-text-color: {{ block.settings.text_color }};"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.icon != blank -%}
          {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy', class: 'insta-community__btn-icon' }}
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <span class="insta-community__btn-text">{{ block.settings.text }}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  class="insta-community section-{{ section.id }}--padding"
  style="
    --background-color: {{ background_color }};
    --text-color: {{ section.settings.text_color }};
    --hashtag-color: {{ section.settings.hashtag_color }};
  "
>
  <div class="insta-community__wrapper">
    {% if section.settings.title != blank %}
      <div class="insta-community__header page-width">
        <h2 class="insta-community__title">
          {{ title }}
          {% if sub_title != blank %}
            <br>
            {{ sub_title }}
          {% endif %}
        </h2>

        <div class="insta-community__actions">
          {%- if social_buttons_html != blank -%}
            <div class="insta-community__social-buttons insta-community__social-buttons--desktop">
              {{ social_buttons_html }}
            </div>
          {% endif %}
          {% if hashtag != blank %}
            <span class="insta-community__hashtag insta-community__hashtag--desktop">{{ hashtag }}</span>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="insta-community__gallery">
      <div class="insta-community__widget-wrap">
        <div class="insta-community__widget" id="insta-feed"></div>
      </div>
    </div>

    {%- if social_buttons_html != blank -%}
      <div class="insta-community__social-buttons insta-community__social-buttons--mobile page-width">
        {{ social_buttons_html }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom Instafeed Row",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title line 1",
      "default": "Leben mit monthlies."
    },
    {
      "type": "inline_richtext",
      "id": "sub_title",
      "label": "Title line 2",
      "default": "Werde Teil der community"
    },
    {
      "type": "text",
      "id": "hashtag",
      "label": "Hashtag text",
      "default": "#bywomenforwomen"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#404040"
    },
    {
      "type": "color",
      "id": "hashtag_color",
      "label": "Hashtag color",
      "default": "#CB342C"
    },
    {
      "type": "header",
      "content": "Paddings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social Link",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Button Text",
          "default": "Follow us"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#404040"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Instafeed Row",
      "blocks": [
        { "type": "social_link", "settings": { "text": "Instagram" } },
        { "type": "social_link", "settings": { "text": "TikTok" } }
      ]
    }
  ]
}
{% endschema %}