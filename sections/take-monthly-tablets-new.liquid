<section class="kann-ich-monthlies-einnehmen">
    <div class="container">
      <div class="kann-ich-monthlies-einnehmen-inner">
        <h2>{{ section.settings.main_heading }}</h2>
      </div>
  
      <div class="kann-ich-monthlies-einnehmen-content">
        <div class="faq-box">
          {% for block in section.blocks %}
            <div class="faq-item">
              <div class="faq-header">
                <span>{{ block.settings.question }}</span>
                <div class="svg-wrapper">
                  <svg xmlns="http://www.w3.org/2000/svg" width="12" height="21" viewBox="0 0 12 21" fill="none" style="transform: rotate(0deg);" class="">
                    <path d="M12 10.0806L2.87909 20.1611L2.87909 15.9609L7.19953 10.0806L2.87909 4.20023L2.87909 -3.48836e-07L12 10.0806Z" fill="#CB342C"></path>
                    <path d="M9.12109 10.0806L0.000185913 20.1611L0.000186123 15.9609L4.32062 10.0806L0.000185757 4.20023L0.000185966 -3.48836e-07L9.12109 10.0806Z" fill="#96B8B5"></path>
                    </svg>
                </div>
              </div>
              <div class="faq-content">
                {{ block.settings.answer }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
  
  <style>
    .kann-ich-monthlies-einnehmen .faq-box .faq-item:last-child {
      grid-column: 1/-1;
      width: 100%;
      max-width:600px;
      margin: 0 auto;
  }
.kann-ich-monthlies-einnehmen .faq-box {
    margin-top: 56px;
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}
.kann-ich-monthlies-einnehmen .faq-item {
    background: #fff;
    border-radius: 12px;
    margin-bottom: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
}
.kann-ich-monthlies-einnehmen .faq-header {
    display: grid;
    grid-template-columns: 1fr auto;
    cursor: pointer;
    background: #ffffff;
    border-radius: 16px;
    padding: 16px 16px 16px 24px;
    align-items: center;
}
.kann-ich-monthlies-einnehmen .faq-header span {
    color: #404040;
    text-align: left;
    font-family: "Quicksand", sans-serif;
    font-size: 17px;
    line-height: 1.4;
    font-weight: 700;
}
.kann-ich-monthlies-einnehmen .svg-wrapper {
    width: 44px !important;
    height: 44px;
    background: #ecf1f4;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}
.kann-ich-monthlies-einnehmen .faq-content {
    padding: 0 20px;
}

.kann-ich-monthlies-einnehmen {
      background: #ecf1f4;
      border-radius: 20px;
      padding: 96px 0px 96px 0px;
      margin: 0 auto;
      max-width: 1320px;
  }
  
.kann-ich-monthlies-einnehmen .kann-ich-monthlies-einnehmen-inner h2 {
  color: #404040;
  text-align: center;
  font-family: "Lora", serif;
  font-size: 40px;
  letter-spacing: -0.02em;
  font-weight: 600;
  line-height: 30px;

}

.kann-ich-monthlies-einnehmen .kann-ich-monthlies-einnehmen-content {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
}
.kann-ich-monthlies-einnehmen .svg-wrapper {
  width: 44px !important;
  height: 44px;
  background: #ecf1f4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.kann-ich-monthlies-einnehmen .faq-header svg {
  transition: transform 0.3s ease;
}

.kann-ich-monthlies-einnehmen .faq-header svg.rotate {
  transform: rotate(180deg);
}

.kann-ich-monthlies-einnehmen .faq-content {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.35s ease;
}
.product-new-custom-product .kann-ich-monthlies-einnehmen {
  background: transparent;
  padding: 0;
}
.product-new-custom-product .kann-ich-monthlies-einnehmen .faq-header {
  background: #FAFCFE;
}

.product-new-custom-product .kann-ich-monthlies-einnehmen .faq-item {
  box-shadow: none;
}
.product-new-custom-product .kann-ich-monthlies-einnehmen .container {
  width: 100%;
  max-width: 100%;
}
@media (max-width:991px) {
  .kann-ich-monthlies-einnehmen .kann-ich-monthlies-einnehmen-inner h2 {
    
    font-size: 24px;
    
  }
  .kann-ich-monthlies-einnehmen .kann-ich-monthlies-einnehmen-inner h2 br {
    display: none;
  }
  .kann-ich-monthlies-einnehmen {
    padding: 56px 0px 56px 0px;
  }
}
@media (max-width:768px) {
 .product-new-custom-product .kann-ich-monthlies-einnehmen .faq-box .faq-item:last-child{
    grid-column: unset;
    max-width: 100%;
}
.kann-ich-monthlies-einnehmen .faq-box .faq-item:last-child {
  max-width: 100%;

}
       .product-new-custom-product .kann-ich-monthlies-einnehmen {
        background: #ECF1F4;
        padding: 56px 0;
        border-radius: 0;
    }
.kann-ich-monthlies-einnehmen .faq-box{
    grid-template-columns: 1fr ;
}
.cst-custom-homepage-new .kann-ich-monthlies-einnehmen{
    padding: 50px 0 !important;
}
}
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const items = document.querySelectorAll('.faq-item');
  
      items.forEach((item) => {
        const header = item.querySelector('.faq-header');
        const content = item.querySelector('.faq-content');
        const svg = item.querySelector('svg');
  
        header.addEventListener('click', () => {
          // Close other items
          items.forEach((other) => {
            if (other !== item) {
              other.classList.remove('active');
              other.querySelector('.faq-content').style.maxHeight = '0';
              other.querySelector('svg').classList.remove('rotate');
            }
          });
  
          // Toggle this item
          item.classList.toggle('active');
  
          if (item.classList.contains('active')) {
            content.style.maxHeight = content.scrollHeight + 'px';
            svg.classList.add('rotate');
          } else {
            content.style.maxHeight = '0';
            svg.classList.remove('rotate');
          }
        });
      });
    });
  </script>
  {% schema %}
  {
    "name": "Take Monthly FAQ New",
    "settings": [
      {
        "type": "html",
        "id": "main_heading",
        "label": "Main Heading",
        "default": "Kann ich monthlies einnehmen, wenn ich…"
      }
    ],
  
    "blocks": [
      {
        "type": "faq_item",
        "name": "FAQ Item",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question",
            "default": "... ein hormonelles Verhütungsmittel benutze?"
          },
          {
            "type": "richtext",
            "id": "answer",
            "label": "Answer"
          }
        ]
      }
    ],
  
    "presets": [
      {
        "name": "Take Monthly FAQ New",
        "category": "FAQ"
      }
    ]
  }
  {% endschema %}
  