<div class="page-width{% if section.settings.narrow %} page-width--inner{% endif %}">
  <div id="painkiller" class="paintesting rich-text section--padding {{ section.settings.custom_class }}">
    <div class="heading">
      <h2>{{ section.settings.Title }}</h2>
      <p class="description">{{ section.settings.section_description }}</p>
    </div>

    <div class="swiper-container_supl">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide">
            <div class="inner_swiper">
              <div class="supplement_details_wrapper front">
                <img
                  data-class="LazyLoad"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                  data-src="{{ block.settings.image | img_url: 'master' }}"
                  alt="">
                <h5 class="title">{{ block.settings.heading }}</h5>
                <p class="dsc">{{ block.settings.dsc }}</p>
                <!-- flip icon removed -->
              </div>
              <!-- back face removed -->
            </div>
          </div>
        {%- endfor -%}
      </div>

      <!-- keep prev only if you use it; remove if not needed -->
      <div class="swiper-supl-button-prev"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Benefits static",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "custom_class", "label": "Custom Class" },
    { "type": "richtext", "id": "Title", "label": "Heading" },
    { "type": "inline_richtext", "id": "section_description", "label": "Description" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Title" },
        { "type": "richtext", "id": "dsc", "label": "Description" }
      ]
    }
  ],
  "presets": [
    { "name": "Benefits static", "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}

<style>
  .swiper-container { width:100%; height:100%; overflow:hidden; box-sizing:border-box; }
  .swiper-wrapper { display:flex; }

  .swiper-container_supl .swiper-slide{
    width:81% !important; display:flex; justify-content:center; align-items:center;
  }

  .swiper-slide-prev, .swiper-slide-next{ opacity:.6; }
  .swiper-button-next, .swiper-button-prev{ color:#000; }

  @media (max-width: 989px){
    .swiper-container_supl .swiper-slide{ width:273px !important; }
  }

  /* make sure no flip transform ever applies */
  #painkiller .inner_swiper{ transform:none !important; }
</style>

<script type="lazyload_js">
  (function($){
    var swiper;
    function initSwiper(){
      if ($(window).width() < 4000){
        if (!swiper){
          swiper = new Swiper('.swiper-container_supl', {
            slidesPerView: 'auto',
            spaceBetween: 16
            // navigation removed (no flip icons). Add back if you use real arrows:
            // navigation: { nextEl: '.swiper-supl-button-next', prevEl: '.swiper-supl-button-prev' }
          });
        }
      } else {
        if (swiper){ swiper.destroy(true,true); swiper = null; }
      }
    }
    $(initSwiper);
    $(window).on('resize', initSwiper);

    // remove any old flip handlers/classes
    $('div#painkiller .inner_swiper').removeClass('rotate').off('click');
  })(jQuery);
</script>
