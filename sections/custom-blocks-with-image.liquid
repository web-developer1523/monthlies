{% if section.settings.heading != blank or section.blocks.size > 0 %}

  {{ 'section-custom-blocks-with-image.css' | asset_url | stylesheet_tag }}

  {% liquid
    assign background_color = section.settings.background_color
    assign heading = section.settings.heading
    assign heading_alignment = section.settings.heading_alignment
    assign text_color = section.settings.text_color
  %}

  {% render 'section-paddings',
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom,
    padding_top_mobile: section.settings.padding_top_mobile,
    padding_bottom_mobile: section.settings.padding_bottom_mobile
  %}

  <div
    class="blocks-with-image-grid section-{{ section.id }}--padding"
    style="
      --background-color: {{ background_color }};
      --heading-alignment: {{ heading_alignment }};
      --text-color: {{ text_color }};
    "
  >
    <div class="blocks-with-image-grid__wrapper">
      {% if heading != blank %}
        <h2 class="blocks-with-image-grid__heading page-width">
          {{ heading }}
        </h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="blocks-with-image-grid__items-wrapper">
          <div class="blocks-with-image-grid__items page-width">
          {% for block in section.blocks %}
            {% liquid
              assign image = block.settings.image
              assign text = block.settings.text
            %}

            {% if image != blank or text != blank %}
              <div class="blocks-with-image-item" {{ block.shopify_attributes }}>
                {% if image != blank %}
                  <div class="blocks-with-image-item__image-wrapper">
                    {{
                      image
                      | image_url: width: 600
                      | image_tag:
                        class: 'blocks-with-image-item__image',
                        loading: 'lazy'
                    }}
                  </div>
                {% endif %}

                {% if text != blank %}
                  <div class="blocks-with-image-item__content">
                    <div class="blocks-with-image-item__text">
                      {{ text }}
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Block with image",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Die natürlichen Inhaltsstoffe unserer Formel bergen zahlreiche Vorteile"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#404040"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (Mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (Mobile)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "Slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Slide description</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Block with image",
      "category": "Custom",
      "blocks": [
        { "type": "Slide" },
        { "type": "Slide" },
        { "type": "Slide" },
        { "type": "Slide" },
        { "type": "Slide" }
      ]
    }
  ]
}
{% endschema %}
