<section class="energieniveau">
    <div class="container">
        <div class="energieniveau-inner">
            <div class="row">

                <!-- LEFT SIDE -->
                <div class="col-md-6">
                    <div class="energieniveau-content">

                        <!-- TAB TITLES -->
                        <ul class="cycle-tabs">
                            {% assign tab_index = 1 %}
                            {% for block in section.blocks %}
                                {% if block.type == 'tab_block' %}
                                    <li class="{% if forloop.first %}active{% endif %}"
                                        data-tab="{{ tab_index }}"
                                        data-block-id="{{ block.id }}">
                                        {{ block.settings.tab_title }}
                                    </li>
                                    {% assign tab_index = tab_index | plus: 1 %}
                                {% endif %}
                            {% endfor %}
                        </ul>

                        <!-- TAB CONTENT -->
                        <div class="cycle-content">

                            {% assign tab_index = 1 %}
                            {% for block in section.blocks %}
                                {% if block.type == 'tab_block' %}
                                    <div class="content-box {% if forloop.first %}active{% endif %}"
                                        id="tab{{ tab_index }}"
                                        data-block-id="{{ block.id }}"
                                    >

                                        <div class="content-box-inner">

                                            <!-- Heading -->
                                            <h2>{{ block.settings.heading }}</h2>

                                            <!-- TAGS FILTERED BY PARENT TAB -->
                                            <div class="cycle-tags-inner">
                                                <div class="tags">

                                                    {% for tag_block in section.blocks %}
                                                        {% if tag_block.type == 'tag_item'
                                                            and tag_block.settings.parent_tab == block.id %}
                                                            <div class="tags-item">
                                                                <a href="#">
                                                                    {% if tag_block.settings.tag_icon %}
                                                                        <img src="{{ tag_block.settings.tag_icon | image_url }}" alt="">
                                                                    {% endif %}
                                                                    {{ tag_block.settings.tag_text }}
                                                                </a>
                                                            </div>
                                                        {% endif %}
                                                    {% endfor %}

                                                </div>
                                            </div>
                                                <!-- BUTTON TAGS -->
                                                <div class="tags">

                                                    {% if block.settings.btn1 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_1 %}
                                                                <img src="{{ block.settings.icon_image_1 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn1 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn2 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_2 %}
                                                                <img src="{{ block.settings.icon_image_2 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn2 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn3 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_3 %}
                                                                <img src="{{ block.settings.icon_image_3 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn3 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn4 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_4 %}
                                                                <img src="{{ block.settings.icon_image_4 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn4 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn5 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_5 %}
                                                                <img src="{{ block.settings.icon_image_5 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn5 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn6 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_6 %}
                                                                <img src="{{ block.settings.icon_image_6 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn6 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn7 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_7 %}
                                                                <img src="{{ block.settings.icon_image_7 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn7 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn8 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_8 %}
                                                                <img src="{{ block.settings.icon_image_8 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn8 }}
                                                        </span>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn9 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_9 %}
                                                                <img src="{{ block.settings.icon_image_9 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn9 }}
                                                        </a>
                                                    </div>
                                                    {% endif %}
                                                
                                                    {% if block.settings.btn10 != blank %}
                                                    <div class="tags-item">
                                                        <span>
                                                            {% if block.settings.icon_image_10 %}
                                                                <img src="{{ block.settings.icon_image_10 | image_url }}" alt="">
                                                            {% endif %}
                                                            {{ block.settings.btn10 }}
                                                        </a>
                                                    </div>
                                                    {% endif %}
                                                
                                                </div>
                                                
                                            <!-- PERCENTAGE -->
                                            <div class="percentage-container">

                                                {% if block.settings.percent != blank or block.settings.percent_text != blank %}
                                                <div class="percent-inner">
                                                    <h2>{{ block.settings.percent }}</h2>
                                                    <p>{{ block.settings.percent_text }}</p>
                                                </div>
                                                {% endif %}
                                            
                                                {% if block.settings.percent1 != blank or block.settings.percent_text1 != blank %}
                                                <div class="percent-inner">
                                                    <h2>{{ block.settings.percent1 }}</h2>
                                                    <p>{{ block.settings.percent_text1 }}</p>
                                                </div>
                                                {% endif %}
                                            
                                                {% if block.settings.percent2 != blank or block.settings.percent_text2 != blank %}
                                                <div class="percent-inner">
                                                    <h2>{{ block.settings.percent2 }}</h2>
                                                    <p>{{ block.settings.percent_text2 }}</p>
                                                </div>
                                                {% endif %}
                                            
                                                {% if block.settings.percent3 != blank or block.settings.percent_text3 != blank %}
                                                <div class="percent-inner">
                                                    <h2>{{ block.settings.percent3 }}</h2>
                                                    <p>{{ block.settings.percent_text3 }}</p>
                                                </div>
                                                {% endif %}
                                            
                                            </div>                                            
                                        </div>
                                    </div>

                                    {% assign tab_index = tab_index | plus: 1 %}
                                {% endif %}
                            {% endfor %}

                        </div>

                    </div>
                </div>

                <!-- RIGHT IMAGE -->
                <div class="col-md-6">
                    <div class="cycle-image">
                        {% for block in section.blocks %}
                            {% if block.type == 'tab_block' and forloop.first %}
                                {% if block.settings.tab_image %}
                                    <img id="cycle-img" src="{{ block.settings.tab_image | image_url }}" alt="">
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

            </div>
        </div>

        <!-- DISCLAIMER -->
        <div class="aussagen-text-inner">
            {{ section.settings.bottom_disclaimer }}
        </div>
    </div>
</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
{% comment %} <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script> {% endcomment %}
<script>
$(function () {
    $(".cycle-tabs li").on("click", function () {
        const tabNumber = $(this).data("tab"); // number

        // Change active tab class
        $(".cycle-tabs li").removeClass("active");
        $(this).addClass("active");

        // Show corresponding content box
        $(".content-box").removeClass("active");
        $("#tab" + tabNumber).addClass("active");

    });
});
</script>
<style>
/* energieniveau css */

.energieniveau {
    padding: 40px 0;
    position: relative;
}

.energieniveau-inner {
    background-color: #fafcfe;
    padding: 56px;
    border-radius: 20px;
    min-height: 675px;
    position: relative;
}

/* TAB BUTTONS */
.cycle-tabs {
    margin: 0;
    padding: 4px;
    list-style: none;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    border: 1px solid #ecf1f4;
    display: flex;
    flex-direction: row;
    gap: 4px;
    align-items: center;
        justify-content: space-between;
    max-width: 340px;
}

.cycle-tabs li {
    background: #ffffff;
    border-radius: 999px;
    color: #404040;
    font-size: 12px;
    padding: 12px;
    font-weight: 400;
    cursor: pointer;
    font-family: Quicksand, sans-serif;
    border: 1px solid #ecf1f4;
    user-select: none;
    transition: 0.2s ease;
}

.cycle-tabs li.active,
.cycle-tabs li:hover {
    background-color: #ecf1f4;
    font-weight: 700;
}

/* TAB CONTENT */
.content-box {
    display: none;
}

.content-box.active {
    display: block;
}

.content-box-inner > h2 {
    color: #404040;
    font-family: "Lora", serif;
    font-size: 24px;
    letter-spacing: -0.02em;
    font-weight: 600;
    margin-top: 32px;
    margin-bottom: 16px;
}

/* TAGS */
.tags {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.tags-item span {
    background: #abd0cd;
    border-radius: 999px;
    padding: 6px 8px;
    display: flex;
    flex-direction: row;
    gap: 4px;
    align-items: center;
    color: #404040;
    font-family: "Quicksand", sans-serif;
    font-size: 16px;
    line-height: 140%;
    font-weight: 400;
    text-decoration: none;
}

div#tab1 .tags-item:first-child  span{
    color: white;
}
.tags-item a img {
    width: auto;
    height: 16px;
}
div#tab2 .tags-item:nth-child(2) span,
div#tab2 .tags-item:nth-child(3) span,
div#tab2 .tags-item:nth-child(4) span {
    color: white;
}
div#tab3 .tags-item:first-child  span{
    color: white;
}

/* PERCENT BOX */
.percentage-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
}
.percent-inner {
    margin-top: 56px;
}

.percent-inner h2 {
    color: #abd0cd;
    font-family: "Lora", serif;
    font-size: 40px;
    letter-spacing: -0.02em;
    font-weight: 600;
}

.percent-inner p {
    color: #7e7b7b;
    font-family: "Quicksand", sans-serif;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 400;
    max-width: 304px;
}

/* RIGHT SIDE IMAGE */
.cycle-image {
    position: absolute;
    top: -11px;
    right: 30px;
}

.cycle-image img {
    border-radius: 20px;
    height: 733px;
    transform: rotate(2deg);
    object-fit: cover;
}
div#tab4 .percentage-container.appco_bg p {
    width: 100%;
    max-width: 99%;
    color: #699a98;
text-align: left;
font-family: "Lora-SemiBold", sans-serif !important;
font-size: 40px;
letter-spacing: -0.02em;
font-weight: 600;
}

div#tab4 .percentage-container {
    display: block;
}
/* DISCLAIMER */
.aussagen-text-inner {
    padding-left: 43px;
    margin-top: 16px;
    max-width: 626px;
}

.aussagen-text-inner p {
    color: #404040;
    font-family: "Quicksand", sans-serif;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 400;
}



.aussagen-text-inner p a {
    color: #404040;
    font-family: "Quicksand", sans-serif;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 400;
}
.accordion {
    border-top: none !important;
}
@media (max-width: 1199px) {
    .energieniveau-inner {
        min-height: 535px;
    }

    .cycle-image img {
        height: 583px;
    }
    .container {
    padding: 0 16px !important;
}
}

@media (max-width: 991px) {
    .aussagen-text-inner {
        padding-left: 0;
    
    }
    .energieniveau-inner .row {
        flex-direction: column-reverse;
    }

.cycle-image {
    border-radius: 20px;
    position: static;
}
.energieniveau-inner .row .col-md-6 {
    width: 100%;
}
.cycle-tabs {
    justify-content: center;
  
}
    .cycle-image img {
        height: 273px;
        width: 100%;
    }

    .energieniveau-content {
        margin-top: 30px;
    }

    .energieniveau-inner {
        padding: 0;
        height: auto;
    } 
.percent-inner h2 {

    font-size: 24px;

}
.percent-inner p {
    font-size: 14px;

}

}
    </style>
