 <div  class="page-width{% if section.settings.narrow %} page-width--inner{% endif %}">
    <div id="painkiller" class="paintesting rich-text section--padding {{ section.settings.custom_class }}">
      <div class="heading ">
       <h2> {{ section.settings.Title }}</h2>
       <p class="description"> {{ section.settings.section_description }} </p>
      </div>


     
<div class="swiper-container_supl">
  <div class="swiper-wrapper">
    {%- for block in section.blocks -%}
      <div class="swiper-slide"> 
        <div class="inner_swiper">
        <div class="supplement_details_wrapper front">
          <img 
            data-class="LazyLoad" 
            src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
            data-src="{{ block.settings.image | img_url : 'master' }}">
          <h5 class="title"> {{ block.settings.heading }}</h5>
          <p class="dsc"> {{ block.settings.dsc }} </p>
           <div class="swiper-supl-button-next"> <span>  </span>
           <img 
            data-class="LazyLoad" 
            src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
            data-src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Flip.png?v=1722924073" /></div>   
        </div>
        <div class="supplement_details_wrapper back">
           <img 
            data-class="LazyLoad" 
            src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
            data-src="{{ block.settings.image | img_url : 'master' }}">
           <h5 class="title"> {{ block.settings.back_heading }}</h5>
           <p class="dsc"> {{ block.settings.back_dsc }} </p>
           <div class="swiper-supl-button-next"> 
            <img 
              data-class="LazyLoad" 
            src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
              data-src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/Flip_arrows.png?v=1722924104" /></div>
        </div>
        </div>
      </div>  
    {%- endfor -%}

  </div>
  <!-- Navigation buttons -->
  
  <div class="swiper-supl-button-prev"> </div>
</div>


    </div>
  </div>

{% schema %}
  {
    "name": "Suppliment Details",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      },
      {
        "type": "richtext",
        "id": "Title",
        "label": "Heading"
      },
       {
        "type": "inline_richtext",
        "id": "section_description",
        "label": "Description"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.header.content"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "t:sections.all.padding.padding_top.unit",
        "label": "t:sections.all.padding.padding_top.label",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "t:sections.all.padding.padding_bottom.unit",
        "label": "t:sections.all.padding.padding_bottom.label",
        "default": 36
      }
    ],
     "blocks": [
    {
      "type": "Slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "dsc",
          "label": "dsc"
        },
        {
          "type": "text",
          "id": "back_heading",
          "label": "Back Face Heading"
        },
        {
          "type": "richtext",
          "id": "back_dsc",
          "label": "Back face dsc"
        },
      ]
    }    
  ],
    "presets": [
      {
        "name": "Supplment Details"
      }
    ]
  }
{% endschema %}

<style>
  .swiper-container {
  width: 100%;
  height: 100%;
  overflow: hidden; 
  box-sizing: border-box;
}

.swiper-wrapper {
  display: flex;
}

.swiper-container_supl .swiper-slide {
  width: 81% !important; /* Adjust width to ensure only part of neighboring slides are visible */
  display: flex;
  justify-content: center;
  align-items: center;
}

.swiper-slide-prev, .swiper-slide-next {
  opacity: 0.6; /* Optional */
}

.swiper-button-next, .swiper-button-prev {
  color: #000; /* Adjust as needed */
}

  @media screen and (max-width:989px) {
    .swiper-container_supl .swiper-slide {
    width: 273px !important; 
  } 
  }

</style>


<script type="lazyload_js">
  
$(document).ready(function() {
  var swiper;

  function initSwiper() {
    if ($(window).width() < 4000) {
      if (!swiper) {  // Initialize Swiper if it does not exist
        swiper = new Swiper('.swiper-container_supl', {
          slidesPerView: 'auto', 
          spaceBetween: 16, // Adjust space between slides if needed
          navigation: {
            nextEl: '.swiper-supl-button-nexts',
            prevEl: '.swiper-supl-button-prev',
          },
          breakpoints: {
            768: {  // Example breakpoint for smaller screens
              slidesPerView: 'auto',
              spaceBetween: 16,
            }
          }
        });
      }
    } else {
      if (swiper) {  // Destroy Swiper if it exists and screen width is >= 990
        swiper.destroy(true, true);
        swiper = null;
      }
    }
  }
  initSwiper();
  $(window).resize(function() {
    initSwiper();
  });
});

$(document).ready(function() {
    $('div#painkiller .inner_swiper').on('click', function() {
        $(this).toggleClass('rotate');
    });
});

