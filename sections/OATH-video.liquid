        {%- else -%}
          <!-- Fall back to original static image if none chosen -->
          <img
            src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/animation-thumbnail.png?v=1741273167"
            alt="Thumbnail" />
        {%- endif -%}
      </a>

      <div class="expert-video-right cst-text-right">
        <h2>{{ section.settings.title }}</h2>
        <p>{{ section.settings.text }}</p>

        <a
          class="expert-video-btn open-video"
          href="javascript:;"
          id="expert-video-btn">
          <svgw
            width="25"
            height="24"
            viewBox="0 0 25 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <path d="M24.44 11.5545C24.2421 5.35986 19.2349 0.352691 13.0405 0.154868C9.66994 0.0479275 6.51656 1.33088 4.18608 3.73705C1.94565 6.05017 0.768494 9.09963 0.87146 12.3241C1.06912 18.5185 6.07639 23.5258 12.2707 23.7235C12.3997 23.7276 12.5275 23.7296 12.6556 23.7296C15.8761 23.7296 18.8839 22.4553 21.1252 20.1413C23.3656 17.8284 24.5429 14.7787 24.44 11.5545ZM19.3416 18.4139C17.5723 20.2407 15.1978 21.2467 12.6556 21.2467C12.554 21.2467 12.4523 21.245 12.3499 21.2419C7.46113 21.0857 3.50935 17.1339 3.35308 12.2449C3.2718 9.69857 4.20098 7.29058 5.96961 5.46465C7.73891 3.63788 10.1134 2.63188 12.6556 2.63188C12.7573 2.63188 12.8589 2.63354 12.9614 2.63668C17.8501 2.79279 21.8019 6.74462 21.9582 11.6336C22.0395 14.18 21.1101 16.588 19.3416 18.4139Z" fill="#252A31" />
            <path d="M16.5228 11.2542L11.2944 7.50529C10.7367 7.10534 9.9603 7.50397 9.9603 8.19031V15.6882C9.9603 16.3746 10.7367 16.7732 11.2944 16.3732L16.5227 12.6242C16.9918 12.288 16.9918 11.5906 16.5228 11.2542Z" fill="#252A31" />
          </svgw>
          {{ section.settings.button }}
        </a>
      </div>
    </div>
  </div>
</div>

<div class="expert-video-popup">
  <svg
    class="expert-video-popup-close"
    fill="#FFFFFF"
    width="100pt"
    height="100pt"
    version="1.1"
    viewBox="0 0 100 100"
    xmlns="http://www.w3.org/2000/svg">
    <path d="m70.508 29.492c-1.9531-1.9531-5.1172-1.9531-7.0703 0l-13.434 13.434-13.434-13.434c-1.9531-1.9531-5.1172-1.9531-7.0703 0-1.9531 1.9531-1.9531 5.1172 0 7.0703l13.434 13.434-13.434 13.434c-1.9531 1.9531-1.9531 5.1172 0 7.0703s5.1172 1.9531 7.0703 0l13.434-13.434 13.434 13.434c1.9531 1.9531 5.1172 1.9531 7.0703 0 1.9531-1.9531 1.9531-5.1172 0-7.0703l-13.434-13.434 13.434-13.434c1.9531-1.9531 1.9531-5.1172 0-7.0703z" />
  </svg>

  <div class="section--padding">
    <div class="page-width">
      <video controls class="expert-video-player">
        <!-- Here, we directly reference the theme editor's "Video URL" setting -->
        <source src="{{ section.settings.video_url }}">
      </video>
    </div>
  </div>
</div>

<script>
  const openButtons = document.querySelectorAll(".open-video");
  const videoPopupWrapper = document.querySelector(".expert-video-popup");
  const closeVideoPopup = document.querySelector(".expert-video-popup-close");
  const videoPlayer = document.querySelector(".expert-video-player");

  // Open video on button or thumbnail click
  openButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      videoPopupWrapper.classList.add("active-video");
      videoPlayer.play();
    });
  });

  // Close video on the 'X' icon
  closeVideoPopup.addEventListener("click", () => {
    videoPopupWrapper.classList.remove("active-video");
    videoPlayer.pause();
    videoPlayer.currentTime = 0;
  });

  // Close video when clicking anywhere outside the video player
  videoPopupWrapper.addEventListener("click", (e) => {
    // If the user did NOT click inside the video player, close the popup
    if (!videoPlayer.contains(e.target)) {
      videoPopupWrapper.classList.remove("active-video");
      videoPlayer.pause();
      videoPlayer.currentTime = 0;
    }
  });
</script>

{% schema %}
{
  "name": "oath-video",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The menstrual cycle explained..."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Discover how your cycle works and how to support your hormones naturally, with insights from Dr. Ashley Florestal, ND."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Play video"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video title",
      "default": "Monthlies in 60 seconds"
    },
    {
      "type": "text",
      "id": "video_text",
      "label": "Video text",
      "default": "Dr Ashley - Naturopathic Doctor"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "default": "https://cdn.shopify.com/videos/c/o/v/e3ca55b213d94ed8bbc316ec9ebef909.mp4"
    },
    {
      "type": "image_picker",
      "id": "thumbnail_image",
      "label": "Thumbnail image",
      "info": "Upload or select a thumbnail image from your library."
    }
  ],
  "presets": [
    {
      "name": "oath-video"
    }
  ]
}
{% endschema %}
