<script>
  document.addEventListener('DOMContentLoaded', function() {
    var addToCartForms = document.querySelectorAll('.add-to-cart-form');

    addToCartForms.forEach(function(form) {
      form.addEventListener('submit', function(event) {
        event.preventDefault();
        var variantId = form.querySelector('.variant-id').innerHTML;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(
            {
              items: [
                {
                  id: variantId,
                  quantity: 1
                }
              ]
            }
          )
        }).then(async function(response) {
          document.querySelector(".product-added").classList.add("active");

          setTimeout(() => {
            document.querySelector(".product-added").classList.remove("active");
          }, "5000");
        }).catch(async function(error) {
          console.error(error);
        });
      });
    });
  });
</script>

<script>
  const filterTags = document.querySelectorAll(".filter-tag");
  const filterSet = document.querySelector(".filter-set");

  const products = document.querySelectorAll(".collection-single-item");
  const sets = document.querySelectorAll(".collection-set-item");
  const productsWrapper = document.querySelector(".collection-single-items");

  let selectedTags = [];

  for (let i = 0; i < filterTags.length; i++) {
    const filterId = filterTags[i].innerHTML;

    filterTags[i].addEventListener("click", () => {
      if (selectedTags.includes(filterId)) {
        for (let j = 0; j < selectedTags.length; j++) {
          if (selectedTags[j] === filterId) {
            selectedTags.splice(j, 1);
          };
        };
      } else {
        selectedTags.push(filterId);
      };

      for (let j = 0; j < filterTags.length; j++) {
        if (selectedTags.includes(filterTags[j].innerHTML)) {
          filterTags[j].classList.add("active");
        } else {
          filterTags[j].classList.remove("active");
        };
      };

      for (let j = 0; j < products.length; j++) {
        const productTags = products[j].querySelectorAll(".collection-single-tag");

        let displayProduct = false;

        for (let k = 0; k < productTags.length; k++) {
          const productTagId = productTags[k].innerHTML;

          if (selectedTags.includes(productTagId)) {
            displayProduct = true;
          };
        };

        if (displayProduct) {
          products[j].style.display = "block";
        } else {
          products[j].style.display = "none";
        };
      };

      for (let j = 0; j < sets.length; j++) {
        const productTags = sets[j].querySelectorAll(".collection-set-tag");

        let displayProduct = false;

        for (let k = 0; k < productTags.length; k++) {
          const productTagId = productTags[k].innerHTML;

          if (selectedTags.includes(productTagId)) {
            displayProduct = true;
          };
        };

        if (displayProduct) {
          sets[j].style.display = "block";
        } else {
          sets[j].style.display = "none";
        };
      };

      if (selectedTags.length === 0) {
        for (let j = 0; j < products.length; j++) {
          products[j].style.display = "block";
        };

        for (let j = 0; j < sets.length; j++) {
          sets[j].style.display = "block";
        };
      };
    });
  };

  filterSet.addEventListener("click", () => {
    if (filterSet.classList.contains("active")) {
      filterSet.classList.remove("active");
      productsWrapper.style.display = "grid";
    } else {
      filterSet.classList.add("active");
      productsWrapper.style.display = "none";
    };
  });

  const params = new window.URLSearchParams(window.location.search);
  const urlTag = params.get('tag');

  if (urlTag) {
    const urlId = urlTag.replace("-", " ");
    selectedTags.push(urlId);

    for (let i = 0; i < filterTags.length; i++) {
      if (selectedTags.includes(filterTags[i].innerHTML)) {
        filterTags[i].classList.add("active");
      } else {
        filterTags[i].classList.remove("active");
      };
    }

    for (let j = 0; j < products.length; j++) {
      const productTags = products[j].querySelectorAll(".collection-single-tag");

      let displayProduct = false;

      for (let k = 0; k < productTags.length; k++) {
        const productTagId = productTags[k].innerHTML;

        if (selectedTags.includes(productTagId)) {
          displayProduct = true;
        };
      };

      if (displayProduct) {
        products[j].style.display = "block";
      } else {
        products[j].style.display = "none";
      };
    };

    for (let j = 0; j < sets.length; j++) {
      const productTags = sets[j].querySelectorAll(".collection-set-tag");

      let displayProduct = false;

      for (let k = 0; k < productTags.length; k++) {
        const productTagId = productTags[k].innerHTML;

        if (selectedTags.includes(productTagId)) {
          displayProduct = true;
        };
      };

      if (displayProduct) {
        sets[j].style.display = "block";
      } else {
        sets[j].style.display = "none";
      };
    };
  };
</script>

