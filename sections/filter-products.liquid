{{ 'section-filter-products.css' | asset_url | stylesheet_tag }}

{% assign singleProducts = collections["single-products"] %}
{% assign setProducts = collections["sets"] %}

<div class="filter-collection">
  <!--<div class="filter-banner">
    <img
      src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/banner.png?v=1686649625"
      alt="banner"
      class="filter-banner--image">

    <img
      src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/line.png?v=1686649769"
      alt="banner-line"
      class="filter-banner--line">
  </div>-->

  <div class="page-width">
    <h1>
      {{ section.settings.title }}
    </h1>

    <div class="filter-container">
      <div class="filter-wrapper">
        <h4 class="filter-wrapper-title">{{ section.settings.filters_title }}</h4>
        <p class="filter-wrapper-desc">{{ section.settings.filters_desc }}</p>

        <div class="filter-items">
          <span class="filter-item filter-tag">{{ section.settings.cramps }}</span>
          <span class="filter-item filter-tag">{{ section.settings.mood_swings }}</span>
          <span class="filter-item filter-tag">{{ section.settings.sleep }}</span>
          <span class="filter-item filter-tag">{{ section.settings.bloating }}</span>
          <span class="filter-item filter-tag">{{ section.settings.imbalance }}</span>
          <div class="split"></div>
          <span class="filter-item filter-set">{{ section.settings.sets }}</span>
        </div>
      </div>

      <div class="collection-right">
        <div class="collection-single-items">
          {% for product in singleProducts.products %}
            {% if product.variants.size == 1 %}
              {% assign tags = product.metafields.custom.pains | replace: '"', '' | replace: '[', '' | replace: ']', '' | split: ',' %}
              {% assign relief = product.metafields.custom.relief | replace: '"', '' | replace: '[', '' | replace: ']', '' %}

                <div class="collection-single-item">
                <!--<span class="collection-single-relief">{{ relief }}</span>-->

                <a class="collection-single-item-url" href="{{product.variants.first.url}}">
                  <div class="collection-single-img">
                    <img src="{{ product.featured_image | img_url: '1024x1024' }}" alt="{{ product.title }}">
                  </div>

                  <div class="collection-single-content">
                    <h5>{{ product.title }}</h5>
                    <div class="collection-single-reviews">
