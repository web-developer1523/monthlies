<style>
  .instafeeds .ingredients_content.tab_content { display: block !important; max-width: 1440px; margin: 0 auto; padding:0px 70px; }
  .instafeeds .ingredients_content.tab_content .card_wrapper { gap: 40px; max-width: 1440px; margin: 0 auto; }
  .instafeeds .ingredients_content.tab_content .accordions { max-width: unset; }
  .instafeeds h2.title.h1 { margin-bottom: 0; }
  .instafeeds h2.title.h1 strong { font-family: inherit; color: #CB342C; }
  .instafeeds h2.title.h1 p{ font-size: 36px; font-family: Lora, sans-serif !important; font-weight: 600; text-align: center; letter-spacing: 0;text-align:center; }
  .instafeeds h2.title.h1 , .instafeeds h2.title.h1 * { margin-top: 0; }
  .instafeeds .ingredients_content .accordion_head { background-size: 20px;cursor: pointer; }
  .instafeeds .ingredients_content .accordion_head { font-size: 18px; font-weight: 700; line-height: 1.15; padding: 12px 25px;background-position:98% center; }
  .shopify-section.instafeeds { background: #ecf1f4; }
  .instafeeds .accordion_content p { margin-bottom: 10px !important; }
.instafeeds .ingredients_content .accordion { border-radius: 15px; border: 1px solid #cccccc6e; box-shadow: none; }
  .instafeeds .ingredients_content.tab_content .card_wrapper > div { flex: 1; }
  .instafeeds .ingredients_content.tab_content .card_wrapper > div { flex: 1; }
 .instafeeds .ingredients_content.tab_content .accordions { background: #fff; position: relative; padding-top: 80px; padding-bottom: 20px;height:100%; }
  .instafeeds .ingredients_content.tab_content .accordions::before { content: ""; width: 60vw; height: 100%; position: absolute; right: -40px; background: #fff; z-index: 0;top:0; }
  .instafeeds .ingredients_content.tab_content .accordions > * { position: relative; }
  .insta_col { padding: 55px 60px; border-radius: 100px 0 0 0; }
  .left_col { padding-top: 90px; } .faq_insta { background: #a6d0cd; }
  .insta_col{position:relative;}
  .insta_col::before { content: ""; width: 60vw; height: 100%; position: absolute; left: 0; background: #ecf1f4; z-index: 0; top:0; border-radius:100px 0 0 0; }
  .insta_col > * { position: relative; }
  .insta_col p { text-align: center; font-size: 26px; margin: 0; }
  .insta_col h2.title.h1, .insta_col h2.title.h1 * {margin-bottom:10px;}
  .faq_insta .ingredients_content .accordion_content , .custom_faq .ingredients_content .accordion_content { padding-bottom: 2px !important; }
  .faq_insta .ingredients_content .accordion_content p ,.custom_faq .ingredients_content .accordion_content p {line-height:1.4;}
@media screen and (max-width:1250px) and (min-width:767px) {
  .instafeeds h2.title.h1 p { font-size:clamp(1rem, 3.056vw, 44px); }
  .home_insta .ingredients_content.tab_content .card_wrapper .insta_col { padding:40px; }
  .instafeeds .ingredients_content.tab_content { padding: 15px; } 
  .insta_col::before { content: ""; width: 65vw; }
  .instafeeds .ingredients_content.tab_content { padding: 15px; }
  .insta_col::before { content: ""; width: 65vw; }
  .insta_col .feed_wrapper > img:first-of-type { max-width: 70%; }
  .insta_col .feed_wrapper .social_wrapper .social_field p { font-size: 12px; }
  .insta_col .feed_wrapper .social_wrapper { right: -30px; }
  img.insta_component_img { max-width: 100px; right: 70px; }
  .instafeeds .ingredients_content.tab_content .card_wrapper > div { justify-content:center;}
  .control_sec { padding: 20px 20px 40px 20px; }
  .control_sec a.shop_btn { width: 80%; padding: 10px 20px; line-height: normal; height: auto; font-size: 16px; }
}
  @media screen and {max-width:450px} {
    body img.insta_component_img {bottom:-20px;}
  }
</style>  
<!-- Ingredients start  -->
     <div class="faq_insta">
      <div class="ingredients_content tab_content"> 
          <div class="card_wrapper">
            <div class="left_col">
              <div class="control_sec">
                <h2 class="title h1"> {{ section.settings.left_sub_heading }} </h2> 
                <p> {{ section.settings.left_description }} </p>
                 {%- if section.settings.button_link != blank -%}
                    <a href="{{ section.settings.button_link }}" class="shop_btn">  {{ section.settings.button_label | escape }}  <img class="btn_icon" src="{{ section.settings.btn_arrow | img_url: 'master' }}"></a>
                  {%- endif -%}
              </div>
            </div>
             <div class="insta_col"> 
               <h2 class="title h1"> {{ section.settings.sub_heading }} </h2> 
               <p class=""> #bywomenforwomen </p>
               <div class="feed_wrapper">
                 <img class=""
                  data-class="LazyLoad"
                  src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
                   data-src="{{ section.settings.insta_feed | img_url: '700x' }}"
                  data-mob-src="{{ section.settings.insta_feed | img_url: '400x' }}">
                {%- if section.settings.insta_component_img  %}
                 <img class="insta_component_img" src="{{ section.settings.insta_component_img | img_url: 'master' }}">
                 {%- endif -%}
                   <div class="social_wrapper"> 
                      {%- for block in section.blocks -%}
                        <div class="social_field">  
                          <img class="social_icon"
                            data-class="LazyLoad" 
                             src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
                             data-src="{{ block.settings.social_image | img_url: 'master' }}"> 
                          <p><a href="{{ block.settings.soical_url }}" target="_blank"> {{ block.settings.soical_text }} </a> </p>
                        </div>
                      {% endfor %}
                 </div>
               </div>
             </div>
           </div>
      </div>
    </div>
<!-- Ingredients end  -->

{% schema %}
  {
    "name": "Home Insta",
    "class":"instafeeds home_insta",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading"
      },
       {
        "type": "richtext",
        "id": "sub_heading",
        "label": "Insta Heading"
      },
      {
        "type": "richtext",
        "id": "left_sub_heading",
        "label": "Left Heading"
      },
      {
        "type": "inline_richtext",
        "id": "left_description",
        "label": "Left Description"
      },
       {
        "type": "image_picker",
        "id": "insta_feed",
        "label": "Insta Image"
      },
      {
        "type": "image_picker",
        "id": "insta_component_img",
        "label": "Insta Component Image"
      },
      {
        "type": "image_picker",
        "id": "btn_arrow",
        "label": "Button icon"
      },
       {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.all.button_label.label",
          "info": "t:sections.all.button_label.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button_link.label"
        },
       {
        "type": "inline_richtext",
        "id": "description",
        "label": "Description"
      }
    ],
     "blocks": [
    {
      "type": "Socialicons",
      "name": "Social Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "social_image",
          "label": "Social Image"
        }, 
        {
          "type": "text",
          "id": "soical_text",
          "label": "Social Text"
        },
         {
          "type": "url",
          "id": "soical_url",
          "label": "Social Link"
        }
      ]
    }
     ],
        "presets": [
      {
        "name": "Home Insta"
      }
    ]
  }
{% endschema %}

