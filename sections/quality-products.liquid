{{ 'section-content-item.css' | asset_url | stylesheet_tag }}

<section class="page-width">
    <div class="content-item">
        <div class="content-side">
            <div class="content-side-title">
                <h4>{{ section.settings.title }}</h4>
            </div>
    
            <div class="content-side-text-wrapper">
                <p class="content-side-text">{{ section.settings.text1 }}</p>
                <p class="content-size-text">{{ section.settings.text2 }}</p>
            </div>
    
            <div class="content-buttons-wrapper">
                <div class="content-buttons">
                    <a
                    href="{{ section.settings.url_1 }}"
                    id="cta-hero"
                    class="button button--black">
                    {{ section.settings.label_1 }}
                    <svg
                      width="7"
                      height="12"
                      viewBox="0 0 7 12"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523"
                        stroke="white"
                        stroke-width="1.5" />
                    </svg>
                  </a>
                </div>
            </div>
        </div>
    
        <img class="visual-side" src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/quality-products.png?v=1688545447" alt="Quality products">
    </div>
</section>

{% schema %}
    {
      "name": "quality-products",
      "tag": "section",
      "class": "section",
      "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Quality products"
        },
        {
            "type": "text",
            "id": "text1",
            "label": "Text 1",
            "default": "Our premium formulas are expertly designed to tackle your symptoms with high-quality natural, gluten-free, lactose-free, and organic ingredients."
        },
        {
            "type": "text",
            "id": "text2",
            "label": "Text 2",
            "default": "Handpicked by experts for effective relief and hormonal balance, our formulas ensure a harmonious, side-effect-free experience."
        },
        {
            "type": "url",
            "id": "url_1",
            "label": "URL 1"
        },
        {
            "type": "text",
            "id": "label_1",
            "label": "Label 1",
            "default": "Take the quiz"
        }
      ],
      "presets": [
        {
          "name": "quality-products"
        }
      ]
    }
  {% endschema %}