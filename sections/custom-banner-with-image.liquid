{%- if section.settings.image != blank -%}
  {{ 'section-custom-banner-with-image.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign background_image = section.settings.image
    assign background_image_mobile = section.settings.image_mobile
    assign reviews_image = section.settings.reviews_image
    assign title = section.settings.title
    assign text_color = section.settings.text_color | default: '#404040'
    assign button_label = section.settings.button_label
    assign button_link = section.settings.button_link | default: '#'
    assign button_background = section.settings.button_background | default: '#CB342C'
    assign button_color = section.settings.button_color | default: '#ffffff'
    assign button_radius = section.settings.button_radius | default: 50
  -%}

  {% render 'section-paddings',
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom,
    padding_top_mobile: section.settings.padding_top_mobile,
    padding_bottom_mobile: section.settings.padding_bottom_mobile
  %}

  <section
    class="custom-hero-banner custom-hero-banner--{{ section.id }} section-{{ section.id }}--padding"
    style="
      --text-color: {{ text_color }};
      --button-background: {{ button_background }};
      --button-color: {{ button_color }};
      --button-radius: {{ button_radius }}px;
    "
  >
    {%- if background_image != blank -%}
      <picture class="custom-hero-banner__media">
        {%- if background_image_mobile != blank -%}
          <source
            media="(max-width: 550px)"
            srcset="
              {{ background_image_mobile | image_url: width: 400 }} 400w,
              {{ background_image_mobile | image_url: width: 800 }} 800w
            "
          >
        {%- endif -%}

        {{ background_image | image_url: width: 2000 | image_tag:
          class: 'custom-hero-banner__img',
          loading: 'lazy',
          widths: '750, 1500, 2250, 3000',
          sizes: '100vw'
        }}
      </picture>
    {%- endif -%}

    <div class="custom-hero-banner__container page-width">
      <div class="custom-hero-banner__content">

        {%- if reviews_image != blank -%}
          <div class="custom-hero-banner__reviews">
            {{ reviews_image | image_url: width: nil | image_tag: class: 'custom-hero-banner__reviews-img', loading: 'lazy' }}
          </div>
        {%- endif -%}

        <h2 class="custom-hero-banner__title">{{ title }}</h2>

        {%- if button_label != blank -%}
          <a href="{{ button_link }}" class="custom-hero-banner__button">
            {{ button_label }}
          </a>
        {%- endif -%}

      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (Mobile)"
    },
    {
      "type": "image_picker",
      "id": "reviews_image",
      "label": "Reviews image"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Spüre weniger Schmerzen..."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "monthlies kaufen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Button radius",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#CB342C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#404040"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Paddings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}