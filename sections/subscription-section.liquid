
 <div class="how_work page-width{% if section.settings.narrow %} page-width--inner{% endif %}">
    <div id="offers" class="rich-text section--padding {{ section.settings.custom_class }}">
        <div class="heading ">
         <h2> {{ section.settings.Title }}</h2>
        <span>{{ section.settings.dsc }}</span>
   </div>
<div class="swiper-container">
   <div class="subscription_btns">
    <div class="subscription_btn active">
      <div class="en">{{section.settings.tab_heading1}}</div>
      <div class="german">{{section.settings.tab_heading1_ge}}</div>
    </div>
    <div class="subscription_btn">
      <div class="en">{{section.settings.tab_heading2}}</div>
      <div class="german">{{section.settings.tab_heading2_ge}}</div> 
    </div>
    {% if section.settings.tab_heading3 != blank %}
      <div class="subscription_btn">
      <div class="en">{{section.settings.tab_heading3}}</div>
      <div class="german">{{section.settings.tab_heading3_ge}}</div> 
    </div>  
  {% endif %}
  </div>
  
  
  <div class="swiper-wrapper">
    {%- for block in section.blocks -%}
      <div class="swiper-slide">
         <div class="subscription-tab_wrapper {{ block.settings.custom_class }} {% if forloop.index == 1 %}active{% endif %}">
                 <p class="tabs_heading"> {{ block.settings.title }} </p> 
                  <div class="image_wrapper"> 
                     <div class="overflow_none"> 
                      <img 
                      data-class="LazyLoad" 
                      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
                      data-src="{{ block.settings.image | img_url: '1600x' }}" alt="{{ block.settings.heading }}" > 
                    </div> 
                    {% if block.settings.mob_image %}
                    <img class="mobile_img"
                      data-class="LazyLoad"
                      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" 
                       data-src="{{ block.settings.mob_image | img_url: '500x' }}" alt="{{ block.settings.heading }}" > 
                    {% endif %}

                    {% if forloop.first %}
                      <span class="save GBP">  {{ block.settings.save }}  </span> 
                      <span class="save euro">  {{ block.settings.save }}  </span> 
                      {% endif %}

                    {% if forloop.last %}
                      <span class="save GBP">  {{ block.settings.save }}  </span> 
                      <span class="save euro">  {{ block.settings.save }}  </span> 
                      {% endif %}
                   
                  </div>
                    <div class="content_part">
                   <span class="title">{{ block.settings.heading }}</span>
                  <div class="price_col">  
                   <div> 
                      {% if block.settings.offprice != blank %}   
                          <span class="price GBP">{{block.settings.price}}</span>
                          <span class="price euro">{{block.settings.price_ge}}</span>
                      {% else %}
                         <span class="price GBP">{{block.settings.price}}</span>
                         <span class="price euro">{{block.settings.price_ge}}</span>
                     {% endif %}
                     <div class="off_save">
                        {% if block.settings.offprice != blank %}                   
                          <span class="offprice GBP">{{ block.settings.offprice }}</span>
                          <span class="offprice euro">{{ block.settings.offprice_ge }}</span>
                        {% endif %}
                     </div>
                   </div>
                    <div class="time_period"> {{ block.settings.time_period }} </div>
                  </div> 
                  <span class="dsc">{{ block.settings.dsc }}</span>
                  <span class="list">{{ block.settings.list }}</span>
                  {% if block.settings.list1 != blank %}
                  <span class="list1">{{ block.settings.list1 }}</span>
                  {% endif %}
                   <div class="btns_wrapper"> 
                     <a href="{{ block.settings.button_link }}" id="cta-buynowben" class="button button--black">
                       {{ block.settings.button_label | escape }} 
                    </a>
                      <a href="{{ block.settings.learn_more }}" id="read_more" class="button read_more button--black">
                      {% if block.settings.learn_more_text != blank %} {{ block.settings.learn_more_text }} {% else %}Learn More {% endif %}
                    </a>
                   </div>
                   <div class="pay_managment">
                       <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                   {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
             </ul>
            <p> {{ block.settings.shipping_text }} </p>
           </div>
          </div>
        </div>
      </div>
      
    {%- endfor -%}
  </div>
  <!-- Navigation buttons -->
 
</div>


    </div>
  </div>
  <style>
html[lang="en"] .price_col .GBP {
display: block !important;
}

html[lang="en"] .price_col .euro {
display: none !important;
}

html[lang="en"] .off_save .GBP {
display: block !important;
}
html[lang="en"] .off_save .euro {
display: none !important;
}

html[lang="de"] .price_col .GBP {
display: none !important;
}

html[lang="de"] .price_col .euro {
display: block !important;
}

html[lang="de"] .off_save .GBP {
display: none !important;
}
html[lang="de"] .off_save .euro {
display: block !important;
}


.subscription_btns {
  justify-content: center;
  gap: 10px;
  margin-bottom: 20px;
  padding:0 5px;
  align-items: center;
}
.subscription_btn.active>div {
  color: #fff;
}
.subscription_btns>div {
  padding: 5px;
  text-align: center;
  font-size: 14px;
  height: 90px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: normal !important;
}
.subscription_btn {
cursor: pointer;
transition: all 0.3s;
}

.subscription_btn.active {
background: #cb342c;
color: #fff;
}
    
    .how_work .swiper-slide {
   width: 50% !important; /* Adjust width to ensure only part of neighboring slides are visible */
   display: flex;
   justify-content: center;
   align-items: center;
 }
   .swiper-container {
   width: 100%;
   height: 100%;
   overflow: hidden; 
   box-sizing: border-box;
 }
 
 .swiper-wrapper {
   display: flex;
 }
 
 .swiper-slide-prev, .swiper-slide-next {
   opacity: 1; /* Optional */
 }
 
 .swiper-button-next, .swiper-button-prev {
   color: #000; /* Adjust as needed */
 }
 .how_work #offers .subscription-tab_wrapper {
  width: 100%;
}
 @media screen and (max-width:1024px) {
  div#offers .swiper-container .swiper-wrapper {
    justify-content: start;
}

}
@media screen and (max-width:767px) {
  body .how_work div#offers .swiper-slide {
    width: 100% !important;
  }
}

 @media screen and (max-width:575px) {
  .subscription_btns {
    display:flex;
  }
   .how_work .subscription-tabs .swiper-wrapper {
     justify-content: flex-start;
   }
   .how_work .swiper-slide {
   width: 100% !important; /* Adjust width to ensure only part of neighboring slides are visible */
   display: flex;
   justify-content: center;
   align-items: center;
 }
 }
 
 </style>
 
 <script type="lazyload_js">
  $(document).ready(function() {
    var swiper = new Swiper('.swiper-container', {
      slidesPerView: 1,
      spaceBetween: 16,
      loop: false,
      allowTouchMove: true,
      on: {
        slideChange: function() {
          // Update active button on slide change
          var activeIndex = this.activeIndex;
          $('.subscription_btns .subscription_btn')
            .removeClass('active')
            .eq(activeIndex)
            .addClass('active');
        }
      },
      breakpoints: {
        1200: { slidesPerView: 3, spaceBetween: 16 },
        768: { slidesPerView: 2, spaceBetween: 16 },
        575: { slidesPerView: 1, spaceBetween: 16 }
      }
      
    });
    function checkScreenWidth() {
       if ($(window).width() < 991) { 
        initializeSwiper(); 
      } 
    } 
    // Check on page load 
    checkScreenWidth(); 
    // Check on window resize 
    $(window).resize(function() { 
      checkScreenWidth(); 
    });
    {% comment %} $(document).ready(function() {
       $('body .subscription-tabs .swiper-slide:nth-of-type(1)').addClass('active'); }); 
       $(document).ready(function() { 
        $('body .subscription-tabs .swiper-slide').on('click' , function() { 
          $(this).addClass('active'); $(this).siblings().removeClass('active'); 
        }); 
    }); {% endcomment %}
    {% comment %} // $(document).ready(function() { 
      // $('body .subscription_btns div[class*="swiper-subscription-button"]').on('click' , function() { 
        // $(this).addClass('active'); 
        // $(this).siblings().removeClass('active'); 
        // }); 
  // }); {% endcomment %}
    // Button click changes slide
    $('.subscription_btns .subscription_btn').on('click', function() {
      var index = $(this).index();
      swiper.slideTo(index);
      $(this).addClass('active').siblings().removeClass('active');
    });
  });
  </script>
  
