{% schema %}
  {
    "name": "Prodcut Custom Accordions",
    "class":"custom_faq",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading"
      },
         {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }
    ],
      "blocks": [
    {
      "type": "right",
      "name": "right",
      "settings": [
         {
          "type": "text",
          "id": "acc_id",
          "label": "Add Id"
        }, 
        {
          "type": "text",
          "id": "accordion_heading",
          "label": "Accordion Heading"
        }, 
        {
          "type": "richtext",
          "id": "dsc",
          "label": "Accordion Description"
        }
      ]
    },
        {
      "type": "left",
      "name": "left",
      "settings": [
        {
          "type": "text",
          "id": "acc_id1",
          "label": "Add Id"
        }, 
        {
          "type": "text",
          "id": "accordion_heading1",
          "label": "Accordion Heading"
        }, 
        {
          "type": "richtext",
          "id": "dsc1",
          "label": "Accordion Description"
        }
      ]
    }
     ],
        "presets": [
      {
        "name": "Product Custom Accordion"
      }
    ]
  }
{% endschema %}

