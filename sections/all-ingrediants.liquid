<section class="cst-custom-all_ingrediants page-width">
  <div class="ingredient-tabs">
    <ul class="tabs-nav">
      {% assign tab_keys = 'all,vitamin,mineral,nutrient,amino_acid,plant_extract,other_ingredient' | split: ',' %}
      {% assign tab_labels = section.settings.all
        | append: ',' 
        | append: section.settings.tab1
        | append: ',' 
        | append: section.settings.tab2
        | append: ',' 
        | append: section.settings.tab3
        | append: ',' 
        | append: section.settings.tab4
        | append: ',' 
        | append: section.settings.tab5
        | append: ',' 
        | append: section.settings.tab6
        | split: ','
      %}

      {% for tab in tab_keys %}
        <li class="tab-link {% if forloop.first %}active{% endif %}" data-tab="{{ tab }}">
          {{ tab_labels[forloop.index0] }}
        </li>
      {% endfor %}
    </ul>

    <div class="tabs-content">
{% for tab in tab_keys %}
  <div class="tab-content {% if forloop.first %}active{% endif %}" id="{{ tab }}">
    <h1>{{ tab_labels[forloop.index0] }}</h1>
    <div class="ingredient-grid">
      {% for block in section.blocks %}
        {% if tab == 'all' or block.type == tab %}
          <div class="ingredient-card">
            {% if block.settings.image %}
              <div class="ingredient-image">
                <a href="{{ block.settings.button_link }}">
                  <img src="{{ block.settings.image | image_url }}">
                </a>
              </div>
            {% endif %}
            <div class="ingredient-info">
              <a href="{{ block.settings.button_link }}">
                <h3>{{ block.settings.title }}</h3>
              </a>
              <p>{{ block.settings.description }}</p>
              <div class="plus-icon">
                <a class="btn" href="{{ block.settings.button_link }}">
                  Read more
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="btn-container">
      <a class="btn de-german" target="_blank" href="{{ settings.btn_link_de }}">
        {{ settings.btn }}
      </a>
      <a class="btn en-uk" target="_blank" href="{{ settings.btn_link_en }}">
        {{ settings.btn }}
      </a>
    </div>
  </div>
{% endfor %}

    </div>
  </div>
</section>

