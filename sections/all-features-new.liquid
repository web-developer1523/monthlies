        "label": "Feature 1"
      },
      {
        "type": "inline_richtext",
        "id": "feature_2",
        "label": "Feature 2"
      },
      {
        "type": "inline_richtext",
        "id": "feature_3",
        "label": "Feature 3"
      },
      {
        "type": "inline_richtext",
        "id": "feature_4",
        "label": "Feature 4"
      },
      {
        "type": "inline_richtext",
        "id": "feature_5",
        "label": "Feature 5"
      },
      {
        "type": "inline_richtext",
        "id": "feature_6",
        "label": "Feature 6"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
