<section class="cst-disc-main">
    <div class="discover-container">
        
        <!-- Left Image -->
        <div class="discover-image">

            {% if section.settings.main_image != blank %}
                <img src="{{ section.settings.main_image | img_url: 'master' }}" alt="Discover App" class="main-img desktop-image">
            {% endif %}
            {% if section.settings.mobile_main_image != blank %}
                <img src="{{ section.settings.mobile_main_image | img_url: 'master' }}" alt="Discover App" class="main-img mobile-image">
            {% endif %}
            
            {% if section.settings.floating_card_1 != blank %}
                <img src="{{ section.settings.floating_card_1 | img_url: 'master' }}" alt="Floating card" class="floating-card-1">
            {% endif %}

            {% if section.settings.floating_card_2 != blank %}
                <img src="{{ section.settings.floating_card_2 | img_url: 'master' }}" alt="Floating card" class="floating-card-2">
            {% endif %}
        </div>

        <!-- Right Content -->
        <div class="discover-content">

            {% if section.settings.heading != blank %}
                <h2>{{ section.settings.heading }}</h2>
            {% endif %}

            <ul class="features-list">
                {% if section.settings.feature_1 != blank %}<li>{{ section.settings.feature_1 }}</li>{% endif %}
                {% if section.settings.feature_2 != blank %}<li>{{ section.settings.feature_2 }}</li>{% endif %}
                {% if section.settings.feature_3 != blank %}<li>{{ section.settings.feature_3 }}</li>{% endif %}
                {% if section.settings.feature_4 != blank %}<li>{{ section.settings.feature_4 }}</li>{% endif %}
                {% if section.settings.feature_5 != blank %}<li>{{ section.settings.feature_5 }}</li>{% endif %}
                {% if section.settings.feature_6 != blank %}<li>{{ section.settings.feature_6 }}</li>{% endif %}
            </ul>

            {% if section.settings.button_text != blank %}
                <a href="{{ section.settings.button_link }}" class="discover-btn">
                    {{ section.settings.button_text }}
                </a>
            {% endif %}

            {% if section.settings.appstore_btn != blank %}
                <div class="dwnload-app-block">
                <img src="{{ section.settings.appstore_btn | img_url: 'master' }}" alt="App Store" class="appstore-btn" />
                </div>
            {% endif %}

        </div>

    </div>
</section>


<style>
    .cst-disc-main .mobile-image {
    display: none !important;
}
.cst-disc-main {
    background: #f3f6fa;
    padding: 24px 20px !important;
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    border-radius: 20px;
        width: 97%;
}

    
    .cst-disc-main .discover-container {
        display: flex;
        align-items: center;
        gap: 50px;
        position:relative;  
    }
    .cst-disc-main .dwnload-app-block img {
    position: absolute;
    top: 0;
    right: 0;
}
    /* LEFT IMAGE */
    .cst-disc-main .discover-image {
        position: relative;
        width: 50%;
    }
    
    .cst-disc-main .discover-image .main-img {
        width: 100%;
        border-radius: 20px;
        display:block;
    }
    
    /* Floating images */
    .cst-disc-main .floating-card-1 {
        position: absolute;
        top: 20px;
        right: -20px;
        width: 160px;
    }
    
    .cst-disc-main .floating-card-2 {
        position: absolute;
        bottom: 30px;
        left: 20px;
        width: 160px;
    }
    
    /* RIGHT CONTENT */
    .cst-disc-main .discover-content {
        width: 50%;
    }
    
    .cst-disc-main .discover-content h2 {
    font-size: 40px;
    font-weight: 600;
    color: #404040;
    margin-bottom: 25px;
    max-width: 524px;
    }
    
    .cst-disc-main .features-list {
        list-style: none;
        padding: 0;
        margin: 0 0 25px;
    }
    
    .cst-disc-main .features-list li {
        font-size: 16px;
        color: #404040;
        margin-bottom: 12px;
        padding-left: 22px;
        position: relative;
            font-weight: 400;
    } 
    
    .cst-disc-main .features-list li::before {
    content: "";
    width: 12px;
    height: 12px;
  background: url("https://cdn.shopify.com/s/files/1/0708/7462/8371/files/tickicon_4e5c8496-0350-4eed-bab0-42dda1e90056.png?v=1765878775") no-repeat center;
  background-size: contain;
  position: absolute;
  left: 0;
  top: 6px;
    }
    
    /* BUTTON */
 .cst-disc-main .discover-btn {
    display: inline-block;
    background: #d64141;
    padding: 12px 26px;
    border-radius: 25px;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 20px;
    box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
}
    
    .cst-disc-main .appstore-btn {
        max-width: 100%;
    }
    
    @media(max-width: 1250px) {
       .cst-disc-main .dwnload-app-block img {
        max-width: 154px;
        top: -7px;
    }
        .cst-disc-main .discover-content h2 {
            margin-top: 36px;
            font-size:34px;
        }
        .cst-disc-main .discover-container {
    gap: 20px;
}
    }
    /* ------------------------------
       RESPONSIVE (Mobile)
    --------------------------------- */
    @media(max-width: 991px) {
.cst-disc-main .discover-image .main-img , .cst-disc-main .discover-image{
        height: 100%;
        object-fit:cover;
    }
    }
    @media(max-width: 789px) {
         .cst-disc-main .desktop-image {
    display: none !important;
}
    .cst-disc-main .mobile-image {
    display: block !important;
}
.cst-disc-main .dwnload-app-block img{
    display: none ;
}
        .cst-disc-main .discover-container {
            flex-direction: column-reverse;
            text-align: left;
            width: 95%;
            gap: 30px;
        }
    
        .cst-disc-main .discover-image,
        .cst-disc-main .discover-content {
            width: 100%;
        }
    
        .cst-disc-main .discover-content h2 {
            font-size: 24px;
            line-height: 1.3;
            margin-top:10px;
        }
    
        .cst-disc-main .features-list li {
            font-size: 13px;
            margin-bottom: 10px;
        }
        .cst-disc-main .features-list li strong{
            font-weight: 700;
        }
        .cst-disc-main .discover-btn {
            width: 100%;
            text-align: center;
            padding: 14px 0;
            font-size: 16px;
        }
    
        .cst-disc-main .appstore-btn {
            width: 150px;
            margin-top: 10px;
        }
    
        .cst-disc-main .floating-card-1,
        .cst-disc-main .floating-card-2 {
            width: 130px;
        }
    
        .cst-disc-main .floating-card-1 {
            right: -10px;
            top: -10px;
        }
    
        .cst-disc-main .floating-card-2 {
            bottom: 10px;
            left: 10px;
        }
    }

</style>
