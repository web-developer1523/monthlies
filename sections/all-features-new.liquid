        "label": "Floating Card Image 1"
      },
      {
        "type": "image_picker",
        "id": "floating_card_2",
        "label": "Floating Card Image 2"
      },
      {
        "type": "inline_richtext",
        "id": "heading",
        "label": "Heading",
        "default": "Discover all the features of our app."
      },
      {
        "type": "inline_richtext",
