{{ 'section-personalised-solution.css' | asset_url | stylesheet_tag }}


<div class="your-solution-section">
  <div class="page-width">
    <div class="solution-container">
      <div class="solution-left">
        <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/girl-holding-box.png?v=1686226501" alt="Step">
        <span class="caption">{{ section.settings.caption }}</span>
        <a
          href="{{ section.settings.url }}"
          id="cta-included"
          class="button button--white">
          {{ section.settings.label }}
          <svg
            width="7"
            height="12"
            viewBox="0 0 7 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <path
              d="M0.679688 1.15234L5.67969 6.15234L0.679688 11.1523"
              stroke="white"
              stroke-width="1.5" />
          </svg>
        </a>
      </div>

      <div class="solution-right">
        <div class="solution-title-container">
          <img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/icon.png?v=1681241572" alt="icon" />
          <h2 class="h1 text-white">{{ section.settings.title }}</h2>
        </div>
        <p class="text-white leading-text">{{ section.settings.description }}</p>

        <a class="text-white bottom-leading-text" href="{% if localization.language.iso_code != "en" %}/{{ localization.language.iso_code }}{% endif %}/pages/cycle-assessment">
          <strong>{{ section.settings.discount }}</strong>
        </a>

        <div class="steps-list">
          <a href="{% if localization.language.iso_code != "en" %}/{{ localization.language.iso_code }}{% endif %}/pages/offer" class="steps-item">
            <div class="steps-item-content">
              <div class="step-header">
                <div class="step-bullet">
                  <span>1</span>
                </div>
                <p class="step-title">{{ section.settings.title_1 }}</p>
              </div>

              <p class="step-desc">
                {{ section.settings.description_1 }}
              </p>
            </div>

            <svg
              width="11"
              height="19"
              viewBox="0 0 11 19"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M1 1L9.60938 9.60938L1 18.2188"
                stroke="white"
                stroke-opacity="0.3"
                stroke-width="1.72187" />
            </svg>
          </a>

          <a href="{% if localization.language.iso_code != "en" %}/{{ localization.language.iso_code }}{% endif %}/pages/offer" class="steps-item">
            <div class="steps-item-content">
              <div class="step-header">
                <div class="step-bullet">
                  <span>2</span>
                </div>
                <p class="step-title">{{ section.settings.title_2 }}</p>
                <div class="free-tag">
                  FREE
                </div>
              </div>

              <p class="step-desc">
                {{ section.settings.description_2 }}
              </p>
            </div>

            <svg
              width="11"
              height="19"
              viewBox="0 0 11 19"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M1 1L9.60938 9.60938L1 18.2188"
                stroke="white"
                stroke-opacity="0.3"
                stroke-width="1.72187" />
            </svg>
          </a>

          <a href="{% if localization.language.iso_code != "en" %}/{{ localization.language.iso_code }}{% endif %}/pages/offer" class="steps-item">
            <div class="steps-item-content">
              <div class="step-header">
                <div class="step-bullet">
                  <span>3</span>
                </div>
                <p class="step-title">{{ section.settings.title_3 }}</p>
                <div class="free-tag">
                  FREE
                </div>
              </div>

              <p class="step-desc">
                {{ section.settings.description_3 }}
              </p>
            </div>

            <svg
              width="11"
              height="19"
              viewBox="0 0 11 19"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M1 1L9.60938 9.60938L1 18.2188"
                stroke="white"
                stroke-opacity="0.3"
                stroke-width="1.72187" />
            </svg>
          </a>

          <a href="{% if localization.language.iso_code != "en" %}/{{ localization.language.iso_code }}{% endif %}/pages/offer" class="steps-item">
            <div class="steps-item-content">
              <div class="step-header">
                <div class="step-bullet">
                  <span>4</span>
                </div>
                <p class="step-title">{{ section.settings.title_4 }}</p>
                <div class="free-tag">
                  FREE
                </div>
              </div>

              <p class="step-desc">
                {{ section.settings.description_4 }}
              </p>
            </div>

            <svg
              width="11"
              height="19"
              viewBox="0 0 11 19"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M1 1L9.60938 9.60938L1 18.2188"
                stroke="white"
                stroke-opacity="0.3"
                stroke-width="1.72187" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "personalised-solution",
    "class": "section",
    "tag": "section",
    "settings": [
      {
        "type": "text",
        "label": "Title",
        "id": "title",
        "default": "Your personalised solution"
      },
      {
        "type": "text",
        "label": "Description",
        "id": "description",
        "default": "Your Monthlies Box will provide you a set of hand-picked products, expert guidance tailored to your needs, some handy tips and tricks to improve your daily habits, and an expert consultation."
      },
      {
        "type": "text",
        "label": "Discount",
        "id": "discount",
        "default": "Buy now and get a 25% discount off your first order."
      },
      {
        "type": "text",
        "label": "Item 1 - Title",
        "id": "title_1",
        "default": "Quality products"
      }, {
        "type": "text",
        "label": "Item 1 - Description",
        "id": "description_1",
        "default": "A recommended set of products curated by our experts for your unique needs."
      }, {
        "type": "text",
        "label": "Item 2 - Title",
        "id": "title_2",
        "default": "Your cycle guide"
      }, {
        "type": "text",
        "label": "Item 2 - Description",
        "id": "description_2",
        "default": "Tailored insights to deepen your understanding of your cycle and symptoms, along with guidance to help improve your menstrual experience."
      }, {
        "type": "text",
        "label": "Item 3 - Title",
        "id": "title_3",
        "default": "Exercise & nutrition tips"
      }, {
        "type": "text",
        "label": "Item 3 - Description",
        "id": "description_3",
        "default": "Expert advice on how to improve your daily habits to tackle your unique set of symptoms."
      }, {
        "type": "text",
        "label": "Item 4 - Title",
        "id": "title_4",
        "default": "Expert consultation"
      }, {
        "type": "text",
        "label": "Item 4 - Description",
        "id": "description_4",
        "default": "Book a free consultation with one of our experts to review your progress and improve your next period."
      }, {
        "type": "url",
        "label": "Button URL",
        "id": "url"
      }, {
        "type": "text",
        "label": "Button label",
        "id": "label",
        "default": "Take the quiz"
      }, {
        "type": "text",
        "label": "Image caption",
        "id": "caption",
        "default": "Take our quiz to get your personalised solution"
      }
    ],
    "presets": [
      {
        "name": "personalised-solution section"
      }
    ]
  }
{% endschema %}