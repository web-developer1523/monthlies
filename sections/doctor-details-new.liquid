                  {% endif %}
                  
                </div>
              {% endfor %}
            </div>
          </div>
    <script>
      /* =========================
          DYNAMIC TEAM DATA (FROM LIQUID)
          ========================= */
      const teamMembers = [
        {% for block in section.blocks %}
          {
            name: {{ block.settings.name | json }},
            role: {{ block.settings.role | json }},
            // short and full may contain newlines or HTML — json keeps them safe as JS strings
            short: {{ block.settings.short_description | json }},
            full: {{ block.settings.full_description | json }},
            image: {{ block.settings.profile_image | img_url: 'master' | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ];
      
      /* =========================
          STATE
          ========================= */
      let currentCardIndex = 0;
      
      /* =========================
          UTIL: safe convert text -> HTML (preserve newlines)
          If the text already contains HTML tags they will render. We only convert newlines.
          ========================= */
      function textToHtml(s){
        if(!s && s !== "") return "";
        // s is already a JS string (from json). Replace \n with <br>
        return String(s).replace(/\r\n/g,'\n').replace(/\r/g,'\n').replace(/\n/g,'<br>');
      }
      
      /* =========================
          STAR ACTIVE HIGHLIGHT
          ========================= */
      function updateStarActive() {
          const stars = document.querySelectorAll(".stars-navigation div");
          if(!stars || stars.length === 0) return;
          stars.forEach((s, index) => {
              s.classList.remove("active");
              const img = s.querySelector("img");
              if(img) img.src = "https://cdn.shopify.com/s/files/1/0708/7462/8371/files/greenstar_430x.png";
          });
      
          const idx = Math.max(0, Math.min(currentCardIndex, stars.length - 1));
          const activeStar = stars[idx];
          if(activeStar){
              activeStar.classList.add("active");
              const img = activeStar.querySelector("img");
              if(img) img.src = "https://cdn.shopify.com/s/files/1/0708/7462/8371/files/redstar_430x.png";
          }
      }
      
      /* =========================
          UPDATE STACK ORDER (works with any number of cards)
          ========================= */
      function updateStackOrder(noRotate = false) {
          const cards = Array.from(document.querySelectorAll('.team-card'));
          if(!cards || cards.length === 0) return;
      
          // reset classes
          cards.forEach(c => {
            c.className = "team-card";
          });
      
          const len = cards.length;
          // ensure currentCardIndex is valid
          currentCardIndex = ((currentCardIndex % len) + len) % len;
      
          // always set active (front)
          cards[currentCardIndex].classList.add("active");
      
          // set behind classes for next two cards if they exist
          if(len > 1){
            const c2 = (currentCardIndex + 1) % len;
            cards[c2].classList.add("behind-1");
            if(noRotate) cards[c2].classList.add("no-rotate");
          }
          if(len > 2){
            const c3 = (currentCardIndex + 2) % len;
            cards[c3].classList.add("behind-2");
            if(noRotate) cards[c3].classList.add("no-rotate");
          }
      
          updateStarActive();
      }
      
      /* =========================
          SWITCH CARD (called by your star nav)
          ========================= */
      function switchCard(index) {
          const cards = document.querySelectorAll('.team-card');
          if(!cards || cards.length === 0) return;
          currentCardIndex = Math.max(0, Math.min(index, cards.length - 1));
          updateStackOrder(true); // no rotation on manual switch
      }
      
      /* =========================
          POPUP: fully dynamic rendering
          - uses teamMembers[] built from Liquid
          - preserves newlines as <br>
          ========================= */
      function toggleDetail(e, i){
          if(e && e.preventDefault) e.preventDefault();
      
          // guard
          if(!teamMembers || !teamMembers[i]) {
            console.warn("No team data for index", i);
            return;
          }
      
          const data = teamMembers[i];
      
          // build HTML safely (data.* are JS strings from json)
          const shortHTML = textToHtml(data.short || "");
          const fullHTML  = textToHtml(data.full || "");
          const roleHTML  = textToHtml(data.role || "");
          const nameHTML  = textToHtml(data.name || "");
          const imageHTML = data.image ? `<img src="${data.image}" alt="${(data.name||'')}" class="popup-profile-image" style="max-width:120px;display:block;margin-bottom:12px;">` : "";
      
          const detailContent = document.getElementById("detailContent");
          if(!detailContent) return;
      
          detailContent.innerHTML = `
              <span class='close-popup' onclick='closeDetailPopup()'>&times;</span>
              <div class="popup-inner" style="padding:12px;">
                ${imageHTML}
                <h2 style="margin:0 0 6px 0;">${nameHTML}</h2>
                ${roleHTML ? `<p style="margin:0 0 10px 0;"><strong>${roleHTML}</strong></p>` : ''}
                ${shortHTML ? `<div class="popup-short" style="margin-top:8px;">${shortHTML}</div>` : ''}
                ${fullHTML ? `<div class="popup-full" style="margin-top:0;">${fullHTML}</div>` : ''}
              </div>
          `;
      
          document.getElementById("detailPopup").classList.add("show");
      }
      
      /* =========================
          CLOSE POPUP
          ========================= */
      function closeDetailPopup(){
          const popup = document.getElementById("detailPopup");
          if(!popup) return;
          popup.classList.remove("show");
      
          // optionally clear content (keeps DOM small)
          const detailContent = document.getElementById("detailContent");
          if(detailContent){
            // restore the close button area so DOM structure doesn't break in case other code expects it
            detailContent.innerHTML = `<span class='close-popup' onclick='closeDetailPopup()'>&times;</span>`;
          }
      }
      
      /* =========================
          INIT
          ========================= */
      document.addEventListener("DOMContentLoaded", () => {
          // ensure any existing inline markup uses the first card as active
          const cards = document.querySelectorAll('.team-card');
          if(cards && cards.length > 0){
            // if you want to match the order of teamMembers array to DOM cards, ensure blocks are output in the same order (they are)
            currentCardIndex = 0;
          }
      
          updateStackOrder(true);
          updateStarActive();
      
          // close popup on background click (optional but useful)
          const popup = document.getElementById("detailPopup");
          if(popup){
            popup.addEventListener('click', function(e){
              // close when clicking outside the content area
              if(e.target === popup) closeDetailPopup();
            });
          }
      
          // bind escape key to close popup
          document.addEventListener('keydown', function(e){
            if(e.key === "Escape") closeDetailPopup();
          });
      });
      </script>
      

      <script>
        /* =========================
           TOUCH SWIPE SUPPORT (MOBILE)
           ========================= */
        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;
        
        const swipeThreshold = 50; // minimum swipe distance
        
        function handleSwipe() {
          const diffX = touchEndX - touchStartX;
          const diffY = touchEndY - touchStartY;
        
          // horizontal swipe
          if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > swipeThreshold) {
            if (diffX < 0) {
              // swipe left → next card
              nextCard();
            } else {
              // swipe right → previous card
              prevCard();
            }
          }
        
          // vertical swipe (optional but nice on mobile)
          if (Math.abs(diffY) > Math.abs(diffX) && Math.abs(diffY) > swipeThreshold) {
            if (diffY < 0) {
              // swipe up → next card
              nextCard();
            } else {
              // swipe down → previous card
              prevCard();
            }
          }
        }
        
        function nextCard() {
          const cards = document.querySelectorAll('.team-card');
          if (!cards.length) return;
        
          currentCardIndex = (currentCardIndex + 1) % cards.length;
          updateStackOrder();
        }
        
        function prevCard() {
          const cards = document.querySelectorAll('.team-card');
          if (!cards.length) return;
        
          currentCardIndex =
            (currentCardIndex - 1 + cards.length) % cards.length;
          updateStackOrder();
        }
        
        document.addEventListener("DOMContentLoaded", () => {
          const swipeArea = document.querySelector(".card-container");
          if (!swipeArea) return;
        
          swipeArea.addEventListener("touchstart", (e) => {
            touchStartX = e.changedTouches[0].screenX;
            touchStartY = e.changedTouches[0].screenY;
          }, { passive: true });
        
          swipeArea.addEventListener("touchend", (e) => {
            touchEndX = e.changedTouches[0].screenX;
            touchEndY = e.changedTouches[0].screenY;
            handleSwipe();
          }, { passive: true });
        });
        </script>
