                            </div>
                            {% endfor %}
                    </div>
                    <div class="stars-navigation">
                        <div onclick="switchCard(0)"><img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/greenstar_430x.png" alt="Star 1"></div>
                        <div onclick="switchCard(1)"><img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/greenstar_430x.png" alt="Star 2"></div>
                        <div onclick="switchCard(2)"><img src="https://cdn.shopify.com/s/files/1/0708/7462/8371/files/greenstar_430x.png" alt="Star 3"></div>
                    </div>
                </div>
                </div>
        
                <!-- STAR NAVIGATION -->
             
            </div>
        
