    {% schema %}
    {
      "name": "Doctor Details New",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "main_heading",
          "label": "Main Heading",
          "default": "A global team, one purpose"
        },
        {
          "type": "inline_richtext",
          "id": "sub_heading",
          "label": "Sub Heading",
          "default": "Created by women, for women."
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Description",
          "default": "Three women from three different continents..."
        },
        {
          "type": "image_picker",
          "id": "right_image",
          "label": "Right Side Main Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_right_image",
          "label": "Mobile Right Side Main Image"
        }
      ],
    "blocks": [
      {
        "type": "team",
        "name": "Team Member",
        "settings": [
          {
            "type": "inline_richtext",
            "id": "name",
            "label": "Name"
          },
          {
            "type": "inline_richtext",
            "id": "role",
            "label": "Role"
          },
          {
            "type": "image_picker",
            "id": "profile_image",
            "label": "Profile Image"
          },
          {
            "type": "inline_richtext",
            "id": "learn_more",
            "label": "Learn more text"
          },
          {
            "type": "inline_richtext",
            "id": "short_description",
            "label": "Short Description"
          },
          {
            "type": "textarea",
            "id": "full_description",
            "label": "Full Description"
          }
        ]
      }
    ],
      "max_blocks": 10,
      "presets": [
        {
          "name": "Doctor Details New"
        }
      ]
    }
    {% endschema %}
    