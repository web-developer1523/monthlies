<script>
      (function() {
        function initFaqAccordions() {
          var container = document.querySelector('.faq_insta .ingredients_content');
          if (!container) return;
          var accordions = container.querySelectorAll('.accordion');
          accordions.forEach(function(accordion) {
            accordion.addEventListener('click', function() {
              var content = this.querySelector('.accordion_content');
              var isActive = this.classList.contains('active');
              accordions.forEach(function(acc) {
                acc.classList.remove('active');
                var c = acc.querySelector('.accordion_content');
                if (c) c.style.maxHeight = '0';
              });
              if (!isActive) {
                this.classList.add('active');
                if (content) {
                  content.style.maxHeight = content.scrollHeight + 'px';
                }
              } else if (content) {
                content.style.maxHeight = '0';
              }
            });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initFaqAccordions);
        } else {
          initFaqAccordions();
        }
      })();
    </script>
