<section class="solution">
  <div class="main-section headin">
    <h2>{{ section.settings['section-heading'] }}</h2>
    {{ section.settings.description }}
  </div>
  <div class="container">
    <div class="sol1_box">
      <h2>{{ section.settings.Heading }}</h2>
      <img src="{{ section.settings.image | img_url: 'master' }}" alt="">
    </div>
    <div class="sol2_box">
      <div>{{ section.settings.paragraph }}</div>
      <div class="uni-container">
        <div class="uni">
          <div class="health_percent">{{ section.settings.percentage_health }}</div>
          <p>{{ section.settings.improvement_text }}</p>
        </div>
        <div class="uni">
          <div class="health_percent">{{ section.settings.percentage_feeling }}</div>
          <p>{{ section.settings.feeling_text }}</p>
        </div>
      </div>
      <div class="note">{{ section.settings.note }}</div>
    </div>
  </div>
</section>
<section class="hormones desktop_dash">
  <div class="container">
    {% for block in section.blocks %}
      {% case block.type %}
        {%- when 'benefits' -%}
          <div class="happens_box">
            <div class="upper-box">
              <div class="balnce">
                {{ block.settings.benefit_heading }}
              </div>
              <div class="hap1">
                {{ block.settings.benefit_subheading }}
                <div>{{ block.settings.benefit_text }}</div>
              </div>
            </div>
            <div class="hap2">
              <div class="flower">
                <img src="{{ block.settings.help-image | img_url: 'master' }}" alt="">
                {{ block.settings.help_heading }}
              </div>
              <div>
                {{ block.settings.help_text }}
                <details class="cst-details">
                  <summary>
                    <span id="open">{{ block.settings['read-more'] }}</span>
                    <span id="close">{{ block.settings['read-less'] }}</span>
                  </summary>

                  {{ block.settings.help_text1 }}
                </details>
              </div>
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
  <div class="extra-note">{{ section.settings.button }}</div>
</section>
<section class="hormones mobile_dash">
  <div class="container">
    <!-- Tab Buttons -->
    <div class="tab-buttons">
      {% for block in section.blocks %}
        <button class="tab-btn {% if forloop.first %}active{% endif %}" data-tab="tab{{ forloop.index }}">
          {{ block.settings.benefit_heading | strip_html }}
        </button>
      {% endfor %}
    </div>

    <!-- Tab Content -->
    <div class="tab-content">
      {% for block in section.blocks %}
        <div class="happens_box tab-panel {% if forloop.first %}active{% endif %}" id="tab{{ forloop.index }}">
          <div class="upper-box">
            <div class="balnce">
              {{ block.settings.benefit_heading }}
            </div>
            <div class="hap1">
              <h3>{{ block.settings.benefit_subheading }}</h3>
              <div>
                {{ block.settings.benefit_text }}
              </div>
            </div>
          </div>
          <div class="hap2">
            <div class="flower">
              {% if block.settings['help-image'] != blank %}
                <img src="{{ block.settings.help-image | image_url }}" alt="">
              {% endif %}
              {{ block.settings.help_heading }}
            </div>
            <div>
              {% if block.settings.help_subheading != blank %}
                <p>
                  <strong>{{ block.settings.help_subheading }}</strong>
                </p>
              {% endif %}
              <p>{{ block.settings.help_text }}</p>
              <details>
                <summary>
                  <span id="open">{{ block.settings['read-more'] }}</span>
                  <span id="close">{{ block.settings['read-less'] }}</span>
                </summary>
                <p>
                  {{ block.settings.help_text1 }}
                </p>
              </details>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.tab-btn');
  const tabs = document.querySelectorAll('.tab-panel');

  buttons.forEach(btn => {
      btn.addEventListener('click', () => {
          buttons.forEach(b => b.classList.remove('active'));
          tabs.forEach(tab => tab.classList.remove('active'));

          btn.classList.add('active');
          document.getElementById(btn.dataset.tab).classList.add('active');
      });
  });
</script>

