{{ 'section-pain-comparison.css' | asset_url | stylesheet_tag }}

{% render 'section-paddings',
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  padding_top_mobile: section.settings.padding_top_mobile,
  padding_bottom_mobile: section.settings.padding_bottom_mobile
%}

{%- capture section_style -%}
  --pain-comparison-bg: {{ section.settings.background_color }};
  --pain-comparison-heading-color: {{ section.settings.heading_color }};
  --pain-comparison-heading-size: {{ section.settings.heading_size }}px;
  --pain-comparison-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
  --pain-comparison-heading-max-width: {{ section.settings.heading_max_width }}px;
  --pain-comparison-accent: {{ section.settings.heading_accent }};
  --pain-comparison-subheading-color: {{ section.settings.subheading_color }};
  --pain-comparison-subheading-size: {{ section.settings.subheading_size }}px;
  --pain-comparison-subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
  --pain-comparison-media-width: {{ section.settings.media_width }}px;
  --pain-comparison-media-width-mobile: {{ section.settings.media_width_mobile }}px;
  --pain-comparison-row-gap: {{ section.settings.row_gap }}px;
  --pain-comparison-col-gap: {{ section.settings.col_gap }}px;
  --pain-comparison-item-radius: {{ section.settings.item_radius }}px;
  --pain-comparison-item-padding: {{ section.settings.item_padding_y }}px {{ section.settings.item_padding_x }}px;
  --pain-comparison-item-padding-mobile: {{ section.settings.item_padding_y_mobile }}px {{ section.settings.item_padding_x_mobile }}px;
  --pain-comparison-item-size: {{ section.settings.item_text_size }}px;
  --pain-comparison-item-size-mobile: {{ section.settings.item_text_size_mobile }}px;
  --pain-comparison-positive-bg: {{ section.settings.positive_bg }};
  --pain-comparison-positive-text: {{ section.settings.positive_text }};
  --pain-comparison-negative-bg: {{ section.settings.negative_bg }};
  --pain-comparison-negative-text: {{ section.settings.negative_text }};
  --pain-comparison-icon-size: {{ section.settings.icon_size }}px;
  --pain-comparison-icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
  --pain-comparison-positive-icon: {{ section.settings.positive_icon }};
  --pain-comparison-positive-icon-bg: {{ section.settings.positive_icon_bg }};
  --pain-comparison-negative-icon: {{ section.settings.negative_icon }};
  --pain-comparison-negative-icon-bg: {{ section.settings.negative_icon_bg }};
  --pain-comparison-vs-size: {{ section.settings.vs_size }}px;
  --pain-comparison-vs-size-mobile: {{ section.settings.vs_size_mobile }}px;
  --pain-comparison-vs-text-size: {{ section.settings.vs_text_size }}px;
  --pain-comparison-vs-text-size-mobile: {{ section.settings.vs_text_size_mobile }}px;
  --pain-comparison-vs-bg: {{ section.settings.vs_bg }};
  --pain-comparison-vs-color: {{ section.settings.vs_color }};
{%- endcapture -%}

<section class="pain-comparison section-{{ section.id }}--padding" style="{{ section_style | strip_newlines }}">
  <div class="pain-comparison__inner page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="pain-comparison__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="pain-comparison__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="pain-comparison__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign vs_text = section.settings.vs_text | strip -%}
    <div class="pain-comparison__layout">
      <div class="pain-comparison__media pain-comparison__media--left">
        {%- if section.settings.left_image != blank -%}
          {{
            section.settings.left_image
            | image_url: width: 600
            | image_tag:
              class: 'pain-comparison__media-image',
              loading: 'lazy',
              sizes: '(min-width: 990px) 20vw, 40vw',
              widths: '200, 300, 400, 600',
              alt: section.settings.left_image.alt
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'pain-comparison__media-image' }}
        {%- endif -%}
      </div>

      {%- if vs_text != blank -%}
        <div class="pain-comparison__vs pain-comparison__vs--media">
          {{ vs_text | escape }}
        </div>
      {%- endif -%}

      <div class="pain-comparison__comparison">
        {%- assign visible_rows = 0 -%}
        {%- for block in section.blocks -%}
          {%- assign left_text = block.settings.left_text | strip -%}
          {%- assign right_text = block.settings.right_text | strip -%}
          {%- if left_text != blank or right_text != blank -%}
            {%- assign visible_rows = visible_rows | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="pain-comparison__list">
          {%- assign rendered_rows = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign left_text = block.settings.left_text | strip -%}
            {%- assign right_text = block.settings.right_text | strip -%}
            {%- if left_text != blank or right_text != blank -%}
              {%- assign rendered_rows = rendered_rows | plus: 1 -%}
              {%- assign row_classes = 'pain-comparison__row' -%}
              {%- if vs_text != blank and rendered_rows == 2 and visible_rows > 2 -%}
                {%- assign row_classes = row_classes | append: ' pain-comparison__row--with-vs' -%}
              {%- endif -%}
              <div class="{{ row_classes }}" {{ block.shopify_attributes }}>
                <div class="pain-comparison__item pain-comparison__item--positive">
                  <svg class="pain-comparison__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="pain-comparison__icon-circle" cx="12" cy="12" r="10"></circle>
                    <path class="pain-comparison__icon-path" d="M8 12.5l2.6 2.6L16.5 9"></path>
                  </svg>
                  <div class="pain-comparison__item-text">
                    {{ left_text }}
                  </div>
                </div>
                <div class="pain-comparison__item pain-comparison__item--negative">
                  <svg class="pain-comparison__icon pain-comparison__icon--negative" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="pain-comparison__icon-circle" cx="12" cy="12" r="10"></circle>
                    <path class="pain-comparison__icon-path" d="M9 9l6 6M15 9l-6 6"></path>
                  </svg>
                  <div class="pain-comparison__item-text">
                    {{ right_text }}
                  </div>
                </div>
                {%- if vs_text != blank and rendered_rows == 2 and visible_rows > 2 -%}
                  <div class="pain-comparison__vs pain-comparison__vs--list pain-comparison__vs--after-row">
                    {{ vs_text | escape }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if vs_text != blank and visible_rows <= 2 -%}
          <div class="pain-comparison__vs pain-comparison__vs--list">
            {{ vs_text | escape }}
          </div>
        {%- endif -%}
      </div>

      <div class="pain-comparison__media pain-comparison__media--right">
        {%- if section.settings.right_image != blank -%}
          {{
            section.settings.right_image
            | image_url: width: 600
            | image_tag:
              class: 'pain-comparison__media-image',
              loading: 'lazy',
              sizes: '(min-width: 990px) 20vw, 40vw',
              widths: '200, 300, 400, 600',
              alt: section.settings.right_image.alt
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'pain-comparison__media-image' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

